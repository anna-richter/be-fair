        for imgs, idxs in dataloader:
            imgs = imgs.to(device)
            feats = model(imgs)
            feats = feats.cpu().numpy()
            emb[idxs.numpy()] = feats
    return emb


def predict(image_paths, boosters, batch_size=32, num_workers=4):
    """
    Predict malignancy probability for a list of image paths.
    Args:
      image_paths: list of str paths to images
      boosters: list of trained lightgbm.Booster objects
    Returns:
      numpy array of shape (n_images,) with average malignant probability
    """
    # Set up transforms and model
    weights = EfficientNet_B0_Weights.IMAGENET1K_V1
    transform = weights.transforms()
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = efficientnet_b0(weights=weights)
    feature_dim = model.classifier[1].in_features
    model.classifier = torch.nn.Identity()
    model.to(device)

    ds = SkinDataset(image_paths, transform)
    loader = DataLoader(
        ds, batch_size=batch_size, num_workers=num_workers, shuffle=False
    )
    emb = extract_embeddings(model, loader, device, feature_dim)

    preds = np.zeros((emb.shape[0],), dtype=np.float32)
    for booster in boosters:
        preds += booster.predict(emb, num_iteration=booster.best_iteration or None)
    return preds / len(boosters)


if __name__ == "__main__":
    # Load metadata
    df = pd.read_csv("./input/mydataset.csv")
    df["y"] = (df["label"] == "malignant").astype(int)
    img_dir = "./input/MyImages"
    paths = df["image_name"].apply(lambda x: os.path.join(img_dir, x + ".jpg")).tolist()
    ys = df["y"].values

    # Prepare model for embedding extraction
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    weights = EfficientNet_B0_Weights.IMAGENET1K_V1
    transform = weights.transforms()
    model = efficientnet_b0(weights=weights)
    feature_dim = model.classifier[1].in_features
    model.classifier = torch.nn.Identity()
    model.to(device)

    # Extract embeddings for all images
    ds_all = SkinDataset(paths, transform)
    loader_all = DataLoader(ds_all, batch_size=32, num_workers=4, shuffle=False)
    embeddings = extract_embeddings(model, loader_all, device, feature_dim)

    # 5-fold stratified CV with LightGBM using callbacks for early stopping
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    boosters = []
    aucs = []
    for fold, (tr_idx, val_idx) in enumerate(skf.split(embeddings, ys), 1):
        X_tr, X_val = embeddings[tr_idx], embeddings[val_idx]
        y_tr, y_val = ys[tr_idx], ys[val_idx]

        dtrain = lgb.Dataset(X_tr, label=y_tr)
        dval = lgb.Dataset(X_val, label=y_val, reference=dtrain)

        params = {
            "objective": "binary",
            "boosting_type": "gbdt",
            "metric": "auc",
            "learning_rate": 0.01,
            "num_leaves": 31,
            "verbose": -1,
            "seed": 42,
        }

        # Use callbacks for early stopping
        booster = lgb.train(
            params,
            dtrain,
            num_boost_round=10000,
            valid_sets=[dval],
            callbacks=[
                lgb.early_stopping(stopping_rounds=50),
                lgb.log_evaluation(period=100),
            ],
        )

        prob_val = booster.predict(X_val, num_iteration=booster.best_iteration)
        auc = roc_auc_score(y_val, prob_val)
        print(f"Fold {fold} AUROC: {auc:.4f}")

        boosters.append(booster)
        aucs.append(auc)

    mean_auc = np.mean(aucs)
    print(f"Mean AUROC: {mean_auc:.4f}")

    # Demonstrate predict() on the full dataset
    preds = predict(paths, boosters)
    overall_auc = roc_auc_score(ys, preds)
    print(f"Overall AUROC by predict(): {overall_auc:.4f}")

