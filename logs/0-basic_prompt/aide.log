    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    weights = EfficientNet_B0_Weights.IMAGENET1K_V1
    base_transform = weights.transforms()
    model = efficientnet_b0(weights=weights)
    feature_dim = model.classifier[1].in_features
    model.classifier = torch.nn.Identity()
    model.to(device)

    # 3) Extract TTA embeddings
    embs_list = []
    for tf in [base_transform,
               transforms.Compose([transforms.RandomHorizontalFlip(p=1.0), base_transform]),
               transforms.Compose([transforms.RandomVerticalFlip(p=1.0), base_transform])]:
        ds = SkinDataset(paths, tf)
        dl = DataLoader(ds, batch_size=32, num_workers=4, shuffle=False)
        embs_list.append(extract_embeddings(model, dl, device, feature_dim))
