            feats = model(imgs)
            emb[idxs.numpy()] = feats.cpu().numpy()
    return emb


def predict(image_paths, classifiers, batch_size=32, num_workers=4):
    """
    Predict malignancy probability for a list of image paths with horizontal and vertical flip TTA.
    Args:
      image_paths: list of str paths to images
      classifiers: list of trained LGBMClassifier models
    Returns:
