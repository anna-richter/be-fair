        auc = roc_auc_score(y_val, prob_val)
        print(f"Fold {fold} AUROC: {auc:.4f}")

        boosters.append(booster)
        aucs.append(auc)

    mean_auc = np.mean(aucs)
    print(f"Mean AUROC: {mean_auc:.4f}")

    # Demonstrate predict() on the full dataset
    preds = predict(paths, boosters)
    overall_auc = roc_auc_score(ys, preds)
    print(f"Overall AUROC by predict(): {overall_auc:.4f}")

