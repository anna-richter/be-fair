    print(f"Mean AUROC: {np.mean(aucs):.4f}")

    # overall on training via predict()
    preds = predict(paths, classifiers)
    overall_auc = roc_auc_score(ys, preds)
    print(f"Overall AUROC by predict(): {overall_auc:.4f}")

