    emb = sum(emb_list) / len(emb_list)

    preds = np.zeros(len(image_paths), dtype=np.float32)
    for clf in classifiers:
        preds += clf.predict_proba(emb, num_iteration=clf.best_iteration_)[:, 1]
    preds /= len(classifiers)
    return preds


if __name__ == "__main__":
    # load data
    df = pd.read_csv("./input/mydataset.csv")
    df["y"] = (df["label"] == "malignant").astype(int)
    img_dir = "./input/MyImages"
    paths = df["image_name"].apply(lambda x: os.path.join(img_dir, x + ".jpg")).tolist()
    ys = df["y"].values

    # set up device and transforms
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    weights = EfficientNet_B0_Weights.IMAGENET1K_V1
    base_transform = weights.transforms()
    hflip = transforms.Compose([transforms.RandomHorizontalFlip(p=1.0), base_transform])
    vflip = transforms.Compose([transforms.RandomVerticalFlip(p=1.0), base_transform])

    # load pretrained backbone
    model = efficientnet_b0(weights=weights)
    feature_dim = model.classifier[1].in_features
    model.classifier = torch.nn.Identity()
    model.to(device)

    # extract embeddings once with TTA
    emb0 = extract_embeddings(
        model,
        DataLoader(
            SkinDataset(paths, base_transform),
            batch_size=32,
            num_workers=4,
            shuffle=False,
        ),
        device,
        feature_dim,
    )
    emb1 = extract_embeddings(
        model,
        DataLoader(
            SkinDataset(paths, hflip), batch_size=32, num_workers=4, shuffle=False
        ),
        device,
        feature_dim,
    )
    emb2 = extract_embeddings(
        model,
        DataLoader(
            SkinDataset(paths, vflip), batch_size=32, num_workers=4, shuffle=False
        ),
        device,
        feature_dim,
    )
    embeddings = (emb0 + emb1 + emb2) / 3.0

    # 5‐fold CV with OOF predictions
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    classifiers = []
    aucs = []
    oof_preds = np.zeros(len(ys), dtype=np.float32)

    for fold, (tr_idx, val_idx) in enumerate(skf.split(embeddings, ys), start=1):
        X_tr, X_val = embeddings[tr_idx], embeddings[val_idx]
        y_tr, y_val = ys[tr_idx], ys[val_idx]

        clf = lgb.LGBMClassifier(
            objective="binary",
            boosting_type="gbdt",
            n_estimators=1000,
            class_weight="balanced",
            random_state=42,
            n_jobs=-1,
        )
        clf.fit(
            X_tr,
            y_tr,
            eval_set=[(X_val, y_val)],
            eval_metric="auc",
            callbacks=[lgb.early_stopping(50), lgb.log_evaluation(0)],
        )
        p_val = clf.predict_proba(X_val, num_iteration=clf.best_iteration_)[:, 1]
        oof_preds[val_idx] = p_val
        auc = roc_auc_score(y_val, p_val)
        print(f"Fold {fold} AUROC: {auc:.4f}")
        classifiers.append(clf)
        aucs.append(auc)

    print(f"Mean CV AUROC: {np.mean(aucs):.4f}")
    overall_auc = roc_auc_score(ys, oof_preds)
    print(f"OOF AUROC: {overall_auc:.4f}")

