import os
import glob
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models

class SkinLesionDataset(Dataset):
    def __init__(self, df, image_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.image_dir = image_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.loc[idx]
        path = os.path.join(self.image_dir, row["image_name"] + ".jpg")
        img = Image.open(path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row["binary_label"], dtype=torch.long)
        return img, label

def predict(model_paths, image_dir):
    """
    Args:
        model_paths: list of .pth model checkpoint paths
        image_dir: directory with .jpg test images
    Returns:
        DataFrame with columns ['image_name','malignant_prob'] (averaged)
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    transform = transforms.Compose([
        transforms.Resize((128,128)),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])
    ])
    # load all models
    models_list = []
    for mp in model_paths:
        m = models.resnet18(pretrained=False)
        m.fc = nn.Linear(m.fc.in_features,2)
        m.load_state_dict(torch.load(mp, map_location=device))
        m.to(device).eval()
        models_list.append(m)
    # predict
    results = []
    for fname in sorted(os.listdir(image_dir)):
        if not fname.lower().endswith(".jpg"):
            continue
        img = Image.open(os.path.join(image_dir,fname)).convert("RGB")
        x = transform(img).unsqueeze(0).to(device)
        probs = []
        with torch.no_grad():
            for m in models_list:
                logits = m(x)
                p = torch.softmax(logits,dim=1)[0,1].item()
                probs.append(p)
        avgp = float(np.mean(probs))
        results.append({"image_name":os.path.splitext(fname)[0],"malignant_prob":avgp})
    return pd.DataFrame(results)

