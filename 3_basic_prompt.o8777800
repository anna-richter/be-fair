                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4)                                              
                        all_feats =                                             
                    np.zeros((len(image_paths),                                 
                    feat_model.feature_dim),                                    
                    dtype=np.float32)                                           
                        with torch.no_grad():                                   
                            for imgs, idxs in loader:                           
                                imgs = imgs.to(device)                          
                                feats =                                         
                    feat_model.forward_features(imgs)                           
                                # some timm models return                       
                    flat features                                               
                                if feats.ndim == 4:                             
                                    feats =                                     
                    torch.flatten(feats, start_dim=1)                           
                                feats = feats.cpu().numpy()                     
                                all_feats[idxs.numpy()] =                       
                    feats                                                       
                        # each lr_model: use .predict_proba                     
                    to get pos class probability                                
                        probs =                                                 
                    np.stack([m.predict_proba(all_feats)[:,                     
                    1] for m in lr_models], axis=1)                             
                        return probs.mean(axis=1)                               
                                                                                
                                                                                
                    def main():                                                 
                        # settings                                              
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_SPLITS = 5                                            
                        DEVICE = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                        # read data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        df["label_bin"] = (df.label ==                          
                    "malignant").astype(int)                                    
                        # build full list of image paths in                     
                    the CSV order                                               
                        image_paths = []                                        
                        for base in df.image_name:                              
                            # match .image_12274... or                          
                    image_12274...                                              
                            matches =                                           
                    glob.glob(os.path.join(IMG_DIR,                             
                    f"*{base}.*"))                                              
                            if not matches:                                     
                                raise                                           
                    FileNotFoundError(f"No file found for                       
                    image {base}")                                              
                            image_paths.append(matches[0])                      
                        # transforms                                            
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # load pretrained backbone                              
                        backbone =                                              
                    timm.create_model("resnet18",                               
                    pretrained=True)                                            
                        # timm ResNet has feature_dim                           
                    attribute or infer from output of                           
                    forward_features                                            
                        backbone.eval()                                         
                        backbone.feature_dim = (                                
                            backbone.num_features                               
                            if hasattr(backbone,                                
                    "num_features")                                             
                            else backbone.fc.in_features                        
                        )                                                       
                        backbone = backbone.to(DEVICE)                          
                        # extract features once                                 
                        ds_full =                                               
                    ImagePathsDataset(image_paths,                              
                    transform=transform)                                        
                        loader_full = DataLoader(ds_full,                       
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        features = np.zeros((len(ds_full),                      
                    backbone.feature_dim),                                      
                    dtype=np.float32)                                           
                        with torch.no_grad():                                   
                            for imgs, idxs in loader_full:                      
                                imgs = imgs.to(DEVICE)                          
                                feats =                                         
                    backbone.forward_features(imgs)                             
                                if feats.ndim == 4:                             
                                    feats =                                     
                    torch.flatten(feats, start_dim=1)                           
                                feats_np =                                      
                    feats.cpu().numpy()                                         
                                for i, idx in                                   
                    enumerate(idxs):                                            
                                    features[idx] =                             
                    feats_np[i]                                                 
                        labels = df.label_bin.values                            
                        # cross-validate logistic                               
                    regression                                                  
                        skf =                                                   
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                        lr_models = []                                          
                        scores = []                                             
                        for train_idx, val_idx in                               
                    skf.split(features, labels):                                
                            X_tr, y_tr =                                        
                    features[train_idx], labels[train_idx]                      
                            X_va, y_va = features[val_idx],                     
                    labels[val_idx]                                             
                            lr =                                                
                    LogisticRegression(max_iter=1000)                           
                            lr.fit(X_tr, y_tr)                                  
                            yps = lr.predict_proba(X_va)[:,                     
                    1]                                                          
                            auc = roc_auc_score(y_va, yps)                      
                            scores.append(auc)                                  
                            lr_models.append(lr)                                
                            print(f"Fold AUROC: {auc:.4f}")                     
                        print(f"Mean AUROC:                                     
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                        # Optional: save predictions on all                     
                    images as submission.csv                                    
                        preds = predict(                                        
                            image_paths,                                        
                            backbone,                                           
                            lr_models,                                          
                            device=DEVICE,                                      
                            transform=transform,                                
                            batch_size=32,                                      
                        )                                                       
                        submission =                                            
                    pd.DataFrame({"image_name":                                 
                    df.image_name, "malignant_prob":                            
                    preds})                                                     
                        submission.to_csv("./working/submis                     
                    sion.csv", index=False)                                     
                        print("Saved submission.csv to                          
                    ./working/")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
