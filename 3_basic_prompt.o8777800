                    ze(0), -1).cpu().numpy()                                    
                                feats[idxs.numpy()] = out                       
                        return feats                                            
                                                                                
                                                                                
                    def predict(model, feature_extractor,                       
                    img_dir, batch_size=32):                                    
                        # Predict malignancy probabilities                      
                    for all .jpg in img_dir                                     
                        img_names = [f for f in                                 
