                    # Task description                                          
                                                                                
                    ## Task goal                                                
                                                                                
                    I am a dermatologist, I have collected                      
                    data about skin lesions with my                             
                    colleagues over the last years. Now I                       
                    want to train an AI on this dataset                         
                    that can differentiate malignant and                        
                    benign lesions. The idea is that I                          
                    upload a folder with new images and the                     
                    model returns the probability between 0                     
                    and 1 for each image that the image                         
                    shows a malignant skin lesion.                              
                                                                                
                    ## Task evaluation                                          
                                                                                
                    Area under the receiver operator curve                      
                    (AUROC)                                                     
                                                                                
                    # Previous (buggy) implementation                           
                                                                                
                    ```python                                                   
                    import os                                                   
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.loc[idx]                              
                            base = row.image_name                               
                            # find file matching                                
                    image_name.*                                                
                            matches =                                           
                    glob.glob(os.path.join(self.img_dir,                        
                    base + ".*"))                                               
                            if not matches:                                     
                                raise                                           
                    FileNotFoundError(f"No file for                             
                    {base}")                                                    
                            img_path = matches[0]                               
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = row.label_bin                               
                            return img, label                                   
                                                                                
                                                                                
                    def predict(image_paths, model,                             
                    device="cpu", transform=None):                              
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths.                             
                        Args:                                                   
                            image_paths (List[str]): paths                      
                    to image files.                                             
                            model (torch.nn.Module):                            
                    trained binary classification model.                        
                            device (str): 'cpu' or 'cuda'.                      
                            transform (callable):                               
                    preprocessing transforms.                                   
                        Returns:                                                
                            np.ndarray: array of                                
                    probabilities for the malignant class.                      
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        loader = DataLoader(image_paths,                        
                    batch_size=32, shuffle=False)                               
                        for batch in loader:                                    
                            imgs = []                                           
                            for path in batch:                                  
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                if transform:                                   
                                    img = transform(img)                        
                                imgs.append(img)                                
                            imgs =                                              
                    torch.stack(imgs).to(device)                                
                            with torch.no_grad():                               
                                out = model(imgs)                               
                                prob =                                          
                    torch.sigmoid(out).squeeze().cpu().nump                     
                    y()                                                         
                                probs.extend(prob.tolist())                     
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_SPLITS = 5                                            
                        BATCH_SIZE = 32                                         
                        EPOCHS = 3                                              
                        DEVICE = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                        # Data                                                  
                        df = pd.read_csv(CSV_PATH)                              
                        # binary label: malignant=1, else=0                     
                        df["label_bin"] = (df.label ==                          
                    "malignant").astype(int)                                    
                        skf =                                                   
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                        # transforms                                            
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        scores = []                                             
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.label_bin)):                     
                            print(f"Fold                                        
                    {fold+1}/{N_SPLITS}")                                       
                            train_df = df.loc[train_idx]                        
                            val_df = df.loc[val_idx]                            
                            train_ds =                                          
                    SkinLesionDataset(train_df, IMG_DIR,                        
                    transform=transform)                                        
                            val_ds =                                            
                    SkinLesionDataset(val_df, IMG_DIR,                          
                    transform=transform)                                        
                            train_loader = DataLoader(                          
                                train_ds,                                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                            )                                                   
                            val_loader = DataLoader(                            
                                val_ds,                                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4                                               
                            )                                                   
                            # model                                             
                            model =                                             
                    timm.create_model("resnet18",                               
                    pretrained=True, num_classes=1)                             
                            model = model.to(DEVICE)                            
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            # training                                          
                            for epoch in range(EPOCHS):                         
                                model.train()                                   
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs, labels =                              
                    imgs.to(DEVICE),                                            
                    labels.float().to(DEVICE)                                   
                                    preds =                                     
                    model(imgs).squeeze()                                       
                                    loss = criterion(preds,                     
                    labels)                                                     
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # validation                                        
                            model.eval()                                        
                            ys, yps = [], []                                    
                            with torch.no_grad():                               
                                for imgs, labels in                             
                    val_loader:                                                 
                                    imgs = imgs.to(DEVICE)                      
                                    logits =                                    
                    model(imgs).squeeze().cpu().numpy()                         
                                    prob = 1 / (1 +                             
                    np.exp(-logits))                                            
                                    yps.extend(prob.tolist(                     
                    ))                                                          
                                    ys.extend(labels.numpy(                     
                    ).tolist())                                                 
                            auc = roc_auc_score(ys, yps)                        
                            print(f"Fold {fold+1} AUROC:                        
                    {auc:.4f}")                                                 
                            scores.append(auc)                                  
                        print(f"Mean AUROC:                                     
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
