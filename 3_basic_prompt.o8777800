                    response: We can address the long                           
                    training time by using a much lighter                       
                    model and freezing its pretrained                           
                    backbone, training only the final                           
                    classifier for a few epochs on a                            
                    single held-out validation split. We                        
                    also skip any zero‐byte (corrupt)                           
                    images when building our map. This                          
                    reduces the number of parameters being                      
                    updated and the number of epochs, so                        
                    training finishes quickly yet still                         
                    provides a realistic AUROC on held-out                      
                    data. The same script includes a                            
                    reusable `predict()` function for new                       
                    image folders.                                              
                                                                                
                    ```python                                                   
                    import os                                                   
                    import glob                                                 
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    StratifiedShuffleSplit                                      
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                    def build_image_map(image_dir):                             
                        mapping = {}                                            
                        for filepath in                                         
                    glob.glob(os.path.join(image_dir,                           
                    "*")):                                                      
                            if os.path.getsize(filepath)                        
                    == 0:                                                       
                                continue  # skip corrupt                        
                    zero-byte files                                             
                            fname =                                             
                    os.path.basename(filepath)                                  
                            key = fname.lstrip(".")                             
                            idx = key.lower().find(".jpg")                      
                            if idx != -1:                                       
                                img_name = key[:idx]                            
                                mapping[img_name] =                             
                    filepath                                                    
                        return mapping                                          
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_map,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_map = img_map                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, i):                               
                            row = self.df.iloc[i]                               
                            path =                                              
                    self.img_map[row.image_name]                                
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            x = self.transform(img)                             
                            y = torch.tensor(row.label,                         
                    dtype=torch.float32)                                        
                            return x, y                                         
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        total_loss = 0.0                                        
                        for x, y in loader:                                     
                            x, y = x.to(device),                                
                    y.to(device).unsqueeze(1)                                   
                            optimizer.zero_grad()                               
                            out = model(x)                                      
                            loss = criterion(out, y)                            
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss +=                                       
                    loss.item()*x.size(0)                                       
                        return                                                  
                    total_loss/len(loader.dataset)                              
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for x, y in loader:                                 
                                x = x.to(device)                                
                                logits = model(x)                               
                                prob =                                          
                    torch.sigmoid(logits).cpu().numpy().fl                      
                    atten()                                                     
                                ps.extend(prob.tolist())                        
                                ys.extend(y.numpy().tolist                      
                    ())                                                         
                        return roc_auc_score(ys, ps)                            
                                                                                
                    def predict(image_folder):                                  
                        """                                                     
                        Predict malignancy probability for                      
                    each image in a folder.                                     
                        Args:                                                   
                            image_folder (str): path to                         
                    folder of images                                            
                        Returns:                                                
                            pandas.DataFrame with columns                       
                    ['image_name','probability']                                
                        """                                                     
                        img_map =                                               
                    build_image_map(image_folder)                               
                        transform = transforms.Compose([                        
                            transforms.Resize((224,224)),                       
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.4                      
                    85,0.456,0.406],                                            
                    std=[0.229,0.224,0.225]),                                   
                        ])                                                      
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.mobilenet_v2(pretrained=False)                       
                        # replace classifier to output                          
                    single logit                                                
                        model.classifier = nn.Sequential(                       
                            nn.Dropout(0.2),                                    
                            nn.Linear(model.last_channel,                       
                    1)                                                          
                        )                                                       
                        model.load_state_dict(torch.load("                      
                    working/model.pth",                                         
                    map_location=device))                                       
                        model = model.to(device).eval()                         
                        results = []                                            
                        with torch.no_grad():                                   
                            for name, path in                                   
                    img_map.items():                                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                prob =                                          
                    torch.sigmoid(model(x)).item()                              
                                results.append({"image_nam                      
                    e": name, "probability": prob})                             
                        return pd.DataFrame(results)                            
                                                                                
                    if __name__ == "__main__":                                  
                        # read and preprocess                                   
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label"] =                                           
                    (df["label"]=="malignant").astype(int)                      
                        img_map =                                               
                    build_image_map("./input/MyImages")                         
                        df =                                                    
                    df[df.image_name.isin(img_map)]                             
                        # single stratified split                               
                        splitter =                                              
                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                        train_idx, val_idx =                                    
                    next(splitter.split(df, df.label))                          
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                                                                                
                        transform = transforms.Compose([                        
                            transforms.Resize((224,224)),                       
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.4                      
                    85,0.456,0.406],                                            
                    std=[0.229,0.224,0.225]),                                   
                        ])                                                      
                                                                                
                        train_ds =                                              
                    SkinLesionDataset(train_df, img_map,                        
                    transform)                                                  
                        val_ds   =                                              
                    SkinLesionDataset(val_df,   img_map,                        
                    transform)                                                  
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        train_loader =                                          
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=0,                                
                    pin_memory=(device.type=="cuda"))                           
                        val_loader   = DataLoader(val_ds,                       
                    batch_size=32, shuffle=False,                               
                    num_workers=0,                                              
                    pin_memory=(device.type=="cuda"))                           
                                                                                
                        # build lightweight model and                           
                    freeze backbone                                             
                        model =                                                 
                    models.mobilenet_v2(pretrained=True)                        
                        for param in                                            
                    model.features.parameters():                                
                            param.requires_grad = False                         
                        model.classifier = nn.Sequential(                       
                            nn.Dropout(0.2),                                    
                            nn.Linear(model.last_channel,                       
                    1)                                                          
                        )                                                       
                        model = model.to(device)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(filter(lambda p:                           
                    p.requires_grad, model.parameters()),                       
                    lr=1e-4)                                                    
                                                                                
                        # train just a few epochs                               
                        for epoch in range(2):                                  
                            loss = train_one_epoch(model,                       
                    train_loader, criterion, optimizer,                         
                    device)                                                     
                            print(f"Epoch {epoch+1}/2                           
                    train loss: {loss:.4f}")                                    
                                                                                
                        auc = evaluate(model, val_loader,                       
                    device)                                                     
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                        # save final model                                      
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                        # no test folder provided; if you                       
                    have new images, call predict()                             
