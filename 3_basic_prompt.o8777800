                    response: I propose fine-tuning a                           
                    pretrained ResNet18 on our binary task                      
                    of malignant vs. non-malignant lesions                      
                    using a simple 80/20 split for                              
                    training and validation. Images are                         
                    resized to 224×224 with basic                               
                    augmentation (random horizontal flips)                      
                    and normalized. We train for a few                          
                    epochs with binary cross-entropy loss,                      
                    then compute AUROC on the validation                        
                    set. A `predict()` function is                              
                    provided for inference on new image                         
                    paths.                                                      
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.loc[idx]                              
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = 1 if row.label ==                           
                    'malignant' else 0                                          
                            return image,                                       
                    torch.tensor(label,                                         
                    dtype=torch.float32)                                        
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        total_loss = 0                                          
                        for imgs, labels in loader:                             
                            imgs, labels =                                      
                    imgs.to(device), labels.to(device)                          
                            preds = model(imgs).squeeze(1)                      
                            loss = criterion(preds,                             
                    labels)                                                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    imgs.size(0)                                                
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        all_preds, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(device)                          
                                preds =                                         
                    model(imgs).squeeze(1).cpu().numpy()                        
                                all_preds.extend(preds.tol                      
                    ist())                                                      
                                all_labels.extend(labels.n                      
                    umpy().tolist())                                            
                        return roc_auc_score(all_labels,                        
                    all_preds)                                                  
                                                                                
                    def predict(model, image_paths,                             
                    device, transform):                                         
                        """                                                     
                        Predicts the probability of                             
                    malignancy for each image in                                
                    image_paths.                                                
                        Args:                                                   
                            model: trained PyTorch model.                       
                            image_paths: list of paths to                       
                    image files.                                                
                            device: 'cpu' or 'cuda'.                            
                            transform: torchvision                              
                    transforms applied to each image.                           
                        Returns:                                                
                            List of probabilities between                       
                    0 and 1.                                                    
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img =                                           
                    transform(img).unsqueeze(0).to(device)                      
                                prob =                                          
                    model(img).squeeze(1).cpu().item()                          
                                probs.append(prob)                              
                        return probs                                            
                                                                                
                    def main():                                                 
                        # Load data                                             
                        df =                                                    
                    pd.read_csv('./input/mydataset.csv')                        
                        img_dir = './input/MyImages'                            
                        # Split                                                 
                        train_df, val_df =                                      
                    train_test_split(df, test_size=0.2,                         
                    stratify=df['label']=='malignant',                          
                    random_state=42)                                            
                        # Transforms                                            
                        train_tf =                                              
                    T.Compose([T.Resize((224,224)),                             
                    T.RandomHorizontalFlip(),                                   
                    T.ToTensor(),                                               
                                              T.Normalize(                      
                    [0.485,0.456,0.406],[0.229,0.224,0.225                      
                    ])])                                                        
                        val_tf =                                                
                    T.Compose([T.Resize((224,224)),                             
                    T.ToTensor(),                                               
                                            T.Normalize([0                      
                    .485,0.456,0.406],[0.229,0.224,0.225])                      
                    ])                                                          
                        # Datasets & loaders                                    
                        train_ds =                                              
                    SkinLesionDataset(train_df, img_dir,                        
                    train_tf)                                                   
                        val_ds = SkinLesionDataset(val_df,                      
                    img_dir, val_tf)                                            
                        train_loader =                                          
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # Model                                                 
                        device = torch.device('cuda' if                         
                    torch.cuda.is_available() else 'cpu')                       
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Sequential(nn.Linear(model.fc.in_fe                      
                    atures,1), nn.Sigmoid())                                    
                        model = model.to(device)                                
                        criterion = nn.BCELoss()                                
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        # Train                                                 
                        for epoch in range(5):                                  
                            loss = train_one_epoch(model,                       
                    train_loader, criterion, optimizer,                         
                    device)                                                     
                            print(f"Epoch {epoch+1}/5,                          
                    Loss: {loss:.4f}")                                          
                        # Evaluate                                              
                        auc = evaluate(model, val_loader,                       
                    device)                                                     
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
