                        Predict malignant probabilities                         
                    for all .jpg images in img_dir using                        
                    the trained model.                                          
                        Returns a DataFrame with columns                        
                    ['image_name', 'malignant_prob'].                           
                        """                                                     
                        img_names = [f for f in                                 
                    os.listdir(img_dir) if                                      
