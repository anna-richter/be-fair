                        for fold, (tr_idx, val_idx) in                          
                    enumerate(skf.split(X, y), 1):                              
                            X_tr, X_val = X[tr_idx],                            
                    X[val_idx]                                                  
                            y_tr, y_val = y[tr_idx],                            
                    y[val_idx]                                                  
                            clf =                                               
                    RandomForestClassifier(n_estimators=10                      
                    0, random_state=42, n_jobs=-1)                              
                            clf.fit(X_tr, y_tr)                                 
                            preds =                                             
