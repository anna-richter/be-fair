                            yps =                                               
                    pipeline.predict_proba(X_va)[:, 1]                          
                            auc = roc_auc_score(y_va, yps)                      
                            scores.append(auc)                                  
                            mlp_models.append(pipeline)                         
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                                                                                
                        print(f"Mean AUROC:                                     
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                        preds = predict(                                        
                            image_paths,                                        
                            backbone,                                           
                            mlp_models,                                         
                            device=DEVICE,                                      
                            transform=transform,                                
                            batch_size=32,                                      
                        )                                                       
                        submission =                                            
