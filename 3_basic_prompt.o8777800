                        final_clf =                                             
                    RandomForestClassifier(n_estimators=10                      
                    0, random_state=42, n_jobs=-1)                              
                        final_clf.fit(X, y)                                     
                                                                                
                        # Generate submission on all                            
                    images in input/MyImages                                    
                        print("Generating submission                            
                    predictions...")                                            
                        sub_df = predict(final_clf,                             
                    img_dir)                                                    
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        sub_df.to_csv("./working/submissio                      
                    n.csv", index=False)                                        
                        print("Saved submission to                              
                    ./working/submission.csv")                                  
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
