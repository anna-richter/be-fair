                    {np.std(scores):.4f}")                                      
                                                                                
                        # generate submission using                             
                    ensemble of fold models                                     
                        preds = predict(image_paths,                            
                    backbone, mlp_models, device=DEVICE,                        
                    transform=transform, batch_size=32)                         
                        submission =                                            
