                                                      alph                      
                    a=1e-4, early_stopping=True,                                
                                                      rand                      
                    om_state=42, max_iter=200))                                 
                            ])                                                  
                            pipe.fit(X_tr, y_tr)                                
                            # preds orig & flip                                 
                            p_o =                                               
                    pipe.predict_proba(X_va_o)[:,1]                             
                            p_f =                                               
                    pipe.predict_proba(X_va_f)[:,1]                             
                            p_avg = 0.5*(p_o + p_f)                             
                            auc = roc_auc_score(y_va,                           
                    p_avg)                                                      
                            print(f"Fold {fold} AUROC w/                        
                    TTA: {auc:.4f}")                                            
                            scores.append(auc)                                  
                            mlp_models.append(pipe)                             
                                                                                
                        print(f"Mean AUROC w/ TTA:                              
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                        # final predictions with TTA                            
                        preds = predict(image_paths,                            
                    backbone, mlp_models, device=DEVICE,                        
                                        transforms=[transf                      
                    orm_orig, transform_flip],                                  
                    batch_size=32)                                              
                        submission =                                            
                    pd.DataFrame({"image_name":                                 
