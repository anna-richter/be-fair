                                raise                                           
                    FileNotFoundError(f"No file found for                       
                    image {base}")                                              
                            image_paths.append(matches[0])                      
                                                                                
                        # transforms                                            
                        transform_orig = T.Compose([                            
                            T.Resize((224,224)),                                
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                        transform_flip = T.Compose([                            
                            T.Resize((224,224)),                                
                            T.RandomHorizontalFlip(p=1.0),                      
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
