                            pipeline = Pipeline(                                
                                [                                               
                                    ("scaler",                                  
                    StandardScaler()),                                          
                                    (                                           
                                        "mlp",                                  
                                        MLPClassifier(                          
                                            hidden_layer_si                     
                    zes=(128,),                                                 
                                            activation="rel                     
                    u",                                                         
