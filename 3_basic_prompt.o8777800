                    ```python                                                   
                    import os                                                   
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from sklearn.pipeline import Pipeline                       
                    from sklearn.preprocessing import                           
                    StandardScaler                                              
                    from sklearn.neural_network import                          
                    MLPClassifier                                               
                                                                                
                    class ImagePathsDataset(Dataset):                           
                        def __init__(self, image_paths,                         
                    transform=None):                                            
                            self.image_paths = image_paths                      
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                                                                                
                        def __getitem__(self, idx):                             
                            path = self.image_paths[idx]                        
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            if self.transform:                                  
                                img = self.transform(img)                       
                            return img, idx                                     
                                                                                
                    def predict(                                                
                        image_paths, feat_model,                                
                    mlp_models, device="cpu",                                   
                    transform=None, batch_size=32                               
                    ):                                                          
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths using                        
                        a CNN feature extractor and                             
                    trained sklearn Pipeline MLP models.                        
                        Args:                                                   
                            image_paths (List[str]): paths                      
                    to image files.                                             
                            feat_model (torch.nn.Module):                       
                    CNN feature extractor with                                  
                    global_pool.                                                
                            mlp_models (List[sklearn                            
                    Pipeline]): list of trained pipelines.                      
                            device (str): 'cpu' or 'cuda'.                      
                            transform (callable):                               
                    preprocessing transforms.                                   
                            batch_size (int): batch size                        
                    for feature extraction.                                     
                        Returns:                                                
                            np.ndarray: array of averaged                       
                    probabilities for the malignant class.                      
                        """                                                     
                        feat_model.eval()                                       
                        ds =                                                    
                    ImagePathsDataset(image_paths,                              
                    transform=transform)                                        
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4)                                              
                        all_feats =                                             
                    np.zeros((len(image_paths),                                 
                    feat_model.feature_dim),                                    
                    dtype=np.float32)                                           
                        with torch.no_grad():                                   
                            for imgs, idxs in loader:                           
                                imgs = imgs.to(device)                          
                                feats =                                         
                    feat_model.forward_features(imgs)                           
                                if hasattr(feat_model,                          
                    "global_pool"):                                             
                                    feats =                                     
                    feat_model.global_pool(feats)                               
                                if feats.ndim > 2:                              
                                    feats =                                     
                    torch.flatten(feats, start_dim=1)                           
                                feats =                                         
                    feats.cpu().numpy()                                         
                                all_feats[idxs.numpy()] =                       
                    feats                                                       
                        probs =                                                 
                    np.stack([m.predict_proba(all_feats)[:                      
                    , 1] for m in mlp_models], axis=1)                          
                        return probs.mean(axis=1)                               
                                                                                
                    def main():                                                 
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_SPLITS = 5                                            
                        DEVICE = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                                                                                
                        df = pd.read_csv(CSV_PATH)                              
                        df["label_bin"] = (df.label ==                          
                    "malignant").astype(int)                                    
                                                                                
                        image_paths = []                                        
                        for base in df.image_name:                              
                            matches =                                           
                    glob.glob(os.path.join(IMG_DIR,                             
                    f"*{base}.*"))                                              
                            if not matches:                                     
                                raise                                           
                    FileNotFoundError(f"No file found for                       
                    image {base}")                                              
                            image_paths.append(matches[0])                      
                                                                                
                        transform = T.Compose([                                 
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485,                            
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                        ])                                                      
                                                                                
                        # Use ResNet50 instead of ResNet18                      
                        backbone =                                              
                    timm.create_model("resnet50",                               
                    pretrained=True)                                            
                        backbone.eval()                                         
                        backbone.feature_dim =                                  
                    backbone.num_features                                       
                        backbone = backbone.to(DEVICE)                          
                                                                                
                        ds_full =                                               
                    ImagePathsDataset(image_paths,                              
                    transform=transform)                                        
                        loader_full = DataLoader(ds_full,                       
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        features = np.zeros((len(ds_full),                      
                    backbone.feature_dim),                                      
                    dtype=np.float32)                                           
                        with torch.no_grad():                                   
                            for imgs, idxs in loader_full:                      
                                imgs = imgs.to(DEVICE)                          
                                feats =                                         
                    backbone.forward_features(imgs)                             
                                if hasattr(backbone,                            
                    "global_pool"):                                             
                                    feats =                                     
                    backbone.global_pool(feats)                                 
                                if feats.ndim > 2:                              
                                    feats =                                     
                    torch.flatten(feats, start_dim=1)                           
                                np_feats =                                      
                    feats.cpu().numpy()                                         
                                for i, idx in                                   
                    enumerate(idxs):                                            
                                    features[idx] =                             
                    np_feats[i]                                                 
                                                                                
                        labels = df.label_bin.values                            
                        skf =                                                   
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                        mlp_models = []                                         
                        scores = []                                             
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(features, labels),                      
                    1):                                                         
                            X_tr, y_tr =                                        
                    features[train_idx], labels[train_idx]                      
                            X_va, y_va =                                        
                    features[val_idx], labels[val_idx]                          
                            pipeline = Pipeline([                               
                                ("scaler",                                      
                    StandardScaler()),                                          
                                ("mlp", MLPClassifier(                          
                                    hidden_layer_sizes=(12                      
                    8,),                                                        
                                    activation="relu",                          
                                    solver="adam",                              
                                    alpha=1e-4,                                 
                                    early_stopping=True,                        
                                    random_state=42,                            
                                    max_iter=200,                               
                                )),                                             
                            ])                                                  
                            pipeline.fit(X_tr, y_tr)                            
                            yps =                                               
                    pipeline.predict_proba(X_va)[:, 1]                          
                            auc = roc_auc_score(y_va, yps)                      
                            scores.append(auc)                                  
                            mlp_models.append(pipeline)                         
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                                                                                
                        print(f"Mean AUROC:                                     
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                        preds = predict(                                        
                            image_paths,                                        
                            backbone,                                           
                            mlp_models,                                         
                            device=DEVICE,                                      
                            transform=transform,                                
                            batch_size=32,                                      
                        )                                                       
                        submission =                                            
                    pd.DataFrame({"image_name":                                 
                    df.image_name, "malignant_prob":                            
                    preds})                                                     
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        submission.to_csv("./working/submi                      
                    ssion.csv", index=False)                                    
                        print("Saved submission.csv to                          
                    ./working/")                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
