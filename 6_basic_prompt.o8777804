                    the final fully connected layer, which                      
                    greatly reduces computation during                          
                    backpropagation. I will also decrease                       
                    the number of epochs to 3 and the                           
                    image input size to 128×128 to further                      
                    speed up training. The 5-fold                               
                    cross-validation procedure remains the                      
                    same, and we will print the per-fold                        
                    AUROC as well as the mean and standard                      
                    deviation. A `predict()` function is                        
                    provided for inference on new image                         
                    lists.                                                      
                                                                                
                    ```python                                                   
                    import os                                                   
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    def build_image_map(img_dir):                               
                        img_map = {}                                            
                        for fpath in                                            
                    glob.glob(os.path.join(img_dir, "*")):                      
                            if os.path.getsize(fpath) ==                        
                    0:                                                          
                                continue                                        
                            name =                                              
                    os.path.splitext(os.path.basename(fpat                      
                    h))[0]                                                      
                            try:                                                
                                img = Image.open(fpath)                         
                                img.verify()                                    
                            except Exception:                                   
                                continue                                        
                            img_map[name] = fpath                               
                        return img_map                                          
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_map,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_map = img_map                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            name = row["image_name"]                            
                            fpath = self.img_map[name]                          
                            img =                                               
                    Image.open(fpath).convert("RGB")                            
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["malignant"],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                    def predict(model, image_names,                             
                    img_dir, device):                                           
                        """                                                     
                        Predict malignant probabilities                         
                    for a list of image_name strings.                           
                        Args:                                                   
                            model: trained torch model                          
                            image_names: list of                                
                    image_name (no extension)                                   
                            img_dir: directory where                            
                    images reside                                               
                            device: torch device                                
                        Returns:                                                
                            numpy array of probabilities                        
                    in [0,1]                                                    
                        """                                                     
                        valid_map =                                             
                    build_image_map(img_dir)                                    
                        tf = T.Compose([                                        
                            T.Resize(144),                                      
                            T.CenterCrop(128),                                  
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225]),                                     
                        ])                                                      
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for name in image_names:                            
                                if name not in valid_map:                       
                                    raise                                       
                    FileNotFoundError(f"No valid image for                      
                    {name}")                                                    
                                img =                                           
                    Image.open(valid_map[name]).convert("R                      
                    GB")                                                        
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                logits = model(x)                               
                                prob =                                          
                    torch.sigmoid(logits).item()                                
                                probs.append(prob)                              
                        return np.array(probs)                                  
                                                                                
                    def main():                                                 
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        EPOCHS = 3                                              
                        LR = 1e-3                                               
                                                                                
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        df = pd.read_csv(DATA_CSV)                              
                        df["malignant"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                                                                                
                        img_map = build_image_map(IMG_DIR)                      
                        df =                                                    
                    df[df["image_name"].isin(img_map)].res                      
                    et_index(drop=True)                                         
                        print(f"Filtered dataset:                               
                    {len(df)} valid records")                                   
                                                                                
                        X = df["image_name"].values                             
                        y = df["malignant"].values                              
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=SEED)                            
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        transform = T.Compose([                                 
                            T.Resize(144),                                      
                            T.CenterCrop(128),                                  
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225]),                                     
                        ])                                                      
                                                                                
                        fold_aucs = []                                          
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(X, y), 1):                              
                            print(f"\nFold {fold}")                             
                            train_df =                                          
                    pd.DataFrame({"image_name":                                 
                    X[train_idx], "malignant":                                  
                    y[train_idx]})                                              
                            val_df =                                            
                    pd.DataFrame({"image_name":                                 
                    X[val_idx], "malignant": y[val_idx]})                       
                                                                                
                            train_ds =                                          
                    SkinLesionDataset(train_df, img_map,                        
                    transform)                                                  
                            val_ds =                                            
                    SkinLesionDataset(val_df, img_map,                          
                    transform)                                                  
                            train_loader =                                      
                    DataLoader(train_ds,                                        
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                            val_loader =                                        
                    DataLoader(val_ds,                                          
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            # Freeze all conv layers                            
                            for param in                                        
                    model.parameters():                                         
                                param.requires_grad =                           
                    False                                                       
                            # Replace and fine-tune only                        
                    final layer                                                 
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                                                                                
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    optim.Adam(model.fc.parameters(),                           
                    lr=LR)                                                      
                                                                                
                            for epoch in range(1,                               
                    EPOCHS+1):                                                  
                                model.train()                                   
                                total_loss = 0.0                                
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.unsqueeze(1).to(device)                              
                                    optimizer.zero_grad()                       
                                    logits = model(imgs)                        
                                    loss =                                      
                    criterion(logits, labels)                                   
                                    loss.backward()                             
                                    optimizer.step()                            
                                    total_loss +=                               
                    loss.item() * imgs.size(0)                                  
                                avg_loss = total_loss /                         
                    len(train_loader.dataset)                                   
                                print(f" Epoch                                  
                    {epoch}/{EPOCHS} - Loss:                                    
                    {avg_loss:.4f}")                                            
                                                                                
                            model.eval()                                        
                            y_true, y_score = [], []                            
                            with torch.no_grad():                               
                                for imgs, labels in                             
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits = model(imgs)                        
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fl                      
                    atten()                                                     
                                    y_score.extend(probs.t                      
                    olist())                                                    
                                    y_true.extend(labels.n                      
                    umpy().tolist())                                            
                            auc = roc_auc_score(y_true,                         
                    y_score)                                                    
                            print(f" Fold {fold} AUROC:                         
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                                                                                
                        print("\nCross-Validation AUROC                         
                    scores:", fold_aucs)                                        
                        print(f"Mean AUROC:                                     
                    {np.mean(fold_aucs):.4f}  Std:                              
                    {np.std(fold_aucs):.4f}")                                   
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
