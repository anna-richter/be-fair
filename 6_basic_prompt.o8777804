                    for f in files]                                             
                        feats = extract_features(img_names)                     
                        probs =                                                 
                    final_clf.predict_proba(feats)[:, 1]                        
                        return pd.DataFrame({"image_name":                      
                    img_names, "malignant_probability":                         
                    probs})                                                     
                                                                                
                                                                                
