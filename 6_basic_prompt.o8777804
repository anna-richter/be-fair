                    ```python                                                   
                    import os                                                   
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    from torchvision import transforms,                         
                    models                                                      
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.linear_model import                            
                    LogisticRegression                                          
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, image_paths,                         
                    labels=None, transform=None):                               
                            self.image_paths = image_paths                      
                            self.labels = labels                                
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                        def __getitem__(self, idx):                             
                            img =                                               
                    Image.open(self.image_paths[idx]).conv                      
                    ert('RGB')                                                  
                            if self.transform:                                  
                                img = self.transform(img)                       
                            if self.labels is None:                             
                                return img,                                     
                    os.path.basename(self.image_paths[idx]                      
                    )                                                           
                            return img, self.labels[idx]                        
                                                                                
                    def extract_features(image_paths,                           
                    batch_size=32, device='cpu'):                               
                        transform = transforms.Compose([                        
                            transforms.Resize(224),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.4                      
                    85,0.456,0.406],                                            
                    std=[0.229,0.224,0.225]),                                   
                        ])                                                      
                        ds = LesionDataset(image_paths,                         
                    transform=transform)                                        
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4)                                              
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier = nn.Identity()                        
                        model = model.to(device).eval()                         
                        feats = []                                              
                        with torch.no_grad():                                   
                            for imgs, _ in loader:                              
                                imgs = imgs.to(device)                          
                                out = model(imgs)                               
                                feats.append(out.cpu().num                      
                    py())                                                       
                        return np.vstack(feats)                                 
                                                                                
                    # Main script                                               
                    if __name__ == '__main__':                                  
                        # Load metadata                                         
                        df =                                                    
                    pd.read_csv('./input/mydataset.csv')                        
                        # Build image paths                                     
                        img_dir = './input/MyImages'                            
                        paths = []                                              
                        for name in df['image_name']:                           
                            p = os.path.join(img_dir,                           
                    f"{name}.jpg")                                              
                            if os.path.isfile(p):                               
                                paths.append(p)                                 
                            else:                                               
                                # try other extensions                          
                                for ext in                                      
                    ['.jpeg','.png']:                                           
                                    q = p[:-4]+ext                              
                                    if os.path.isfile(q):                       
                                        paths.append(q);                        
                    break                                                       
                                else:                                           
                                    raise                                       
                    FileNotFoundError(f"Image for {name}                        
                    not found")                                                 
                        # Labels: malignant vs rest                             
                        y =                                                     
                    (df['label']=='malignant').astype(int)                      
                    .values                                                     
                        # Feature extraction                                    
                        device = 'cuda' if                                      
                    torch.cuda.is_available() else 'cpu'                        
                        X = extract_features(paths,                             
                    batch_size=64, device=device)                               
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, valid_idx in                             
                    skf.split(X, y):                                            
                            X_tr, X_val = X[train_idx],                         
                    X[valid_idx]                                                
                            y_tr, y_val = y[train_idx],                         
                    y[valid_idx]                                                
                            clf =                                               
                    LogisticRegression(max_iter=1000,                           
                    solver='lbfgs')                                             
                            clf.fit(X_tr, y_tr)                                 
                            probs =                                             
                    clf.predict_proba(X_val)[:,1]                               
                            aucs.append(roc_auc_score(y_va                      
                    l, probs))                                                  
                        mean_auc, std_auc = np.mean(aucs),                      
                    np.std(aucs)                                                
                        print(f"Mean ROC AUC:                                   
                    {mean_auc:.4f} ± {std_auc:.4f}")                            
                        # Retrain on full set                                   
                        final_clf =                                             
                    LogisticRegression(max_iter=1000,                           
                    solver='lbfgs')                                             
                        final_clf.fit(X, y)                                     
                                                                                
                        def predict(image_dir,                                  
                    batch_size=32):                                             
                            """                                                 
                            Predict malignancy                                  
                    probabilities for all images in                             
                    image_dir.                                                  
                            Returns a DataFrame with                            
                    columns                                                     
                    ['image_name','prob_malignant'].                            
                            """                                                 
                            files = sorted([f for f in                          
                    os.listdir(image_dir)                                       
                                            if                                  
                    f.lower().endswith(('.jpg','.jpeg','.p                      
                    ng'))])                                                     
                            paths =                                             
                    [os.path.join(image_dir,f) for f in                         
                    files]                                                      
                            feats =                                             
                    extract_features(paths,                                     
                    batch_size=batch_size, device=device)                       
                            probs =                                             
                    final_clf.predict_proba(feats)[:,1]                         
                            return                                              
                    pd.DataFrame({'image_name': files,                          
                    'prob_malignant': probs})                                   
                                                                                
                        # If there is a test folder, write                      
                    submission.csv                                              
                        test_dir = './input/test'                               
                        if os.path.isdir(test_dir):                             
                            sub = predict(test_dir)                             
                            sub.to_csv('./working/submissi                      
                    on.csv', index=False)                                       
