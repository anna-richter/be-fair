                                optimizer.zero_grad()                           
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            avg_loss = running_loss /                           
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{EPOCHS} - Loss:                                  
                    {avg_loss:.4f}")                                            
                                                                                
                        # validation                                            
                        model.eval()                                            
                        y_true, y_scores = [], []                               
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
