                    # Task description                                          
                                                                                
                    ## Task goal                                                
                                                                                
                    I am a dermatologist, I have collected                      
                    data about skin lesions with my                             
                    colleagues over the last years. Now I                       
                    want to train an AI on this dataset                         
                    that can differentiate malignant and                        
                    benign lesions. The idea is that I                          
                    upload a folder with new images and the                     
                    model returns the probability between 0                     
                    and 1 for each image that the image                         
                    shows a malignant skin lesion.                              
                                                                                
                    ## Task evaluation                                          
                                                                                
                    Area under the receiver operator curve                      
                    (AUROC)                                                     
                                                                                
                    # Previous (buggy) implementation                           
                                                                                
                    ```python                                                   
                    import os                                                   
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                                                                                
                    def build_image_map(img_dir):                               
                        """                                                     
                        Scan img_dir for image files,                           
                    attempt to open each, and build a dict                      
                        mapping image_name (no extension)                       
                    to full file path for valid images.                         
                        Skip zero-byte or unreadable files.                     
                        """                                                     
                        img_map = {}                                            
                        for fpath in                                            
                    glob.glob(os.path.join(img_dir, "*")):                      
                            if os.path.getsize(fpath) == 0:                     
                                continue                                        
                            name =                                              
                    os.path.splitext(os.path.basename(fpath                     
                    ))[0]                                                       
                            try:                                                
                                img = Image.open(fpath)                         
                                img.verify()  # ensure file                     
                    is readable                                                 
                            except Exception:                                   
                                continue                                        
                            img_map[name] = fpath                               
                        return img_map                                          
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_map,                         
                    transform=None):                                            
                            """                                                 
                            df: dataframe with columns                          
                    ['image_name','malignant']                                  
                            img_map: dict mapping                               
                    image_name -> filepath                                      
                            """                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_map = img_map                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            name = row["image_name"]                            
                            fpath = self.img_map[name]                          
                            img =                                               
                    Image.open(fpath).convert("RGB")                            
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["malignant"],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def predict(model, image_names,                             
                    img_dir, device):                                           
                        """                                                     
                        Predict malignant probabilities for                     
                    a list of image_name strings.                               
                        Args:                                                   
                            model: trained torch model                          
                            image_names: list of image_name                     
                    (no extension)                                              
                            img_dir: directory where images                     
                    reside                                                      
                            device: torch device                                
                        Returns:                                                
                            numpy array of probabilities in                     
                    [0,1]                                                       
                        """                                                     
                        # build local map                                       
                        valid_map =                                             
                    build_image_map(img_dir)                                    
                        tf = T.Compose(                                         
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for name in image_names:                            
                                if name not in valid_map:                       
                                    raise                                       
                    FileNotFoundError(f"No valid image for                      
                    {name}")                                                    
                                img =                                           
                    Image.open(valid_map[name]).convert("RG                     
                    B")                                                         
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                logits = model(x)                               
                                prob =                                          
                    torch.sigmoid(logits).item()                                
                                probs.append(prob)                              
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        # config                                                
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        EPOCHS = 5                                              
                        LR = 1e-4                                               
                                                                                
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # load and preprocess                                   
                        df = pd.read_csv(DATA_CSV)                              
                        df["malignant"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                                                                                
                        # build map of valid images                             
                        img_map = build_image_map(IMG_DIR)                      
                        df =                                                    
                    df[df["image_name"].isin(img_map)].rese                     
                    t_index(drop=True)                                          
                        print(f"Filtered dataset: {len(df)}                     
                    records with valid images")                                 
                                                                                
                        # stratified 5-fold CV                                  
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=SEED)                            
                        X = df["image_name"].values                             
                        y = df["malignant"].values                              
                                                                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                                                                                
                        fold_scores = []                                        
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(X, y), 1):                              
                            print(f"\nStarting fold                             
                    {fold}")                                                    
                            train_df =                                          
                    pd.DataFrame({"image_name":                                 
                    X[train_idx], "malignant":                                  
                    y[train_idx]})                                              
                            val_df =                                            
                    pd.DataFrame({"image_name": X[val_idx],                     
                    "malignant": y[val_idx]})                                   
                                                                                
                            train_ds =                                          
                    SkinLesionDataset(train_df, img_map,                        
                    transform)                                                  
                            val_ds =                                            
                    SkinLesionDataset(val_df, img_map,                          
                    transform)                                                  
                            train_loader = DataLoader(                          
                                train_ds,                                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                            )                                                   
                            val_loader = DataLoader(                            
                                val_ds,                                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4                                               
                            )                                                   
                                                                                
                            # model                                             
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                            # train                                             
                            for epoch in range(EPOCHS):                         
                                model.train()                                   
                                running_loss = 0.0                              
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.unsqueeze(1).to(device)                              
                                    optimizer.zero_grad()                       
                                    logits = model(imgs)                        
                                    loss =                                      
                    criterion(logits, labels)                                   
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item() * imgs.size(0)                                  
                                avg_loss = running_loss /                       
                    len(train_loader.dataset)                                   
                                print(f"Fold {fold} Epoch                       
                    {epoch+1}/{EPOCHS} - Loss:                                  
                    {avg_loss:.4f}")                                            
                                                                                
                            # validate                                          
                            model.eval()                                        
                            y_true, y_scores = [], []                           
                            with torch.no_grad():                               
                                for imgs, labels in                             
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits = model(imgs)                        
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    y_scores.extend(probs.t                     
                    olist())                                                    
                                    y_true.extend(labels.nu                     
                    mpy().tolist())                                             
                            auroc = roc_auc_score(y_true,                       
                    y_scores)                                                   
                            print(f"Fold {fold} AUROC:                          
                    {auroc:.4f}")                                               
                            fold_scores.append(auroc)                           
                                                                                
                        print(f"\nCross-Validation AUROC                        
                    scores: {fold_scores}")                                     
                        print(f"Mean AUROC:                                     
                    {np.mean(fold_scores):.4f}  Std:                            
                    {np.std(fold_scores):.4f}")                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
