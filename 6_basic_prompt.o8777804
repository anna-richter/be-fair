                    standard deviation of the ROC AUC, we                       
                    retrain on the full data and expose a                       
                    `predict(image_dir)` function that                          
                    returns malignant probabilities for                         
                    any new folder of images. Finally, we                       
                    demonstrate saving these probabilities                      
                    to `submission.csv`.                                        
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import models,                             
                    transforms                                                  
                    from sklearn.linear_model import                            
                    LogisticRegression                                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                    # Constants                                                 
                    IMAGE_DIR = "./input/MyImages"                              
                    CSV_PATH = "./input/mydataset.csv"                          
                    BATCH_SIZE = 32                                             
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Dataset for feature extraction                            
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            image = self.transform(image)                       
                            label = row["binary_label"]                         
                            return image, label,                                
                    row["image_name"]                                           
                                                                                
                    # Load and prepare labels                                   
                    df = pd.read_csv(CSV_PATH)                                  
                    df["binary_label"] = (df["label"] ==                        
                    "malignant").astype(int)                                    
                                                                                
                    # Image transforms for ResNet18                             
                    transform = transforms.Compose([                            
                        transforms.Resize(256),                                 
                        transforms.CenterCrop(224),                             
                        transforms.ToTensor(),                                  
                        transforms.Normalize(mean=[0.485,0                      
                    .456,0.406], std=[0.229,0.224,0.225])                       
                    ])                                                          
                                                                                
                    # Prepare dataset & loader                                  
                    dataset = SkinDataset(df, IMAGE_DIR,                        
                    transform)                                                  
                    loader = DataLoader(dataset,                                
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                    # Load pretrained ResNet18 and build                        
                    feature extractor                                           
                    cnn =                                                       
                    models.resnet18(pretrained=True).to(DE                      
                    VICE)                                                       
                    cnn.eval()                                                  
                    feature_extractor =                                         
                    torch.nn.Sequential(*list(cnn.children                      
                    ())[:-1]).to(DEVICE)                                        
                                                                                
                    # Extract features for all images                           
                    all_features = []                                           
                    all_labels = []                                             
                    all_names = []                                              
                    with torch.no_grad():                                       
                        for imgs, labs, names in loader:                        
                            imgs = imgs.to(DEVICE)                              
                            feats =                                             
                    feature_extractor(imgs).view(imgs.size                      
                    (0), -1).cpu().numpy()                                      
                            all_features.append(feats)                          
                            all_labels.extend(labs.cpu().n                      
                    umpy())                                                     
                            all_names.extend(names)                             
                    features = np.vstack(all_features)                          
                    labels = np.array(all_labels)                               
                                                                                
                    # 5-fold cross-validation with                              
                    logistic regression                                         
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    scores = []                                                 
                    for train_idx, test_idx in                                  
                    skf.split(features, labels):                                
                        X_train, X_test =                                       
                    features[train_idx],                                        
                    features[test_idx]                                          
                        y_train, y_test =                                       
                    labels[train_idx], labels[test_idx]                         
                        clf =                                                   
                    LogisticRegression(max_iter=1000)                           
                        clf.fit(X_train, y_train)                               
                        probs =                                                 
                    clf.predict_proba(X_test)[:,1]                              
                        scores.append(roc_auc_score(y_test                      
                    , probs))                                                   
                    print(f"5-fold CV ROC AUC:                                  
                    {np.mean(scores):.4f} ±                                     
                    {np.std(scores):.4f}")                                      
                                                                                
                    # Train final model on full data                            
                    final_clf =                                                 
                    LogisticRegression(max_iter=1000).fit(                      
                    features, labels)                                           
                                                                                
                    def predict(image_dir):                                     
                        """                                                     
                        Predict malignant probabilities                         
                    for all .jpg images in a directory.                         
                        Args:                                                   
                            image_dir (str): Path to                            
                    folder containing test images named                         
                    like 'image_123.jpg'.                                       
                        Returns:                                                
                            pandas.DataFrame with columns                       
                    ['image_name', 'malignant_proba'].                          
                        """                                                     
                        image_files = [f for f in                               
                    os.listdir(image_dir) if                                    
                    f.lower().endswith(".jpg")]                                 
                        df_test =                                               
                    pd.DataFrame({"image_name":                                 
                    [os.path.splitext(f)[0] for f in                            
                    image_files]})                                              
                        df_test["binary_label"] = 0  #                          
                    placeholder                                                 
                        ds = SkinDataset(df_test,                               
                    image_dir, transform)                                       
                        dl = DataLoader(ds,                                     
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                        preds = []                                              
                        names = []                                              
                        with torch.no_grad():                                   
                            for imgs, _, img_names in dl:                       
                                imgs = imgs.to(DEVICE)                          
                                feats =                                         
                    feature_extractor(imgs).view(imgs.size                      
                    (0), -1).cpu().numpy()                                      
                                p =                                             
                    final_clf.predict_proba(feats)[:,1]                         
                                preds.extend(p)                                 
                                names.extend(img_names)                         
                        return pd.DataFrame({"image_name":                      
                    names, "malignant_proba": preds})                           
                                                                                
                    # Generate submission and save                              
                    submission = predict(IMAGE_DIR)                             
                    submission.to_csv("./working/submissio                      
                    n.csv", index=False)                                        
                    ```                                                         
