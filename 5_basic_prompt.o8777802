                    response: We fine-tune a pre-trained                        
                    ResNet18 model to classify malignant                        
                    vs benign lesions by mapping malignant                      
                    labels to 1 and benign/non-neoplastic                       
                    to 0. We split the dataset into                             
                    stratified train and validation sets                        
                    (80/20), apply standard image                               
                    transforms, and train with                                  
                    BCEWithLogitsLoss and Adam optimizer                        
                    for 5 epochs. After training, we                            
                    evaluate model performance by                               
                    computing the area under the ROC curve                      
                    on the validation set. A reusable                           
                    predict() function is provided to                           
                    generate probability predictions for                        
                    new images.                                                 
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Custom dataset for loading images                         
                    and labels                                                  
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                    def predict(image_paths, model,                             
                    transform, device="cpu",                                    
                    batch_size=32):                                             
                        """                                                     
                        Predict probabilities for a list                        
                    of image file paths.                                        
                        Args:                                                   
                          image_paths (list of str): paths                      
                    to image files.                                             
                          model (torch.nn.Module): trained                      
                    model.                                                      
                          transform                                             
                    (torchvision.transforms):                                   
                    preprocessing transforms.                                   
                          device (str): 'cpu' or 'cuda'.                        
                          batch_size (int): batch size.                         
                        Returns:                                                
                          np.ndarray: array of                                  
                    probabilities for malignant class.                          
                        """                                                     
                        model.eval()                                            
                        ds = [(path,) for path in                               
                    image_paths]                                                
                        # simple loader                                         
                        probs = []                                              
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(image_paths), batch_size):                              
                                batch_paths =                                   
                    image_paths[i:i+batch_size]                                 
                                imgs = []                                       
                                for p in batch_paths:                           
                                    img =                                       
                    Image.open(p).convert("RGB")                                
                                    imgs.append(transform(                      
                    img))                                                       
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                batch_probs =                                   
                    torch.sigmoid(logits).cpu().numpy()                         
                                probs.extend(batch_probs.t                      
                    olist())                                                    
                        return np.array(probs)                                  
                                                                                
                    def main():                                                 
                        # Configuration                                         
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        BATCH_SIZE = 32                                         
                        EPOCHS = 5                                              
                        LR = 1e-4                                               
                        DEVICE = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                        torch.manual_seed(42)                                   
                        np.random.seed(42)                                      
                                                                                
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        # Map labels: malignant=1,                              
                    others=0                                                    
                        df["target"] =                                          
                    df.label.apply(lambda x: 1 if x ==                          
                    "malignant" else 0)                                         
                        # Split train/val                                       
                        train_df, val_df =                                      
                    train_test_split(df, test_size=0.2,                         
                    stratify=df.target, random_state=42)                        
                                                                                
                        # Transforms                                            
                        train_transforms = T.Compose([                          
                            T.Resize((224,224)),                                
                            T.RandomHorizontalFlip(),                           
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485,0.456,                      
                    0.406], std=[0.229,0.224,0.225])                            
                        ])                                                      
                        val_transforms = T.Compose([                            
                            T.Resize((224,224)),                                
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485,0.456,                      
                    0.406], std=[0.229,0.224,0.225])                            
                        ])                                                      
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMG_DIR,                        
                    transform=train_transforms)                                 
                        val_ds = SkinLesionDataset(val_df,                      
                    IMG_DIR, transform=val_transforms)                          
                        train_loader =                                          
                    DataLoader(train_ds,                                        
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model setup                                           
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop                                         
                        for epoch in range(EPOCHS):                             
                            model.train()                                       
                            total_loss = 0.0                                    
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE), labels.to(DEVICE)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                total_loss += loss.item()                       
                    * imgs.size(0)                                              
                            avg_loss = total_loss /                             
                    len(train_ds)                                               
                            print(f"Epoch                                       
                    {epoch+1}/{EPOCHS}, Training Loss:                          
                    {avg_loss:.4f}")                                            
                                                                                
                        # Validation and AUROC computation                      
                        model.eval()                                            
                        all_probs, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(DEVICE)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_probs.extend(probs.tol                      
                    ist())                                                      
                                all_labels.extend(labels.n                      
                    umpy().tolist())                                            
                                                                                
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                        # Example of saving submission if                       
                    needed:                                                     
                        # test_images =                                         
                    [os.path.join(IMG_DIR, f) for f in                          
                    os.listdir(IMG_DIR) if                                      
                    f.endswith(".jpg")]                                         
                        # test_probs =                                          
                    predict(test_images, model,                                 
                    val_transforms, DEVICE, BATCH_SIZE)                         
                        # submission =                                          
                    pd.DataFrame({"image_name":                                 
                    [os.path.basename(p) for p in                               
                    test_images], "malignant_prob":                             
                    test_probs})                                                
                        #                                                       
                    submission.to_csv("./working/submissio                      
                    n.csv", index=False)                                        
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
