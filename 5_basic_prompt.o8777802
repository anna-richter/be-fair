                    # Task description                                          
                                                                                
                    ## Task goal                                                
                                                                                
                    I am a dermatologist, I have collected                      
                    data about skin lesions with my                             
                    colleagues over the last years. Now I                       
                    want to train an AI on this dataset                         
                    that can differentiate malignant and                        
                    benign lesions. The idea is that I                          
                    upload a folder with new images and the                     
                    model returns the probability between 0                     
                    and 1 for each image that the image                         
                    shows a malignant skin lesion.                              
                                                                                
                    ## Task evaluation                                          
                                                                                
                    Area under the receiver operator curve                      
                    (AUROC)                                                     
                                                                                
                    # Implementation                                            
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                    from tqdm import tqdm                                       
                    import random                                               
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def predict(image_paths, model,                             
                    transform, device="cpu",                                    
                    batch_size=32):                                             
                        """                                                     
                        Predict probabilities for a list of                     
                    image file paths.                                           
                        Args:                                                   
                          image_paths (list of str): paths                      
                    to image files.                                             
                          model (torch.nn.Module): trained                      
                    model.                                                      
                          transform                                             
                    (torchvision.transforms): preprocessing                     
                    transforms.                                                 
                          device (str): 'cpu' or 'cuda'.                        
                          batch_size (int): batch size.                         
                        Returns:                                                
                          np.ndarray: array of                                  
                    probabilities for malignant class.                          
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(image_paths), batch_size):                              
                                batch_paths = image_paths[i                     
                    : i + batch_size]                                           
                                imgs = []                                       
                                for p in batch_paths:                           
                                    img =                                       
                    Image.open(p).convert("RGB")                                
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                batch_probs =                                   
                    torch.sigmoid(logits).cpu().numpy()                         
                                probs.extend(batch_probs.to                     
                    list())                                                     
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        # Configuration                                         
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_FOLDS = 5                                             
                        BATCH_SIZE = 32                                         
                        EPOCHS = 3                                              
                        LR = 1e-3                                               
                        DEVICE = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                        SEED = 42                                               
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                        random.seed(SEED)                                       
                                                                                
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        df["target"] =                                          
                    df.label.apply(lambda x: 1 if x ==                          
                    "malignant" else 0)                                         
                        # Filter out missing or zero-byte                       
                    image files                                                 
                        df["filepath"] =                                        
                    df.image_name.map(lambda x:                                 
                    os.path.join(IMG_DIR, f"{x}.jpg"))                          
                        df = df[                                                
                            df.filepath.map(lambda x:                           
                    os.path.exists(x) and                                       
                    os.path.getsize(x) > 0)                                     
                        ].reset_index(drop=True)                                
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = T.Compose(                              
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        skf =                                                   
                    StratifiedKFold(n_splits=N_FOLDS,                           
                    shuffle=True, random_state=SEED)                            
                        oof_preds = np.zeros(len(df))                           
                        oof_targets = df.target.values                          
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.target)):                        
                            print(f"Starting fold                               
                    {fold+1}/{N_FOLDS}")                                        
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                                                                                
                            train_ds =                                          
                    SkinLesionDataset(train_df, IMG_DIR,                        
                    transform=train_transform)                                  
                            val_ds =                                            
                    SkinLesionDataset(val_df, IMG_DIR,                          
                    transform=val_transform)                                    
                            train_loader = DataLoader(                          
                                train_ds,                                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                            )                                                   
                            val_loader = DataLoader(                            
                                val_ds,                                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4                                               
                            )                                                   
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            # Freeze backbone                                   
                            for param in                                        
                    model.parameters():                                         
                                param.requires_grad = False                     
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model.fc.requires_grad_(True)                       
                            model = model.to(DEVICE)                            
                                                                                
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    optim.Adam(model.fc.parameters(),                           
                    lr=LR)                                                      
                                                                                
                            # Training                                          
                            for epoch in range(EPOCHS):                         
                                model.train()                                   
                                running_loss = 0.0                              
                                for imgs, labels in tqdm(                       
                                    train_loader,                               
                    desc=f"Fold {fold+1} Epoch {epoch+1}"                       
                                ):                                              
                                    imgs, labels =                              
                    imgs.to(DEVICE), labels.to(DEVICE)                          
                                    optimizer.zero_grad()                       
                                    logits =                                    
                    model(imgs).squeeze(1)                                      
                                    loss =                                      
                    criterion(logits, labels)                                   
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item() * imgs.size(0)                                  
                                print(                                          
                                    f"Fold {fold+1} Epoch                       
                    {epoch+1} training loss:                                    
                    {running_loss/len(train_ds):.4f}"                           
                                )                                               
                                                                                
                            # Validation                                        
                            model.eval()                                        
                            val_probs = []                                      
                            with torch.no_grad():                               
                                for imgs, _ in val_loader:                      
                                    imgs = imgs.to(DEVICE)                      
                                    logits =                                    
                    model(imgs).squeeze(1)                                      
                                    val_probs.extend(torch.                     
                    sigmoid(logits).cpu().numpy().tolist())                     
                            oof_preds[val_idx] = val_probs                      
                            fold_auc =                                          
                    roc_auc_score(oof_targets[val_idx],                         
                    val_probs)                                                  
                            print(f"Fold {fold+1} AUROC:                        
                    {fold_auc:.4f}")                                            
                                                                                
                        # Overall CV AUROC                                      
                        cv_auc = roc_auc_score(oof_targets,                     
                    oof_preds)                                                  
                        print(f"Overall CV AUROC:                               
                    {cv_auc:.4f}")                                              
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
