                            transform: torchvision                              
                    transform to apply to each image.                           
                            device: torch device (e.g.,                         
                    'cuda' or 'cpu'). If None,                                  
                    auto-selects.                                               
                        Returns:                                                
                            List of probabilities between                       
                    0 and 1 for each image.                                     
                        """                                                     
                        if device is None:                                      
                            device = torch.device("cuda"                        
                    if torch.cuda.is_available() else                           
                    "cpu")                                                      
                        model = model.to(device).eval()                         
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                logit =                                         
                    model(x).squeeze(1)                                         
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                                probs.append(prob)                              
                        return probs                                            
