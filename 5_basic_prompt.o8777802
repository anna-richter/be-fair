                    probs):                                                     
                                    results.append({"image                      
                    _name": fname, "malignant_prob":                            
                    float(p)})                                                  
                        return pd.DataFrame(results)                            
                                                                                
                    def main():                                                 
                        # Read and prepare data                                 
