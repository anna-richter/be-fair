                    * imgs.size(0)                                              
                            avg_loss = total_loss /                             
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{EPOCHS} - Training loss:                         
                    {avg_loss:.4f}")                                            
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels, all_preds = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
