                            aucs.append(roc)                                    
                        print(f'Mean AUROC:                                     
                    {np.mean(aucs):.4f}')                                       
                                                                                
                        # train on full data                                    
                        full_ds = SkinLesionDataset(df,                         
                    img_dir,                                                    
                            transform=transforms.Compose([                      
