                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.fc.parameters(),                           
                    lr=1e-4)                                                    
                                                                                
                        # train for 2 epochs                                    
                        for epoch in range(2):                                  
                            model.train()                                       
                            for xb, yb in dl_train:                             
                                xb, yb = xb.to(device),                         
                    yb.float().to(device)                                       
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                loss = criterion(logits,                        
                    yb)                                                         
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # validate                                              
                        model.eval()                                            
                        all_probs = []                                          
                        all_labels = []                                         
                        with torch.no_grad():                                   
                            for xb, yb in dl_val:                               
                                xb = xb.to(device)                              
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_probs.extend(probs.tol                      
                    ist())                                                      
                                all_labels.extend(yb.numpy                      
                    ().tolist())                                                
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Hold-out AUROC:                                 
                    {auc:.4f}")                                                 
                                                                                
                        # save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                        # generate submission                                   
                        sub = predict("input/MyImages",                         
                    model_path="working/model.pth",                             
                                      batch_size=32,                            
                    device=device)                                              
                        sub.to_csv("working/submission.csv                      
                    ", index=False)                                             
                        print("Saved predictions to                             
                    working/submission.csv")                                    
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
