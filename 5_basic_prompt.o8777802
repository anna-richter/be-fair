                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        probs = []                                              
                        names = []                                              
                        with torch.no_grad():                                   
                            for xb, batch_names in dl:                          
                                xb = xb.to(device)                              
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                p =                                             
                    torch.sigmoid(logits).cpu().numpy()                         
                                probs.extend(p.tolist())                        
                                names.extend(batch_names)                       
                        return pd.DataFrame({"image_name":                      
                    names, "malignant_probability": probs})                     
                                                                                
                                                                                
                    # Main training + CV                                        
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
