                    torch.stack(imgs).to(device)                                
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                for n, p in zip(names,                          
                    probs):                                                     
                                    results.append({"image_                     
                    name": n, "malignant_prob": float(p)})                      
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Main training & cross-validation                          
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("input/mydataset.csv")                          
                        # binary label: malignant=1 else=0                      
                        df["label_bin"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                        img_dir = "input/MyImages"                              
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.label_bin),                      
                    1):                                                         
                            train_df, val_df =                                  
                    df.loc[train_idx], df.loc[val_idx]                          
                            train_ds = SkinLesionDataset(                       
                                train_df,                                       
                                img_dir,                                        
                                transform=transforms.Compos                     
                    e(                                                          
                                    [                                           
                                        transforms.Resize((                     
                    224, 224)),                                                 
                                        transforms.RandomHo                     
                    rizontalFlip(),                                             
                                        transforms.ToTensor                     
                    (),                                                         
                                        transforms.Normaliz                     
                    e(                                                          
                                            mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)                                                      
                                        ),                                      
                                    ]                                           
                                ),                                              
                            )                                                   
                            val_ds = SkinLesionDataset(                         
                                val_df,                                         
                                img_dir,                                        
                                transform=transforms.Compos                     
                    e(                                                          
                                    [                                           
                                        transforms.Resize((                     
                    224, 224)),                                                 
                                        transforms.ToTensor                     
                    (),                                                         
                                        transforms.Normaliz                     
                    e(                                                          
                                            mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)                                                      
                                        ),                                      
                                    ]                                           
                                ),                                              
                            )                                                   
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=2)                                
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                                                                                
                            model =                                             
                    timm.create_model("resnet50",                               
                    pretrained=True, num_classes=1)                             
                            model.to(device)                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            # train for 3 epochs                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs, labels =                              
                    imgs.to(device), labels.to(device)                          
                                    logits =                                    
                    model(imgs).squeeze(1)                                      
                                    loss =                                      
                    criterion(logits, labels)                                   
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # validate                                          
                            model.eval()                                        
                            all_labels, all_probs = [], []                      
                            with torch.no_grad():                               
                                for imgs, labels in                             
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1)                                      
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy()                         
                                    all_probs.extend(probs.                     
                    tolist())                                                   
                                    all_labels.extend(label                     
                    s.numpy().tolist())                                         
                            roc = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                            print(f"Fold {fold} AUROC:                          
                    {roc:.4f}")                                                 
                            aucs.append(roc)                                    
                        print(f"Mean AUROC:                                     
                    {np.mean(aucs):.4f}")                                       
                                                                                
                        # train on full data                                    
                        full_ds = SkinLesionDataset(                            
                            df,                                                 
                            img_dir,                                            
                            transform=transforms.Compose(                       
                                [                                               
                                    transforms.Resize((224,                     
                    224)),                                                      
                                    transforms.RandomHorizo                     
                    ntalFlip(),                                                 
                                    transforms.ToTensor(),                      
                                    transforms.Normalize(                       
                                        mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)                           
                                    ),                                          
                                ]                                               
                            ),                                                  
                        )                                                       
                        full_loader = DataLoader(full_ds,                       
                    batch_size=32, shuffle=True,                                
                    num_workers=2)                                              
                        model_full =                                            
                    timm.create_model("resnet50",                               
                    pretrained=True, num_classes=1).to(                         
                            device                                              
                        )                                                       
                        opt_full =                                              
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=1e-4)                                                 
                        crit = nn.BCEWithLogitsLoss()                           
                        for epoch in range(3):                                  
                            model_full.train()                                  
                            for imgs, labels in                                 
                    full_loader:                                                
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                loss =                                          
                    crit(model_full(imgs).squeeze(1),                           
                    labels)                                                     
                                opt_full.zero_grad()                            
                                loss.backward()                                 
                                opt_full.step()                                 
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model_full.state_dict(),                     
                    "working/resnet50_full.pth")                                
                        print("Trained full model saved to                      
                    working/resnet50_full.pth")                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
