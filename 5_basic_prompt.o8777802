                    response: We can precompute frozen                          
                    backbone features for all images in                         
                    one pass and then train a lightweight                       
                    logistic regression model in a 5-fold                       
                    CV loop, which avoids expensive                             
                    repeated forward passes. We build a                         
                    DataLoader over the entire dataset (no                      
                    augmentation), extract global-pooled                        
                    ResNet18 features once, and then use                        
                    StratifiedKFold to train and evaluate                       
                    a sklearn LogisticRegression with AUC.                      
                    A predict() function chains the frozen                      
                    feature extractor and the trained                           
                    classifier for new image lists.                             
                                                                                
                    ```python                                                   
                    import os                                                   
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.linear_model import                            
                    LogisticRegression                                          
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn                                        
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import timm                                                 
                    from torchvision import transforms                          
                                                                                
                    # Paths                                                     
                    CSV_PATH = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                                                                                
                    # Load metadata                                             
                    df = pd.read_csv(CSV_PATH)                                  
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                                                                                
                    # Build mapping from image_name to                          
                    file name                                                   
                    file_map = {}                                               
                    for fname in os.listdir(IMG_DIR):                           
                        if fname.startswith("."):                               
                            parts = fname.split(".")                            
                            if len(parts) > 1:                                  
                                key = parts[1]                                  
                            else:                                               
                                continue                                        
                        else:                                                   
                            key =                                               
                    os.path.splitext(fname)[0]                                  
                        file_map[key] = fname                                   
                                                                                
                    # Transforms (no augmentation)                              
                    mean = [0.485, 0.456, 0.406]                                
                    std = [0.229, 0.224, 0.225]                                 
                    tf = transforms.Compose([                                   
                        transforms.Resize((224,224)),                           
                        transforms.ToTensor(),                                  
                        transforms.Normalize(mean, std),                        
                    ])                                                          
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    file_map, transform):                                       
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.file_map = file_map                            
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            key = row["image_name"]                             
                            fname = self.file_map.get(key)                      
                            path =                                              
                    os.path.join(self.img_dir, fname)                           
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            x = self.transform(img)                             
                            y = row["target"]                                   
                            return x, y                                         
                                                                                
                    def extract_features(model, loader,                         
                    device):                                                    
                        model.eval()                                            
                        feats = []                                              
                        labels = []                                             
                        with torch.no_grad():                                   
                            for xb, yb in loader:                               
                                xb = xb.to(device)                              
                                f =                                             
                    model(xb).view(xb.size(0),                                  
                    -1).cpu().numpy()                                           
                                feats.append(f)                                 
                                labels.extend(yb.numpy().t                      
                    olist())                                                    
                        return np.vstack(feats),                                
                    np.array(labels)                                            
                                                                                
                    def predict(feature_extractor,                              
                    classifier, image_paths, transform,                         
                    device=None):                                               
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths.                             
                        Args:                                                   
                            feature_extractor: frozen                           
                    torch model ending with global pool                         
                    (no fc)                                                     
                            classifier: sklearn classifier                      
                    with predict_proba                                          
                            image_paths: list of full                           
                    image paths                                                 
                            transform: torchvision                              
                    transform                                                   
                            device: torch device or None                        
                        Returns:                                                
                            List of probabilities for                           
                    malignancy.                                                 
                        """                                                     
                        if device is None:                                      
                            device = torch.device("cuda"                        
                    if torch.cuda.is_available() else                           
                    "cpu")                                                      
                        feature_extractor =                                     
                    feature_extractor.to(device).eval()                         
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                f =                                             
                    feature_extractor(x).view(1,                                
                    -1).cpu().numpy()                                           
                                p =                                             
                    classifier.predict_proba(f)[0,1]                            
                                probs.append(p)                                 
                        return probs                                            
                                                                                
                    if __name__ == "__main__":                                  
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # DataLoader for all images                             
                        ds = SkinDataset(df, IMG_DIR,                           
                    file_map, tf)                                               
                        loader = DataLoader(ds,                                 
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # Load pretrained backbone                              
                        full_model =                                            
                    timm.create_model("resnet18",                               
                    pretrained=True)                                            
                        # remove final FC                                       
                        backbone =                                              
                    nn.Sequential(*list(full_model.childre                      
                    n())[:-1])                                                  
                        backbone = backbone.to(device)                          
                        # Extract features once                                 
                        X, y = extract_features(backbone,                       
                    loader, device)                                             
                        # 5-fold CV with logistic                               
                    regression                                                  
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(X, y)):                                 
                            X_train, X_val = X[train_idx],                      
                    X[val_idx]                                                  
                            y_train, y_val = y[train_idx],                      
                    y[val_idx]                                                  
                            clf =                                               
                    LogisticRegression(max_iter=1000,                           
                    class_weight='balanced',                                    
                    solver='liblinear')                                         
                            clf.fit(X_train, y_train)                           
                            preds =                                             
                    clf.predict_proba(X_val)[:,1]                               
                            auc = roc_auc_score(y_val,                          
                    preds)                                                      
                            print(f"Fold {fold+1} AUC:                          
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
