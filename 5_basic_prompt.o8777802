                            val_loader =                                        
                    DataLoader(val_ds, batch_size=32,                           
                    shuffle=False, num_workers=2)                               
                                                                                
                            model =                                             
                    timm.create_model('resnet50',                               
                    pretrained=True, num_classes=1)                             
                            model.to(device)                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            # train for 3 epochs                                
                            for epoch in range(3):                              
                                model.train()                                   
