                    pretrained=True)                                            
                        # children up to global_pool                            
                        backbone =                                              
                    nn.Sequential(*list(full_model.childre                      
                    n())[:-1]).to(device)                                       
                                                                                
                        # 3) Extract features                                   
                        X, y = extract_features(backbone,                       
                    loader, device)                                             
                                                                                
                        # 4) 5-fold CV with                                     
                    LogisticRegression                                          
