                    Image.open(img_path).convert("RGB")                         
                            if self.transforms:                                 
                                img = self.transforms(img)                      
                            label = row["label_bin"]                            
                            return img, torch.tensor(label,                     
                    dtype=torch.float32)                                        
                                                                                
                                                                                
                    def predict(image_paths, model, device,                     
                    transforms):                                                
                        """                                                     
                        Predict probability of malignancy                       
                    for a list of image file paths.                             
