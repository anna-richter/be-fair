                        full_loader = DataLoader(full_ds,                       
                    batch_size=32, shuffle=True,                                
                    num_workers=2)                                              
                        model_full =                                            
                    timm.create_model('resnet50',                               
                    pretrained=True,                                            
                    num_classes=1).to(device)                                   
                        opt_full =                                              
                    torch.optim.Adam(model_full.parameters                      
                    (), lr=1e-4)                                                
                        crit = nn.BCEWithLogitsLoss()                           
                        for epoch in range(3):                                  
                            model_full.train()                                  
                            for imgs, labels in                                 
                    full_loader:                                                
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                loss =                                          
                    crit(model_full(imgs).squeeze(1),                           
                    labels)                                                     
                                opt_full.zero_grad();                           
                    loss.backward(); opt_full.step()                            
                        os.makedirs('working',                                  
