                    transform):                                                 
                                self.df, self.img_dir,                          
                    self.transform = df, img_dir, transform                     
                                                                                
                            def __len__(self):                                  
                                return len(self.df)                             
                                                                                
                            def __getitem__(self, idx):                         
                                name =                                          
                    self.df.iloc[idx].image_name                                
                                img =                                           
                    Image.open(os.path.join(self.img_dir,                       
                    name + ".jpg")).convert("RGB")                              
                                return self.transform(img),                     
                    name                                                        
                                                                                
                        ds = PredDataset(df, image_folder,                      
                    transform)                                                  
                        dl = DataLoader(ds,                                     
                    batch_size=batch_size, shuffle=False)                       
