                    optim.lr_scheduler.CosineAnnealingLR(o                      
                    ptimizer, T_max=3)                                          
                                                                                
                    for epoch in range(3):                                      
                        model_full.train()                                      
                        for imgs, labels in full_loader:                        
                            imgs, labels =                                      
                    imgs.to(device), labels.to(device)                          
                            # MixUp                                             
                            lam =                                               
                    np.random.beta(mixup_alpha,                                 
                    mixup_alpha)                                                
                            idx =                                               
                    torch.randperm(imgs.size(0))                                
                            imgs_shuffled = imgs[idx]                           
                            labels_shuffled = labels[idx]                       
                            imgs_mix = lam * imgs + (1 -                        
                    lam) * imgs_shuffled                                        
                            labels_mix = lam * labels + (1                      
                    - lam) * labels_shuffled                                    
                                                                                
                            optimizer.zero_grad()                               
                            logits =                                            
                    model_full(imgs_mix).view(-1)                               
                            loss = criterion(logits,                            
                    labels_mix)                                                 
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                                                                                
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model_full.state_dict(),                         
                    os.path.join("working", "model.pth"))                       
                    print("Model with MixUp saved to                            
                    working/model.pth")                                         
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    with TTA on new images.                                     
                        Args:                                                   
                            folder_path (str): Path to                          
                    folder of .jpg images.                                      
                        Returns:                                                
                            pandas.DataFrame with columns                       
                    ['image_name','probability'].                               
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_22                      
                    4", pretrained=False, num_classes=1)                        
                        model.load_state_dict(torch.load("                      
                    working/model.pth",                                         
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                logits1 =                                       
                    model(inp).view(-1)                                         
                                logits2 =                                       
                    model(torch.flip(inp,                                       
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) / 2).item()                         
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
