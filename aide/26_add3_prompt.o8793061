                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset class                                             
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join("input", "MyImages",                           
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(os.path.join("input",                      
                    "mydataset.csv"))                                           
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                    df["skin_tone_group"] =                                     
                    df["skin_tone"].fillna(-1).astype(int)                      
                                                                                
                    # Compute pos_weight for loss                               
                    pos = df.target.sum()                                       
                    neg = len(df) - pos                                         
                    pos_weight = torch.tensor(neg / pos,                        
                    device=device)                                              
                                                                                
                    # Cross-validation                                          
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.target)):                        
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                                                                                
                        # Compute inverse-frequency weights                     
                    for skin tone groups                                        
                        grp_counts =                                            
                    df_train.skin_tone_group.value_counts()                     
                    .to_dict()                                                  
                        inv_grp = {g: 1.0 / c for g, c in                       
                    grp_counts.items()}                                         
                        # Compute inverse-frequency weights                     
                    for classes                                                 
                        class_counts =                                          
                    df_train.target.value_counts().to_dict(                     
                    )                                                           
                        inv_cl = {cls: 1.0 / cnt for cls,                       
                    cnt in class_counts.items()}                                
                                                                                
                        # Per-sample weight = inv_grp *                         
                    inv_cl                                                      
                        w_grp =                                                 
                    df_train.skin_tone_group.map(inv_grp).v                     
                    alues                                                       
                        w_cl =                                                  
                    df_train.target.map(inv_cl).values                          
                        sample_w = w_grp * w_cl                                 
                        sample_w = torch.tensor(sample_w,                       
                    dtype=torch.double)                                         
                        sampler = WeightedRandomSampler(                        
                            sample_w,                                           
                    num_samples=len(sample_w),                                  
                    replacement=True                                            
                        )                                                       
                                                                                
                        train_ds = LesionDataset(df_train,                      
                    train_tf)                                                   
                        val_ds = LesionDataset(df_val,                          
                    val_tf)                                                     
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        model = timm.create_model(                              
                            "vit_base_patch16_224",                             
                    pretrained=True, num_classes=1                              
                        ).to(device)                                            
                        criterion =                                             
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                        optimizer =                                             
                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                        # Train                                                 
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).view(-1)                                        
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validate with TTA                                     
                        model.eval()                                            
                        all_preds, all_trues = [], []                           
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).view(-1)                                         
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2                                 
                                all_preds.extend(probs.cpu(                     
                    ).numpy())                                                  
                                all_trues.extend(labels.num                     
                    py())                                                       
                        auc = roc_auc_score(all_trues,                          
                    all_preds)                                                  
                        print(f"Fold {fold} AUC:                                
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUC: {mean_auc:.4f}")                       
                                                                                
                    # Retrain on full data with combined                        
                    weights                                                     
                    grp_counts =                                                
                    df.skin_tone_group.value_counts().to_di                     
                    ct()                                                        
                    inv_grp = {g: 1.0 / c for g, c in                           
                    grp_counts.items()}                                         
                    class_counts =                                              
                    df.target.value_counts().to_dict()                          
                    inv_cl = {cls: 1.0 / cnt for cls, cnt                       
                    in class_counts.items()}                                    
                    w_grp =                                                     
                    df.skin_tone_group.map(inv_grp).values                      
                    w_cl = df.target.map(inv_cl).values                         
                    sample_w = w_grp * w_cl                                     
                    sample_w = torch.tensor(sample_w,                           
                    dtype=torch.double)                                         
                    sampler =                                                   
                    WeightedRandomSampler(sample_w,                             
                    num_samples=len(sample_w),                                  
                    replacement=True)                                           
                                                                                
                    full_ds = LesionDataset(df, train_tf)                       
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                                                                                
                    model_full = timm.create_model(                             
                        "vit_base_patch16_224",                                 
                    pretrained=True, num_classes=1                              
                    ).to(device)                                                
                    criterion =                                                 
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                    optimizer =                                                 
                    optim.AdamW(model_full.parameters(),                        
                    lr=3e-5)                                                    
                    scheduler =                                                 
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                    for epoch in range(3):                                      
                        model_full.train()                                      
                        for imgs, labels in full_loader:                        
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            logits =                                            
                    model_full(imgs).view(-1)                                   
                            loss = criterion(logits,                            
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                                                                                
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model_full.state_dict(),                         
                    os.path.join("working", "model.pth"))                       
                    print("Model saved to                                       
                    working/model.pth")                                         
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path using TTA.                         
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=False, num_classes=1)                         
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                logits1 =                                       
                    model(inp).view(-1)                                         
                                logits2 =                                       
                    model(torch.flip(inp,                                       
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) / 2).item()                         
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                    Results: The model training and                             
                    evaluation ran successfully without any                     
                    errors. The 5-fold cross-validation                         
                    showed strong performance with AUC                          
                    scores ranging approximately from 0.94                      
                    to 0.95, and a mean CV AUC of 0.9462,                       
                    indicating robust classification of                         
                    malignant versus benign lesions. The                        
                    training included a weighted sampling                       
                    strategy to address fairness across                         
                    skin tones and class imbalance, and                         
                    test-time augmentation was applied                          
                    during validation. The final model was                      
                    retrained on the full dataset and saved                     
                    correctly. Overall, the approach                            
                    appears effective and well-executed.                        
                    Validation Metric: 0.9462                                   
                                                                                
                    -------------------------------                             
                    Design: I propose to integrate CutMix                       
                    augmentation into the training loop to                      
                    improve generalization and robustness                       
                    across skin tones, while retaining the                      
                    existing weighted sampler and test‐time                     
                    augmentation. For each training batch,                      
                    with probability 0.5 we sample λ from                       
                    Beta(1.0,1.0), generate a random                            
                    bounding box, and mix image patches and                     
                    labels accordingly, computing the loss                      
                    as λ·L(pred, y_a) + (1−λ)·L(pred, y_b).                     
                    We then run 5‐fold cross‐validation to                      
                    measure the AUROC improvement, retrain                      
                    on the full dataset, save the model,                        
                    and provide a `predict()` function with                     
                    TTA.                                                        
                    Code: import os                                             
                    import random                                               
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                    # Set random seeds for reproducibility                      
                    seed = 42                                                   
                    random.seed(seed)                                           
                    np.random.seed(seed)                                        
                    torch.manual_seed(seed)                                     
                    torch.cuda.manual_seed_all(seed)                            
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join("input", "MyImages",                           
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        # size: (B, C, H, W)                                    
                        W = size[3]                                             
                        H = size[2]                                             
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bby1, bbx1, bby2, bbx2  #                        
                    y1, x1, y2, x2                                              
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(os.path.join("input",                      
                    "mydataset.csv"))                                           
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                    df["skin_tone_group"] =                                     
                    df["skin_tone"].fillna(-1).astype(int)                      
                                                                                
                    # Compute pos_weight                                        
                    pos = df.target.sum()                                       
                    neg = len(df) - pos                                         
                    pos_weight = torch.tensor(neg / pos,                        
                    device=device)                                              
                                                                                
                    # 5-fold CV                                                 
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=seed)                            
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.target)):                        
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        # sample weights                                        
                        grp_counts =                                            
                    df_train.skin_tone_group.value_counts()                     
                    .to_dict()                                                  
                        inv_grp = {g: 1.0 / c for g, c in                       
                    grp_counts.items()}                                         
                        class_counts =                                          
                    df_train.target.value_counts().to_dict(                     
                    )                                                           
                        inv_cl = {c: 1.0 / count for c,                         
                    count in class_counts.items()}                              
                        w_grp =                                                 
                    df_train.skin_tone_group.map(inv_grp).v                     
                    alues                                                       
                        w_cl =                                                  
                    df_train.target.map(inv_cl).values                          
                        sample_w = torch.tensor(w_grp *                         
                    w_cl, dtype=torch.double)                                   
                        sampler = WeightedRandomSampler(                        
                            sample_w,                                           
                    num_samples=len(sample_w),                                  
                    replacement=True                                            
                        )                                                       
                                                                                
                        train_ds = LesionDataset(df_train,                      
                    train_tf)                                                   
                        val_ds = LesionDataset(df_val,                          
                    val_tf)                                                     
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model = timm.create_model(                              
                            "vit_base_patch16_224",                             
                    pretrained=True, num_classes=1                              
                        ).to(device)                                            
                        criterion =                                             
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                        optimizer =                                             
                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                        # Training with CutMix                                  
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                r = np.random.rand()                            
                                if r < 0.5:                                     
                                    lam =                                       
                    np.random.beta(1.0, 1.0)                                    
                                    rand_index =                                
                    torch.randperm(imgs.size(0)).to(device)                     
                                    y_a = labels                                
                                    y_b =                                       
                    labels[rand_index]                                          
                                    bbx1, bby1, bbx2, bby2                      
                    = rand_bbox(imgs.size(), lam)                               
                                    imgs[:, :, bbx1:bbx2,                       
                    bby1:bby2] = imgs[                                          
                                        rand_index, :,                          
                    bbx1:bbx2, bby1:bby2                                        
                                    ]                                           
                                    lam_adjust = 1 - (                          
                                        (bbx2 - bbx1) *                         
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                    )                                           
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss = lam_adjust *                         
                    criterion(logits, y_a) + (                                  
                                        1 - lam_adjust                          
                                    ) * criterion(logits,                       
                    y_b)                                                        
                                else:                                           
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss =                                      
                    criterion(logits, labels)                                   
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        preds, trues = [], []                                   
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).view(-1)                                         
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2                                 
                                preds.extend(probs.cpu().nu                     
                    mpy())                                                      
                                trues.extend(labels.numpy()                     
                    )                                                           
                        auc = roc_auc_score(trues, preds)                       
                        print(f"Fold {fold} AUC:                                
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUC: {mean_auc:.4f}")                       
                                                                                
                    # Retrain on full data                                      
                    grp_counts =                                                
                    df.skin_tone_group.value_counts().to_di                     
                    ct()                                                        
                    inv_grp = {g: 1.0 / c for g, c in                           
                    grp_counts.items()}                                         
                    class_counts =                                              
                    df.target.value_counts().to_dict()                          
                    inv_cl = {c: 1.0 / count for c, count                       
                    in class_counts.items()}                                    
                    w_grp =                                                     
                    df.skin_tone_group.map(inv_grp).values                      
                    w_cl = df.target.map(inv_cl).values                         
                    sample_w = torch.tensor(w_grp * w_cl,                       
                    dtype=torch.double)                                         
                    sampler =                                                   
                    WeightedRandomSampler(sample_w,                             
                    num_samples=len(sample_w),                                  
                    replacement=True)                                           
                                                                                
                    full_ds = LesionDataset(df, train_tf)                       
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                    model_full = timm.create_model(                             
                        "vit_base_patch16_224",                                 
                    pretrained=True, num_classes=1                              
                    ).to(device)                                                
                    criterion =                                                 
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                    optimizer =                                                 
                    optim.AdamW(model_full.parameters(),                        
                    lr=3e-5)                                                    
                    scheduler =                                                 
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                    for epoch in range(3):                                      
                        model_full.train()                                      
                        for imgs, labels in full_loader:                        
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            r = np.random.rand()                                
                            if r < 0.5:                                         
                                lam = np.random.beta(1.0,                       
                    1.0)                                                        
                                rand_index =                                    
                    torch.randperm(imgs.size(0)).to(device)                     
                                y_a = labels                                    
                                y_b = labels[rand_index]                        
                                bbx1, bby1, bbx2, bby2 =                        
                    rand_bbox(imgs.size(), lam)                                 
                                imgs[:, :, bbx1:bbx2,                           
                    bby1:bby2] = imgs[rand_index, :,                            
                    bbx1:bbx2, bby1:bby2]                                       
                                lam_adjust = 1 - (                              
                                    (bbx2 - bbx1) * (bby2 -                     
                    bby1) / (imgs.size(-1) * imgs.size(-2))                     
                                )                                               
                                logits =                                        
                    model_full(imgs).view(-1)                                   
                                loss = lam_adjust *                             
                    criterion(logits, y_a) + (1 -                               
                    lam_adjust) * criterion(                                    
                                    logits, y_b                                 
                                )                                               
                            else:                                               
                                logits =                                        
                    model_full(imgs).view(-1)                                   
                                loss = criterion(logits,                        
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                                                                                
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model_full.state_dict(),                         
                    os.path.join("working", "model.pth"))                       
                    print("Model saved to                                       
                    working/model.pth")                                         
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path using TTA.                         
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=False, num_classes=1)                         
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                logits1 =                                       
                    model(inp).view(-1)                                         
                                logits2 =                                       
                    model(torch.flip(inp,                                       
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) / 2).item()                         
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                    Results: The training script ran                            
                    successfully without errors. The model                      
                    achieved a strong mean cross-validation                     
                    AUROC of 0.9435, indicating robust                          
                    overall performance. The code applied                       
                    group and class reweighting to address                      
                    fairness across skin tones, and the                         
                    training included CutMix augmentation                       
                    and test-time augmentation for improved                     
                    generalization. The final model was                         
                    saved correctly and a prediction                            
                    function was provided for inference on                      
                    new images.                                                 
                    Validation Metric: 0.9435                                   
                                                                                
                    -------------------------------                             
                    Design: I propose replacing the                             
                    BCEWithLogitsLoss with a binary focal                       
                    loss that down‐weights easy examples                        
                    and emphasizes harder samples,                              
                    potentially boosting AUROC without                          
                    altering the rest of the pipeline. We                       
                    compute class‐balanced alpha weights                        
                    from each fold’s positive/negative                          
                    proportions to retain fairness, and                         
                    integrate this FocalLoss into both the                      
                    5‐fold CV and the final full‐data                           
                    training. All other settings—including                      
                    the WeightedRandomSampler for skin‐tone                     
                    fairness, ViT backbone, augmentations,                      
                    and test‐time augmentation—remain                           
                    unchanged. We then report per‐fold and                      
                    mean CV AUC and save the final model                        
                    for inference.                                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.nn.functional as F                             
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class FocalLoss(nn.Module):                                 
                        def __init__(self, alpha=(0.25,                         
                    0.75), gamma=2.0, reduction="mean"):                        
                            super().__init__()                                  
                            self.alpha = alpha  #                               
                    (alpha_neg, alpha_pos)                                      
                            self.gamma = gamma                                  
                            self.reduction = reduction                          
                                                                                
                        def forward(self, inputs, targets):                     
                            # inputs: logits, targets:                          
                    float tensor 0/1                                            
                            bce =                                               
                    F.binary_cross_entropy_with_logits(inpu                     
                    ts, targets, reduction="none")                              
                            p_t = torch.exp(-bce)                               
                            focal_term = (1 - p_t) **                           
                    self.gamma                                                  
                            loss = focal_term * bce                             
                            alpha_factor = targets *                            
                    self.alpha[1] + (1 - targets) *                             
                    self.alpha[0]                                               
                            loss = alpha_factor * loss                          
                            if self.reduction == "mean":                        
                                return loss.mean()                              
                            elif self.reduction == "sum":                       
                                return loss.sum()                               
                            return loss                                         
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join("input",                           
                    "MyImages", row.image_name + ".jpg")                        
                            ).convert("RGB")                                    
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(os.path.join("input",                      
                    "mydataset.csv"))                                           
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                    df["skin_tone_group"] =                                     
                    df["skin_tone"].fillna(-1).astype(int)                      
                                                                                
                    # 5-fold stratified CV                                      
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.target)):                        
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        # compute per-sample weights for                        
                    skin-tone & class fairness                                  
                        grp_counts =                                            
                    df_train.skin_tone_group.value_counts()                     
                    .to_dict()                                                  
                        inv_grp = {g: 1.0 / c for g, c in                       
                    grp_counts.items()}                                         
                        class_counts =                                          
                    df_train.target.value_counts().to_dict(                     
                    )                                                           
                        inv_cl = {cl: 1.0 / c for cl, c in                      
                    class_counts.items()}                                       
                        w_grp =                                                 
                    df_train.skin_tone_group.map(inv_grp).v                     
                    alues                                                       
                        w_cl =                                                  
                    df_train.target.map(inv_cl).values                          
                        sample_w = torch.tensor(w_grp *                         
                    w_cl, dtype=torch.double)                                   
                        sampler = WeightedRandomSampler(                        
                            sample_w,                                           
                    num_samples=len(sample_w),                                  
                    replacement=True                                            
                        )                                                       
                                                                                
                        # compute alpha for focal loss from                     
                    class distribution                                          
                        pos = df_train.target.sum()                             
                        neg = len(df_train) - pos                               
                        alpha_pos = neg / (pos + neg)                           
                        alpha_neg = pos / (pos + neg)                           
                        criterion =                                             
                    FocalLoss(alpha=(alpha_neg, alpha_pos),                     
                    gamma=2.0).to(device)                                       
                                                                                
                        train_ds = LesionDataset(df_train,                      
                    train_tf)                                                   
                        val_ds = LesionDataset(df_val,                          
                    val_tf)                                                     
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model = timm.create_model(                              
                            "vit_base_patch16_224",                             
                    pretrained=True, num_classes=1                              
                        ).to(device)                                            
                        optimizer =                                             
                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).view(-1)                                        
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        preds, trues = [], []                                   
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).view(-1)                                         
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2                                 
                                preds.extend(probs.cpu().nu                     
                    mpy())                                                      
                                trues.extend(labels.numpy()                     
                    )                                                           
                        auc = roc_auc_score(trues, preds)                       
                        print(f"Fold {fold} AUC:                                
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUC: {mean_auc:.4f}")                       
                                                                                
                    # Retrain on full data                                      
                    grp_counts =                                                
                    df.skin_tone_group.value_counts().to_di                     
                    ct()                                                        
                    inv_grp = {g: 1.0 / c for g, c in                           
                    grp_counts.items()}                                         
                    class_counts =                                              
                    df.target.value_counts().to_dict()                          
                    inv_cl = {cl: 1.0 / c for cl, c in                          
                    class_counts.items()}                                       
                    w_grp =                                                     
                    df.skin_tone_group.map(inv_grp).values                      
                    w_cl = df.target.map(inv_cl).values                         
                    sample_w = torch.tensor(w_grp * w_cl,                       
                    dtype=torch.double)                                         
                    sampler =                                                   
                    WeightedRandomSampler(sample_w,                             
                    num_samples=len(sample_w),                                  
                    replacement=True)                                           
                                                                                
                    # alpha for full data                                       
                    pos = df.target.sum()                                       
                    neg = len(df) - pos                                         
                    alpha_pos = neg / (pos + neg)                               
                    alpha_neg = pos / (pos + neg)                               
                    criterion_full =                                            
                    FocalLoss(alpha=(alpha_neg, alpha_pos),                     
                    gamma=2.0).to(device)                                       
                                                                                
                    full_ds = LesionDataset(df, train_tf)                       
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                    model_full = timm.create_model(                             
                        "vit_base_patch16_224",                                 
                    pretrained=True, num_classes=1                              
                    ).to(device)                                                
                    optimizer =                                                 
                    optim.AdamW(model_full.parameters(),                        
                    lr=3e-5)                                                    
                    scheduler =                                                 
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                    for epoch in range(3):                                      
                        model_full.train()                                      
                        for imgs, labels in full_loader:                        
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            logits =                                            
                    model_full(imgs).view(-1)                                   
                            loss = criterion_full(logits,                       
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                                                                                
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model_full.state_dict(),                         
                    os.path.join("working", "model.pth"))                       
                    print("Model saved to                                       
                    working/model.pth")                                         
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path using TTA.                         
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=False, num_classes=1)                         
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                logits1 =                                       
                    model(inp).view(-1)                                         
                                logits2 =                                       
                    model(torch.flip(inp,                                       
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) / 2).item()                         
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                    Results: The training script                                
                    successfully trained a vision                               
                    transformer model with focal loss and                       
                    weighted sampling to address fairness                       
                    across skin tones and class imbalance.                      
                    The 5-fold cross-validation yielded a                       
                    strong mean AUROC of 0.9479, indicating                     
                    robust overall performance. The model                       
                    was then retrained on the full dataset                      
                    with the same strategies and saved. The                     
                    prediction function applies test-time                       
                    augmentation for improved inference. No                     
                    bugs or errors were observed in the                         
                    execution log.                                              
                    Validation Metric: 0.9479                                   
                                                                                
                    -------------------------------                             
                    Design: I propose to integrate CutMix                       
                    augmentation into the training loop                         
                    with probability 0.5 (β=1.0) to further                     
                    improve generalization and fairness                         
                    across skin tones by mixing lesion                          
                    images and labels. All other                                
                    components—including the                                    
                    WeightedRandomSampler, FocalLoss, ViT                       
                    backbone, TTA, and training                                 
                    schedule—remain unchanged. We will                          
                    apply CutMix per batch during both                          
                    cross‐validation and full‐data                              
                    training, computing the loss as                             
                    λ·L(pred, y_a)+(1−λ)·L(pred, y_b).                          
                    Finally, we report the mean CV AUROC                        
                    and save the improved model.                                
                    Code: import os                                             
                    import random                                               
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.nn.functional as F                             
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    # CutMix helper                                             
                    def rand_bbox(size, lam):                                   
                        W = size[2]                                             
                        H = size[3]                                             
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    class FocalLoss(nn.Module):                                 
                        def __init__(self, alpha=(0.25,                         
                    0.75), gamma=2.0, reduction="mean"):                        
                            super().__init__()                                  
                            self.alpha = alpha                                  
                            self.gamma = gamma                                  
                            self.reduction = reduction                          
                                                                                
                        def forward(self, inputs, targets):                     
                            bce =                                               
                    F.binary_cross_entropy_with_logits(inpu                     
                    ts, targets, reduction="none")                              
                            p_t = torch.exp(-bce)                               
                            focal_term = (1 - p_t) **                           
                    self.gamma                                                  
                            loss = focal_term * bce                             
                            alpha_factor = targets *                            
                    self.alpha[1] + (1 - targets) *                             
                    self.alpha[0]                                               
                            loss = alpha_factor * loss                          
                            if self.reduction == "mean":                        
                                return loss.mean()                              
                            elif self.reduction == "sum":                       
                                return loss.sum()                               
                            return loss                                         
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join("input",                           
                    "MyImages", row.image_name + ".jpg")                        
                            ).convert("RGB")                                    
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(os.path.join("input",                      
                    "mydataset.csv"))                                           
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                    df["skin_tone_group"] =                                     
                    df["skin_tone"].fillna(-1).astype(int)                      
                                                                                
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.target)):                        
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        # per-sample weights                                    
                        grp_counts =                                            
                    df_train.skin_tone_group.value_counts()                     
                    .to_dict()                                                  
                        inv_grp = {g: 1.0 / c for g, c in                       
                    grp_counts.items()}                                         
                        class_counts =                                          
                    df_train.target.value_counts().to_dict(                     
                    )                                                           
                        inv_cl = {cl: 1.0 / c for cl, c in                      
                    class_counts.items()}                                       
                        w_grp =                                                 
                    df_train.skin_tone_group.map(inv_grp).v                     
                    alues                                                       
                        w_cl =                                                  
                    df_train.target.map(inv_cl).values                          
                        sample_w = torch.tensor(w_grp *                         
                    w_cl, dtype=torch.double)                                   
                        sampler = WeightedRandomSampler(                        
                            sample_w,                                           
                    num_samples=len(sample_w),                                  
                    replacement=True                                            
                        )                                                       
                        # focal loss alpha                                      
                        pos = df_train.target.sum()                             
                        neg = len(df_train) - pos                               
                        alpha_pos = neg / (pos + neg)                           
                        alpha_neg = pos / (pos + neg)                           
                        criterion =                                             
                    FocalLoss(alpha=(alpha_neg, alpha_pos),                     
                    gamma=2.0).to(device)                                       
                                                                                
                        train_ds = LesionDataset(df_train,                      
                    train_tf)                                                   
                        val_ds = LesionDataset(df_val,                          
                    val_tf)                                                     
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model = timm.create_model(                              
                            "vit_base_patch16_224",                             
                    pretrained=True, num_classes=1                              
                        ).to(device)                                            
                        optimizer =                                             
                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                        # Training with CutMix                                  
                        cutmix_prob = 0.5                                       
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                r = np.random.rand()                            
                                if r < cutmix_prob:                             
                                    lam =                                       
                    np.random.beta(1.0, 1.0)                                    
                                    batch_size =                                
                    imgs.size()[0]                                              
                                    idx_perm =                                  
                    torch.randperm(batch_size).to(device)                       
                                    bbx1, bby1, bbx2, bby2                      
                    = rand_bbox(imgs.size(), lam)                               
                                    imgs[:, :, bby1:bby2,                       
                    bbx1:bbx2] = imgs[                                          
                                        idx_perm, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                    ]                                           
                                    lam_adjusted = 1 - (                        
                                        (bbx2 - bbx1) *                         
                    (bby2 - bby1) / (imgs.size()[-1] *                          
                    imgs.size()[-2])                                            
                                    )                                           
                                    labels_a, labels_b =                        
                    labels, labels[idx_perm]                                    
                                    optimizer.zero_grad()                       
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss = lam_adjusted *                       
                    criterion(logits, labels_a) + (                             
                                        1 - lam_adjusted                        
                                    ) * criterion(logits,                       
                    labels_b)                                                   
                                else:                                           
                                    optimizer.zero_grad()                       
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss =                                      
                    criterion(logits, labels)                                   
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        preds, trues = [], []                                   
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).view(-1)                                         
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2                                 
                                preds.extend(probs.cpu().nu                     
                    mpy())                                                      
                                trues.extend(labels.numpy()                     
                    )                                                           
                        auc = roc_auc_score(trues, preds)                       
                        print(f"Fold {fold} AUC:                                
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUC: {mean_auc:.4f}")                       
                                                                                
                    # Retrain on full data with CutMix                          
                    grp_counts =                                                
                    df.skin_tone_group.value_counts().to_di                     
                    ct()                                                        
                    inv_grp = {g: 1.0 / c for g, c in                           
                    grp_counts.items()}                                         
                    class_counts =                                              
                    df.target.value_counts().to_dict()                          
                    inv_cl = {cl: 1.0 / c for cl, c in                          
                    class_counts.items()}                                       
                    w_grp =                                                     
                    df.skin_tone_group.map(inv_grp).values                      
                    w_cl = df.target.map(inv_cl).values                         
                    sample_w = torch.tensor(w_grp * w_cl,                       
                    dtype=torch.double)                                         
                    sampler =                                                   
                    WeightedRandomSampler(sample_w,                             
                    num_samples=len(sample_w),                                  
                    replacement=True)                                           
                    pos = df.target.sum()                                       
                    neg = len(df) - pos                                         
                    alpha_pos = neg / (pos + neg)                               
                    alpha_neg = pos / (pos + neg)                               
                    criterion_full =                                            
                    FocalLoss(alpha=(alpha_neg, alpha_pos),                     
                    gamma=2.0).to(device)                                       
                                                                                
                    full_ds = LesionDataset(df, train_tf)                       
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                    model_full = timm.create_model(                             
                        "vit_base_patch16_224",                                 
                    pretrained=True, num_classes=1                              
                    ).to(device)                                                
                    optimizer =                                                 
                    optim.AdamW(model_full.parameters(),                        
                    lr=3e-5)                                                    
                    scheduler =                                                 
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                                                                                
                    for epoch in range(3):                                      
                        model_full.train()                                      
                        for imgs, labels in full_loader:                        
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            r = np.random.rand()                                
                            if r < cutmix_prob:                                 
                                lam = np.random.beta(1.0,                       
                    1.0)                                                        
                                batch_size = imgs.size()[0]                     
                                idx_perm =                                      
                    torch.randperm(batch_size).to(device)                       
                                bbx1, bby1, bbx2, bby2 =                        
                    rand_bbox(imgs.size(), lam)                                 
                                imgs[:, :, bby1:bby2,                           
                    bbx1:bbx2] = imgs[idx_perm, :,                              
                    bby1:bby2, bbx1:bbx2]                                       
                                lam_adjusted = 1 - (                            
                                    (bbx2 - bbx1) * (bby2 -                     
                    bby1) / (imgs.size()[-1] *                                  
                    imgs.size()[-2])                                            
                                )                                               
                                labels_a, labels_b =                            
                    labels, labels[idx_perm]                                    
                                optimizer.zero_grad()                           
                                logits =                                        
                    model_full(imgs).view(-1)                                   
                                loss = lam_adjusted *                           
                    criterion_full(logits, labels_a) + (                        
                                    1 - lam_adjusted                            
                                ) * criterion_full(logits,                      
                    labels_b)                                                   
                            else:                                               
                                optimizer.zero_grad()                           
                                logits =                                        
                    model_full(imgs).view(-1)                                   
                                loss =                                          
                    criterion_full(logits, labels)                              
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                                                                                
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model_full.state_dict(),                         
                    os.path.join("working", "model.pth"))                       
                    print("Model saved to                                       
                    working/model.pth")                                         
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path using TTA.                         
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=False, num_classes=1)                         
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                logits1 =                                       
                    model(inp).view(-1)                                         
                                logits2 =                                       
                    model(torch.flip(inp,                                       
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) / 2).item()                         
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
