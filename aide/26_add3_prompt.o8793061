                    ().numpy())                                                 
                                all_trues.extend(labels.nu                      
                    mpy())                                                      
                        auc = roc_auc_score(all_trues,                          
                    all_preds)                                                  
                        print(f"Fold {fold} AUC with                            
                    MixUp: {auc:.4f}")                                          
                        aucs.append(auc)                                        
                                                                                
