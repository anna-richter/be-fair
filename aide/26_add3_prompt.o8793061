                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(o                      
                    ptimizer, T_max=3)                                          
                                                                                
                        # Train                                                 
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).view(-1)                                        
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        all_preds, all_trues = [], []                           
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).view(-1)                                        
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_preds.extend(probs.tol                      
                    ist())                                                      
                                all_trues.extend(labels.nu                      
                    mpy().tolist())                                             
                        auc = roc_auc_score(all_trues,                          
                    all_preds)                                                  
                        print(f'Fold {fold} AUC:                                
                    {auc:.4f}')                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f'Mean CV AUC: {mean_auc:.4f}')                       
                                                                                
                    # Retrain on full data                                      
                    grp_counts =                                                
                    df['skin_tone_group'].value_counts().t                      
