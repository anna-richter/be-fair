                    = rand_bbox(imgs.size(), lam)                               
                                    imgs[:, :, bby1:bby2,                       
                    bbx1:bbx2] = imgs[                                          
                                        idx_perm, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                    ]                                           
                                    lam_adjusted = 1 - (                        
                                        (bbx2 - bbx1) *                         
                    (bby2 - bby1) / (imgs.size()[-1] *                          
                    imgs.size()[-2])                                            
                                    )                                           
                                    labels_a, labels_b =                        
                    labels, labels[idx_perm]                                    
                                    optimizer.zero_grad()                       
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss = lam_adjusted *                       
                    criterion(logits, labels_a) + (                             
