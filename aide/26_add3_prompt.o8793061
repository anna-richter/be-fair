                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            model.eval()                                        
                            preds, truths = [], []                              
                            with torch.no_grad():                               
                                for imgs, labels in                             
                    val_loader:                                                 
                                    imgs = imgs.to(DEVICE)                      
                                    logits = model(imgs)                        
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    preds.extend(probs)                         
                                    truths.extend(labels.nu                     
                    mpy().flatten())                                            
                            auc = roc_auc_score(truths,                         
                    preds)                                                      
