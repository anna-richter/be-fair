                    row['image_name'] + '.jpg')                                 
                            img =                                               
                    Image.open(path).convert('RGB')                             
                            if self.transform: img =                            
                    self.transform(img)                                         
                            label = 1 if row['label'] ==                        
                    'malignant' else 0                                          
                            return img, label                                   
                                                                                
                    class                                                       
                    GroupBalancedBatchSampler(BatchSampler                      
                    ):                                                          
                        def __init__(self, labels, groups,                      
                    batch_size):                                                
                            assert batch_size %                                 
                    len(np.unique(groups)) == 0                                 
