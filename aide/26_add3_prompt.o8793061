                    Image.open(os.path.join(self.img_dir,                       
                    row.image_name +                                            
                    ".jpg")).convert("RGB")                                     
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor([row.malignant],                               
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                    class PredictDataset(Dataset):                              
                        def __init__(self, img_paths,                           
                    transform=None):                                            
                            self.img_paths = img_paths                          
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.img_paths)                          
                        def __getitem__(self, idx):                             
                            p = self.img_paths[idx]                             
                            img =                                               
                    Image.open(p).convert("RGB")                                
                            if self.transform:                                  
                                img = self.transform(img)                       
                            name =                                              
                    os.path.splitext(os.path.basename(p))[                      
                    0]                                                          
                            return img, name                                    
                                                                                
                    def mixup_data(x, y, alpha=0.4,                             
                    device="cpu"):                                              
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha>0 else 1.0                                         
                        batch_size = x.size(0)                                  
                        index =                                                 
                    torch.randperm(batch_size).to(device)                       
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                    def inference_tta(model, imgs,                              
                    device):                                                    
                        # original                                              
                        logits1 = model(imgs)                                   
                        # horizontal flip                                       
                        imgs_flipped = torch.flip(imgs,                         
                    dims=[3])                                                   
                        logits2 = model(imgs_flipped)                           
                        probs1 = torch.sigmoid(logits1)                         
                        probs2 = torch.sigmoid(logits2)                         
                        return ((probs1 + probs2) /                             
                    2.0).cpu().numpy().flatten()                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
