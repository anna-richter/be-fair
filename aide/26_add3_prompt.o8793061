                    full_ds = LesionDataset(df, train_tf)                       
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                                                                                
                    model_full =                                                
                    timm.create_model('vit_base_patch16_22                      
                    4', pretrained=True,                                        
                    num_classes=1).to(device)                                   
                    criterion =                                                 
                    nn.BCEWithLogitsLoss(pos_weight=pos_we                      
                    ight)                                                       
                    optimizer =                                                 
                    optim.AdamW(model_full.parameters(),                        
                    lr=3e-5)                                                    
