                    model(imgs).view(-1)                                        
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                        # validation with extended TTA                          
                        model.eval()                                            
