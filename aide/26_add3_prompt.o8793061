                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.4,                             
                    device='cpu'):                                              
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
