                    Image.open(os.path.join("input",                            
                    "MyImages", row.image_name +                                
                    ".jpg")).convert("RGB")                                     
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
