                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(o                      
                    ptimizer, T_max=3)                                          
                                                                                
                        # Training with CutMix                                  
                        cutmix_prob = 0.5                                       
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                r = np.random.rand()                            
                                if r < cutmix_prob:                             
                                    lam =                                       
                    np.random.beta(1.0,1.0)                                     
                                    batch_size =                                
                    imgs.size()[0]                                              
