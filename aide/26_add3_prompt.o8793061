                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path using TTA.                         
                        Returns a pandas DataFrame with                         
                    columns ['image_name','probability'].                       
                        """                                                     
                        model =                                                 
                    timm.create_model("vit_base_patch16_22                      
                    4", pretrained=False, num_classes=1)                        
                        model.load_state_dict(torch.load("                      
                    working/model.pth",                                         
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    val_tf(img).unsqueeze(0).to(device)                         
                            with torch.no_grad():                               
                                l1 = model(inp).view(-1)                        
                                l2 = model(torch.flip(inp,                      
                    dims=[3])).view(-1)                                         
                                prob =                                          
                    ((torch.sigmoid(l1)+torch.sigmoid(l2))                      
                    /2).item()                                                  
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                    # Example usage: preds =                                    
                    predict("input/MyTestImages")                               
                    #                                                           
                    preds.to_csv("working/submission.csv",                      
                    index=False)                                                
