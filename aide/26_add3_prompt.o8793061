                        for imgs, labels in full_loader:                        
                            imgs, labels =                                      
                    imgs.to(device), labels.to(device)                          
                            mixed_imgs, targets_a,                              
                    targets_b, lam = mixup_data(imgs,                           
                    labels, alpha=0.4, device=device)                           
                            optimizer.zero_grad()                               
                            logits =                                            
                    model_full(mixed_imgs).view(-1)                             
                            loss = lam*criterion(logits,                        
