                    ```python                                                   
                    import os                                                   
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    row.image_name + ".jpg")).convert(                          
                                "RGB"                                           
                            )                                                   
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor([row.malignant],                               
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    class PredictDataset(Dataset):                              
                        def __init__(self, img_paths,                           
                    transform=None):                                            
                            self.img_paths = img_paths                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.img_paths)                          
                                                                                
                        def __getitem__(self, idx):                             
                            p = self.img_paths[idx]                             
                            img =                                               
                    Image.open(p).convert("RGB")                                
                            if self.transform:                                  
                                img = self.transform(img)                       
                            name =                                              
                    os.path.splitext(os.path.basename(p))[0                     
                    ]                                                           
                            return img, name                                    
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.4,                             
                    device="cpu"):                                              
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha > 0 else 1.0                                       
                        batch_size = x.size(0)                                  
                        index =                                                 
                    torch.randperm(batch_size).to(device)                       
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def inference_tta(model, imgs, device):                     
                        # original                                              
                        logits1 = model(imgs)                                   
                        # horizontal flip                                       
                        imgs_flipped = torch.flip(imgs,                         
                    dims=[3])                                                   
                        logits2 = model(imgs_flipped)                           
                        probs1 = torch.sigmoid(logits1)                         
                        probs2 = torch.sigmoid(logits2)                         
                        return ((probs1 + probs2) /                             
                    2.0).cpu().numpy().flatten()                                
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all JPEG images in folder_path                          
                    using TTA.                                                  
                        Returns a pandas DataFrame with                         
                    columns                                                     
                    ['image_name','malignancy_probability']                     
                    .                                                           
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model_path = "./working/model.pth"                      
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        img_paths = [                                           
                            os.path.join(folder_path, f)                        
                            for f in                                            
                    os.listdir(folder_path)                                     
                            if f.lower().endswith(".jpg")                       
                        ]                                                       
                        ds = PredictDataset(img_paths,                          
                    transform)                                                  
                        loader = DataLoader(ds,                                 
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        results = []                                            
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                imgs = imgs.to(device)                          
                                probs =                                         
                    inference_tta(model, imgs, device)                          
                                for n, p in zip(names,                          
                    probs):                                                     
                                    results.append({"image_                     
                    name": n, "malignancy_probability":                         
                    float(p)})                                                  
                        df = pd.DataFrame(results)                              
                        return df                                               
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
