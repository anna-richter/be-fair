                    labels_b)                                                   
                                else:                                           
                                    optimizer.zero_grad()                       
                                    logits =                                    
                    model(imgs).view(-1)                                        
                                    loss =                                      
                    criterion(logits, labels)                                   
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        preds, trues = [], []                                   
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
