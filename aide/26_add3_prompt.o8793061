                    .to_dict()                                                  
                        inv_grp = {g: 1.0 / c for g, c in                       
                    grp_counts.items()}                                         
                        sample_w =                                              
                    df_train.skin_tone_group.map(inv_grp).v                     
                    alues                                                       
                        sampler =                                               
                    WeightedRandomSampler(sample_w,                             
                    len(sample_w), replacement=True)                            
                                                                                
                        train_ds = LesionDataset(df_train,                      
