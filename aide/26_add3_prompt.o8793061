                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                lam =                                           
                    np.random.beta(mix_alpha, mix_alpha)                        
                                idx =                                           
                    torch.randperm(imgs.size(0))                                
                                imgs_shuffled = imgs[idx]                       
                                labels_shuffled =                               
                    labels[idx]                                                 
                                mixed_imgs = lam * imgs +                       
                    (1-lam) * imgs_shuffled                                     
                                logits =                                        
                    model(mixed_imgs).view(-1)                                  
                                loss =                                          
                    lam*criterion(logits, labels) +                             
                    (1-lam)*criterion(logits,                                   
                    labels_shuffled)                                            
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                        # validation with TTA                                   
                        model.eval()                                            
                        all_preds, all_trues = [], []                           
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs, [-1])).view(-1)                      
                                probs =                                         
                    (torch.sigmoid(logits1)+torch.sigmoid(                      
