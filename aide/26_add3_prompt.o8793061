                    Design: I propose to integrate MixUp                        
                    augmentation (α=0.4) into the training                      
                    loop to improve generalization and                          
                    robustness across skin tones while                          
                    retaining the existing weighted sampler                     
                    and TTA. For each training batch, we                        
                    sample a mixing coefficient λ from a                        
                    Beta(α,α) distribution, shuffle the                         
                    batch, and linearly combine images and                      
                    labels accordingly before computing the                     
                    loss as λ·L(pred, y_a) + (1−λ)·L(pred,                      
                    y_b). We then perform 5-fold                                
                    cross-validation with this                                  
                    MixUp-augmented training and report the                     
                    mean AUROC.                                                 
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset                                                   
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join("input",                           
                    "MyImages", row.image_name + ".jpg")                        
                            ).convert("RGB")                                    
                            img = self.transform(img)                           
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    # Load and preprocess                                       
                    df = pd.read_csv(os.path.join("input",                      
                    "mydataset.csv"))                                           
                    df["target"] = (df.label ==                                 
                    "malignant").astype(int)                                    
                    df["skin_tone_group"] =                                     
                    df.skin_tone.fillna(-1).astype(int)                         
                    pos = df.target.sum()                                       
                    neg = len(df) - pos                                         
                    pos_weight = torch.tensor(neg / pos,                        
                    device=device)                                              
                                                                                
                    # MixUp parameter                                           
                    mix_alpha = 0.4                                             
                                                                                
                    # Cross-validation                                          
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.target)):                        
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        # weighted sampler by skin tone                         
                        grp =                                                   
                    df_train.skin_tone_group.value_counts()                     
                    .to_dict()                                                  
                        inv = {g: 1.0 / c for g, c in                           
                    grp.items()}                                                
                        weights =                                               
                    df_train.skin_tone_group.map(inv).value                     
                    s                                                           
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    len(weights), replacement=True)                             
                        train_ds = LesionDataset(df_train,                      
                    train_tf)                                                   
                        val_ds = LesionDataset(df_val,                          
                    val_tf)                                                     
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # model                                                 
                        model = timm.create_model(                              
                            "vit_base_patch16_224",                             
                    pretrained=True, num_classes=1                              
                        ).to(device)                                            
                        criterion =                                             
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                        optimizer =                                             
                    optim.AdamW(model.parameters(),                             
                    lr=3e-5)                                                    
                        scheduler =                                             
                    optim.lr_scheduler.CosineAnnealingLR(op                     
                    timizer, T_max=3)                                           
                        # train with MixUp                                      
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                lam =                                           
                    np.random.beta(mix_alpha, mix_alpha)                        
                                idx =                                           
                    torch.randperm(imgs.size(0))                                
                                imgs_shuffled = imgs[idx]                       
                                labels_shuffled =                               
                    labels[idx]                                                 
                                mixed_imgs = lam * imgs +                       
                    (1 - lam) * imgs_shuffled                                   
                                logits =                                        
                    model(mixed_imgs).view(-1)                                  
                                loss = lam *                                    
                    criterion(logits, labels) + (1 - lam) *                     
                    criterion(                                                  
                                    logits, labels_shuffled                     
                                )                                               
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                        # validation with TTA                                   
                        model.eval()                                            
                        all_preds, all_trues = [], []                           
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).view(-1)                                        
                                logits2 =                                       
                    model(torch.flip(imgs, [-1])).view(-1)                      
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2                                 
                                all_preds.extend(probs.cpu(                     
                    ).numpy())                                                  
                                all_trues.extend(labels.num                     
                    py())                                                       
                        auc = roc_auc_score(all_trues,                          
                    all_preds)                                                  
                        print(f"Fold {fold} AUC with MixUp:                     
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    print(f"Mean CV AUC with MixUp:                             
                    {np.mean(aucs):.4f}")                                       
                                                                                
