                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                mixed_imgs, y_a, y_b, lam =                     
                    mixup_data(imgs, labels, alpha=0.4)                         
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(mixed_imgs).view(-1)                                  
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
