                    f.lower().endswith(".jpg")])                                
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(img_names), BATCH_SIZE):                                
                                batch = img_names[i : i +                       
                    BATCH_SIZE]                                                 
                                imgs = torch.stack(                             
                                    [                                           
                                        transform(Image.ope                     
                    n(os.path.join(folder,                                      
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                for fname, p in zip(batch,                      
                    probs):                                                     
                                    name =                                      
                    os.path.splitext(fname)[0]                                  
                                    results.append((name,                       
                    float(p)))                                                  
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(SUBMISSION_PATH,                                 
