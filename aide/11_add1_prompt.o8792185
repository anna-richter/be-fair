                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            name = self.names[idx]                              
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    name + ".jpg")).convert("RGB")                              
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(self.labels[idx],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                    # Transforms                                                
                    train_transform = transforms.Compose([                      
                        transforms.RandomResizedCrop(224),                      
                        transforms.RandomHorizontalFlip(),                      
                        transforms.RandomVerticalFlip(),                        
                        transforms.ToTensor(),                                  
                        transforms.Normalize([0.485,0.456,                      
                    0.406],[0.229,0.224,0.225]),                                
                    ])                                                          
                    val_transform = transforms.Compose([                        
                        transforms.Resize((224,224)),                           
                        transforms.ToTensor(),                                  
                        transforms.Normalize([0.485,0.456,                      
                    0.406],[0.229,0.224,0.225]),                                
                    ])                                                          
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(DATA_CSV)                                  
                    df["label_bin"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                    y = df["label_bin"].values                                  
                                                                                
                    # Cross-validation with mixup and TTA                       
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, y), 1):                             
                        print(f"Fold {fold}")                                   
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds = SkinDataset(train_df,                        
                    IMG_DIR, transform=train_transform)                         
                        val_ds = SkinDataset(val_df,                            
                    IMG_DIR, transform=val_transform)                           
                        train_loader =                                          
                    DataLoader(train_ds,                                        
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features                      
                    , 1)                                                        
                        model = model.to(DEVICE)                                
                        criterion =                                             
                    nn.BCEWithLogitsLoss(reduction="none")                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                                                                                
                        # Train with mixup                                      
                        model.train()                                           
                        for epoch in range(N_EPOCHS):                           
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                                mixed_imgs, targets_a,                          
                    targets_b, lam = mixup_data(imgs,                           
                    labels)                                                     
                                preds = model(mixed_imgs)                       
                                loss = lam *                                    
                    criterion(preds, targets_a) + (1 -                          
                    lam) * criterion(preds, targets_b)                          
                                loss = loss.mean()                              
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate with TTA (horizontal                         
                    flip)                                                       
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(DEVICE)                          
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=(3,)))                          
                                probs =                                         
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) /                                   
                    2).cpu().numpy().flatten()                                  
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.n                      
                    umpy().flatten())                                           
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"  Fold {fold} AUROC:                            
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc, std_auc = np.mean(aucs),                          
                    np.std(aucs)                                                
                    print(f"\nCV AUROC with Mixup:                              
                    {mean_auc:.4f} ± {std_auc:.4f}")                            
                                                                                
                    # Retrain on full data with mixup                           
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    transform=train_transform)                                  
                    full_loader = DataLoader(full_ds,                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                    model =                                                     
                    models.densenet121(pretrained=True)                         
                    model.classifier =                                          
                    nn.Linear(model.classifier.in_features                      
                    , 1)                                                        
                    model = model.to(DEVICE)                                    
                    criterion =                                                 
                    nn.BCEWithLogitsLoss(reduction="none")                      
                    optimizer =                                                 
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                    model.train()                                               
                    for epoch in range(N_EPOCHS):                               
                        for imgs, labels in                                     
                    tqdm(full_loader, desc=f"Full train                         
                    epoch {epoch+1}"):                                          
                            imgs, labels =                                      
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                            mixed_imgs, targets_a,                              
                    targets_b, lam = mixup_data(imgs,                           
                    labels)                                                     
                            preds = model(mixed_imgs)                           
                            loss = lam * criterion(preds,                       
                    targets_a) + (1 - lam) *                                    
                    criterion(preds, targets_b)                                 
                            loss = loss.mean()                                  
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                                                                                
                    # Prediction function with TTA                              
                    def predict(folder: str, model_path:                        
                    str = MODEL_PATH, device=DEVICE):                           
                        """                                                     
                        Predict malignancy probabilities                        
                    for images in a folder using                                
                    horizontal-flip TTA.                                        
                        Returns a DataFrame with                                
                    ["image_name","malignancy_probability"                      
                    ].                                                          
                        """                                                     
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features                      
                    , 1)                                                        
                        model.load_state_dict(torch.load(m                      
                    odel_path, map_location=device))                            
                        model = model.to(device).eval()                         
                        transform = val_transform                               
                        results = []                                            
                        img_names = sorted([f for f in                          
                    os.listdir(folder) if                                       
                    f.lower().endswith(".jpg")])                                
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(img_names), BATCH_SIZE):                                
                                batch =                                         
                    img_names[i:i+BATCH_SIZE]                                   
                                imgs = []                                       
                                for fname in batch:                             
                                    img =                                       
                    Image.open(os.path.join(folder,                             
                    fname)).convert("RGB")                                      
                                    imgs.append(transform(                      
                    img))                                                       
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=(3,)))                          
                                probs =                                         
                    ((torch.sigmoid(logits1) +                                  
                    torch.sigmoid(logits2)) /                                   
                    2).cpu().numpy().flatten()                                  
                                for fname, p in zip(batch,                      
                    probs):                                                     
                                    name =                                      
                    os.path.splitext(fname)[0]                                  
                                    results.append((name,                       
                    float(p)))                                                  
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(SUBMISSION_PATH,                                 
                    index=False)                                                
                    print(f"Submission saved to                                 
                    {SUBMISSION_PATH}")                                         
                    ```                                                         
