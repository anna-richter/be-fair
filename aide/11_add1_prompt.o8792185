                    torch.manual_seed(42)                                       
                    np.random.seed(42)                                          
                                                                                
                                                                                
                    # Dataset definition                                        
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.names =                                        
                    df["image_name"].tolist()                                   
                            self.labels =                                       
                    df["label_bin"].tolist()                                    
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            name = self.names[idx]                              
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    name + ".jpg")).convert("RGB")                              
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(self.labels[idx],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_transform = transforms.Compose(                       
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.RandomVerticalFlip()                     
                    ,                                                           
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_transform = transforms.Compose(                         
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(DATA_CSV)                                  
                    df["label_bin"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                    y = df["label_bin"].values                                  
                                                                                
                                                                                
                    # TTA function                                              
                    def tta_predictions(model, imgs):                           
                        views = [None, (3,), (2,), (2, 3)]                      
                        logits_sum =                                            
                    torch.zeros(imgs.size(0), 1,                                
                    device=imgs.device)                                         
                        for d in views:                                         
                            inp = imgs if d is None else                        
                    torch.flip(imgs, dims=d)                                    
                            logits_sum += model(inp)                            
                        return logits_sum / len(views)                          
                                                                                
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, y), 1):                             
                        print(f"Fold {fold}")                                   
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds = SkinDataset(train_df,                        
                    IMG_DIR, train_transform)                                   
                        val_ds = SkinDataset(val_df,                            
                    IMG_DIR, val_transform)                                     
                        # compute fairness weights based on                     
                    skin_tone frequency                                         
                        skin_counts =                                           
                    train_df["skin_tone"].value_counts().to                     
                    _dict()                                                     
                        weights =                                               
                    train_df["skin_tone"].map(lambda x: 1.0                     
                    / skin_counts[x]).values                                    
                        weights = weights / weights.mean()                      
                        sampler = WeightedRandomSampler(                        
                            weights.tolist(),                                   
                    num_samples=len(weights),                                   
                    replacement=True                                            
                        )                                                       
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, sampler=sampler,                     
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        scheduler =                                             
                    CosineAnnealingLR(optimizer,                                
                    T_max=N_EPOCHS, eta_min=1e-6)                               
                                                                                
                        for epoch in range(N_EPOCHS):                           
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"  Fold {fold} AUROC (4-view                     
                    TTA, WeightedSampler): {auc:.4f}")                          
                        aucs.append(auc)                                        
                                                                                
                    mean_auc, std_auc = np.mean(aucs),                          
                    np.std(aucs)                                                
                    print(                                                      
                        f"\nCV AUROC with WeightedSampler &                     
                    CosineAnnealingLR & 4-view TTA:                             
                    {mean_auc:.4f} ± {std_auc:.4f}"                             
                    )                                                           
                                                                                
                    # Retrain on full data with fairness                        
                    sampling                                                    
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_transform)                                            
                    full_skin_counts =                                          
                    df["skin_tone"].value_counts().to_dict(                     
                    )                                                           
                    full_weights =                                              
                    df["skin_tone"].map(lambda x: 1.0 /                         
                    full_skin_counts[x]).values                                 
                    full_weights = full_weights /                               
                    full_weights.mean()                                         
                    full_sampler = WeightedRandomSampler(                       
                        full_weights.tolist(),                                  
                    num_samples=len(full_weights),                              
                    replacement=True                                            
                    )                                                           
                    full_loader = DataLoader(                                   
                        full_ds, batch_size=BATCH_SIZE,                         
                    sampler=full_sampler, num_workers=4                         
                    )                                                           
                                                                                
                    model =                                                     
                    models.densenet121(pretrained=True)                         
                    model.classifier =                                          
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                    model = model.to(DEVICE)                                    
                    criterion = nn.BCEWithLogitsLoss()                          
                    optimizer =                                                 
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                    scheduler =                                                 
                    CosineAnnealingLR(optimizer,                                
                    T_max=N_EPOCHS, eta_min=1e-6)                               
                                                                                
                    model.train()                                               
                    for epoch in range(N_EPOCHS):                               
                        for imgs, labels in                                     
                    tqdm(full_loader, desc=f"Full train                         
                    epoch {epoch+1}"):                                          
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE).unsqueeze(1)                              
                            preds = model(imgs)                                 
                            loss = criterion(preds, labels)                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder: str, model_path:                        
                    str = MODEL_PATH, device=DEVICE):                           
                        """                                                     
                        Predict malignancy probabilities                        
                    for images in a folder using 4-view                         
                    TTA.                                                        
                        Returns a DataFrame with columns                        
                    ['image_name','malignancy_probability']                     
                    .                                                           
                        """                                                     
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model = model.to(device).eval()                         
                        transform = val_transform                               
                        results = []                                            
                        img_names = sorted([f for f in                          
                    os.listdir(folder) if                                       
                    f.lower().endswith(".jpg")])                                
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(img_names), BATCH_SIZE):                                
                                batch = img_names[i : i +                       
                    BATCH_SIZE]                                                 
                                imgs = torch.stack(                             
                                    [                                           
                                        transform(Image.ope                     
                    n(os.path.join(folder,                                      
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                for fname, p in zip(batch,                      
                    probs):                                                     
                                    results.append((os.path                     
                    .splitext(fname)[0], float(p)))                             
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(SUBMISSION_PATH,                                 
                    index=False)                                                
                    print(f"Submission saved to                                 
                    {SUBMISSION_PATH}")                                         
                                                                                
                    Results: The training script executed                       
                    successfully without any errors.                            
                    Cross-validation with 5 folds using a                       
                    WeightedRandomSampler for fairness by                       
                    skin tone and 4-view TTA achieved a                         
                    mean AUROC of 0.9367 with a low                             
                    standard deviation of 0.0040,                               
                    indicating stable and strong                                
                    performance. The model was then                             
                    retrained on the full dataset using the                     
                    same fairness sampling approach. The                        
                    submission file with malignancy                             
                    probabilities was generated                                 
                    successfully. Overall, the model                            
                    training and prediction pipeline is                         
                    well-implemented and achieves high                          
                    AUROC.                                                      
                    Validation Metric: 0.9367                                   
                                                                                
                    -------------------------------                             
                    Design: I propose replacing the                             
                    standard BCEWithLogitsLoss with a Focal                     
                    Loss (γ=2, α=0.25) to focus the model                       
                    on hard-to-classify malignant examples                      
                    and mitigate class imbalance. This                          
                    change is atomic and should improve                         
                    AUROC by reducing the impact of easy                        
                    negatives and emphasizing difficult                         
                    positives during training. We will use                      
                    the same DenseNet-121 backbone, 4-view                      
                    TTA, CosineAnnealingLR scheduler, and                       
                    overall training/prediction pipeline,                       
                    swapping only the loss function. Below                      
                    is the updated implementation.                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.nn.functional as F                             
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                                                                                
                    # Configuration                                             
                    DATA_CSV = "input/mydataset.csv"                            
                    IMG_DIR = "input/MyImages"                                  
                    MODEL_PATH = "working/model.pth"                            
                    SUBMISSION_PATH =                                           
                    "working/submission.csv"                                    
                    N_SPLITS = 5                                                
                    BATCH_SIZE = 32                                             
                    N_EPOCHS = 5                                                
                    LR = 1e-4                                                   
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    os.makedirs("working", exist_ok=True)                       
                    torch.manual_seed(42)                                       
                    np.random.seed(42)                                          
                                                                                
                                                                                
                    # Focal Loss definition                                     
                    class FocalLoss(nn.Module):                                 
                        def __init__(self, alpha=0.25,                          
                    gamma=2.0, reduction="mean"):                               
                            super().__init__()                                  
                            self.alpha = alpha                                  
                            self.gamma = gamma                                  
                            self.reduction = reduction                          
                                                                                
                        def forward(self, inputs, targets):                     
                            # inputs: logits, targets:                          
                    float tensor with 0/1                                       
                            bce =                                               
                    F.binary_cross_entropy_with_logits(inpu                     
                    ts, targets, reduction="none")                              
                            probs = torch.sigmoid(inputs)                       
                            p_t = probs * targets + (1 -                        
                    probs) * (1 - targets)                                      
                            alpha_t = self.alpha * targets                      
                    + (1 - self.alpha) * (1 - targets)                          
                            loss = alpha_t * (1 - p_t) **                       
                    self.gamma * bce                                            
                            if self.reduction == "mean":                        
                                return loss.mean()                              
                            elif self.reduction == "sum":                       
                                return loss.sum()                               
                            else:                                               
                                return loss                                     
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.names =                                        
                    df["image_name"].tolist()                                   
                            self.labels =                                       
                    df["label_bin"].tolist()                                    
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            name = self.names[idx]                              
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    name + ".jpg")).convert("RGB")                              
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(self.labels[idx],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_transform = transforms.Compose(                       
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.RandomVerticalFlip()                     
                    ,                                                           
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_transform = transforms.Compose(                         
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(DATA_CSV)                                  
                    df["label_bin"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                    y = df["label_bin"].values                                  
                                                                                
                                                                                
                    # TTA function                                              
                    def tta_predictions(model, imgs):                           
                        views = [None, (3,), (2,), (2, 3)]                      
                        logits_sum =                                            
                    torch.zeros(imgs.size(0), 1,                                
                    device=imgs.device)                                         
                        for d in views:                                         
                            inp = imgs if d is None else                        
                    torch.flip(imgs, dims=d)                                    
                            logits_sum += model(inp)                            
                        return logits_sum / len(views)                          
                                                                                
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, y), 1):                             
                        print(f"Fold {fold}")                                   
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds = SkinDataset(train_df,                        
                    IMG_DIR, train_transform)                                   
                        val_ds = SkinDataset(val_df,                            
                    IMG_DIR, val_transform)                                     
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = FocalLoss(alpha=0.25,                       
                    gamma=2.0)                                                  
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        scheduler =                                             
                    CosineAnnealingLR(optimizer,                                
                    T_max=N_EPOCHS, eta_min=1e-6)                               
                                                                                
                        for epoch in range(N_EPOCHS):                           
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"  Fold {fold} AUROC (4-view                     
                    TTA, FocalLoss): {auc:.4f}")                                
                        aucs.append(auc)                                        
                                                                                
                    mean_auc, std_auc = np.mean(aucs),                          
                    np.std(aucs)                                                
                    print(f"\nCV AUROC with FocalLoss &                         
                    CosineAnnealingLR: {mean_auc:.4f} ±                         
                    {std_auc:.4f}")                                             
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_transform)                                            
                    full_loader = DataLoader(full_ds,                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                    model =                                                     
                    models.densenet121(pretrained=True)                         
                    model.classifier =                                          
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                    model = model.to(DEVICE)                                    
                    criterion = FocalLoss(alpha=0.25,                           
                    gamma=2.0)                                                  
                    optimizer =                                                 
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                    scheduler =                                                 
                    CosineAnnealingLR(optimizer,                                
                    T_max=N_EPOCHS, eta_min=1e-6)                               
                                                                                
                    model.train()                                               
                    for epoch in range(N_EPOCHS):                               
                        for imgs, labels in                                     
                    tqdm(full_loader, desc=f"Full train                         
                    epoch {epoch+1}"):                                          
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE).unsqueeze(1)                              
                            preds = model(imgs)                                 
                            loss = criterion(preds, labels)                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                        scheduler.step()                                        
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder: str, model_path:                        
                    str = MODEL_PATH, device=DEVICE):                           
                        """                                                     
                        Predict malignancy probabilities                        
                    for images in a folder using 4-view                         
                    TTA.                                                        
                        Returns a DataFrame with columns                        
                    ['image_name',                                              
                    'malignancy_probability'].                                  
                        """                                                     
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model = model.to(device).eval()                         
                        transform = val_transform                               
                        results = []                                            
                        img_names = sorted([f for f in                          
                    os.listdir(folder) if                                       
                    f.lower().endswith(".jpg")])                                
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(img_names), BATCH_SIZE):                                
                                batch = img_names[i : i +                       
                    BATCH_SIZE]                                                 
                                imgs = torch.stack(                             
                                    [                                           
                                        transform(Image.ope                     
                    n(os.path.join(folder,                                      
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                for fname, p in zip(batch,                      
                    probs):                                                     
                                    results.append((os.path                     
                    .splitext(fname)[0], float(p)))                             
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(SUBMISSION_PATH,                                 
                    index=False)                                                
                    print(f"Submission saved to                                 
                    {SUBMISSION_PATH}")                                         
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    5-fold cross-validation using a                             
                    DenseNet121 model with Focal Loss and                       
                    Cosine Annealing LR scheduler achieved                      
                    a strong mean AUROC of 0.9418 ± 0.0037,                     
                    indicating good classification                              
                    performance for malignancy detection.                       
                    The model was then retrained on the                         
                    full dataset and saved. The provided                        
                    prediction function uses 4-view Test                        
                    Time Augmentation to generate                               
                    malignancy probabilities for new                            
                    images, ensuring robustness. Overall,                       
                    the approach is sound and the results                       
                    are promising for the task.                                 
                    Validation Metric: 0.9418                                   
                                                                                
                    -------------------------------                             
                    Design: I propose to ensemble the five                      
                    fold-trained DenseNet-121 models at                         
                    inference time by saving each fold’s                        
                    weights during cross-validation and                         
                    averaging their TTA‐enhanced                                
                    predictions. During CV each fold’s                          
                    model is saved to                                           
                    `working/model_fold_{fold}.pth`. The                        
                    `predict()` function loads all five                         
                    fold models, applies 4‐view TTA per                         
                    model, converts logits to                                   
                    probabilities, and averages across                          
                    models to yield final malignancy                            
                    scores. This ensembling should boost                        
                    robustness and AUROC without changing                       
                    the training loop.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                                                                                
                    # Configuration                                             
                    DATA_CSV = "input/mydataset.csv"                            
                    IMG_DIR = "input/MyImages"                                  
                    WORK_DIR = "working"                                        
                    os.makedirs(WORK_DIR, exist_ok=True)                        
                    N_SPLITS = 5                                                
                    BATCH_SIZE = 32                                             
                    N_EPOCHS = 5                                                
                    LR = 1e-4                                                   
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    torch.manual_seed(42)                                       
                    np.random.seed(42)                                          
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.names =                                        
                    df["image_name"].tolist()                                   
                            self.labels =                                       
                    df["label_bin"].tolist()                                    
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            name = self.names[idx]                              
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    name + ".jpg")).convert("RGB")                              
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(self.labels[idx],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Transforms                                                
                    train_transform = transforms.Compose(                       
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.RandomVerticalFlip()                     
                    ,                                                           
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_transform = transforms.Compose(                         
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(DATA_CSV)                                  
                    df["label_bin"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                    y = df["label_bin"].values                                  
                                                                                
                                                                                
                    # TTA                                                       
                    def tta_predictions(model, imgs):                           
                        views = [None, (3,), (2,), (2, 3)]                      
                        logits_sum =                                            
                    torch.zeros(imgs.size(0), 1,                                
                    device=imgs.device)                                         
                        for d in views:                                         
                            inp = imgs if d is None else                        
                    torch.flip(imgs, dims=d)                                    
                            logits_sum += model(inp)                            
                        return logits_sum / len(views)                          
                                                                                
                                                                                
                    # Cross-validation and save fold models                     
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, y), 1):                             
                        print(f"Fold {fold}")                                   
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds = SkinDataset(train_df,                        
                    IMG_DIR, train_transform)                                   
                        val_ds = SkinDataset(val_df,                            
                    IMG_DIR, val_transform)                                     
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        scheduler =                                             
                    CosineAnnealingLR(optimizer,                                
                    T_max=N_EPOCHS, eta_min=1e-6)                               
                                                                                
                        for epoch in range(N_EPOCHS):                           
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                            scheduler.step()                                    
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits =                                        
                    tta_predictions(model, imgs)                                
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"  Fold {fold} AUROC:                            
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                        # Save model                                            
                        torch.save(model.state_dict(),                          
                    os.path.join(WORK_DIR,                                      
                    f"model_fold_{fold}.pth"))                                  
                                                                                
                    mean_auc, std_auc = np.mean(aucs),                          
                    np.std(aucs)                                                
                    print(f"\nCV AUROC (ensemble-ready                          
                    models): {mean_auc:.4f} ±                                   
                    {std_auc:.4f}")                                             
                                                                                
                                                                                
                    # Prediction with fold-ensemble and TTA                     
                    def predict(folder: str, model_dir: str                     
                    = WORK_DIR, device=DEVICE):                                 
                        """                                                     
                        Predict malignancy probabilities by                     
                    ensembling all fold models with 4-view                      
                    TTA.                                                        
                        Returns DataFrame with                                  
                    ['image_name','malignancy_probability']                     
                    .                                                           
                        """                                                     
                        # load all fold model paths                             
                        model_paths = sorted(                                   
                            [                                                   
                                os.path.join(model_dir, f)                      
                                for f in                                        
                    os.listdir(model_dir)                                       
                                if                                              
                    f.startswith("model_fold_")                                 
                            ]                                                   
                        )                                                       
                        models_list = []                                        
                        for mp in model_paths:                                  
                            m =                                                 
                    models.densenet121(pretrained=False)                        
                            m.classifier =                                      
                    nn.Linear(m.classifier.in_features, 1)                      
                            m.load_state_dict(torch.load(mp                     
                    , map_location=device))                                     
                            m.to(device).eval()                                 
                            models_list.append(m)                               
                        # images                                                
                        fnames = sorted([f for f in                             
                    os.listdir(folder) if                                       
                    f.lower().endswith(".jpg")])                                
                        results = []                                            
                        with torch.no_grad():                                   
                            for i in range(0, len(fnames),                      
                    BATCH_SIZE):                                                
                                batch = fnames[i : i +                          
                    BATCH_SIZE]                                                 
                                imgs = torch.stack(                             
                                    [                                           
                                        val_transform(Image                     
                    .open(os.path.join(folder,                                  
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                # accumulate probs                              
                                probs_sum =                                     
                    np.zeros(len(batch), dtype=np.float32)                      
                                for m in models_list:                           
                                    logits =                                    
                    tta_predictions(m, imgs)                                    
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    probs_sum += probs                          
                                probs_avg = probs_sum /                         
                    len(models_list)                                            
                                for fname, p in zip(batch,                      
                    probs_avg):                                                 
                                    results.append((os.path                     
                    .splitext(fname)[0], float(p)))                             
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(os.path.join(WORK_DIR,                           
                    "submission.csv"), index=False)                             
                    print(f"Submission saved to                                 
                    {os.path.join(WORK_DIR,'submission.csv'                     
                    )}")                                                        
                                                                                
