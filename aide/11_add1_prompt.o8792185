                    sorted([os.path.join(model_dir,f) for                       
                    f in os.listdir(model_dir) if                               
                    f.startswith("model_fold_")])                               
                        models_list = []                                        
                        for mp in model_paths:                                  
                            m =                                                 
                    models.densenet121(pretrained=False)                        
                            m.classifier =                                      
                    nn.Linear(m.classifier.in_features,1)                       
                            m.load_state_dict(torch.load(m                      
                    p, map_location=device))                                    
                            m.to(device).eval()                                 
                            models_list.append(m)                               
