                    torch.sigmoid(logits).cpu().numpy().fl                      
                    atten()                                                     
                                for fname, p in zip(batch,                      
                    probs):                                                     
                                    name =                                      
                    os.path.splitext(fname)[0]                                  
                                    results.append((name,                       
                    float(p)))                                                  
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(SUBMISSION_PATH,                                 
                    index=False)                                                
