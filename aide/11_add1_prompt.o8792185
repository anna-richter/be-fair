                    ```python                                                   
                    import os                                                   
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms                          
                    import timm                                                 
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import xgboost as xgb                                       
                    import joblib                                               
                                                                                
                    # Dataset for loading images                                
                    class ImageDataset(Dataset):                                
                        def __init__(self, image_paths,                         
                    transform):                                                 
                            self.image_paths = image_paths                      
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                        def __getitem__(self, idx):                             
                            from PIL import Image                               
                            img =                                               
                    Image.open(self.image_paths[idx]).conv                      
                    ert('RGB')                                                  
                            return self.transform(img),                         
                    idx                                                         
                                                                                
                    # Load labels and image paths                               
                    df =                                                        
                    pd.read_csv('input/mydataset.csv')                          
                    df['target'] =                                              
                    (df['label']=='malignant').astype(int)                      
                    image_names = df['image_name'].values                       
                    image_paths =                                               
                    [os.path.join('input/MyImages', name +                      
                    '.jpg') for name in image_names]                            
                    targets = df['target'].values                               
                                                                                
                    # Image transforms                                          
                    transform = transforms.Compose([                            
                        transforms.Resize((224,224)),                           
                        transforms.ToTensor(),                                  
                        transforms.Normalize(mean=(0.485,0                      
                    .456,0.406), std=(0.229,0.224,0.225))                       
                    ])                                                          
                                                                                
                    # Prepare DataLoader for feature                            
                    extraction                                                  
                    dataset = ImageDataset(image_paths,                         
                    transform)                                                  
                    loader = DataLoader(dataset,                                
                    batch_size=32, num_workers=4,                               
                    shuffle=False)                                              
                                                                                
                    # Load EfficientNet-B0 feature                              
                    extractor                                                   
                    device = torch.device('cuda' if                             
                    torch.cuda.is_available() else 'cpu')                       
                    fe_model =                                                  
                    timm.create_model('efficientnet_b0',                        
                    pretrained=True, num_classes=0,                             
                    global_pool='avg').to(device)                               
                    fe_model.eval()                                             
                                                                                
                    # Extract embeddings                                        
                    n = len(dataset)                                            
                    feat_dim = fe_model.num_features                            
                    features = np.zeros((n, feat_dim),                          
                    dtype=np.float32)                                           
                    with torch.no_grad():                                       
                        for imgs, idxs in loader:                               
                            imgs = imgs.to(device)                              
                            out =                                               
                    fe_model(imgs).cpu().numpy()                                
                            for emb, i in zip(out,                              
                    idxs.numpy()):                                              
                                features[i] = emb                               
                                                                                
                    # 5-fold CV with XGBoost                                    
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(features,                               
                    targets), start=1):                                         
                        X_tr, X_val = features[train_idx],                      
                    features[val_idx]                                           
                        y_tr, y_val = targets[train_idx],                       
                    targets[val_idx]                                            
                        clf =                                                   
                    xgb.XGBClassifier(use_label_encoder=Fa                      
                    lse, eval_metric='logloss',                                 
                    random_state=42)                                            
                        clf.fit(X_tr, y_tr)                                     
                        preds =                                                 
                    clf.predict_proba(X_val)[:,1]                               
                        auc = roc_auc_score(y_val, preds)                       
                        print(f'Fold {fold} AUROC:                              
                    {auc:.4f}')                                                 
                        aucs.append(auc)                                        
                    print(f'Mean CV AUROC:                                      
                    {np.mean(aucs):.4f}')                                       
                                                                                
                    # Retrain on all data and save model                        
                    final_model =                                               
                    xgb.XGBClassifier(use_label_encoder=Fa                      
                    lse, eval_metric='logloss',                                 
                    random_state=42)                                            
                    final_model.fit(features, targets)                          
                    os.makedirs('working', exist_ok=True)                       
                    joblib.dump(final_model,                                    
                    'working/model_xgb.pkl')                                    
                                                                                
                    def predict(folder):                                        
                        """                                                     
                        Predict malignancy probabilities                        
                    for all .jpg images in a folder.                            
                        Args:                                                   
                            folder (str): path to folder                        
                    of images                                                   
                        Returns:                                                
                            dict: mapping from image                            
                    filename to malignancy probability                          
                        """                                                     
                        files = [f for f in                                     
                    os.listdir(folder) if                                       
                    f.lower().endswith('.jpg')]                                 
                        paths = [os.path.join(folder, f)                        
                    for f in files]                                             
                        ds = ImageDataset(paths,                                
                    transform)                                                  
                        dl = DataLoader(ds, batch_size=32,                      
                    num_workers=4, shuffle=False)                               
                        feats = np.zeros((len(ds),                              
                    feat_dim), dtype=np.float32)                                
                        with torch.no_grad():                                   
                            for imgs, idxs in dl:                               
                                imgs = imgs.to(device)                          
                                out =                                           
                    fe_model(imgs).cpu().numpy()                                
                                for emb, i in zip(out,                          
                    idxs.numpy()):                                              
                                    feats[i] = emb                              
                        probs =                                                 
                    final_model.predict_proba(feats)[:,1]                       
                        return dict(zip(files, probs))                          
                                                                                
                    # Generate submission.csv                                   
                    preds = predict('input/MyImages')                           
                    sub = pd.DataFrame({                                        
                        'image_name': list(preds.keys()),                       
                        'malignancy_probability':                               
                    list(preds.values())                                        
                    })                                                          
                    sub.to_csv('working/submission.csv',                        
                    index=False)                                                
                    ```                                                         
