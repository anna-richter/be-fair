                            return len(self.paths)                              
                                                                                
                        def __getitem__(self, idx):                             
                            img =                                               
                    Image.open(self.paths[idx]).convert("RG                     
                    B")                                                         
                            return transform(img)                               
                                                                                
                                                                                
                    # Load pretrained ResNet50 and strip                        
