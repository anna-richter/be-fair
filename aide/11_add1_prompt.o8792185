                    ame)[0]] = prob                                             
                        return results                                          
                                                                                
                                                                                
                    # 7. Create submission.csv for all                          
                    input images                                                
                    preds = predict(IMG_DIR)                                    
                    sub_df = pd.DataFrame(                                      
                        {"image_name": list(preds.keys()),                      
                    "malignancy_probability":                                   
