                    epoch {epoch+1}"):                                          
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE).unsqueeze(1)                              
                            preds = model(imgs)                                 
                            loss = criterion(preds, labels)                     
