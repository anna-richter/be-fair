                                probs_avg = probs_sum /                         
                    len(models_list)                                            
                                for fname, p in zip(batch,                      
                    probs_avg):                                                 
                                    results.append((os.pat                      
                    h.splitext(fname)[0],float(p)))                             
                        return pd.DataFrame(results,                            
                    columns=["image_name","malignancy_prob                      
                    ability"])                                                  
                                                                                
                    # Generate submission                                       
                    sub = predict(IMG_DIR)                                      
                    sub.to_csv(os.path.join(WORK_DIR,"subm                      
                    ission.csv"), index=False)                                  
