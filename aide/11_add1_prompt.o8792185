                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.names =                                        
                    df["image_name"].tolist()                                   
                            self.labels =                                       
                    df["label_bin"].tolist()                                    
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
