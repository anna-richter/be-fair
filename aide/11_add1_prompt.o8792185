                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                    DATA_CSV = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                    MODEL_PATH = "./working/model.pth"                          
                    SUBMISSION_CSV =                                            
                    "./working/submission.csv"                                  
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                                                                                
                    # 1. Dataset                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transforms):                                                
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transforms = transforms                        
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transforms(img)                          
                            label =                                             
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.long)                                           
                            return img, label                                   
                                                                                
                                                                                
                    # 2. Read and preprocess labels                             
                    df = pd.read_csv(DATA_CSV)                                  
                    # Map malignant=1, others=0                                 
                    df["label_bin"] =                                           
                    df["label"].apply(lambda x: 1 if x ==                       
                    "malignant" else 0)                                         
                                                                                
                    # 3. Transforms                                             
                    tfms = T.Compose(                                           
                        [                                                       
                            T.Resize(256),                                      
                            T.CenterCrop(224),                                  
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)),                         
                        ]                                                       
                    )                                                           
                                                                                
                    # 4. 5-fold CV                                              
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.label_bin)):                     
                        print(f"Fold {fold+1}")                                 
                        train_df = df.iloc[train_idx]                           
                        val_df = df.iloc[val_idx]                               
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMG_DIR,                        
                    tfms)                                                       
                        val_ds = SkinLesionDataset(val_df,                      
                    IMG_DIR, tfms)                                              
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # Model                                                 
                        model =                                                 
                    timm.create_model("resnet18",                               
                    pretrained=True,                                            
                    num_classes=2).to(DEVICE)                                   
                        criterion = nn.CrossEntropyLoss()                       
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        # Train for 3 epochs                                    
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, lbls in train_loader:                     
                                imgs, lbls =                                    
                    imgs.to(DEVICE), lbls.to(DEVICE)                            
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    lbls)                                                       
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                        # Evaluate                                              
                        model.eval()                                            
                        all_probs = []                                          
                        all_lbls = []                                           
                        with torch.no_grad():                                   
                            for imgs, lbls in val_loader:                       
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.softmax(logits, dim=1)[:,                             
                    1].cpu().numpy()                                            
                                all_probs.extend(probs)                         
                                all_lbls.extend(lbls.numpy(                     
                    ))                                                          
                        auc = roc_auc_score(all_lbls,                           
                    all_probs)                                                  
                        print(f" Fold {fold+1} AUROC:                           
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean AUROC over 5 folds:                            
                    {mean_auc:.4f}")                                            
                                                                                
                    # 5. Save last fold model                                   
                    os.makedirs(os.path.dirname(MODEL_PATH)                     
                    , exist_ok=True)                                            
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # 6. Prediction function                                    
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each image in a folder.                                     
                        Args:                                                   
                          folder_path (str): Path to folder                     
                    containing .jpg images.                                     
                        Returns:                                                
                          dict: {image_name (no extension):                     
                    probability_of_malignant}                                   
                        """                                                     
                        model =                                                 
                    timm.create_model("resnet18",                               
                    pretrained=False, num_classes=2)                            
                        model.load_state_dict(torch.load(MO                     
                    DEL_PATH, map_location=DEVICE))                             
                        model.to(DEVICE).eval()                                 
                        results = {}                                            
                        transform = tfms                                        
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith(".jpg"):                             
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                inp =                                           
                    transform(img).unsqueeze(0).to(DEVICE)                      
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.softmax(model(inp), dim=1)[0,                         
                    1].item()                                                   
