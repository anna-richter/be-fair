                    imgs.to(device), targets.to(device)                         
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, targets,                             
                    alpha=0.4)                                                  
                                    optimizer.zero_grad()                       
                                    outputs =                                   
                    model(mixed_imgs).squeeze(1)                                
                                    loss =                                      
                    lam*criterion(outputs, y_a) +                               
                    (1-lam)*criterion(outputs, y_b)                             
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item()*imgs.size(0)                                    
                                scheduler.step()                                
                                print(f"Fold {fold} Epoch                       
                    {epoch} - Loss:                                             
                    {running_loss/len(train_ds):.4f}")                          
                                                                                
                            model.eval()                                        
                            with torch.no_grad():                               
                                for imgs, targets, idxs in                      
