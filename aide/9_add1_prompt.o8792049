                    (1 + np.exp(-logit)))                                       
                                results[fname] =                                
                    float(np.mean(probs))                                       
                        return results                                          
                                                                                
                    def main():                                                 
                        df =                                                    
                    pd.read_csv("input/mydataset.csv")                          
                        df["target"] = (df.label ==                             
                    "malignant").astype(int)                                    
                        df["filepath"] =                                        
                    df.image_name.apply(lambda x:                               
                    os.path.join("input/MyImages", x +                          
                    ".jpg"))                                                    
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        oof_preds = np.zeros(len(df))                           
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        train_transform =                                       
                    transforms.Compose([                                        
                            transforms.RandomResizedCrop(2                      
                    24),                                                        
                            transforms.RandomHorizontalFli                      
                    p(),                                                        
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=(0.4                      
                    85,0.456,0.406),                                            
                    std=(0.229,0.224,0.225)),                                   
                            transforms.RandomErasing(p=0.5                      
                    , scale=(0.02,0.33), ratio=(0.3,3.3),                       
                    value='random')                                             
                        ])                                                      
                        val_transform =                                         
                    transforms.Compose([                                        
                            transforms.Resize(256),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=(0.4                      
                    85,0.456,0.406),                                            
                    std=(0.229,0.224,0.225))                                    
                        ])                                                      
                                                                                
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.target)):                        
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                            class_counts =                                      
                    train_df.target.value_counts().to_dict                      
                    ()                                                          
                            class_weights = {cls:                               
                    1.0/count for cls,count in                                  
                    class_counts.items()}                                       
                            sample_weights =                                    
                    train_df.target.map(class_weights).val                      
                    ues                                                         
                            sampler =                                           
                    WeightedRandomSampler(torch.DoubleTens                      
                    or(sample_weights),                                         
                                                                                
                      num_samples=len(sample_weights),                          
                                                                                
                      replacement=True)                                         
                            train_ds =                                          
                    SkinLesionDataset(train_df,                                 
                    transform=train_transform)                                  
                            val_ds =                                            
                    SkinLesionDataset(val_df,                                   
                    transform=val_transform,                                    
                    return_index=True)                                          
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    sampler=sampler, num_workers=4,                             
                    pin_memory=True)                                            
                            val_loader   =                                      
                    DataLoader(val_ds, batch_size=32,                           
                    shuffle=False, num_workers=4,                               
                    pin_memory=True)                                            
                                                                                
                            model =                                             
                    timm.create_model("swin_tiny_patch4_wi                      
                    ndow7_224", pretrained=True,                                
                    num_classes=1).to(device)                                   
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
