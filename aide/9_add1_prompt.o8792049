                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            scheduler.step()                                    
                            avg_loss = running_loss /                           
                    len(train_ds)                                               
                            print(f"Epoch {epoch} -                             
                    Training Loss: {avg_loss:.4f}")                             
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        all_preds, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                # Original logits                               
                                logits1 = model(imgs)                           
                                # Flipped logits                                
                                logits2 =                                       
                    model(torch.flip(imgs, dims=[3]))                           
                                logits = (logits1 +                             
                    logits2) / 2.0                                              
                                probs =                                         
                    torch.sigmoid(logits).squeeze(1).cpu().                     
                    numpy()                                                     
                                all_preds.extend(probs.toli                     
                    st())                                                       
                                all_targets.extend(targets.                     
                    numpy().tolist())                                           
                                                                                
                        auc = roc_auc_score(all_targets,                        
                    all_preds)                                                  
                        print(f"Validation ROC AUC with                         
                    TTA: {auc:.4f}")                                            
                                                                                
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
