                    torch.optim.lr_scheduler.StepLR(optimiz                     
                    er, step_size=2, gamma=0.1)                                 
                        # Training loop                                         
                        for epoch in range(1, 6):                               
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device), targets.to(device)                         
                                optimizer.zero_grad()                           
                                outputs =                                       
                    model(imgs).squeeze(1)                                      
                                loss = criterion(outputs,                       
                    targets)                                                    
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            scheduler.step()                                    
                            avg_loss = running_loss /                           
                    len(train_ds)                                               
                            print(f"Epoch {epoch} -                             
                    Training Loss: {avg_loss:.4f}")                             
                        # Validation                                            
                        model.eval()                                            
                        all_preds, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1).cpu().numpy()                        
                                probs = 1 / (1 +                                
