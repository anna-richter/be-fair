                                loss = lam *                                    
                    criterion(outputs, y_a) + (1 - lam) *                       
                    criterion(outputs, y_b)                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss +=                                 
                    loss.item() * imgs.size(0)                                  
                            scheduler.step()                                    
                            print(f"Epoch {epoch} -                             
