                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets                                              
                        train_ds =                                              
                    SkinLesionDataset(train_df,                                 
                    transform=train_transform)                                  
                        val_ds = SkinLesionDataset(val_df,                      
                    transform=val_transform)                                    
                                                                                
                        # Compute sample weights for                            
                    balancing                                                   
                        class_counts =                                          
                    train_df["target"].value_counts().to_di                     
                    ct()                                                        
                        class_weights = {cls: 1.0 / count                       
                    for cls, count in class_counts.items()}                     
                        sample_weights =                                        
                    train_df["target"].map(class_weights).v                     
                    alues                                                       
                        sampler = WeightedRandomSampler(                        
                            weights=torch.DoubleTensor(samp                     
                    le_weights),                                                
                            num_samples=len(sample_weights)                     
                    ,                                                           
                            replacement=True,                                   
                        )                                                       
                                                                                
                        # DataLoaders                                           
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer, scheduler                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model = timm.create_model(                              
                            "swin_tiny_patch4_window7_224",                     
                    pretrained=True, num_classes=1                              
                        )                                                       
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        scheduler =                                             
                    torch.optim.lr_scheduler.StepLR(optimiz                     
                    er, step_size=2, gamma=0.1)                                 
                                                                                
                        # Training loop with MixUp                              
                        alpha = 0.4                                             
                        for epoch in range(1, 6):                               
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device), targets.to(device)                         
                                mixed_imgs, y_a, y_b, lam =                     
                    mixup_data(imgs, targets, alpha)                            
                                optimizer.zero_grad()                           
                                outputs =                                       
                    model(mixed_imgs).squeeze(1)                                
                                loss = lam *                                    
                    criterion(outputs, y_a) + (1 - lam) *                       
                    criterion(outputs, y_b)                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            scheduler.step()                                    
                            avg_loss = running_loss /                           
                    len(train_ds)                                               
                            print(f"Epoch {epoch} -                             
                    Training Loss: {avg_loss:.4f}")                             
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_preds, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1).cpu().numpy()                        
                                probs = 1 / (1 +                                
                    np.exp(-logits))                                            
                                all_preds.extend(probs.toli                     
                    st())                                                       
                                all_targets.extend(targets.                     
                    numpy().tolist())                                           
                        auc = roc_auc_score(all_targets,                        
                    all_preds)                                                  
                        print(f"Validation ROC AUC:                             
                    {auc:.4f}")                                                 
                                                                                
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using a                      
                    Swin Transformer architecture with                          
                    MixUp augmentation and class balancing.                     
                    The validation ROC AUC achieved was                         
                    0.929, indicating strong performance in                     
                    distinguishing malignant from benign                        
                    lesions. The model was saved correctly                      
                    for later inference.                                        
                    Validation Metric: 0.929                                    
                                                                                
                    -------------------------------                             
                    Design: I propose to improve robustness                     
                    and generalization by ensembling five                       
                    models trained on different stratified                      
                    folds. We’ll perform 5-fold                                 
                    cross-validation, training a Swin                           
                    Transformer model on each fold, saving                      
                    each checkpoint, and computing                              
                    out‐of‐fold ROC AUC across the full                         
                    dataset. At inference, our `predict`                        
                    function will load all five models and                      
                    average their malignancy probabilities.                     
                    This ensemble approach typically yields                     
                    a substantial boost in test‐time AUROC                      
                    with only modest code changes.                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn                                        
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as                            
                    transforms                                                  
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df,                                  
                    transform=None, return_index=False):                        
                            self.df = df  # preserves                           
                    original indices for OOF mapping                            
                            self.transform = transform                          
                            self.return_index =                                 
                    return_index                                                
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(row.filepath).convert("RGB")                     
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            if self.return_index:                               
                                return img, label, row.name                     
                            else:                                               
                                return img, label                               
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.4):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index, :]                                                 
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(image_folder: str):                             
                        """                                                     
                        Load ensemble of 5 models and                           
                    predict malignancy probabilities for                        
                    each image.                                                 
                        Args:                                                   
                            image_folder (str): path to                         
                    folder containing images.                                   
                        Returns:                                                
                            Dict[str, float]: mapping from                      
                    image filename to malignancy                                
                    probability.                                                
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                        # load models                                           
                        models = []                                             
                        for fold in range(5):                                   
                            m = timm.create_model(                              
                                "swin_tiny_patch4_window7_2                     
                    24", pretrained=False, num_classes=1                        
                            )                                                   
                            ckpt =                                              
                    f"working/model_fold{fold}.pth"                             
                            m.load_state_dict(torch.load(ck                     
                    pt, map_location=device))                                   
                            m.to(device).eval()                                 
                            models.append(m)                                    
                        results = {}                                            
                        for fname in                                            
                    sorted(os.listdir(image_folder)):                           
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                path =                                          
                    os.path.join(image_folder, fname)                           
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                t =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                probs = []                                      
                                with torch.no_grad():                           
                                    for m in models:                            
                                        logit = m(t).item()                     
                                        probs.append(1 / (1                     
                    + np.exp(-logit)))                                          
                                results[fname] =                                
                    float(np.mean(probs))                                       
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        df =                                                    
                    pd.read_csv("input/mydataset.csv")                          
                        df["target"] = (df.label ==                             
                    "malignant").astype(int)                                    
                        df["filepath"] =                                        
                    df.image_name.apply(                                        
                            lambda x:                                           
                    os.path.join("input/MyImages", x +                          
                    ".jpg")                                                     
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        oof_preds = np.zeros(len(df))                           
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.target)):                        
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                            # sampler for class balance                         
                            class_counts =                                      
                    train_df.target.value_counts().to_dict(                     
                    )                                                           
                            class_weights = {cls: 1.0 /                         
                    count for cls, count in                                     
                    class_counts.items()}                                       
                            sample_weights =                                    
                    train_df.target.map(class_weights).valu                     
                    es                                                          
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                torch.DoubleTensor(sample_w                     
                    eights),                                                    
                                num_samples=len(sample_weig                     
                    hts),                                                       
                                replacement=True,                               
                            )                                                   
                            train_ds =                                          
                    SkinLesionDataset(train_df,                                 
                    transform=train_transform)                                  
                            val_ds =                                            
                    SkinLesionDataset(val_df,                                   
                    transform=val_transform,                                    
                    return_index=True)                                          
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=4,                             
                    pin_memory=True                                             
                            )                                                   
                            val_loader = DataLoader(                            
                                val_ds, batch_size=32,                          
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                            )                                                   
                                                                                
                            model = timm.create_model(                          
                                "swin_tiny_patch4_window7_2                     
                    24", pretrained=True, num_classes=1                         
                            ).to(device)                                        
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            scheduler =                                         
                    torch.optim.lr_scheduler.StepLR(optimiz                     
                    er, step_size=2, gamma=0.1)                                 
                                                                                
                            for epoch in range(1, 6):                           
                                model.train()                                   
                                running_loss = 0.0                              
                                for imgs, targets in                            
                    train_loader:                                               
                                    imgs, targets =                             
                    imgs.to(device), targets.to(device)                         
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, targets,                             
                    alpha=0.4)                                                  
                                    optimizer.zero_grad()                       
                                    outputs =                                   
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(outputs, y_a) + (1 - lam) *                       
                    criterion(                                                  
                                        outputs, y_b                            
                                    )                                           
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item() * imgs.size(0)                                  
                                scheduler.step()                                
                                avg_loss = running_loss /                       
                    len(train_ds)                                               
                                print(f"Fold {fold} Epoch                       
                    {epoch} - Loss: {avg_loss:.4f}")                            
                                                                                
                            # validation                                        
                            model.eval()                                        
                            with torch.no_grad():                               
                                for imgs, targets, idxs in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1).cpu().numpy()                        
                                    probs = 1 / (1 +                            
                    np.exp(-logits))                                            
                                    oof_preds[np.array(idxs                     
                    )] = probs                                                  
                            fold_auc =                                          
                    roc_auc_score(df.target.iloc[val_idx],                      
                    oof_preds[val_idx])                                         
                            print(f"Fold {fold} ROC AUC:                        
                    {fold_auc:.4f}")                                            
                            os.makedirs("working",                              
                    exist_ok=True)                                              
                            torch.save(model.state_dict(),                      
                    f"working/model_fold{fold}.pth")                            
                                                                                
                        overall_auc =                                           
                    roc_auc_score(df.target.values,                             
                    oof_preds)                                                  
                        print(f"Overall OOF ROC AUC:                            
                    {overall_auc:.4f}")                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without errors. The model                      
                    was trained using 5-fold                                    
                    cross-validation with a Swin                                
                    Transformer Tiny architecture and mixup                     
                    augmentation. The validation ROC AUC                        
                    scores for each fold ranged from                            
                    approximately 0.9263 to 0.9463, with an                     
                    overall out-of-fold ROC AUC of 0.9367,                      
                    indicating strong performance in                            
                    classifying malignant vs benign                             
                    lesions. The model weights were saved                       
                    correctly, and a prediction function is                     
                    provided for inference on new images.                       
                    Validation Metric: 0.9367                                   
                                                                                
                    -------------------------------                             
                    Design: I propose adding RandomErasing                      
                    augmentation to the training pipeline                       
                    to improve robustness to occlusions and                     
                    color variations. This atomic change                        
                    only modifies the train_transform,                          
                    inserting a RandomErasing step after                        
                    normalization. The rest of the 5‐fold                       
                    CV ensembling pipeline remains                              
                    unchanged to isolate the effect of this                     
                    augmentation. We retrain the models and                     
                    report updated fold and overall ROC                         
                    AUC.                                                        
