                                continue                                        
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                            t =                                                 
                    transform(img).unsqueeze(0).to(device)                      
                            t_flipped = torch.flip(t,                           
                    dims=[3])                                                   
                            probs = []                                          
                            with torch.no_grad():                               
                                for m in models:                                
                                    logit1 = m(t).item()                        
                                    logit2 =                                    
                    m(t_flipped).item()                                         
                                    avg_logit = 0.5 *                           
                    (logit1 + logit2)                                           
                                    probs.append(1 / (1 +                       
                    np.exp(-avg_logit)))                                        
                            results[fname] =                                    
                    float(np.mean(probs))                                       
                        return results                                          
                                                                                
