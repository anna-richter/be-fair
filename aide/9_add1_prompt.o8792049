                    torch.optim.lr_scheduler.StepLR(optimiz                     
                    er, step_size=2, gamma=0.1)                                 
                                                                                
                        # Training loop                                         
                        for epoch in range(1, 6):                               
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device), targets.to(device)                         
                                optimizer.zero_grad()                           
                                outputs =                                       
                    model(imgs).squeeze(1)                                      
                                loss = criterion(outputs,                       
                    targets)                                                    
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            scheduler.step()                                    
                            print(f"Epoch {epoch} -                             
                    Training Loss:                                              
                    {running_loss/len(train_ds):.4f}")                          
                                                                                
                        # Validation with TTA (horizontal                       
                    flip)                                                       
                        model.eval()                                            
                        all_preds, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits1 =                                       
                    model(imgs).squeeze(1)                                      
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).squeeze(1)                                       
                                avg_logits = (logits1 +                         
                    logits2) / 2                                                
                                probs =                                         
                    torch.sigmoid(avg_logits).cpu().numpy()                     
                                all_preds.extend(probs.toli                     
                    st())                                                       
                                all_targets.extend(targets.                     
                    numpy().tolist())                                           
                        auc = roc_auc_score(all_targets,                        
                    all_preds)                                                  
                        print(f"Validation ROC AUC with                         
                    TTA: {auc:.4f}")                                            
                                                                                
                        # Save model                                            
                        os.makedirs("working",                                  
