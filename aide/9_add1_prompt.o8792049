                            ema_model.to(device)                                
                            for p in                                            
                    ema_model.parameters():                                     
                                p.requires_grad_(False)                         
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            scheduler =                                         
                    torch.optim.lr_scheduler.StepLR(optimiz                     
                    er, step_size=2, gamma=0.1)                                 
                                                                                
                            for epoch in range(1, 6):                           
                                model.train()                                   
                                running_loss = 0.0                              
                                for imgs, targets in                            
                    train_loader:                                               
                                    imgs, targets =                             
                    imgs.to(device), targets.to(device)                         
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, targets)                             
                                    optimizer.zero_grad()                       
                                    outputs =                                   
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(outputs, y_a) + (1 - lam) *                       
                    criterion(                                                  
                                        outputs, y_b                            
                                    )                                           
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item() * imgs.size(0)                                  
                                    # EMA update                                
                                    with torch.no_grad():                       
                                        for ema_p, p in                         
                    zip(ema_model.parameters(),                                 
                    model.parameters()):                                        
                                            ema_p.mul_(ema_                     
                    decay).add_(p.data, alpha=1 -                               
                    ema_decay)                                                  
                                scheduler.step()                                
                                print(f"Fold {fold} Epoch                       
                    {epoch} - Loss:                                             
                    {running_loss/len(train_ds):.4f}")                          
                                                                                
                            # Validation with EMA model +                       
                    horizontal-flip TTA                                         
                            ema_model.eval()                                    
                            with torch.no_grad():                               
                                for imgs, targets, idxs in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    imgs_flipped =                              
                    torch.flip(imgs, dims=[3])                                  
                                    logits1 =                                   
                    ema_model(imgs).squeeze(1)                                  
                                    logits2 =                                   
                    ema_model(imgs_flipped).squeeze(1)                          
                                    logits = 0.5 * (logits1                     
                    + logits2)                                                  
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy()                         
                                    oof_preds[idxs.numpy()]                     
                    = probs                                                     
                            fold_auc =                                          
                    roc_auc_score(df.target.iloc[val_idx],                      
                    oof_preds[val_idx])                                         
                            print(f"Fold {fold} ROC AUC:                        
                    {fold_auc:.4f}")                                            
                            torch.save(ema_model.state_dict                     
                    (),                                                         
                    f"working/model_fold{fold}_ema.pth")                        
                                                                                
                        overall_auc =                                           
                    roc_auc_score(df.target.values,                             
                    oof_preds)                                                  
                        print(f"Overall OOF ROC AUC:                            
                    {overall_auc:.4f}")                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
