                    logits2) / 2.0                                              
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_preds.extend(probs.tol                      
                    ist())                                                      
                                all_targets.extend(targets                      
                    .numpy().tolist())                                          
                        auc = roc_auc_score(all_targets,                        
                    all_preds)                                                  
                        print(f"Validation ROC AUC with                         
                    TTA: {auc:.4f}")                                            
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
