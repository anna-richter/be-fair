                    import os                                                   
                    import joblib                                               
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    import torch                                                
                    from torch import nn                                        
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import timm                                                 
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import lightgbm as lgb                                      
                                                                                
                    # Paths                                                     
                    CSV_PATH = "./input/mydataset.csv"                          
                    IMAGE_DIR = "./input/MyImages"                              
                    MODEL_PATH = "./working/lgb_model.pkl"                      
                                                                                
                    # Dataset for feature extraction                            
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            img_name = self.df.loc[idx,                         
                    "image_name"] + ".jpg"                                      
                            path =                                              
                    os.path.join(self.img_dir, img_name)                        
                            image =                                             
                    Image.open(path).convert("RGB")                             
                            return self.transform(image),                       
                    idx                                                         
                                                                                
                    def build_feature_extractor(device):                        
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        # remove classifier                                     
                        if hasattr(model, "classifier"):                        
                            model.classifier =                                  
                    nn.Identity()                                               
                        elif hasattr(model, "fc"):                              
                            model.fc = nn.Identity()                            
                        model.eval()                                            
                        model.to(device)                                        
                        return model                                            
                                                                                
                    def extract_features(model,                                 
                    dataloader, device, feat_dim):                              
                        features =                                              
                    np.zeros((len(dataloader.dataset),                          
                    feat_dim), dtype=np.float32)                                
                        with torch.no_grad():                                   
                            for imgs, idxs in dataloader:                       
                                imgs = imgs.to(device)                          
                                feats = model(imgs)                             
                                feats =                                         
                    feats.cpu().numpy()                                         
                                for i, idx in                                   
                    enumerate(idxs):                                            
                                    features[idx] =                             
                    feats[i]                                                    
                        return features                                         
                                                                                
                    def main():                                                 
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        # Transforms                                            
                        transform = transforms.Compose([                        
                            transforms.Resize(256),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=(0.4                      
                    85, 0.456, 0.406),                                          
                                                 std=(0.22                      
                    9, 0.224, 0.225)),                                          
                        ])                                                      
                        # Feature extractor                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        feat_extractor =                                        
                    build_feature_extractor(device)                             
                        # DataLoader                                            
                        dataset = SkinLesionDataset(df,                         
                    IMAGE_DIR, transform)                                       
                        loader = DataLoader(dataset,                            
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                        # Determine feature dimension                           
                        sample = torch.zeros(1, 3, 224,                         
                    224).to(device)                                             
                        with torch.no_grad():                                   
                            feat_dim =                                          
                    feat_extractor(sample).shape[1]                             
                        X =                                                     
                    extract_features(feat_extractor,                            
                    loader, device, feat_dim)                                   
                        y = df["target"].values                                 
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, val_idx in                               
                    skf.split(X, y):                                            
                            clf = lgb.LGBMClassifier(                           
                                n_estimators=1000,                              
                    learning_rate=0.05, random_state=42                         
                            )                                                   
                            clf.fit(                                            
                                X[train_idx],                                   
                                y[train_idx],                                   
                                eval_set=[(X[val_idx],                          
                    y[val_idx])],                                               
                                eval_metric="auc",                              
                                callbacks=[lgb.early_stopp                      
                    ing(stopping_rounds=50),                                    
                                           lgb.log_evaluat                      
                    ion(period=0)],                                             
                            )                                                   
                            preds =                                             
                    clf.predict_proba(X[val_idx])[:, 1]                         
                            aucs.append(roc_auc_score(y[va                      
                    l_idx], preds))                                             
                        mean_auc = np.mean(aucs)                                
                        print(f"Mean CV AUROC:                                  
                    {mean_auc:.4f}")                                            
                        # Retrain on full data                                  
                        final_clf = lgb.LGBMClassifier(                         
                            n_estimators=1000,                                  
                    learning_rate=0.05, random_state=42                         
                        )                                                       
                        final_clf.fit(X, y)                                     
                        # Save model                                            
                        os.makedirs(os.path.dirname(MODEL_                      
                    PATH), exist_ok=True)                                       
                        joblib.dump(final_clf, MODEL_PATH)                      
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path.                                   
                        Returns a dict: {filename:                              
                    probability}.                                               
                        """                                                     
                        model = joblib.load(MODEL_PATH)                         
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        feat_extractor =                                        
                    build_feature_extractor(device)                             
                        transform = transforms.Compose([                        
                            transforms.Resize(256),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=(0.4                      
                    85, 0.456, 0.406),                                          
                                                 std=(0.22                      
                    9, 0.224, 0.225)),                                          
                        ])                                                      
                        files = [f for f in                                     
                    os.listdir(folder_path) if                                  
                    f.lower().endswith(".jpg")]                                 
                        files.sort()                                            
                        class FolderDataset(Dataset):                           
                            def __init__(self, files,                           
                    img_dir, transform):                                        
                                self.files = files                              
                                self.img_dir = img_dir                          
                                self.transform = transform                      
                            def __len__(self):                                  
                                return len(self.files)                          
                            def __getitem__(self, idx):                         
                                fn = self.files[idx]                            
                                img =                                           
                    Image.open(os.path.join(self.img_dir,                       
                    fn)).convert("RGB")                                         
                                return                                          
                    self.transform(img), idx                                    
                        ds = FolderDataset(files,                               
                    folder_path, transform)                                     
                        dl = DataLoader(ds, batch_size=64,                      
                    shuffle=False, num_workers=4)                               
                        with torch.no_grad():                                   
                            feats = []                                          
                            for imgs, _ in dl:                                  
                                imgs = imgs.to(device)                          
                                out =                                           
                    feat_extractor(imgs).cpu().numpy()                          
                                feats.append(out)                               
                            feats = np.vstack(feats)                            
                        probs =                                                 
                    model.predict_proba(feats)[:, 1]                            
                        return {files[i]: float(probs[i])                       
                    for i in range(len(files))}                                 
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
