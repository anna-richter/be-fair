                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                                                                                
                        results = {}                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    os.listdir(folder_path):                                    
                                if not                                          
