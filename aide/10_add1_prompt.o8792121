                    ./working/efficientnet_b3_cutmix.pth",                      
                     map_location=device))                                      
                        model.to(device).eval()                                 
                        mean = [0.485, 0.456, 0.406]; std                       
                    = [0.229, 0.224, 0.225]                                     
                        tta_transform =                                         
                    transforms.Compose([                                        
                            transforms.Resize(320),                             
                            transforms.TenCrop(300),                            
                            transforms.Lambda(lambda                            
                    crops: torch.stack([                                        
                                transforms.Normalize(mean,                      
                    std)(transforms.ToTensor()(crop)) for                       
                    crop in crops                                               
                            ])),                                                
                        ])                                                      
                        results = {}                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    os.listdir(folder_path):                                    
                                if not                                          
                    fname.lower().endswith((".jpg",".png")                      
                    ): continue                                                 
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                crops = tta_transform(img)                      
                                bs, c, h, w = crops.size()                      
                                inputs = crops.to(device)                       
                                outputs = model(inputs)                         
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs)                       
                                results[fname] =                                
                    probs.mean().item()                                         
