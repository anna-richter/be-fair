                        tta_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(288),                         
                                transforms.TenCrop(260),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                                                                                
                        results = {}                                            
                        with torch.no_grad():                                   
