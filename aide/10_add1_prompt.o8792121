                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.linear_model import                            
                    LogisticRegression                                          
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import joblib                                               
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # Dataset for image feature extraction                      
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = row.target                                  
                            return img, label                                   
                                                                                
                                                                                
                    # Read metadata and prepare targets                         
                    df =                                                        
                    pd.read_csv("./input/mydataset.csv")                        
                    df["target"] = df.label.apply(lambda x:                     
                    1 if x == "malignant" else 0)                               
                    train_df, val_df = train_test_split(                        
                        df, test_size=0.2,                                      
                    stratify=df["target"], random_state=42                      
                    )                                                           
                                                                                
                    # Transforms and DataLoaders                                
                    transform = transforms.Compose(                             
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.48                     
                    5, 0.456, 0.406], std=[0.229, 0.224,                        
                    0.225]),                                                    
                        ]                                                       
                    )                                                           
                    train_ds = SkinLesionDataset(train_df,                      
                    "./input/MyImages", transform)                              
                    val_ds = SkinLesionDataset(val_df,                          
                    "./input/MyImages", transform)                              
                    train_loader = DataLoader(train_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                    val_loader = DataLoader(val_ds,                             
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                    # Prepare feature extractor                                 
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    resnet =                                                    
                    models.resnet18(pretrained=True)                            
                    modules = list(resnet.children())[:-1]                      
                    # drop final fc                                             
                    encoder =                                                   
                    torch.nn.Sequential(*modules).to(device                     
                    )                                                           
                    encoder.eval()                                              
                                                                                
                                                                                
                    def extract_features(loader):                               
                        feats = []                                              
                        labels = []                                             
                        with torch.no_grad():                                   
                            for imgs, lbls in loader:                           
                                imgs = imgs.to(device)                          
                                out = encoder(imgs)  #                          
                    [B,512,1,1]                                                 
                                out = out.view(out.size(0),                     
                    -1).cpu().numpy()                                           
                                feats.append(out)                               
                                labels.extend(lbls.numpy())                     
                        return np.vstack(feats),                                
                    np.array(labels)                                            
                                                                                
                                                                                
                    # Extract features                                          
                    X_train, y_train =                                          
                    extract_features(train_loader)                              
                    X_val, y_val =                                              
                    extract_features(val_loader)                                
                                                                                
                    # Train logistic regression                                 
                    clf = LogisticRegression(max_iter=1000,                     
                    class_weight="balanced")                                    
                    clf.fit(X_train, y_train)                                   
                                                                                
                    # Validate                                                  
                    probs = clf.predict_proba(X_val)[:, 1]                      
                    auc = roc_auc_score(y_val, probs)                           
                    print("Validation AUROC:", auc)                             
                                                                                
                    # Save models                                               
                    os.makedirs("./working", exist_ok=True)                     
                    joblib.dump(clf,                                            
                    "./working/logistic_model.pkl")                             
                    torch.save(encoder.state_dict(),                            
                    "./working/encoder.pth")                                    
                                                                                
                                                                                
                    def predict(image_folder):                                  
                        """                                                     
                        Predict malignancy probability for                      
                    all .jpg images in image_folder.                            
                        Returns a DataFrame with columns:                       
                    image_name, malignancy_prob.                                
                        """                                                     
                        # load models                                           
                        clf =                                                   
                    joblib.load("./working/logistic_model.p                     
                    kl")                                                        
                        encoder =                                               
                    models.resnet18(pretrained=False)                           
                        modules =                                               
                    list(encoder.children())[:-1]                               
                        encoder =                                               
                    torch.nn.Sequential(*modules).to(device                     
                    )                                                           
                        encoder.load_state_dict(torch.load(                     
                    "./working/encoder.pth"))                                   
                        encoder.eval()                                          
                        # prepare transforms                                    
                        tfm = transforms.Compose(                               
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        # collect images                                        
                        imgs = []                                               
                        names = []                                              
                        for fname in                                            
                    os.listdir(image_folder):                                   
                            if                                                  
                    fname.lower().endswith(".jpg"):                             
                                img =                                           
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                imgs.append(tfm(img))                           
                                names.append(os.path.splite                     
                    xt(fname)[0])                                               
                        if not imgs:                                            
                            return                                              
                    pd.DataFrame(columns=["image_name",                         
                    "malignancy_prob"])                                         
                        batch =                                                 
                    torch.stack(imgs).to(device)                                
                        with torch.no_grad():                                   
                            feats =                                             
                    encoder(batch).view(len(imgs),                              
                    -1).cpu().numpy()                                           
                        probs = clf.predict_proba(feats)[:,                     
                    1]                                                          
                        return pd.DataFrame({"image_name":                      
                    names, "malignancy_prob": probs})                           
                                                                                
                                                                                
                    # Example usage (uncomment to run on                        
                    new data):                                                  
                    # preds = predict("./input/MyImages")                       
                    #                                                           
                    preds.to_csv("./working/submission.csv"                     
                    , index=False)                                              
                                                                                
                    Results: The code successfully trained                      
                    a logistic regression classifier on                         
                    features extracted from a pretrained                        
                    ResNet18 model. The validation AUROC                        
                    achieved was approximately 0.827,                           
                    indicating good discriminative                              
                    performance for classifying malignant                       
                    versus benign skin lesions. The feature                     
                    extraction and prediction pipeline are                      
                    properly implemented and the model                          
                    artifacts are saved for future                              
                    inference.                                                  
                    Validation Metric: 0.8267397310127925                       
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    EfficientNet-B0 by replacing its                            
                    classifier with a binary output layer                       
                    and train it to predict malignancy                          
                    using binary cross-entropy loss. We                         
                    split the dataset into stratified 80/20                     
                    train/validation sets, apply data                           
                    augmentations (random resized crops,                        
                    flips, rotations, color jitter) during                      
                    training and standard resizing/cropping                     
                    for validation, and train for 5 epochs                      
                    with the Adam optimizer. After training                     
                    we evaluate performance via AUROC on                        
                    the validation set, save the trained                        
                    model, and provide a                                        
                    predict(folder_path) function that                          
                    returns malignancy probabilities for                        
                    new images.                                                 
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import torchvision.models as models                         
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = 1 if row["label"] ==                        
                    "malignant" else 0                                          
                            return image, label                                 
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder.                                     
                        Args:                                                   
                            folder_path (str): Path to                          
                    folder containing images (jpg/png).                         
                        Returns:                                                
                            dict: mapping image filename to                     
                    malignancy probability (0-1).                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.efficientnet_b0(pretrained=False                     
                    )                                                           
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.load_state_dict(                                  
                            torch.load("./working/efficient                     
                    net_model.pth", map_location=device)                        
                        )                                                       
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            img =                                               
                    transform(img).unsqueeze(0).to(device)                      
                            with torch.no_grad():                               
                                prob =                                          
                    torch.sigmoid(model(img)).item()                            
                            results[fname] = prob                               
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Load and split data                                   
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label"] =                                           
                    df["label"].astype(str)                                     
                        df["binary"] =                                          
                    df["label"].apply(lambda x: 1 if x ==                       
                    "malignant" else 0)                                         
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, stratify=df["binary"],                          
                    test_size=0.2, random_state=42                              
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
                                transforms.ColorJitter(brig                     
                    htness=0.2, contrast=0.2,                                   
                    saturation=0.2),                                            
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds = SkinDataset(train_df,                        
                    "./input/MyImages", train_transform)                        
                        val_ds = SkinDataset(val_df,                            
                    "./input/MyImages", val_transform)                          
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.efficientnet_b0(pretrained=True)                     
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Training loop                                         
                        for epoch in range(5):                                  
                            model.train()                                       
                            for images, labels in                               
                    tqdm(train_loader, desc=f"Epoch                             
                    {epoch+1}/5"):                                              
                                images, labels =                                
                    images.to(device),                                          
                    labels.float().unsqueeze(1).to(device)                      
                                optimizer.zero_grad()                           
                                outputs = model(images)                         
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
                    val_loader:                                                 
                                images = images.to(device)                      
                                outputs = model(images)                         
                                probs =                                         
                    torch.sigmoid(outputs).cpu().numpy().fl                     
                    atten()                                                     
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                        # Save model                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "./working/efficientnet_model.pth")                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs on the                       
                    skin lesion dataset using                                   
                    EfficientNet-B0, achieving a strong                         
                    validation AUROC of 0.9165, indicating                      
                    good discriminative performance for                         
                    malignancy classification. The script                       
                    also includes a prediction function                         
                    that loads the saved model and returns                      
                    malignancy probabilities for new                            
                    images.                                                     
                    Validation Metric: 0.9165                                   
                                                                                
                    -------------------------------                             
                    Design: We compute simple color-based                       
                    features (channel means, standard                           
                    deviations, and histograms) for each                        
                    image plus available metadata                               
                    (skin_tone, alternative_skin_tone) and                      
                    binarize the target as malignant vs.                        
                    non-malignant. We train a LightGBM                          
                    classifier using stratified 5‐fold                          
                    cross‐validation to optimize AUROC,                         
                    report the mean CV AUROC, then retrain                      
                    on the full dataset. A                                      
                    `predict(folder_path)` function loads                       
                    the final model and returns malignancy                      
                    probabilities for new images. The                           
                    script prints the average CV AUROC.                         
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from lightgbm import LGBMClassifier                         
                    import pickle                                               
                                                                                
                                                                                
                    # Feature extraction: color statistics                      
                    + histograms + metadata                                     
                    def extract_features(image_path):                           
                        img =                                                   
                    Image.open(image_path).convert("RGB")                       
                        arr = np.array(img)                                     
                        feats = []                                              
                        # channel means and stds                                
                        means = arr.mean(axis=(0, 1))                           
                        stds = arr.std(axis=(0, 1))                             
                        feats.extend(means.tolist())                            
                        feats.extend(stds.tolist())                             
                        # histograms: 16 bins per channel                       
                        for c in range(3):                                      
                            hist, _ = np.histogram(arr[:,                       
                    :, c], bins=16, range=(0, 255),                             
                    density=True)                                               
                            feats.extend(hist.tolist())                         
                        return feats                                            
                                                                                
                                                                                
                    # Main script                                               
                    df = pd.read_csv("input/mydataset.csv")                     
                    # Binarize target: malignant=1 else 0                       
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                                                                                
                    # Extract features for all images                           
                    feature_list = []                                           
                    for idx, row in df.iterrows():                              
                        img_path = os.path.join("input",                        
                    "MyImages", f"{row['image_name']}.jpg")                     
                        feats = extract_features(img_path)                      
                        # add metadata                                          
                        feats.append(row["skin_tone"])                          
                        feats.append(row["alternative_skin_                     
                    tone"])                                                     
                        feature_list.append(feats)                              
                    X = np.array(feature_list)                                  
                    y = df["target"].values                                     
                                                                                
                    # 5‐fold stratified CV                                      
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for train_idx, val_idx in skf.split(X,                      
                    y):                                                         
                        X_train, X_val = X[train_idx],                          
                    X[val_idx]                                                  
                        y_train, y_val = y[train_idx],                          
                    y[val_idx]                                                  
                        clf =                                                   
                    LGBMClassifier(n_estimators=100,                            
                    learning_rate=0.1, random_state=42)                         
                        clf.fit(X_train, y_train)                               
                        preds = clf.predict_proba(X_val)[:,                     
                    1]                                                          
                        auc = roc_auc_score(y_val, preds)                       
                        aucs.append(auc)                                        
                    print(f"Mean CV AUROC:                                      
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # Retrain on full data                                      
                    final_clf =                                                 
                    LGBMClassifier(n_estimators=100,                            
                    learning_rate=0.1, random_state=42)                         
                    final_clf.fit(X, y)                                         
                    # Save model                                                
                    with                                                        
                    open("working/lightgbm_skin_lesion.pkl"                     
                    , "wb") as f:                                               
                        pickle.dump(final_clf, f)                               
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Given a folder of images, returns a                     
                    dict mapping image filename to                              
                        malignancy probability [0-1].                           
                        """                                                     
                        # load model                                            
                        with                                                    
                    open("working/lightgbm_skin_lesion.pkl"                     
                    , "rb") as f:                                               
                            model = pickle.load(f)                              
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg", ".png",                     
                    ".jpeg")):                                                  
                                path =                                          
                    os.path.join(folder_path, fname)                            
                                feats =                                         
                    extract_features(path)                                      
                                # assume metadata unknown                       
                    => set to -1                                                
                                feats.append(-1)  #                             
                    skin_tone unknown                                           
                                feats.append(-1)  #                             
                    alternative_skin_tone unknown                               
                                prob =                                          
                    model.predict_proba([feats])[0, 1]                          
                                results[fname] = prob                           
                        return results                                          
                                                                                
                                                                                
                    # Example usage of predict (uncomment                       
                    to run on new folder)                                       
                    # preds = predict('input/MyImages')                         
                    # print(preds)                                              
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained using 5-fold                              
                    stratified cross-validation, achieving                      
                    a mean AUROC of approximately 0.711,                        
                    indicating moderate predictive                              
                    performance. The final model was                            
                    retrained on the full dataset and saved                     
                    for future use. The prediction function                     
                    correctly loads the saved model and                         
                    extracts features from new images to                        
                    output malignancy probabilities.                            
                    Validation Metric: 0.7109                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    DenseNet-121 by replacing its                               
                    classifier with a binary output, using                      
                    stratified train/validation split and                       
                    balanced BCE loss to address class                          
                    imbalance. During training we apply                         
                    data augmentation (random resized                           
                    crops, flips, rotations, color jitter)                      
                    and standard resizing for validation,                       
                    optimizing with Adam. We monitor AUROC                      
                    on the validation set and save the best                     
                    model. A predict(folder_path) function                      
                    loads the saved model and returns                           
                    malignancy probabilities for new                            
                    images. We report the validation AUROC                      
                    after training.                                             
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, images_dir,                      
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.images_dir = images_dir                        
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.loc[idx]                              
                            img_path =                                          
                    os.path.join(self.images_dir,                               
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(folder_path,                                    
                    model_path="working/densenet121_best.pt                     
                    ", batch_size=32):                                          
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        tf = T.Compose(                                         
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        imgs = sorted([f for f in                               
                    os.listdir(folder_path) if                                  
                    f.lower().endswith(".jpg")])                                
                        probs = []                                              
                        with torch.no_grad():                                   
                            for i in range(0, len(imgs),                        
                    batch_size):                                                
                                batch = imgs[i : i +                            
                    batch_size]                                                 
                                x = torch.stack(                                
                                    [                                           
                                        tf(Image.open(os.pa                     
                    th.join(folder_path,                                        
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                logits =                                        
                    model(x).squeeze(1)                                         
                                probs.extend(torch.sigmoid(                     
                    logits).cpu().numpy())                                      
                        return pd.DataFrame({"image_name":                      
                    imgs, "malignancy_prob": probs})                            
                                                                                
                                                                                
                    # Main                                                      
                    def main():                                                 
                        # Load data                                             
                        df =                                                    
                    pd.read_csv("input/mydataset.csv")                          
                        # Binary label                                          
                        df["label_bin"] = (df.label ==                          
                    "malignant").astype(int)                                    
                        # Split                                                 
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["label_bin"],                                   
                    random_state=42                                             
                        )                                                       
                        # Transforms                                            
                        train_tf = T.Compose(                                   
                            [                                                   
                                T.RandomResizedCrop(224),                       
                                T.RandomHorizontalFlip(),                       
                                T.RandomRotation(15),                           
                                T.ColorJitter(0.1, 0.1,                         
                    0.1, 0.1),                                                  
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_tf = T.Compose(                                     
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        train_ds =                                              
                    SkinLesionDataset(train_df,                                 
                    "input/MyImages", transform=train_tf)                       
                        val_ds = SkinLesionDataset(val_df,                      
                    "input/MyImages", transform=val_tf)                         
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(device)                                
                                                                                
                        # Loss with pos_weight                                  
                        pos = train_df["label_bin"].sum()                       
                        neg = len(train_df) - pos                               
                        pos_weight = torch.tensor([neg /                        
                    pos], device=device)                                        
                        criterion =                                             
                    nn.BCEWithLogitsLoss(pos_weight=pos_wei                     
                    ght)                                                        
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=1e-4)                     
                                                                                
                        best_auc = 0.0                                          
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        # Train                                                 
                        for epoch in range(1, 6):                               
                            model.train()                                       
                            for imgs, lbls in train_loader:                     
                                imgs, lbls =                                    
                    imgs.to(device), lbls.to(device)                            
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    lbls)                                                       
                                loss.backward()                                 
                                optimizer.step()                                
                            # Validate                                          
                            model.eval()                                        
                            all_logits, all_lbls = [], []                       
                            with torch.no_grad():                               
                                for imgs, lbls in                               
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1).cpu().numpy()                        
                                    all_logits.extend(logit                     
                    s)                                                          
                                    all_lbls.extend(lbls.nu                     
                    mpy())                                                      
                            probs = 1 / (1 +                                    
                    np.exp(-np.array(all_logits)))                              
                            auc = roc_auc_score(all_lbls,                       
                    probs)                                                      
                            print(f"Epoch {epoch}: val                          
                    AUROC = {auc:.4f}")                                         
                            if auc > best_auc:                                  
                                best_auc = auc                                  
                                torch.save(model.state_dict                     
                    (), "working/densenet121_best.pt")                          
                                                                                
                        print(f"Best validation AUROC:                          
                    {best_auc:.4f}")                                            
                                                                                
                        # Example usage of predict()                            
                        # preds = predict('input/MyImages')                     
                    # uncomment to run prediction on input                      
                    images                                                      
                        #                                                       
                    preds.to_csv('working/submission.csv',                      
                    index=False)                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without any errors. The                        
                    DenseNet121 model was trained on the                        
                    skin lesion dataset with appropriate                        
                    data augmentations and class imbalance                      
                    handling using pos_weight in                                
                    BCEWithLogitsLoss. The validation AUROC                     
                    improved steadily over epochs, reaching                     
                    a best score of 0.9026, indicating good                     
                    discriminative performance for                              
                    malignancy classification. The provided                     
                    predict function loads the saved best                       
                    model and returns malignancy                                
                    probabilities for new images,                               
                    fulfilling the task requirements.                           
                    Validation Metric: 0.9026                                   
                                                                                
                    -------------------------------                             
                    Design: We update the LightGBM fit                          
                    calls to use the callbacks API for                          
                    early stopping instead of the                               
                    unsupported `early_stopping_rounds`                         
                    argument. Specifically, we pass                             
                    `callbacks=[lgb.early_stopping(50),                         
                    lgb.log_evaluation(0)]` to silence                          
                    verbose output and enable stopping. The                     
                    rest of the pipeline (feature                               
                    extraction, cross‐validation, final                         
                    training, and `predict` function)                           
                    remains unchanged, and we print the                         
                    mean CV AUROC at the end.                                   
                    Code: import os                                             
                    import joblib                                               
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    import torch                                                
                    from torch import nn                                        
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import timm                                                 
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import lightgbm as lgb                                      
                                                                                
                    # Paths                                                     
                    CSV_PATH = "./input/mydataset.csv"                          
                    IMAGE_DIR = "./input/MyImages"                              
                    MODEL_PATH = "./working/lgb_model.pkl"                      
                                                                                
                                                                                
                    # Dataset for feature extraction                            
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            img_name = self.df.loc[idx,                         
                    "image_name"] + ".jpg"                                      
                            path =                                              
                    os.path.join(self.img_dir, img_name)                        
                            image =                                             
                    Image.open(path).convert("RGB")                             
                            return self.transform(image),                       
                    idx                                                         
                                                                                
                                                                                
                    def build_feature_extractor(device):                        
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        # remove classifier                                     
                        if hasattr(model, "classifier"):                        
                            model.classifier =                                  
                    nn.Identity()                                               
                        elif hasattr(model, "fc"):                              
                            model.fc = nn.Identity()                            
                        model.eval()                                            
                        model.to(device)                                        
                        return model                                            
                                                                                
                                                                                
                    def extract_features(model, dataloader,                     
                    device, feat_dim):                                          
                        features =                                              
                    np.zeros((len(dataloader.dataset),                          
                    feat_dim), dtype=np.float32)                                
                        with torch.no_grad():                                   
                            for imgs, idxs in dataloader:                       
                                imgs = imgs.to(device)                          
                                feats = model(imgs)                             
                                feats = feats.cpu().numpy()                     
                                for i, idx in                                   
                    enumerate(idxs):                                            
                                    features[idx] =                             
                    feats[i]                                                    
                        return features                                         
                                                                                
                                                                                
                    def main():                                                 
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        # Transforms                                            
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                        # Feature extractor                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        feat_extractor =                                        
                    build_feature_extractor(device)                             
                        # DataLoader                                            
                        dataset = SkinLesionDataset(df,                         
                    IMAGE_DIR, transform)                                       
                        loader = DataLoader(dataset,                            
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                        # Determine feature dimension                           
                        sample = torch.zeros(1, 3, 224,                         
                    224).to(device)                                             
                        with torch.no_grad():                                   
                            feat_dim =                                          
                    feat_extractor(sample).shape[1]                             
                        X =                                                     
                    extract_features(feat_extractor,                            
                    loader, device, feat_dim)                                   
                        y = df["target"].values                                 
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, val_idx in                               
                    skf.split(X, y):                                            
                            clf =                                               
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05, random_state=42)                        
                            clf.fit(                                            
                                X[train_idx],                                   
                                y[train_idx],                                   
                                eval_set=[(X[val_idx],                          
                    y[val_idx])],                                               
                                eval_metric="auc",                              
                                callbacks=[                                     
                                    lgb.early_stopping(stop                     
                    ping_rounds=50),                                            
                                    lgb.log_evaluation(peri                     
                    od=0),                                                      
                                ],                                              
                            )                                                   
                            preds =                                             
                    clf.predict_proba(X[val_idx])[:, 1]                         
                            aucs.append(roc_auc_score(y[val                     
                    _idx], preds))                                              
                        mean_auc = np.mean(aucs)                                
                        print(f"Mean CV AUROC:                                  
                    {mean_auc:.4f}")                                            
                        # Retrain on full data                                  
                        final_clf = lgb.LGBMClassifier(                         
                            n_estimators=1000,                                  
                    learning_rate=0.05, random_state=42                         
                        )                                                       
                        final_clf.fit(X, y)                                     
                        # Save model                                            
                        os.makedirs(os.path.dirname(MODEL_P                     
                    ATH), exist_ok=True)                                        
                        joblib.dump(final_clf, MODEL_PATH)                      
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each .jpg in folder_path.                                   
                        Returns a dict: {filename:                              
                    probability}.                                               
                        """                                                     
                        model = joblib.load(MODEL_PATH)                         
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        feat_extractor =                                        
                    build_feature_extractor(device)                             
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=(                     
                    0.485, 0.456, 0.406), std=(0.229,                           
                    0.224, 0.225)),                                             
                            ]                                                   
                        )                                                       
                        files = [f for f in                                     
                    os.listdir(folder_path) if                                  
                    f.lower().endswith(".jpg")]                                 
                        files.sort()                                            
                                                                                
                        class FolderDataset(Dataset):                           
                            def __init__(self, files,                           
                    img_dir, transform):                                        
                                self.files = files                              
                                self.img_dir = img_dir                          
                                self.transform = transform                      
                                                                                
                            def __len__(self):                                  
                                return len(self.files)                          
                                                                                
                            def __getitem__(self, idx):                         
                                fn = self.files[idx]                            
                                img =                                           
                    Image.open(os.path.join(self.img_dir,                       
                    fn)).convert("RGB")                                         
                                return self.transform(img),                     
                    idx                                                         
                                                                                
                        ds = FolderDataset(files,                               
                    folder_path, transform)                                     
                        dl = DataLoader(ds, batch_size=64,                      
                    shuffle=False, num_workers=4)                               
                        with torch.no_grad():                                   
                            feats = []                                          
                            for imgs, _ in dl:                                  
                                imgs = imgs.to(device)                          
                                out =                                           
                    feat_extractor(imgs).cpu().numpy()                          
                                feats.append(out)                               
                            feats = np.vstack(feats)                            
                        probs =                                                 
                    model.predict_proba(feats)[:, 1]                            
                        return {files[i]: float(probs[i])                       
                    for i in range(len(files))}                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    uses EfficientNet-B0 pretrained on                          
                    ImageNet as a feature extractor and                         
                    trains a LightGBM classifier on the                         
                    extracted features with 5-fold                              
                    stratified cross-validation. The mean                       
                    cross-validation AUROC achieved is                          
                    approximately 0.8831, indicating good                       
                    discriminative performance for                              
                    classifying malignant vs benign skin                        
                    lesions. The final model is retrained                       
                    on the full dataset and saved for                           
                    inference. The prediction function is                       
                    implemented to extract features and                         
                    predict malignancy probabilities on new                     
                    images.                                                     
                    Validation Metric: 0.8831                                   
                                                                                
                    -------------------------------                             
                    Design: We'll replace the single 80/20                      
                    split with 5‐fold stratified                                
                    cross‐validation, training                                  
                    EfficientNet-B0 for each fold and                           
                    computing per‐fold AUROCs. We train                         
                    each fold for 3 epochs to keep runtime                      
                    reasonable, save each fold model, and                       
                    then average their predictions at                           
                    inference for better generalization.                        
                    The script prints the mean CV AUROC and                     
                    defines a `predict(folder_path)`                            
                    function that loads the 5 saved models                      
                    and returns ensemble malignancy                             
                    probabilities for new images.                               
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import torchvision.models as models                         
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary"]                               
                            return image, label                                 
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder by ensembling 5                      
                    fold models.                                                
                        Args:                                                   
                            folder_path (str): Path to                          
                    folder containing images (jpg/png).                         
                        Returns:                                                
                            dict: mapping image filename to                     
                    malignancy probability (0-1).                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # prepare transforms                                    
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        # load models                                           
                        models_list = []                                        
                        for fold in range(5):                                   
                            m =                                                 
                    models.efficientnet_b0(pretrained=False                     
                    )                                                           
                            m.classifier[1] =                                   
                    nn.Linear(m.classifier[1].in_features,                      
                    1)                                                          
                            path =                                              
                    f"./working/efficientnet_model_fold{fol                     
                    d}.pth"                                                     
                            m.load_state_dict(torch.load(pa                     
                    th, map_location=device))                                   
                            m.to(device).eval()                                 
                            models_list.append(m)                               
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            x =                                                 
                    transform(img).unsqueeze(0).to(device)                      
                            with torch.no_grad():                               
                                preds = []                                      
                                for m in models_list:                           
                                    preds.append(torch.sigm                     
                    oid(m(x)).item())                                           
                                prob =                                          
                    float(np.mean(preds))                                       
                            results[fname] = prob                               
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # load data                                             
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary"] =                                          
                    df["label"].apply(lambda x: 1 if x ==                       
                    "malignant" else 0)                                         
                        img_dir = "./input/MyImages"                            
                                                                                
                        # transforms                                            
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
                                transforms.ColorJitter(brig                     
                    htness=0.2, contrast=0.2,                                   
                    saturation=0.2),                                            
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        fold_aucs = []                                          
                                                                                
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["binary"])):                     
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_transform)                                            
                            val_ds = SkinDataset(val_df,                        
                    img_dir, val_transform)                                     
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                            val_loader = DataLoader(val_ds,                     
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                            model =                                             
                    models.efficientnet_b0(pretrained=True)                     
                            model.classifier[1] =                               
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                            model.to(device)                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                            epochs = 3                                          
                            for epoch in range(epochs):                         
                                model.train()                                   
                                for images, labels in tqdm(                     
                                    train_loader,                               
                    desc=f"Fold {fold} Epoch                                    
                    {epoch+1}/{epochs}", leave=False                            
                                ):                                              
                                    images =                                    
                    images.to(device)                                           
                                    labels =                                    
                    labels.float().unsqueeze(1).to(device)                      
                                    optimizer.zero_grad()                       
                                    outputs = model(images)                     
                                    loss =                                      
                    criterion(outputs, labels)                                  
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            # validation with simple TTA                        
                    (horizontal flip)                                           
                            model.eval()                                        
                            all_labels, all_probs = [], []                      
                            with torch.no_grad():                               
                                for images, labels in                           
                    val_loader:                                                 
                                    images =                                    
                    images.to(device)                                           
                                    out1 =                                      
                    torch.sigmoid(model(images))                                
                                    flipped =                                   
                    torch.flip(images, dims=[3])                                
                                    out2 =                                      
                    torch.sigmoid(model(flipped))                               
                                    probs = ((out1 + out2)                      
                    / 2).cpu().numpy().flatten()                                
                                    all_probs.extend(probs.                     
                    tolist())                                                   
                                    all_labels.extend(label                     
                    s.numpy().tolist())                                         
                            auc = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                            torch.save(model.state_dict(),                      
                    f"./working/efficientnet_model_fold{fol                     
                    d}.pth")                                                    
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.mean(fold_aucs):.4f}")                                  
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script                                
                    successfully trained an EfficientNet-B0                     
                    model using 5-fold stratified                               
                    cross-validation on the skin lesion                         
                    dataset. The model was trained for 3                        
                    epochs per fold with data augmentation                      
                    and simple test-time augmentation. The                      
                    mean cross-validation AUROC achieved                        
                    was approximately 0.913, indicating                         
                    good performance in classifying                             
                    malignant versus benign lesions. The                        
                    trained models were saved for ensemble                      
                    prediction, and the prediction function                     
                    loads these models to average their                         
                    malignancy probability outputs. No bugs                     
                    or errors were observed during                              
                    execution.                                                  
                    Validation Metric: 0.9129                                   
                                                                                
                    -------------------------------                             
                    Design: We will add test-time                               
                    augmentation (TTA) by using                                 
                    torchvision’s TenCrop to generate ten                       
                    224×224 crops of each image during                          
                    validation and inference, normalize                         
                    each crop, average the model                                
                    predictions across the ten crops, and                       
                    thereby smooth and potentially improve                      
                    the AUROC. This atomic change only                          
                    modifies the validation and prediction                      
                    pipelines, leaving training unchanged.                      
                    The updated validation loop reshapes                        
                    the batched crops, runs them through                        
                    the model, applies sigmoid, reshapes                        
                    back to per‐image predictions, and                          
                    averages them. The `predict` function                       
                    is also updated to use TenCrop TTA for                      
                    inference.                                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import torchvision.models as models                         
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(image)                         
                            label = 1 if row["label"] ==                        
                    "malignant" else 0                                          
                            return img, label                                   
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder using TenCrop                        
                    TTA.                                                        
                        Args:                                                   
                            folder_path (str): Path to                          
                    folder containing images (jpg/png).                         
                        Returns:                                                
                            dict: mapping image filename to                     
                    malignancy probability (0-1).                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # Load model                                            
                        model =                                                 
                    models.efficientnet_b0(pretrained=False                     
                    )                                                           
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.load_state_dict(                                  
                            torch.load("./working/efficient                     
                    net_model.pth", map_location=device)                        
                        )                                                       
                        model.to(device).eval()                                 
                        # TTA transform: TenCrop + ToTensor                     
                    + Normalize                                                 
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        tta_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                        results = {}                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    os.listdir(folder_path):                                    
                                if not                                          
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                    continue                                    
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                crops = tta_transform(img)                      
                    # [10,3,224,224]                                            
                                bs, c, h, w = crops.size()                      
                                inputs = crops.to(device)                       
                                outputs = model(inputs)  #                      
                    [10,1]                                                      
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs)                       
                                results[fname] =                                
                    probs.mean().item()                                         
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Load and split data                                   
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label"] =                                           
                    df["label"].astype(str)                                     
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, stratify=df["label"],                           
                    test_size=0.2, random_state=42                              
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
                                transforms.ColorJitter(brig                     
                    htness=0.2, contrast=0.2,                                   
                    saturation=0.2),                                            
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # Validation TTA: TenCrop                               
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds = SkinDataset(train_df,                        
                    "./input/MyImages", train_transform)                        
                        val_ds = SkinDataset(val_df,                            
                    "./input/MyImages", val_transform)                          
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=16, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.efficientnet_b0(pretrained=True)                     
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Training loop                                         
                        for epoch in range(5):                                  
                            model.train()                                       
                            for images, labels in                               
                    tqdm(train_loader, desc=f"Epoch                             
                    {epoch+1}/5"):                                              
                                images, labels =                                
                    images.to(device),                                          
                    labels.float().unsqueeze(1).to(device)                      
                                optimizer.zero_grad()                           
                                outputs = model(images)                         
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
                    val_loader:                                                 
                                bs, ncrops, c, h, w =                           
                    images.size()                                               
                                imgs = images.view(-1, c,                       
                    h, w).to(device)                                            
                                outputs = model(imgs)                           
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs,                       
                    ncrops).mean(dim=1).numpy()                                 
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC with TTA:                      
                    {auc:.4f}")                                                 
                                                                                
                        # Save model                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "./working/efficientnet_model.pth")                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using                        
                    EfficientNet-B0 with appropriate data                       
                    augmentations and TenCrop test-time                         
                    augmentation (TTA) for validation. The                      
                    validation AUROC achieved was 0.9379,                       
                    indicating strong performance in                            
                    classifying malignant vs benign skin                        
                    lesions.                                                    
                    Validation Metric: 0.9379                                   
                                                                                
                    -------------------------------                             
                    Design: We integrate MixUp data                             
                    augmentation into the training loop                         
                    with an alpha of 0.4 to blend image                         
                    pairs and their labels, which can                           
                    improve generalization. We keep the                         
                    EfficientNet-B0 backbone and existing                       
                    TTA inference unchanged but modify the                      
                    training step to mix inputs and compute                     
                    a weighted loss. The rest of the                            
                    pipeline (data loading, validation, and                     
                    prediction) remains the same. Finally,                      
                    we print the validation AUROC and save                      
                    the trained model.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as                            
                    transforms                                                  
                    import torchvision.models as models                         
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                    import random                                               
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.4):                            
                        """Returns mixed inputs, pairs of                       
                    targets, and lambda"""                                      
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1                                             
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index, :]                                                 
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(image)                         
                            label = 1 if row["label"] ==                        
                    "malignant" else 0                                          
                            return img, label                                   
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder using TenCrop                        
                    TTA.                                                        
                        Args:                                                   
                            folder_path (str): Path to                          
                    folder containing images (jpg/png).                         
                        Returns:                                                
                            dict: mapping image filename to                     
                    malignancy probability (0-1).                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # Load model                                            
                        model =                                                 
                    models.efficientnet_b0(pretrained=False                     
                    )                                                           
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.load_state_dict(                                  
                            torch.load("./working/efficient                     
                    net_model.pth", map_location=device)                        
                        )                                                       
                        model.to(device).eval()                                 
                        # TTA transform: TenCrop + ToTensor                     
                    + Normalize                                                 
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        tta_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                        results = {}                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    sorted(os.listdir(folder_path)):                            
                                if not                                          
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                    continue                                    
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                crops = tta_transform(img)                      
                    # [10,3,224,224]                                            
                                bs, c, h, w = crops.size()                      
                                inputs = crops.to(device)                       
                                outputs = model(inputs)                         
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs)                       
                                results[fname] =                                
                    probs.mean().item()                                         
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Load and split data                                   
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label"] =                                           
                    df["label"].astype(str)                                     
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, stratify=df["label"],                           
                    test_size=0.2, random_state=42                              
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
                                transforms.ColorJitter(brig                     
                    htness=0.2, contrast=0.2,                                   
                    saturation=0.2),                                            
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [                                       
                                            transforms.Norm                     
                    alize(mean,                                                 
                    std)(transforms.ToTensor()(crop))                           
                                            for crop in                         
                    crops                                                       
                                        ]                                       
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds = SkinDataset(train_df,                        
                    "./input/MyImages", train_transform)                        
                        val_ds = SkinDataset(val_df,                            
                    "./input/MyImages", val_transform)                          
                        train_loader = DataLoader(                              
                            train_ds, batch_size=32,                            
                    shuffle=True, num_workers=4,                                
                    pin_memory=True                                             
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=16,                              
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Model, loss, optimizer                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.efficientnet_b0(pretrained=True)                     
                        model.classifier[1] =                                   
                    nn.Linear(model.classifier[1].in_featur                     
                    es, 1)                                                      
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Training loop with MixUp                              
                        epochs = 5                                              
                        alpha = 0.4                                             
                        for epoch in range(epochs):                             
                            model.train()                                       
                            running_loss = 0.0                                  
                            for images, labels in                               
                    tqdm(train_loader, desc=f"Epoch                             
                    {epoch+1}/{epochs}"):                                       
                                images, labels =                                
                    images.to(device),                                          
                    labels.float().unsqueeze(1).to(device)                      
                                inputs, targets_a,                              
                    targets_b, lam = mixup_data(images,                         
                    labels, alpha)                                              
                                optimizer.zero_grad()                           
                                outputs = model(inputs)                         
                                loss = lam *                                    
                    criterion(outputs, targets_a) + (1 -                        
                    lam) * criterion(                                           
                                    outputs, targets_b                          
                                )                                               
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * images.size(0)                                            
                            print(                                              
                                f"Epoch {epoch+1} training                      
                    loss:                                                       
                    {running_loss/len(train_loader.dataset)                     
                    :.4f}"                                                      
                            )                                                   
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
                    val_loader:                                                 
                                bs, ncrops, c, h, w =                           
                    images.size()                                               
                                imgs = images.view(-1, c,                       
                    h, w).to(device)                                            
                                outputs = model(imgs)                           
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs,                       
                    ncrops).mean(dim=1).numpy()                                 
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC with MixUp                     
                    + TTA: {auc:.4f}")                                          
                                                                                
                        # Save model                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "./working/efficientnet_model.pth")                         
                                                                                
                        # If test folder exists, run                            
                    predictions and save submission                             
                        test_folder = "./input/test_images"                     
                        if os.path.isdir(test_folder):                          
                            preds = predict(test_folder)                        
                            sub = pd.DataFrame(                                 
                                {                                               
                                    "image_name":                               
                    list(preds.keys()),                                         
                                    "malignancy_probability                     
                    ": list(preds.values()),                                    
                                }                                               
                            )                                                   
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                            print("Saved test predictions                       
                    to ./working/submission.csv")                               
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. It                         
                    trained an EfficientNet-B0 model using                      
                    MixUp data augmentation and TenCrop                         
                    test-time augmentation (TTA). The model                     
                    achieved a strong validation AUROC of                       
                    0.9257, indicating effective                                
                    classification performance on the skin                      
                    lesion dataset. The model was saved                         
                    correctly and the prediction function                       
                    is implemented to produce malignancy                        
                    probabilities with TTA for new images.                      
                    Validation Metric: 0.9257                                   
                                                                                
                    -------------------------------                             
                    Design: We add RandomErasing                                
                    augmentation to the training pipeline                       
                    to force the model to learn robustness                      
                    to occlusions and improve                                   
                    generalization. The rest of the                             
                    training, including EfficientNet‐B0                         
                    backbone, optimizer, TenCrop TTA for                        
                    validation, and evaluation via AUROC,                       
                    remains the same.                                           
