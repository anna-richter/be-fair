                    lr=1e-4)                                                    
                                                                                
                        # Training loop                                         
                        for epoch in range(5):                                  
                            model.train()                                       
                            for images, labels in                               
                    tqdm(train_loader, desc=f"Epoch                             
                    {epoch+1}/5"):                                              
                                images, labels =                                
                    images.to(device),                                          
                    labels.float().unsqueeze(1).to(device)                      
                                optimizer.zero_grad()                           
                                outputs = model(images)                         
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
