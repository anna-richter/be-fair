                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs)                       
                                results[fname] =                                
                    probs.mean().item()                                         
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Load and split data                                   
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
