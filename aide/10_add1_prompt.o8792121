                                    flipped =                                   
                    torch.flip(images, dims=[3])                                
                                    out2 =                                      
                    torch.sigmoid(model(flipped))                               
                                    probs = ((out1 + out2)                      
                    / 2).cpu().numpy().flatten()                                
                                    all_probs.extend(probs                      
                    .tolist())                                                  
                                    all_labels.extend(labe                      
                    ls.numpy().tolist())                                        
                            auc =                                               
                    roc_auc_score(all_labels, all_probs)                        
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                            torch.save(model.state_dict(),                      
                    f"./working/efficientnet_model_fold{fo                      
                    ld}.pth")                                                   
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.mean(fold_aucs):.4f}")                                  
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
                                                                                
                                                                                
