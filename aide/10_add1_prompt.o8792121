                    val_loader:                                                 
                                bs, ncrops, c, h, w =                           
                    images.size()                                               
                                imgs = images.view(-1, c,                       
                    h, w).to(device)                                            
                                outputs = model(imgs)                           
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs,                       
                    ncrops).mean(dim=1).numpy()                                 
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC                                
                    (EfficientNet-B3 + RandAugment + TTA):                      
                    {auc:.4f}")                                                 
                                                                                
                        # Save model                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "./working/efficientnet_b3.pth")                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
