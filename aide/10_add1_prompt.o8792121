                    response: We compute simple                                 
                    color-based features (channel means,                        
                    standard deviations, and histograms)                        
                    for each image plus available metadata                      
                    (skin_tone, alternative_skin_tone) and                      
                    binarize the target as malignant vs.                        
                    non-malignant. We train a LightGBM                          
                    classifier using stratified 5‐fold                          
                    cross‐validation to optimize AUROC,                         
                    report the mean CV AUROC, then retrain                      
                    on the full dataset. A                                      
                    `predict(folder_path)` function loads                       
                    the final model and returns malignancy                      
                    probabilities for new images. The                           
                    script prints the average CV AUROC.                         
                                                                                
                    ```python                                                   
                    import os                                                   
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from lightgbm import LGBMClassifier                         
                    import pickle                                               
                                                                                
                    # Feature extraction: color statistics                      
                    + histograms + metadata                                     
                    def extract_features(image_path):                           
                        img =                                                   
                    Image.open(image_path).convert('RGB')                       
                        arr = np.array(img)                                     
                        feats = []                                              
                        # channel means and stds                                
                        means = arr.mean(axis=(0,1))                            
                        stds = arr.std(axis=(0,1))                              
                        feats.extend(means.tolist())                            
                        feats.extend(stds.tolist())                             
                        # histograms: 16 bins per channel                       
                        for c in range(3):                                      
                            hist,_ =                                            
                    np.histogram(arr[:,:,c], bins=16,                           
                    range=(0,255), density=True)                                
                            feats.extend(hist.tolist())                         
                        return feats                                            
                                                                                
                    # Main script                                               
                    df =                                                        
                    pd.read_csv('input/mydataset.csv')                          
                    # Binarize target: malignant=1 else 0                       
                    df['target'] =                                              
                    (df['label']=='malignant').astype(int)                      
                                                                                
                    # Extract features for all images                           
                    feature_list = []                                           
                    for idx, row in df.iterrows():                              
                        img_path = os.path.join('input',                        
                    'MyImages',                                                 
                    f"{row['image_name']}.jpg")                                 
                        feats = extract_features(img_path)                      
                        # add metadata                                          
                        feats.append(row['skin_tone'])                          
                        feats.append(row['alternative_skin                      
                    _tone'])                                                    
                        feature_list.append(feats)                              
                    X = np.array(feature_list)                                  
                    y = df['target'].values                                     
                                                                                
                    # 5‐fold stratified CV                                      
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for train_idx, val_idx in skf.split(X,                      
                    y):                                                         
                        X_train, X_val = X[train_idx],                          
                    X[val_idx]                                                  
                        y_train, y_val = y[train_idx],                          
                    y[val_idx]                                                  
                        clf =                                                   
                    LGBMClassifier(n_estimators=100,                            
                    learning_rate=0.1, random_state=42)                         
                        clf.fit(X_train, y_train)                               
                        preds =                                                 
                    clf.predict_proba(X_val)[:,1]                               
                        auc = roc_auc_score(y_val, preds)                       
                        aucs.append(auc)                                        
                    print(f"Mean CV AUROC:                                      
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # Retrain on full data                                      
                    final_clf =                                                 
                    LGBMClassifier(n_estimators=100,                            
                    learning_rate=0.1, random_state=42)                         
                    final_clf.fit(X, y)                                         
                    # Save model                                                
                    with                                                        
                    open('working/lightgbm_skin_lesion.pkl                      
                    ', 'wb') as f:                                              
                        pickle.dump(final_clf, f)                               
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Given a folder of images, returns                       
                    a dict mapping image filename to                            
                        malignancy probability [0-1].                           
                        """                                                     
                        # load model                                            
                        with                                                    
                    open('working/lightgbm_skin_lesion.pkl                      
                    ', 'rb') as f:                                              
                            model = pickle.load(f)                              
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith(('.jpg','.png',                      
                    '.jpeg')):                                                  
                                path =                                          
                    os.path.join(folder_path, fname)                            
                                feats =                                         
                    extract_features(path)                                      
                                # assume metadata unknown                       
                    => set to -1                                                
                                feats.append(-1)  #                             
                    skin_tone unknown                                           
                                feats.append(-1)  #                             
                    alternative_skin_tone unknown                               
                                prob =                                          
                    model.predict_proba([feats])[0,1]                           
                                results[fname] = prob                           
                        return results                                          
                                                                                
                    # Example usage of predict (uncomment                       
                    to run on new folder)                                       
                    # preds = predict('input/MyImages')                         
                    # print(preds)                                              
                    ```                                                         
