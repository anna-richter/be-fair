                    , scale=(0.02, 0.33), ratio=(0.3,                           
                    3.3), value='random')                                       
                        ])                                                      
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        val_transform =                                         
                    transforms.Compose([                                        
                            transforms.Resize(256),                             
                            transforms.TenCrop(224),                            
                            transforms.Lambda(lambda                            
                    crops: torch.stack([                                        
                                transforms.Normalize(mean,                      
                    std)(transforms.ToTensor()(crop)) for                       
                    crop in crops                                               
                            ]))                                                 
                        ])                                                      
                                                                                
