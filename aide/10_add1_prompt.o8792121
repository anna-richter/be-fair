                                optimizer.step()                                
                            # Validate                                          
                            model.eval()                                        
                            all_logits, all_lbls = [], []                       
                            with torch.no_grad():                               
                                for imgs, lbls in                               
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1).cpu().numpy()                        
                                    all_logits.extend(logit                     
                    s)                                                          
                                    all_lbls.extend(lbls.nu                     
                    mpy())                                                      
                            probs = 1 / (1 +                                    
                    np.exp(-np.array(all_logits)))                              
                            auc = roc_auc_score(all_lbls,                       
                    probs)                                                      
                            print(f"Epoch {epoch}: val                          
                    AUROC = {auc:.4f}")                                         
                            if auc > best_auc:                                  
                                best_auc = auc                                  
                                torch.save(model.state_dict                     
                    (), "working/densenet121_best.pt")                          
                                                                                
                        print(f"Best validation AUROC:                          
                    {best_auc:.4f}")                                            
                                                                                
                        # Example usage of predict()                            
                        # preds = predict('input/MyImages')                     
                    # uncomment to run prediction on input                      
                    images                                                      
                        #                                                       
                    preds.to_csv('working/submission.csv',                      
                    index=False)                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    ```                                                         
                                                                                
