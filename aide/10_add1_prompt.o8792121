                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = 1 if row["label"] ==                        
                    "malignant" else 0                                          
                            return image, label                                 
                                                                                
                                                                                
