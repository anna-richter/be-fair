                        # Setup SWA                                             
                        swa_start = 2  # start averaging                        
                    after epoch 2 (0-based)                                     
                        swa_model = AveragedModel(model)                        
                                                                                
                        # Training loop with SWA updates                        
                        epochs = 5                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            loop = tqdm(train_loader,                           
                    desc=f"Epoch {epoch+1}/{epochs}")                           
                            for images, labels in loop:                         
                                images = images.to(device)                      
                                labels =                                        
                    labels.float().unsqueeze(1).to(device)                      
                                optimizer.zero_grad()                           
                                outputs = model(images)                         
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                loop.set_postfix(loss=loss                      
                    .item())                                                    
                            # Update SWA model                                  
                            if epoch >= swa_start:                              
                                swa_model.update_parameter                      
                    s(model)                                                    
                                                                                
                        # Update batch-norm statistics for                      
                    the SWA model                                               
                        update_bn(train_loader, swa_model)                      
                                                                                
                        # Validation with TTA using the                         
                    SWA-averaged model                                          
                        swa_model.to(device).eval()                             
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
                    val_loader:                                                 
                                bs, ncrops, c, h, w =                           
                    images.size()                                               
                                imgs = images.view(-1, c,                       
                    h, w).to(device)                                            
                                outputs = swa_model(imgs)                       
                                probs =                                         
                    torch.sigmoid(outputs).cpu().view(bs,                       
                    ncrops).mean(dim=1).numpy()                                 
                                all_probs.extend(probs.tol                      
                    ist())                                                      
                                all_labels.extend(labels.n                      
                    umpy().tolist())                                            
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC                                
                    (EfficientNet-B3 + TTA + SWA):                              
                    {auc:.4f}")                                                 
                                                                                
                        # Save the SWA model for inference                      
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(swa_model.state_dict(),                      
                    "./working/efficientnet_b3.pth")                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
