                        means = arr.mean(axis=(0, 1))                           
                        stds = arr.std(axis=(0, 1))                             
                        feats.extend(means.tolist())                            
                        feats.extend(stds.tolist())                             
                        # histograms: 16 bins per channel                       
                        for c in range(3):                                      
                            hist, _ = np.histogram(arr[:,                       
                    :, c], bins=16, range=(0, 255),                             
                    density=True)                                               
                            feats.extend(hist.tolist())                         
                        return feats                                            
                                                                                
                                                                                
                    # Main script                                               
                    df = pd.read_csv("input/mydataset.csv")                     
                    # Binarize target: malignant=1 else 0                       
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                                                                                
                    # Extract features for all images                           
                    feature_list = []                                           
                    for idx, row in df.iterrows():                              
                        img_path = os.path.join("input",                        
                    "MyImages", f"{row['image_name']}.jpg")                     
                        feats = extract_features(img_path)                      
                        # add metadata                                          
                        feats.append(row["skin_tone"])                          
                        feats.append(row["alternative_skin_                     
                    tone"])                                                     
                        feature_list.append(feats)                              
                    X = np.array(feature_list)                                  
                    y = df["target"].values                                     
                                                                                
                    # 5‐fold stratified CV                                      
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    for train_idx, val_idx in skf.split(X,                      
                    y):                                                         
                        X_train, X_val = X[train_idx],                          
                    X[val_idx]                                                  
                        y_train, y_val = y[train_idx],                          
                    y[val_idx]                                                  
                        clf =                                                   
                    LGBMClassifier(n_estimators=100,                            
                    learning_rate=0.1, random_state=42)                         
                        clf.fit(X_train, y_train)                               
                        preds = clf.predict_proba(X_val)[:,                     
                    1]                                                          
                        auc = roc_auc_score(y_val, preds)                       
                        aucs.append(auc)                                        
                    print(f"Mean CV AUROC:                                      
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # Retrain on full data                                      
                    final_clf =                                                 
                    LGBMClassifier(n_estimators=100,                            
