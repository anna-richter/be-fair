                    -------------------------------                             
                    Design: We wrap the training DataLoader                     
                    in a small wrapper that moves each                          
                    batch to the GPU before calling                             
                    update_bn, so that the input and the                        
                    SWA model’s weights live on the same                        
                    device. This ensures batch‐norm                             
                    statistics are updated properly without                     
                    type mismatches. We then call update_bn                     
                    with this wrapped loader and proceed to                     
                    evaluate and save predictions as                            
                    before.                                                     
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    import torch.optim as optim                                 
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                    from torch.optim.swa_utils import                           
                    AveragedModel, SWALR, update_bn                             
                                                                                
                                                                                
                    class DeviceDataLoader:                                     
                        """Wraps a DataLoader to move data                      
                    to a given device."""                                       
                                                                                
                        def __init__(self, dl, device):                         
                            self.dl = dl                                        
                            self.device = device                                
                                                                                
                        def __iter__(self):                                     
                            for batch in self.dl:                               
                                if isinstance(batch, (list,                     
                    tuple)):                                                    
                                    imgs =                                      
                    batch[0].to(self.device)                                    
                                    rest =                                      
                    [b.to(self.device) for b in batch[1:]]                      
                                    yield (imgs, *rest)                         
                                else:                                           
                                    yield                                       
                    batch.to(self.device)                                       
                                                                                
                        def __len__(self):                                      
                            return len(self.dl)                                 
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join(self.img_dir,                      
                    row["image_name"] + ".jpg")                                 
                            ).convert("RGB")                                    
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        _, _, H, W = size                                       
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities by                     
                    averaging all fold SWA models.                              
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        models_list = []                                        
                        for f in                                                
                    sorted(os.listdir("working")):                              
                            if f.startswith("model_fold_")                      
                    and f.endswith(".pth"):                                     
                                m =                                             
                    models.densenet121(pretrained=False)                        
                                m.classifier =                                  
                    nn.Linear(m.classifier.in_features, 1)                      
                                m.load_state_dict(                              
                                    torch.load(os.path.join                     
                    ("working", f), map_location=device)                        
                                )                                               
                                m.to(device).eval()                             
                                models_list.append(m)                           
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            t =                                                 
                    tf(img).unsqueeze(0).to(device)                             
                            with torch.no_grad():                               
                                probs =                                         
                    [torch.sigmoid(m(t)).item() for m in                        
                    models_list]                                                
                            results.append(                                     
                                {                                               
                                    "image_name":                               
                    os.path.splitext(fname)[0],                                 
                                    "probability":                              
                    float(np.mean(probs)),                                      
                                }                                               
                            )                                                   
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        batch_size, epochs = 32, 3                              
                        cutmix_prob, cutmix_alpha = 0.5,                        
                    1.0                                                         
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        fold_aucs = []                                          
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["target"])):                     
                            train_df, val_df =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_tf)                                                   
                            val_ds = SkinDataset(val_df,                        
                    img_dir, train_tf)                                          
                            tl = DataLoader(                                    
                                train_ds,                                       
                                batch_size=batch_size,                          
                                shuffle=True,                                   
                                num_workers=4,                                  
                                pin_memory=True,                                
                            )                                                   
                            vl = DataLoader(                                    
                                val_ds,                                         
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4, pin_memory=True                              
                            )                                                   
                                                                                
                            model =                                             
                    models.densenet121(pretrained=True)                         
                            model.classifier =                                  
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                            model.to(device)                                    
                            opt =                                               
                    optim.AdamW(model.parameters(),                             
                    lr=1e-4, weight_decay=1e-4)                                 
                            scheduler =                                         
                    CosineAnnealingLR(opt, T_max=epochs,                        
                    eta_min=1e-6)                                               
                            swa_model =                                         
                    AveragedModel(model)                                        
                            swa_scheduler = SWALR(opt,                          
                    swa_lr=1e-5)                                                
                            crit = nn.BCEWithLogitsLoss()                       
                                                                                
                            for epoch in range(epochs):                         
                                model.train()                                   
                                for imgs, targets in tl:                        
                                    imgs = imgs.to(device)                      
                                    targets =                                   
                    targets.to(device).unsqueeze(1)                             
                                    r = np.random.rand()                        
                                    opt.zero_grad()                             
                                    if r < cutmix_prob:                         
                                        lam =                                   
                    np.random.beta(cutmix_alpha,                                
                    cutmix_alpha)                                               
                                        idx2 =                                  
                    torch.randperm(imgs.size(0)).to(device)                     
                                        ta, tb = targets,                       
                    targets[idx2]                                               
                                        bbx1, bby1, bbx2,                       
                    bby2 = rand_bbox(imgs.size(), lam)                          
                                        imgs[:, :,                              
                    bby1:bby2, bbx1:bbx2] = imgs[                               
                                            idx2, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                        ]                                       
                                        lam = 1 - (                             
                                            (bbx2 - bbx1) *                     
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                        )                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    ta) * lam + crit(logits, tb) * (1 -                         
                    lam)                                                        
                                    else:                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    targets)                                                    
                                    loss.backward()                             
                                    opt.step()                                  
                                scheduler.step()                                
                                if epoch > 0:                                   
                                    swa_model.update_parame                     
                    ters(model)                                                 
                                    swa_scheduler.step()                        
                                                                                
                            # update batchnorm stats for                        
                    SWA model with data on correct device                       
                            update_bn(DeviceDataLoader(tl,                      
                    device), swa_model)                                         
                            # evaluation with SWA model                         
                            swa_model.eval()                                    
                            all_p, all_t = [], []                               
                            with torch.no_grad():                               
                                for imgs, targets in vl:                        
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    swa_model(imgs)                                             
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    all_p.extend(probs.toli                     
                    st())                                                       
                                    all_t.extend(targets.nu                     
                    mpy().flatten().tolist())                                   
                            auc = roc_auc_score(all_t,                          
                    all_p)                                                      
                            print(f"Fold {fold} SWA ROC                         
                    AUC: {auc:.4f}")                                            
                            fold_aucs.append(auc)                               
                            torch.save(swa_model.state_dict                     
                    (), f"working/model_fold_{fold}.pth")                       
                                                                                
                        mean_auc = np.mean(fold_aucs)                           
                        print(f"Mean SWA ROC AUC:                               
                    {mean_auc:.4f}")                                            
                                                                                
                        test_folder = os.path.join("input",                     
                    "test")                                                     
                        if os.path.exists(test_folder):                         
                            sub = predict(test_folder)                          
                            sub.to_csv(os.path.join("workin                     
                    g", "submission.csv"), index=False)                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. It                         
                    used 5-fold stratified cross-validation                     
                    with a DenseNet121 model and Stochastic                     
                    Weight Averaging (SWA). The model                           
                    achieved strong performance with fold                       
                    AUROC scores ranging from 0.9179 to                         
                    0.9360 and a mean AUROC of 0.9266,                          
                    indicating good discriminative ability                      
                    for the malignant versus benign                             
                    classification task. The predict                            
                    function averages predictions from all                      
                    fold models to provide malignancy                           
                    probabilities for new images.                               
                    Validation Metric: 0.9266                                   
                                                                                
                    -------------------------------                             
                    Design: We increase the number of                           
                    training epochs from 3 to 5, giving the                     
                    CosineAnnealingLR scheduler more                            
                    iterations to optimize, while keeping                       
                    all other settings identical (5-fold                        
                    CV, DenseNet121, CutMix, AdamW). This                       
                    allows the model to converge more fully                     
                    and can lift the ROC AUC. The                               
                    scheduler’s T_max is updated to match                       
                    the new epoch count. We then print the                      
                    per‐fold and mean ROC AUC and save test                     
                    predictions as before.                                      
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    import torch.optim as optim                                 
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        _, _, H, W = size                                       
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities by                     
                    averaging all fold models.                                  
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        models_list = []                                        
                        for f in                                                
                    sorted(os.listdir("working")):                              
                            if f.startswith("model_fold_")                      
                    and f.endswith(".pth"):                                     
                                m =                                             
                    models.densenet121(pretrained=False)                        
                                m.classifier =                                  
                    nn.Linear(m.classifier.in_features, 1)                      
                                m.load_state_dict(                              
                                    torch.load(os.path.join                     
                    ("working", f), map_location=device)                        
                                )                                               
                                m.to(device).eval()                             
                                models_list.append(m)                           
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            t =                                                 
                    tf(img).unsqueeze(0).to(device)                             
                            probs = []                                          
                            with torch.no_grad():                               
                                for m in models_list:                           
                                    logits = m(t)                               
                                    probs.append(torch.sigm                     
                    oid(logits).item())                                         
                            avgp = float(np.mean(probs))                        
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": avgp})                                       
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                                                                                
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        cutmix_prob, cutmix_alpha = 0.5,                        
                    1.0                                                         
                        batch_size = 32                                         
                        epochs = 5  # increased from 3 to 5                     
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        fold_aucs = []                                          
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["target"])):                     
                            train_df, val_df =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_tf)                                                   
                            val_ds = SkinDataset(val_df,                        
                    img_dir, train_tf)                                          
                            tl = DataLoader(                                    
                                train_ds,                                       
                                batch_size=batch_size,                          
                                shuffle=True,                                   
                                num_workers=4,                                  
                                pin_memory=True,                                
                            )                                                   
                            vl = DataLoader(                                    
                                val_ds,                                         
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4, pin_memory=True                              
                            )                                                   
                                                                                
                            model =                                             
                    models.densenet121(pretrained=True)                         
                            model.classifier =                                  
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                            model.to(device)                                    
                                                                                
                            opt =                                               
                    optim.AdamW(model.parameters(),                             
                    lr=1e-4, weight_decay=1e-4)                                 
                            scheduler =                                         
                    CosineAnnealingLR(opt, T_max=epochs,                        
                    eta_min=1e-6)                                               
                            crit = nn.BCEWithLogitsLoss()                       
                                                                                
                            for epoch in range(epochs):                         
                                model.train()                                   
                                for imgs, targets in tl:                        
                                    imgs = imgs.to(device)                      
                                    targets =                                   
                    targets.to(device).unsqueeze(1)                             
                                    r = np.random.rand()                        
                                    opt.zero_grad()                             
                                    if r < cutmix_prob:                         
                                        lam =                                   
                    np.random.beta(cutmix_alpha,                                
                    cutmix_alpha)                                               
                                        idx2 =                                  
                    torch.randperm(imgs.size(0)).to(device)                     
                                        ta, tb = targets,                       
                    targets[idx2]                                               
                                        bbx1, bby1, bbx2,                       
                    bby2 = rand_bbox(imgs.size(), lam)                          
                                        imgs[:, :,                              
                    bby1:bby2, bbx1:bbx2] = imgs[                               
                                            idx2, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                        ]                                       
                                        lam = 1 - (                             
                                            (bbx2 - bbx1) *                     
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                        )                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    ta) * lam + crit(logits, tb) * (1 -                         
                    lam)                                                        
                                    else:                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    targets)                                                    
                                    loss.backward()                             
                                    opt.step()                                  
                                scheduler.step()                                
                                                                                
                            model.eval()                                        
                            all_p, all_t = [], []                               
                            with torch.no_grad():                               
                                for imgs, targets in vl:                        
                                    imgs = imgs.to(device)                      
                                    logits = model(imgs)                        
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    all_p.extend(probs.toli                     
                    st())                                                       
                                    all_t.extend(targets.nu                     
                    mpy().flatten().tolist())                                   
                            auc = roc_auc_score(all_t,                          
                    all_p)                                                      
                            print(f"Fold {fold} ROC AUC:                        
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                            torch.save(model.state_dict(),                      
                    f"working/model_fold_{fold}.pth")                           
                                                                                
                        print(f"Mean ROC AUC:                                   
                    {np.mean(fold_aucs):.4f}")                                  
                                                                                
                        test_folder = os.path.join("input",                     
                    "test")                                                     
                        if os.path.exists(test_folder):                         
                            sub = predict(test_folder)                          
                            sub.to_csv(os.path.join("workin                     
                    g", "submission.csv"), index=False)                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without any bugs. The                          
                    model was trained using 5-fold                              
                    stratified cross-validation with cutmix                     
                    augmentation and a DenseNet121                              
                    architecture. The validation ROC AUC                        
                    scores across folds ranged from 0.9210                      
                    to 0.9392, with a mean ROC AUC of                           
                    0.9308, indicating strong                                   
                    classification performance on the skin                      
                    lesion malignancy detection task.                           
                    Validation Metric: 0.9308                                   
                                                                                
                    -------------------------------                             
                    Design: We encountered a mismatch when                      
                    updating batch‐norm running statistics                      
                    because `update_bn` uses CPU tensors                        
                    against a GPU model. To fix this, we                        
                    implement our own `update_bn` routine                       
                    that explicitly moves each batch to the                     
                    model’s device before forwarding. We                        
                    replace the                                                 
                    `torch.optim.swa_utils.update_bn` call                      
                    with this custom version so that the                        
                    SWA model’s batch‐norm layers are                           
                    correctly updated on the GPU. This                          
                    ensures inputs and weights share the                        
                    same device and resolves the type                           
                    mismatch error.                                             
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    import torch.optim as optim                                 
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                    from torch.optim.swa_utils import                           
                    AveragedModel, SWALR                                        
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        _, _, H, W = size                                       
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    def update_bn_custom(loader, model,                         
                    device):                                                    
                        model.train()                                           
                        with torch.no_grad():                                   
                            for imgs, _ in loader:                              
                                imgs = imgs.to(device)                          
                                model(imgs)                                     
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities by                     
                    averaging all fold SWA models.                              
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        models_list = []                                        
                        for f in                                                
                    sorted(os.listdir("working")):                              
                            if f.startswith("model_fold_")                      
                    and f.endswith(".pth"):                                     
                                m =                                             
                    models.densenet121(pretrained=False)                        
                                m.classifier =                                  
                    nn.Linear(m.classifier.in_features, 1)                      
                                m.load_state_dict(                              
                                    torch.load(os.path.join                     
                    ("working", f), map_location=device)                        
                                )                                               
                                m.to(device).eval()                             
                                models_list.append(m)                           
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            t =                                                 
                    tf(img).unsqueeze(0).to(device)                             
                            probs = []                                          
                            with torch.no_grad():                               
                                for m in models_list:                           
                                    logits = m(t)                               
                                    probs.append(torch.sigm                     
                    oid(logits).item())                                         
                            avgp = float(np.mean(probs))                        
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": avgp})                                       
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        cutmix_prob, cutmix_alpha = 0.5,                        
                    1.0                                                         
                        batch_size, epochs = 32, 3                              
                        swa_start = epochs // 2                                 
                        fold_aucs = []                                          
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["target"])):                     
                            train_df, val_df =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_tf)                                                   
                            val_ds = SkinDataset(val_df,                        
                    img_dir, train_tf)                                          
                            tl = DataLoader(                                    
                                train_ds,                                       
                                batch_size=batch_size,                          
                                shuffle=True,                                   
                                num_workers=4,                                  
                                pin_memory=True,                                
                            )                                                   
                            vl = DataLoader(                                    
                                val_ds,                                         
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4, pin_memory=True                              
                            )                                                   
                                                                                
                            model =                                             
                    models.densenet121(pretrained=True)                         
                            model.classifier =                                  
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                            model.to(device)                                    
                            opt =                                               
                    optim.AdamW(model.parameters(),                             
                    lr=1e-4, weight_decay=1e-4)                                 
                            scheduler =                                         
                    CosineAnnealingLR(opt, T_max=epochs,                        
                    eta_min=1e-6)                                               
                            crit = nn.BCEWithLogitsLoss()                       
                                                                                
                            swa_model = None                                    
                            swa_scheduler = None                                
                                                                                
                            for epoch in range(epochs):                         
                                model.train()                                   
                                for imgs, targets in tl:                        
                                    imgs = imgs.to(device)                      
                                    targets =                                   
                    targets.to(device).unsqueeze(1)                             
                                    opt.zero_grad()                             
                                    if np.random.rand() <                       
                    cutmix_prob:                                                
                                        lam =                                   
                    np.random.beta(cutmix_alpha,                                
                    cutmix_alpha)                                               
                                        idx2 =                                  
                    torch.randperm(imgs.size(0)).to(device)                     
                                        ta, tb = targets,                       
                    targets[idx2]                                               
                                        bbx1, bby1, bbx2,                       
                    bby2 = rand_bbox(imgs.size(), lam)                          
                                        imgs[:, :,                              
                    bby1:bby2, bbx1:bbx2] = imgs[                               
                                            idx2, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                        ]                                       
                                        lam = 1 - (                             
                                            (bbx2 - bbx1) *                     
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                        )                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    ta) * lam + crit(logits, tb) * (1 -                         
                    lam)                                                        
                                    else:                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    targets)                                                    
                                    loss.backward()                             
                                    opt.step()                                  
                                if epoch >= swa_start:                          
                                    if swa_model is None:                       
                                        swa_model =                             
                    AveragedModel(model)                                        
                                        swa_scheduler =                         
                    SWALR(opt, swa_lr=1e-5)                                     
                                    else:                                       
                                        swa_model.update_pa                     
                    rameters(model)                                             
                                    swa_scheduler.step()                        
                                else:                                           
                                    scheduler.step()                            
                                                                                
                            eval_model = model                                  
                            if swa_model is not None:                           
                                update_bn_custom(tl,                            
                    swa_model, device)                                          
                                eval_model = swa_model                          
                            eval_model.eval()                                   
                                                                                
                            all_p, all_t = [], []                               
                            with torch.no_grad():                               
                                for imgs, targets in vl:                        
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    eval_model(imgs)                                            
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    all_p.extend(probs.toli                     
                    st())                                                       
                                    all_t.extend(targets.nu                     
                    mpy().flatten().tolist())                                   
                            auc = roc_auc_score(all_t,                          
                    all_p)                                                      
                            print(f"Fold {fold} ROC AUC:                        
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                            state_dict = (                                      
                                eval_model.module.state_dic                     
                    t()                                                         
                                if isinstance(eval_model,                       
                    AveragedModel)                                              
                                else                                            
                    eval_model.state_dict()                                     
                            )                                                   
                            torch.save(state_dict,                              
                    f"working/model_fold_{fold}.pth")                           
                                                                                
                        mean_auc = np.mean(fold_aucs)                           
                        print(f"Mean ROC AUC:                                   
                    {mean_auc:.4f}")                                            
                                                                                
                        test_folder = os.path.join("input",                     
                    "test")                                                     
                        if os.path.exists(test_folder):                         
                            sub = predict(test_folder)                          
                            sub.to_csv(os.path.join("workin                     
                    g", "submission.csv"), index=False)                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    achieved strong and consistent ROC AUC                      
                    scores across the 5 folds, with a mean                      
                    ROC AUC of approximately 0.916,                             
                    indicating good classification                              
                    performance for the skin lesion                             
                    malignancy detection task. The use of                       
                    CutMix augmentation and Stochastic                          
                    Weight Averaging contributed to robust                      
                    model generalization.                                       
                    Validation Metric: 0.9159                                   
                                                                                
                    -------------------------------                             
                    Design: We implement horizontal flip                        
                    test‐time augmentation (TTA) by                             
                    averaging model predictions on original                     
                    and flipped images during validation                        
                    and inference. This adds minimal                            
                    complexity but can improve robustness                       
                    and lift the ROC AUC slightly. We                           
                    update the validation loop to compute                       
                    predictions on both versions of each                        
                    batch and average their sigmoid                             
                    outputs. The `predict()` function is                        
                    similarly modified to apply TTA across                      
                    all fold models when generating the                         
                    submission.                                                 
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    import torch.optim as optim                                 
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        _, _, H, W = size                                       
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities by                     
                    averaging all fold models with                              
                    horizontal-flip TTA.                                        
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # load all fold models                                  
                        models_list = []                                        
                        for f in                                                
                    sorted(os.listdir("working")):                              
                            if f.startswith("model_fold_")                      
                    and f.endswith(".pth"):                                     
                                m =                                             
                    models.densenet121(pretrained=False)                        
                                m.classifier =                                  
                    nn.Linear(m.classifier.in_features, 1)                      
                                m.load_state_dict(                              
                                    torch.load(os.path.join                     
                    ("working", f), map_location=device)                        
                                )                                               
                                m.to(device).eval()                             
                                models_list.append(m)                           
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            t =                                                 
                    tf(img).unsqueeze(0).to(device)  #                          
                    shape [1,3,H,W]                                             
                            t_flip = torch.flip(t,                              
                    dims=[3])                                                   
                            probs_per_model = []                                
                            with torch.no_grad():                               
                                for m in models_list:                           
                                    logit1 = m(t)                               
                                    logit2 = m(t_flip)                          
                                    avg_logit = (logit1 +                       
                    logit2) / 2.0                                               
                                    probs_per_model.append(                     
                    torch.sigmoid(avg_logit).item())                            
                            avgp =                                              
                    float(np.mean(probs_per_model))                             
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": avgp})                                       
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        np.random.seed(42)                                      
                        torch.manual_seed(42)                                   
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                                                                                
                        # transforms                                            
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        cutmix_prob, cutmix_alpha = 0.5,                        
                    1.0                                                         
                        batch_size = 32                                         
                        epochs = 5                                              
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        fold_aucs = []                                          
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["target"])):                     
                            train_df, val_df =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_tf)                                                   
                            val_ds = SkinDataset(val_df,                        
                    img_dir, train_tf)                                          
                            tl = DataLoader(                                    
                                train_ds,                                       
                                batch_size=batch_size,                          
                                shuffle=True,                                   
                                num_workers=4,                                  
                                pin_memory=True,                                
                            )                                                   
                            vl = DataLoader(                                    
                                val_ds,                                         
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4, pin_memory=True                              
                            )                                                   
                                                                                
                            model =                                             
                    models.densenet121(pretrained=True)                         
                            model.classifier =                                  
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                            model.to(device)                                    
                                                                                
                            opt =                                               
                    optim.AdamW(model.parameters(),                             
                    lr=1e-4, weight_decay=1e-4)                                 
                            scheduler =                                         
                    CosineAnnealingLR(opt, T_max=epochs,                        
                    eta_min=1e-6)                                               
                            crit = nn.BCEWithLogitsLoss()                       
                                                                                
                            # training                                          
                            for epoch in range(epochs):                         
                                model.train()                                   
                                for imgs, targets in tl:                        
                                    imgs = imgs.to(device)                      
                                    targets =                                   
                    targets.to(device).unsqueeze(1)                             
                                    r = np.random.rand()                        
                                    opt.zero_grad()                             
                                    if r < cutmix_prob:                         
                                        lam =                                   
                    np.random.beta(cutmix_alpha,                                
                    cutmix_alpha)                                               
                                        idx2 =                                  
                    torch.randperm(imgs.size(0)).to(device)                     
                                        ta, tb = targets,                       
                    targets[idx2]                                               
                                        bbx1, bby1, bbx2,                       
                    bby2 = rand_bbox(imgs.size(), lam)                          
                                        imgs[:, :,                              
                    bby1:bby2, bbx1:bbx2] = imgs[                               
                                            idx2, :,                            
                    bby1:bby2, bbx1:bbx2                                        
                                        ]                                       
                                        lam = 1 - (                             
                                            (bbx2 - bbx1) *                     
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                        )                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    ta) * lam + crit(logits, tb) * (1 -                         
                    lam)                                                        
                                    else:                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    targets)                                                    
                                    loss.backward()                             
                                    opt.step()                                  
                                scheduler.step()                                
                                                                                
                            # validation with                                   
                    horizontal-flip TTA                                         
                            model.eval()                                        
                            all_p, all_t = [], []                               
                            with torch.no_grad():                               
                                for imgs, targets in vl:                        
                                    imgs = imgs.to(device)                      
                                    imgs_flip =                                 
                    torch.flip(imgs, dims=[3])                                  
                                    logits1 = model(imgs)                       
                                    logits2 =                                   
                    model(imgs_flip)                                            
                                    logits_avg = (logits1 +                     
                    logits2) / 2.0                                              
                                    probs =                                     
                    torch.sigmoid(logits_avg).cpu().numpy()                     
                    .flatten()                                                  
                                    all_p.extend(probs.toli                     
                    st())                                                       
                                    all_t.extend(targets.nu                     
                    mpy().flatten().tolist())                                   
                            auc = roc_auc_score(all_t,                          
                    all_p)                                                      
                            print(f"Fold {fold} ROC AUC:                        
                    {auc:.4f}")                                                 
                            fold_aucs.append(auc)                               
                            torch.save(model.state_dict(),                      
                    f"working/model_fold_{fold}.pth")                           
                                                                                
                        mean_auc = np.mean(fold_aucs)                           
                        print(f"Mean ROC AUC:                                   
                    {mean_auc:.4f}")                                            
                                                                                
                        # predict on test if exists                             
                        test_folder = os.path.join("input",                     
                    "test")                                                     
                        if os.path.exists(test_folder):                         
                            sub = predict(test_folder)                          
                            sub.to_csv(os.path.join("workin                     
                    g", "submission.csv"), index=False)                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. It                         
                    trained a DenseNet121 model with CutMix                     
                    augmentation and horizontal-flip test                       
                    time augmentation. The model achieved a                     
                    strong mean ROC AUC of 0.9312 across 5                      
                    stratified folds, indicating good                           
                    predictive performance on the skin                          
                    lesion malignancy classification task.                      
