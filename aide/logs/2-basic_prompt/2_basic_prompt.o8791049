                        epochs = 3                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device), targets.to(device)                         
                                mixed_imgs, mixed_targets                       
                    = mixup_data(imgs, targets, alpha=0.4)                      
                                optimizer.zero_grad()                           
                                logits = model(mixed_imgs)                      
                                loss =                                          
                    criterion(logits.view(-1),                                  
                    mixed_targets)                                              
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validation                                            
                        model.eval()                                            
                        all_probs, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fl                      
                    atten().tolist()                                            
                                all_probs.extend(probs)                         
                                all_targets.extend(targets                      
                    .numpy().flatten().tolist())                                
                        roc_auc =                                               
                    roc_auc_score(all_targets, all_probs)                       
                        print(f"Validation ROC AUC:                             
                    {roc_auc:.4f}")                                             
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
