                        model =                                                 
                    timm.create_model("resnet18",                               
                    pretrained=False, num_classes=1)                            
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        # Prepare dataset                                       
                        img_files = [f for f in                                 
                    os.listdir(images_folder) if                                
                    f.lower().endswith(".jpg")]                                 
                        df_test =                                               
                    pd.DataFrame({"image_name":                                 
                    [os.path.splitext(f)[0] for f in                            
                    img_files]})                                                
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        ds = SkinDataset(df_test,                               
                    images_folder, transform, is_test=True)                     
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False)                       
                        results = []                                            
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                for name, p in zip(names,                       
                    probs):                                                     
                                    results.append({"image_                     
                    name": name, "malignancy_prob":                             
                    float(p)})                                                  
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        # Configuration                                         
                        CSV_PATH = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
                        MODEL_PATH = "model.pth"                                
                        BATCH_SIZE = 32                                         
                        EPOCHS = 3                                              
                        lr = 1e-4                                               
                                                                                
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        # Binary label: malignant=1, else=0                     
                        df["binary_label"] = (df["label"]                       
                    == "malignant").astype(int)                                 
                        # Stratified split                                      
                        splitter =                                              
                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                        train_idx, val_idx =                                    
                    next(splitter.split(df,                                     
                    df["binary_label"]))                                        
                        df_train, df_val =                                      
                    df.loc[train_idx], df.loc[val_idx]                          
                                                                                
                        # Transforms                                            
                        train_tf = T.Compose(                                   
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        val_tf = T.Compose(                                     
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets & Loaders                                    
                        train_ds = SkinDataset(df_train,                        
                    IMG_DIR, train_tf)                                          
                        val_ds = SkinDataset(df_val,                            
                    IMG_DIR, val_tf)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    timm.create_model("resnet18",                               
                    pretrained=True, num_classes=1)                             
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=lr)                       
                                                                                
                        # Training loop                                         
                        for epoch in range(EPOCHS):                             
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            epoch_loss = running_loss /                         
                    len(train_ds)                                               
                            print(f"Epoch                                       
                    {epoch+1}/{EPOCHS}, Training Loss:                          
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_logits, all_labels = [], []                         
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1).cpu().numpy()                        
                                all_logits.extend(logits)                       
                                all_labels.extend(labels.nu                     
                    mpy())                                                      
                        probs = 1 / (1 +                                        
                    np.exp(-np.array(all_logits)))                              
                        auc = roc_auc_score(all_labels,                         
                    probs)                                                      
                        print(f"Validation ROC AUC:                             
                    {auc:.4f}")                                                 
                                                                                
                        # Save model                                            
                        torch.save(model.state_dict(),                          
                    MODEL_PATH)                                                 
                                                                                
                        # Example: generate predictions on                      
                    new images folder (uncomment to use)                        
                        # df_preds = predict(IMG_DIR,                           
                    MODEL_PATH)                                                 
                        #                                                       
                    df_preds.to_csv('./working/submission.c                     
                    sv', index=False)                                           
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 3 epochs on the                       
                    skin lesion dataset using a pretrained                      
                    ResNet18 backbone, achieving a good                         
                    validation ROC AUC of 0.8761. This                          
                    indicates the model has learned to                          
                    distinguish malignant from benign                           
                    lesions with good accuracy. The model                       
                    weights were saved properly, and the                        
                    inference function is implemented to                        
                    predict malignancy probabilities on new                     
                    images.                                                     
                    Validation Metric: 0.8761                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    EfficientNet-B0 model from the timm                         
                    library to classify lesions as                              
                    malignant or non-malignant, mapping                         
                    “malignant” to 1 and others to 0, and                       
                    applying standard ImageNet transforms.                      
                    We perform 5-fold stratified                                
                    cross-validation, training each fold                        
                    for 3 epochs with AdamW and                                 
                    BCEWithLogitsLoss, and compute the                          
                    AUROC on each validation set. After CV                      
                    we retrain the same model on the full                       
                    dataset for 3 epochs and save the final                     
                    weights. A `predict(folder_path)`                           
                    function is provided that loads the                         
                    saved model and returns malignancy                          
                    probabilities for new images.                               
                    Code: import os                                             
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset class                                             
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    # Training and validation functions                         
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        for imgs, labels in loader:                             
                            imgs, labels = imgs.to(device),                     
                    labels.to(device).unsqueeze(1)                              
                            preds = model(imgs)                                 
                            loss = criterion(preds, labels)                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                                                                                
                    def eval_epoch(model, loader, device):                      
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(device)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().rav                     
                    el()                                                        
                                ys.extend(labels.numpy().ra                     
                    vel())                                                      
                                ps.extend(probs)                                
                        return roc_auc_score(ys, ps)                            
                                                                                
                                                                                
                    # Main training and CV                                      
                    def main():                                                 
                        # Config                                                
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        MODEL_PATH = "./working/model.pth"                      
                        N_SPLITS = 5                                            
                        BATCH_SIZE = 32                                         
                        LR = 1e-4                                               
                        EPOCHS_CV = 3                                           
                        EPOCHS_FULL = 3                                         
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        # Data                                                  
                        df = pd.read_csv(CSV_PATH)                              
                        df["label"] = df.label.apply(lambda                     
                    x: 1 if x == "malignant" else 0)                            
                        y = df["label"].values                                  
                                                                                
                        # Transforms                                            
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # 5-fold CV                                             
                        skf =                                                   
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, y), 1):                             
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            ds_train =                                          
                    LesionDataset(df_train, IMG_DIR,                            
                    transform)                                                  
                            ds_val = LesionDataset(df_val,                      
                    IMG_DIR, transform)                                         
                            loader_train = DataLoader(                          
                                ds_train,                                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                            )                                                   
                            loader_val = DataLoader(                            
                                ds_val,                                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4                                               
                            )                                                   
                                                                                
                            # Model                                             
                            model =                                             
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=1)                             
                            model.to(DEVICE)                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.AdamW(model.parameters(),                       
                    lr=LR)                                                      
                                                                                
                            # Train                                             
                            for epoch in range(EPOCHS_CV):                      
                                train_one_epoch(model,                          
                    loader_train, criterion, optimizer,                         
                    DEVICE)                                                     
                                                                                
                            # Evaluate                                          
                            auc = eval_epoch(model,                             
                    loader_val, DEVICE)                                         
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.mean(aucs):.4f}")                                       
                                                                                
                        # Retrain on full data                                  
                        full_ds = LesionDataset(df,                             
                    IMG_DIR, transform)                                         
                        full_loader = DataLoader(                               
                            full_ds, batch_size=BATCH_SIZE,                     
                    shuffle=True, num_workers=4                                 
                        )                                                       
                        final_model = timm.create_model(                        
                            "efficientnet_b0",                                  
                    pretrained=True, num_classes=1                              
                        ).to(DEVICE)                                            
                        crit = nn.BCEWithLogitsLoss()                           
                        opt =                                                   
                    torch.optim.AdamW(final_model.parameter                     
                    s(), lr=LR)                                                 
                        for epoch in range(EPOCHS_FULL):                        
                            train_one_epoch(final_model,                        
                    full_loader, crit, opt, DEVICE)                             
                        torch.save(final_model.state_dict()                     
                    , MODEL_PATH)                                               
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in folder_path.                              
                        Returns a DataFrame with columns:                       
                    image_name, malignancy_probability.                         
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False, num_classes=1)                            
                        model.load_state_dict(torch.load(".                     
                    /working/model.pth",                                        
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        tf = T.Compose(                                         
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.sigmoid(model(x)).cpu().item()                        
                                results.append({"image_name                     
                    ": fname, "malignancy_probability":                         
                    prob})                                                      
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without any errors or                          
                    bugs. The 5-fold cross-validation                           
                    yielded a consistent and good AUROC                         
                    performance around 0.88, indicating the                     
                    model effectively distinguishes                             
                    malignant from benign lesions. The                          
                    final model was retrained on the full                       
                    dataset and saved as expected. The                          
                    prediction function is properly                             
                    designed to load the saved model and                        
                    provide malignancy probabilities for                        
                    new images.                                                 
                    Validation Metric: 0.8814                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    DenseNet121 on our skin lesion dataset,                     
                    mapping “malignant” to 1 and the other                      
                    labels to 0, and use standard ImageNet                      
                    normalization with Resize(224) and                          
                    CenterCrop(224). We split the data                          
                    80/20 with stratification on the binary                     
                    label, train for 3 epochs using Adam                        
                    and BCEWithLogitsLoss on GPU if                             
                    available, and compute AUROC on the                         
                    hold-out validation set. The model                          
                    weights are saved to                                        
                    “working/model.pth”. We also provide a                      
                    predict(folder_path) function that                          
                    loads these weights and returns                             
                    malignancy probabilities for new                            
                    images.                                                     
                    Code: import os                                             
                    import pandas as pd                                         
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from PIL import Image                                       
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in folder_path.                              
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # Define model architecture                             
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        # Define transform                                      
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg", ".png",                     
                    ".jpeg")):                                                  
                                continue                                        
                            img_path =                                          
                    os.path.join(folder_path, fname)                            
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            image =                                             
                    transform(image).unsqueeze(0).to(device                     
                    )                                                           
                            with torch.no_grad():                               
                                logit = model(image)                            
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                        # Load and prepare data                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["target"], random_state=42                      
                        )                                                       
                        # Transforms                                            
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # Datasets & Loaders                                    
                        train_ds = SkinDataset(train_df,                        
                    img_dir, transform)                                         
                        val_ds = SkinDataset(val_df,                            
                    img_dir, transform)                                         
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # Model, loss, optimizer                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        # Training loop                                         
                        epochs = 3                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device),                                            
                    targets.to(device).unsqueeze(1)                             
                                optimizer.zero_grad()                           
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    targets)                                                    
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validation                                            
                        model.eval()                                            
                        all_probs = []                                          
                        all_targets = []                                        
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_targets.extend(targets.                     
                    numpy().flatten().tolist())                                 
                        roc_auc =                                               
                    roc_auc_score(all_targets, all_probs)                       
                        print(f"Validation ROC AUC:                             
                    {roc_auc:.4f}")                                             
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model trained for 3 epochs achieved a                       
                    validation ROC AUC of approximately                         
                    0.9101, indicating good discriminative                      
                    performance for classifying skin                            
                    lesions as malignant or benign. The                         
                    model was saved correctly, and the                          
                    prediction function is designed to load                     
                    the saved model and output malignancy                       
                    probabilities for new images.                               
                    Validation Metric: 0.9101                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    Vision Transformer (ViT-B/16) from timm                     
                    for binary classification, mapping                          
                    “malignant” to 1 and all other labels                       
                    to 0, using an 80/20 stratified split.                      
                    We apply standard ImageNet transforms,                      
                    train for 3 epochs with AdamW and                           
                    BCEWithLogitsLoss, and evaluate ROC AUC                     
                    on the hold-out validation set. The                         
                    trained model is saved to                                   
                    “working/model.pth” and a                                   
                    `predict(folder_path)` function loads                       
                    this model to return malignancy                             
                    probabilities for new images. We report                     
                    the validation ROC AUC after training.                      
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedShuffleSplit                                      
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torch.nn as nn                                       
                    from torchvision import transforms                          
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label =                                             
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    def get_transforms():                                       
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        train_t = transforms.Compose(                           
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean,                      
                    std),                                                       
                            ]                                                   
                        )                                                       
                        val_t = transforms.Compose(                             
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean,                      
                    std),                                                       
                            ]                                                   
                        )                                                       
                        return train_t, val_t                                   
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in a folder.                                 
                        Returns a DataFrame with columns                        
                    ['image_name',                                              
                    'malignancy_probability'].                                  
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # load model                                            
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=False, num_classes=1)                         
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        # transforms                                            
                        _, val_transform = get_transforms()                     
                        results = []                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg", ".png",                     
                    ".jpeg")):                                                  
                                img_path =                                      
                    os.path.join(folder_path, fname)                            
                                img =                                           
                    Image.open(img_path).convert("RGB")                         
                                x =                                             
                    val_transform(img).unsqueeze(0).to(devi                     
                    ce)                                                         
                                with torch.no_grad():                           
                                    logits = model(x)                           
                                    prob =                                      
                    torch.sigmoid(logits).item()                                
                                name =                                          
                    os.path.splitext(fname)[0]                                  
                                results.append({"image_name                     
                    ": name, "malignancy_probability":                          
                    prob})                                                      
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        # load data                                             
                        df =                                                    
                    pd.read_csv("input/mydataset.csv")                          
                        # map labels                                            
                        df = df[df.label.notnull()].copy()                      
                        df["label_bin"] =                                       
                    df.label.map(lambda x: 1 if x ==                            
                    "malignant" else 0)                                         
                        # stratified split                                      
                        splitter =                                              
                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                        train_idx, val_idx =                                    
                    next(splitter.split(df, df.label_bin))                      
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_t, val_t = get_transforms()                       
                        train_ds =                                              
                    SkinLesionDataset(df_train,                                 
                    "input/MyImages", transform=train_t)                        
                        val_ds = SkinLesionDataset(df_val,                      
                    "input/MyImages", transform=val_t)                          
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # model, optimizer, loss                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    timm.create_model("vit_base_patch16_224                     
                    ", pretrained=True, num_classes=1)                          
                        model.to(device)                                        
                        optimizer =                                             
                    torch.optim.AdamW(model.parameters(),                       
                    lr=1e-4)                                                    
                        criterion = nn.BCEWithLogitsLoss()                      
                        # train                                                 
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labs in train_loader:                     
                                imgs, labs =                                    
                    imgs.to(device),                                            
                    labs.to(device).unsqueeze(1)                                
                                optimizer.zero_grad()                           
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    labs)                                                       
                                loss.backward()                                 
                                optimizer.step()                                
                        # evaluate                                              
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labs in val_loader:                       
                                imgs = imgs.to(device)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labs.nump                     
                    y().flatten())                                              
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation ROC AUC:                             
                    {auc:.4f}")                                                 
                        # save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
