                            img_name = self.df.loc[idx,                         
                    "image_name"] + ".jpg"                                      
                            img_path =                                          
                    os.path.join(self.img_dir, img_name)                        
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            if self.is_test:                                    
                                return img,                                     
                    self.df.loc[idx, "image_name"]                              
                            label = self.df.loc[idx,                            
                    "binary_label"]                                             
