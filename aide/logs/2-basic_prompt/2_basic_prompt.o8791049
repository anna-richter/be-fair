                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            img_t =                                             
                    transform(img).unsqueeze(0).to(device)                      
                            with torch.no_grad():                               
                                logit = model(img_t)                            
                                prob =                                          
