                    imgs.size(-2))                                              
                                        )                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    ta) * lam + crit(logits, tb) * (1 -                         
                    lam)                                                        
                                    else:                                       
                                        logits =                                
                    model(imgs)                                                 
                                        loss = crit(logits,                     
                    targets)                                                    
                                    loss.backward()                             
                                    opt.step()                                  
                                scheduler.step()                                
                                                                                
                            model.eval()                                        
                            all_p, all_t = [], []                               
                            with torch.no_grad():                               
                                for imgs, targets in vl:                        
                                    imgs = imgs.to(device)                      
                                    logits = model(imgs)                        
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    all_p.extend(probs.toli                     
                    st())                                                       
                                    all_t.extend(targets.nu                     
                    mpy().flatten().tolist())                                   
                            auc = roc_auc_score(all_t,                          
                    all_p)                                                      
                            print(f"Fold {fold} ROC AUC:                        
