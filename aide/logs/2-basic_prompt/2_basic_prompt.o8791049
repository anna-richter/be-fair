                    dtype=torch.float32)                                        
                                                                                
                                                                                
                    def predict(images_folder: str,                             
                    model_path: str = "model.pth",                              
                    batch_size: int = 32):                                      
                        """                                                     
                        Predict malignancy probabilities                        
                    for images in the given folder.                             
                        Args:                                                   
                            images_folder (str): Path to                        
                    folder containing images.                                   
                            model_path (str): Path to saved                     
                    model weights.                                              
                            batch_size (int): Batch size                        
