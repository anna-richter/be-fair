                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from sklearn.model_selection import                         
                    StratifiedShuffleSplit                                      
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None, is_test=False):                             
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.is_test = is_test                              
                        def __len__(self):                                      
                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            img_name = self.df.loc[idx,                         
                    'image_name'] + '.jpg'                                      
                            img_path =                                          
                    os.path.join(self.img_dir, img_name)                        
                            img =                                               
                    Image.open(img_path).convert('RGB')                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            if self.is_test:                                    
                                return img,                                     
                    self.df.loc[idx, 'image_name']                              
                            label = self.df.loc[idx,                            
                    'binary_label']                                             
                            return img,                                         
                    torch.tensor(label,                                         
                    dtype=torch.float32)                                        
                                                                                
                    def predict(images_folder: str,                             
                    model_path: str = 'model.pth',                              
                    batch_size: int = 32):                                      
                        """                                                     
                        Predict malignancy probabilities                        
                    for images in the given folder.                             
                        Args:                                                   
                            images_folder (str): Path to                        
                    folder containing images.                                   
                            model_path (str): Path to                           
                    saved model weights.                                        
                            batch_size (int): Batch size                        
                    for inference.                                              
                        Returns:                                                
                            pandas.DataFrame: columns                           
                    ['image_name', 'malignancy_prob'].                          
                        """                                                     
                        device = torch.device('cuda' if                         
                    torch.cuda.is_available() else 'cpu')                       
                        # Build model                                           
                        model =                                                 
                    timm.create_model('resnet18',                               
                    pretrained=False, num_classes=1)                            
                        model.load_state_dict(torch.load(m                      
                    odel_path, map_location=device))                            
                        model.to(device).eval()                                 
                        # Prepare dataset                                       
                        img_files = [f for f in                                 
                    os.listdir(images_folder) if                                
                    f.lower().endswith('.jpg')]                                 
                        df_test =                                               
                    pd.DataFrame({'image_name':                                 
                    [os.path.splitext(f)[0] for f in                            
                    img_files]})                                                
                        transform =                                             
                    T.Compose([T.Resize((224,224)),                             
                    T.ToTensor(),                                               
                                               T.Normalize                      
                    ([0.485,0.456,0.406],[0.229,0.224,0.22                      
                    5])])                                                       
                        ds = SkinDataset(df_test,                               
                    images_folder, transform,                                   
                    is_test=True)                                               
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False)                       
                        results = []                                            
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                for name, p in zip(names,                       
                    probs):                                                     
                                    results.append({'image                      
                    _name': name, 'malignancy_prob':                            
                    float(p)})                                                  
                        return pd.DataFrame(results)                            
                                                                                
                    if __name__ == '__main__':                                  
                        # Configuration                                         
                        CSV_PATH = './input/mydataset.csv'                      
                        IMG_DIR = './input/MyImages'                            
                        MODEL_PATH = 'model.pth'                                
                        BATCH_SIZE = 32                                         
                        EPOCHS = 3                                              
                        lr = 1e-4                                               
                                                                                
                        # Load data                                             
                        df = pd.read_csv(CSV_PATH)                              
                        # Binary label: malignant=1,                            
                    else=0                                                      
                        df['binary_label'] = (df['label']                       
                    == 'malignant').astype(int)                                 
                        # Stratified split                                      
                        splitter =                                              
                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                        train_idx, val_idx =                                    
                    next(splitter.split(df,                                     
                    df['binary_label']))                                        
                        df_train, df_val =                                      
                    df.loc[train_idx], df.loc[val_idx]                          
                                                                                
                        # Transforms                                            
                        train_tf = T.Compose([                                  
                            T.Resize((224,224)),                                
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                        val_tf = T.Compose([                                    
                            T.Resize((224,224)),                                
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                                                                                
                        # Datasets & Loaders                                    
                        train_ds = SkinDataset(df_train,                        
                    IMG_DIR, train_tf)                                          
                        val_ds = SkinDataset(df_val,                            
                    IMG_DIR, val_tf)                                            
                        train_loader =                                          
                    DataLoader(train_ds,                                        
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        device = torch.device('cuda' if                         
                    torch.cuda.is_available() else 'cpu')                       
                        model =                                                 
                    timm.create_model('resnet18',                               
                    pretrained=True, num_classes=1)                             
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=lr)                       
                                                                                
                        # Training loop                                         
                        for epoch in range(EPOCHS):                             
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss +=                                 
                    loss.item() * imgs.size(0)                                  
                            epoch_loss = running_loss /                         
                    len(train_ds)                                               
                            print(f'Epoch                                       
                    {epoch+1}/{EPOCHS}, Training Loss:                          
                    {epoch_loss:.4f}')                                          
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_logits, all_labels = [], []                         
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1).cpu().numpy()                        
                                all_logits.extend(logits)                       
                                all_labels.extend(labels.n                      
                    umpy())                                                     
                        probs = 1 / (1 +                                        
                    np.exp(-np.array(all_logits)))                              
                        auc = roc_auc_score(all_labels,                         
                    probs)                                                      
                        print(f'Validation ROC AUC:                             
                    {auc:.4f}')                                                 
                                                                                
                        # Save model                                            
                        torch.save(model.state_dict(),                          
                    MODEL_PATH)                                                 
                                                                                
