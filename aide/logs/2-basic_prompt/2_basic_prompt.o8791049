                    lr=1e-4)                                                    
                        # Training with mixup                                   
                        epochs = 3                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs, targets =                                 
                    imgs.to(device), targets.to(device)                         
                                mixed_imgs, mixed_targets =                     
                    mixup_data(imgs, targets, alpha=0.4)                        
                                optimizer.zero_grad()                           
                                logits = model(mixed_imgs)                      
                                loss =                                          
