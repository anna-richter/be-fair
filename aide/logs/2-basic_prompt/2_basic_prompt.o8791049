                    ## Code                                                     
                                                                                
                    ```python                                                   
                    import os                                                   
                    import random                                               
                    import numpy as np                                          
                    import pandas as pd                                         
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from PIL import Image                                       
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    def rand_bbox(size, lam):                                   
                        # size: (batch_size, C, H, W)                           
                        _, _, H, W = size                                       
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(cx - cut_w // 2, 0,                      
                    W)                                                          
                        bby1 = np.clip(cy - cut_h // 2, 0,                      
                    H)                                                          
                        bbx2 = np.clip(cx + cut_w // 2, 0,                      
                    W)                                                          
                        bby2 = np.clip(cy + cut_h // 2, 0,                      
                    H)                                                          
                        return bbx1, bby1, bbx2, bby2                           
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in folder_path.                              
                        Returns a DataFrame with columns:                       
                    image_name, probability.                                    
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load("w                     
                    orking/model.pth",                                          
                    map_location=device))                                       
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder_path)):                            
                            if not                                              
                    fname.lower().endswith((".jpg",                             
                    ".jpeg", ".png")):                                          
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            img_t =                                             
                    transform(img).unsqueeze(0).to(device)                      
                            with torch.no_grad():                               
                                logit = model(img_t)                            
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                            results.append({"image_name":                       
                    os.path.splitext(fname)[0],                                 
                    "probability": prob})                                       
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        csv_path = os.path.join("input",                        
                    "mydataset.csv")                                            
                        img_dir = os.path.join("input",                         
                    "MyImages")                                                 
                                                                                
                        # Load and prepare data                                 
                        df = pd.read_csv(csv_path)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["target"], random_state=42                      
                        )                                                       
                                                                                
                        # Transforms                                            
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets & Loaders                                    
                        train_ds = SkinDataset(train_df,                        
                    img_dir, transform)                                         
                        val_ds = SkinDataset(val_df,                            
                    img_dir, transform)                                         
                        train_loader = DataLoader(                              
                            train_ds, batch_size=32,                            
                    shuffle=True, num_workers=4,                                
                    pin_memory=True                                             
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=32,                              
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Device, model, loss, optimizer                        
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.to(device)                                        
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # CutMix parameters                                     
                        cutmix_prob = 0.5                                       
                        cutmix_alpha = 1.0                                      
                                                                                
                        # Training loop with CutMix                             
                        epochs = 3                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            for imgs, targets in                                
                    train_loader:                                               
                                imgs = imgs.to(device)                          
                                targets =                                       
                    targets.to(device).unsqueeze(1)                             
                                r = np.random.rand()                            
                                if r < cutmix_prob:                             
                                    lam =                                       
                    np.random.beta(cutmix_alpha,                                
                    cutmix_alpha)                                               
                                    rand_index =                                
                    torch.randperm(imgs.size(0)).to(device)                     
                                    target_a = targets                          
                                    target_b =                                  
                    targets[rand_index]                                         
                                    bbx1, bby1, bbx2, bby2                      
                    = rand_bbox(imgs.size(), lam)                               
                                    imgs[:, :, bby1:bby2,                       
                    bbx1:bbx2] = imgs[                                          
                                        rand_index, :,                          
                    bby1:bby2, bbx1:bbx2                                        
                                    ]                                           
                                    lam = 1 - (                                 
                                        (bbx2 - bbx1) *                         
                    (bby2 - bby1) / (imgs.size(-1) *                            
                    imgs.size(-2))                                              
                                    )                                           
                                    optimizer.zero_grad()                       
                                    logits = model(imgs)                        
                                    loss =                                      
                    criterion(logits, target_a) * lam +                         
                    criterion(                                                  
                                        logits, target_b                        
                                    ) * (1 - lam)                               
                                else:                                           
                                    optimizer.zero_grad()                       
                                    logits = model(imgs)                        
                                    loss =                                      
                    criterion(logits, targets)                                  
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_probs, all_targets = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in                                
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_targets.extend(targets.                     
                    numpy().flatten().tolist())                                 
                        roc_auc =                                               
                    roc_auc_score(all_targets, all_probs)                       
                        print(f"Validation ROC AUC:                             
                    {roc_auc:.4f}")                                             
                                                                                
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                        # Optional: create submission if                        
                    test folder exists                                          
                        test_folder = os.path.join("input",                     
                    "test")                                                     
                        if os.path.exists(test_folder):                         
                            sub = predict(test_folder)                          
                            sub.to_csv(os.path.join("workin                     
                    g", "submission.csv"), index=False)                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
