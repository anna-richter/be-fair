# Dataset
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.loc[idx]
        img = Image.open(os.path.join(self.img_dir, row.image_name + ".jpg")).convert(
            "RGB"
        )
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row.binary_label, dtype=torch.float32)
        return img, label, row.skin_tone, row.image_name


# Model factory
def get_model():
    m = models.resnet18(pretrained=True)
    m.fc = nn.Linear(m.fc.in_features, 1)
    return m.to(DEVICE)


# Mixup utilities
def mixup_data(x, y, alpha=MIXUP_ALPHA):
    if alpha > 0:
        lam = np.random.beta(alpha, alpha)
    else:
        lam = 1.0
    batch_size = x.size(0)
    index = torch.randperm(batch_size).to(DEVICE)
    mixed_x = lam * x + (1 - lam) * x[index]
    y_a, y_b = y, y[index]
    return mixed_x, y_a, y_b, lam


def mixup_criterion(criterion, pred, y_a, y_b, lam):
    return lam * criterion(pred, y_a) + (1 - lam) * criterion(pred, y_b)


# Training one epoch with mixup
def train_one_epoch(model, loader, criterion, optimizer):
    model.train()
    running_loss = 0.0
    for imgs, labels, _, _ in loader:
        imgs = imgs.to(DEVICE)
        labels = labels.to(DEVICE).unsqueeze(1)
        # apply mixup
        mixed_imgs, y_a, y_b, lam = mixup_data(imgs, labels)
        optimizer.zero_grad()
        outputs = model(mixed_imgs)
        loss = mixup_criterion(criterion, outputs, y_a, y_b, lam)
        loss.backward()
        optimizer.step()
        running_loss += loss.item() * imgs.size(0)
    return running_loss / len(loader.dataset)


# Evaluation with TTA
def evaluate_with_tta(model, loader):
    model.eval()
    all_labels, all_preds = [], []
    with torch.no_grad():
        for imgs, labels, _, _ in loader:
            imgs = imgs.to(DEVICE)
            out1 = model(imgs)
            p1 = torch.sigmoid(out1)
            imgs_f = torch.flip(imgs, dims=[3])
            out2 = model(imgs_f)
            p2 = torch.sigmoid(out2)
            probs = ((p1 + p2) / 2.0).cpu().numpy().flatten()
            all_preds.extend(probs)
            all_labels.extend(labels.numpy().flatten())
    return roc_auc_score(all_labels, all_preds)


# Prediction function
def predict(model_path, image_folder, batch_size=32):
    """
    Load a trained model and predict malignancy probability for images.
    Returns dict {image_name: probability}.
    """
    model = get_model()
    model.load_state_dict(torch.load(model_path, map_location=DEVICE))
    model.eval()
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    imgs, names = [], []
    for fname in os.listdir(image_folder):
        if fname.lower().endswith((".jpg", ".png")):
            img = Image.open(os.path.join(image_folder, fname)).convert("RGB")
            imgs.append(transform(img))
            names.append(os.path.splitext(fname)[0])
    if not imgs:
        return {}
    dataset = torch.stack(imgs)
    probs = []
    with torch.no_grad():
        for i in range(0, len(dataset), batch_size):
            batch = dataset[i : i + batch_size].to(DEVICE)
            out1 = model(batch)
            p1 = torch.sigmoid(out1)
            batch_f = torch.flip(batch, dims=[3])
            out2 = model(batch_f)
            p2 = torch.sigmoid(out2)
            probs.extend(((p1 + p2) / 2.0).cpu().numpy().flatten())
    return dict(zip(names, probs))


