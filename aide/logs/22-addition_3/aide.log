        )

        model = get_model()
        criterion = FocalLoss(alpha=0.25, gamma=2.0)
        optimizer = optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-4)
        scheduler = OneCycleLR(
            optimizer, max_lr=3e-4, steps_per_epoch=len(train_loader), epochs=EPOCHS
        )

        for epoch in range(EPOCHS):
            _ = train_one_epoch(model, train_loader, criterion, optimizer, scheduler)
        auc = evaluate_with_tta(model, val_loader)
        print(f"Fold {fold+1} AUROC with RandAugment: {auc:.4f}")
        fold_aucs.append(auc)

        # save each fold model for ensembling
        os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
        path = MODEL_PATH.replace(".pth", f"_fold{fold+1}.pth")
        torch.save(model.state_dict(), path)
        model_paths.append(path)

    mean_auc = np.mean(fold_aucs)
    print(f"Mean AUROC with RandAugment: {mean_auc:.4f}")

    # final ensemble predictions on test set
    if os.path.exists(TEST_DIR) and os.listdir(TEST_DIR):
        all_preds = []
        for mp in model_paths:
            preds = predict(mp, TEST_DIR)
            all_preds.append(pd.Series(preds))
        df_ens = pd.concat(all_preds, axis=1).mean(axis=1)
        submission = pd.DataFrame(
            {"image_name": df_ens.index, "malignancy_probability": df_ens.values}
        )
        submission.to_csv("./working/submission.csv", index=False)
        print("Saved ensemble submission.csv with test predictions.")

