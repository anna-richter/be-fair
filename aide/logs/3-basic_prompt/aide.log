Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as transforms
import timm


# Dataset definition
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        image = Image.open(img_path).convert("RGB")
        image = self.transform(image)
        label = torch.tensor(row["target"], dtype=torch.float32)
        return image, label


# Prediction function
def predict(folder_path, model_path="./working/model.pth", batch_size=32):
    """
    Load the saved model and return a DataFrame with columns ['image_name','probability']
    for all .jpg images in folder_path.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # Model
    model = timm.create_model("efficientnet_b0", pretrained=False, num_classes=1)
    model.load_state_dict(torch.load(model_path, map_location=device))
    model.to(device).eval()
    # Transform
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    # Gather images
    files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    results = []
    loader = DataLoader(files, batch_size=batch_size, shuffle=False)
    for batch in loader:
        imgs = []
        for fname in batch:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            imgs.append(transform(img))
        imgs = torch.stack(imgs).to(device)
        with torch.no_grad():
            out = model(imgs).squeeze(1)
            probs = torch.sigmoid(out).cpu().numpy()
        for fname, p in zip(batch, probs):
            results.append({"image_name": fname, "probability": float(p)})
    return pd.DataFrame(results)


def main():
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # Load and prepare data
    df = pd.read_csv("./input/mydataset.csv")
    df = df[df["label"].isin(["benign", "malignant"])].copy()
    df["target"] = df["label"].map({"benign": 0, "malignant": 1})
    img_dir = "./input/MyImages"
    # Transforms
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    # Cross-validation
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"]), 1):
        train_df = df.iloc[train_idx]
        val_df = df.iloc[val_idx]
        train_ds = SkinDataset(train_df, img_dir, transform)
        val_ds = SkinDataset(val_df, img_dir, transform)
        train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=2)
        val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=2)
        # Model
        model = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1)
        model.to(device)
        criterion = nn.BCEWithLogitsLoss()
        optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
        # Train for 3 epochs
        for epoch in range(3):
            model.train()
            for imgs, labels in train_loader:
                imgs, labels = imgs.to(device), labels.to(device)
                optimizer.zero_grad()
                outputs = model(imgs).squeeze(1)
                loss = criterion(outputs, labels)
                loss.backward()
                optimizer.step()
        # Validate
        model.eval()
        preds, trues = [], []
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs = imgs.to(device)
                out = model(imgs).squeeze(1)
                probs = torch.sigmoid(out).cpu().numpy()
                preds.extend(probs.tolist())
                trues.extend(labels.numpy().tolist())
        auc = roc_auc_score(trues, preds)
        print(f"Fold {fold} ROC AUC: {auc:.4f}")
        aucs.append(auc)
    mean_auc = np.mean(aucs)
    print(f"Mean CV ROC AUC: {mean_auc:.4f}")
    # Retrain on full data
    full_ds = SkinDataset(df, img_dir, transform)
    full_loader = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=2)
    model = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1).to(
        device
    )
    criterion = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
    for epoch in range(5):
        model.train()
        for imgs, labels in full_loader:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(imgs).squeeze(1)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
    # Save final model
    os.makedirs("./working", exist_ok=True)
    torch.save(model.state_dict(), "./working/model.pth")


if __name__ == "__main__":
    main()

