import os
import pandas as pd
import numpy as np
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from PIL import Image
import lightgbm as lgb
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score

class ImageDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform
    def __len__(self):
        return len(self.paths)
    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert('RGB')
        return self.transform(img)

def main():
    # Load and preprocess labels
    df = pd.read_csv('./input/mydataset.csv')
    df = df[df['label'].isin(['malignant', 'benign'])].reset_index(drop=True)
    df['target'] = (df['label'] == 'malignant').astype(int)
    img_paths = df['image_name'].apply(lambda x: f'./input/MyImages/{x}.jpg').tolist()
    labels = df['target'].values

    # Image transforms
    transform = transforms.Compose([
        transforms.Resize((224,224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])
    ])

    # Setup device and feature extractor
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    cnn = models.resnet50(pretrained=True)
    cnn.fc = torch.nn.Identity()
    cnn = cnn.to(device).eval()

    # Extract features
    ds = ImageDataset(img_paths, transform)
    loader = DataLoader(ds, batch_size=32, shuffle=False, num_workers=4)
    feats_list = []
    with torch.no_grad():
        for batch in loader:
            batch = batch.to(device)
            feats = cnn(batch)
            feats_list.append(feats.cpu().numpy())
    features = np.vstack(feats_list)

    # 5-fold CV with LightGBM
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for tr_idx, val_idx in skf.split(features, labels):
        X_tr, X_val = features[tr_idx], features[val_idx]
        y_tr, y_val = labels[tr_idx], labels[val_idx]
        clf = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05)
        clf.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], eval_metric='auc',
                early_stopping_rounds=50, verbose=False)
        preds = clf.predict_proba(X_val)[:,1]
        aucs.append(roc_auc_score(y_val, preds))
    print(f"CV ROC AUC scores: {aucs}")
    print("Mean CV ROC AUC:", np.mean(aucs))

    # Retrain on full data and save
    best_iter = clf.best_iteration_ or 1000
    final_clf = lgb.LGBMClassifier(n_estimators=best_iter, learning_rate=0.05)
    final_clf.fit(features, labels)
    final_clf.booster_.save_model('lgb_model.txt')

    # Prediction function
    def predict(folder_path):
        """
        Predict malignancy probabilities for all images in folder_path.
        Returns a dict mapping filename to probability.
        """
        booster = lgb.Booster(model_file='lgb_model.txt')
        cnn_p = models.resnet50(pretrained=True)
        cnn_p.fc = torch.nn.Identity()
        cnn_p = cnn_p.to(device).eval()
        results = {}
        for fname in os.listdir(folder_path):
            if fname.lower().endswith(('.jpg','.png','.jpeg')):
                img = Image.open(os.path.join(folder_path, fname)).convert('RGB')
                x = transform(img).unsqueeze(0).to(device)
                with torch.no_grad():
                    feat = cnn_p(x).cpu().numpy()
                results[fname] = booster.predict(feat)[0]
        return results

    # Example usage:
    # preds = predict('./input/MyImages')
    # print(list(preds.items())[:5])

if __name__ == '__main__':
    main()
