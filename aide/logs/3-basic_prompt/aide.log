import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms
import lightgbm as lgb
from lightgbm.callback import early_stopping, log_evaluation
import joblib


class ImageDataset(Dataset):
    def __init__(self, img_paths, transform):
        self.img_paths = img_paths
        self.transform = transform

    def __len__(self):
        return len(self.img_paths)

    def __getitem__(self, idx):
        img = Image.open(self.img_paths[idx]).convert("RGB")
        return self.transform(img)


def extract_features(model, dataloader, device):
    model.eval()
    feats = []
    with torch.no_grad():
        for batch in dataloader:
            batch = batch.to(device)
            out = model(batch)
            feats.append(out.cpu().numpy())
    return np.vstack(feats)


def predict(folder_path):
    """
    Predict malignancy probabilities for all images in folder_path.
    Returns a dict {filename: probability}.
    """
    clf = joblib.load(os.path.join("working", "lgb_model.joblib"))
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    resnet = models.resnet18(pretrained=True)
    resnet.fc = torch.nn.Identity()
    resnet = resnet.to(device)
    tr = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    img_files = [
        f for f in os.listdir(folder_path) if f.lower().endswith((".jpg", ".png"))
    ]
    img_paths = [os.path.join(folder_path, f) for f in img_files]
    ds = ImageDataset(img_paths, tr)
    dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    feats = extract_features(resnet, dl, device)
    probs = clf.predict_proba(feats)[:, 1]
    return dict(zip(img_files, probs))


def main():
    # load and prepare data
    df = pd.read_csv(os.path.join("input", "mydataset.csv"))
    df = df[df["label"].isin(["malignant", "benign"])].reset_index(drop=True)
    label_map = {"benign": 0, "malignant": 1}
    y = df["label"].map(label_map).values
    img_dir = os.path.join("input", "MyImages")
    img_paths = [os.path.join(img_dir, f"{n}.jpg") for n in df["image_name"]]
    # feature extractor setup
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    resnet = models.resnet18(pretrained=True)
    resnet.fc = torch.nn.Identity()
    resnet = resnet.to(device)
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    ds = ImageDataset(img_paths, transform)
    dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    print("Extracting features...")
    X = extract_features(resnet, dl, device)
    # 5-fold CV with early stopping via callbacks
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
        X_tr, y_tr = X[tr_idx], y[tr_idx]
        X_va, y_va = X[va_idx], y[va_idx]
        clf = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05)
        clf.fit(
            X_tr,
            y_tr,
            eval_set=[(X_va, y_va)],
            eval_metric="auc",
            callbacks=[early_stopping(stopping_rounds=50), log_evaluation(period=0)],
        )
        p = clf.predict_proba(X_va)[:, 1]
        auc = roc_auc_score(y_va, p)
        print(f"Fold {fold} AUC: {auc:.4f}")
        aucs.append(auc)
    print(f"Mean CV AUC: {np.mean(aucs):.4f}")
    # retrain on full data and save model
    final_clf = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05)
    final_clf.fit(X, y)
    os.makedirs("working", exist_ok=True)
    joblib.dump(final_clf, os.path.join("working", "lgb_model.joblib"))
    print("Model saved to working/lgb_model.joblib")


if __name__ == "__main__":
    main()

