            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    # gather image paths
    img_files = [
        f for f in os.listdir(folder_path) if f.lower().endswith((".jpg", ".png"))
    ]
    img_paths = [os.path.join(folder_path, f) for f in img_files]
    ds = ImageDataset(img_paths, tr)
    dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    feats = extract_features(resnet, dl, device)
    probs = clf.predict_proba(feats)[:, 1]
    return dict(zip(img_files, probs))


