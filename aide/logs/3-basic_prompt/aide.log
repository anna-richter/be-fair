import random

# fix random seeds
seed = 42
torch.manual_seed(seed)
np.random.seed(seed)
random.seed(seed)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(seed)

class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
