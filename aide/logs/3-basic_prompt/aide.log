    img_dir = os.path.join("input", "MyImages")
    img_paths = [os.path.join(img_dir, f"{n}.jpg") for n in df["image_name"]]
    # model setup
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    resnet = models.resnet18(pretrained=True)
    resnet.fc = torch.nn.Identity()
    resnet = resnet.to(device)
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    ds = ImageDataset(img_paths, transform)
    dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    print("Extracting features...")
    X = extract_features(resnet, dl, device)
    # 5-fold CV
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
        X_tr, y_tr = X[tr_idx], y[tr_idx]
