            X_tr,
            y_tr,
            eval_set=[(X_va, y_va)],
            eval_metric="auc",
            early_stopping_rounds=50,
            verbose=False,
        )
        p = clf.predict_proba(X_va)[:, 1]
        auc = roc_auc_score(y_va, p)
        print(f"Fold {fold} AUC: {auc:.4f}")
        aucs.append(auc)
    print(f"Mean CV AUC: {np.mean(aucs):.4f}")
    # retrain on full data and save model
    final_clf = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05)
    final_clf.fit(X, y)
    os.makedirs("working", exist_ok=True)
    joblib.dump(final_clf, os.path.join("working", "lgb_model.joblib"))
    print("Model saved to working/lgb_model.joblib")


if __name__ == "__main__":
    main()

