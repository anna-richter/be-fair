Code: import os
import pickle
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from sklearn.ensemble import RandomForestClassifier
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms


class ImageFolderDataset(Dataset):
    def __init__(self, filenames, folder, transform):
        self.filenames = filenames
        self.folder = folder
        self.transform = transform

    def __len__(self):
        return len(self.filenames)

    def __getitem__(self, idx):
        fname = self.filenames[idx]
        path = os.path.join(self.folder, fname)
        img = Image.open(path).convert("RGB")
        return self.transform(img), idx


def extract_image_features(image_folder):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    filenames = sorted(
        [f for f in os.listdir(image_folder) if f.lower().endswith((".jpg", ".png"))]
    )
    transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ]
    )
    ds = ImageFolderDataset(filenames, image_folder, transform)
    loader = DataLoader(ds, batch_size=32, shuffle=False, num_workers=4)
    cnn = models.resnet18(pretrained=True)
    cnn = nn.Sequential(*list(cnn.children())[:-1]).to(device).eval()
    features = np.zeros((len(filenames), 512), dtype=np.float32)
    with torch.no_grad():
        for imgs, idxs in loader:
            imgs = imgs.to(device)
            out = cnn(imgs).view(imgs.size(0), -1).cpu().numpy()
            for i, idx in enumerate(idxs.numpy()):
                features[idx] = out[i]
    image_names = [os.path.splitext(f)[0] for f in filenames]
    return image_names, features


def main():
    # Load labels
    df = pd.read_csv("./input/mydataset.csv")
    df["label_binary"] = (df["label"] == "malignant").astype(int)
    img_folder = "./input/MyImages"
    image_names, X = extract_image_features(img_folder)
    label_map = dict(zip(df["image_name"], df["label_binary"]))
    y = np.array([label_map[name] for name in image_names], dtype=int)

    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for train_idx, val_idx in skf.split(X, y):
        X_train, X_val = X[train_idx], X[val_idx]
        y_train, y_val = y[train_idx], y[val_idx]
        model = RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=42)
        model.fit(X_train, y_train)
        preds = model.predict_proba(X_val)[:, 1]
        aucs.append(roc_auc_score(y_val, preds))
    print(f"Mean CV AUROC: {np.mean(aucs):.4f}")

    # Retrain on all data
    final_model = RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=42)
    final_model.fit(X, y)
    os.makedirs("working", exist_ok=True)
    with open("working/rf_model.pkl", "wb") as f:
        pickle.dump(final_model, f)


def predict(image_folder):
    """
    Predict malignancy probabilities for images in a folder using the saved model.
    Args:
      image_folder (str): path to folder of .jpg/.png images
    Returns:
      dict: mapping image_name (without extension) to malignancy probability [0-1]
    """
    model = pickle.load(open("working/rf_model.pkl", "rb"))
    image_names, X = extract_image_features(image_folder)
    probs = model.predict_proba(X)[:, 1]
    return dict(zip(image_names, probs))


if __name__ == "__main__":
    main()

Results: The training script successfully extracted image features using a pretrained ResNet-18, then trained a RandomForestClassifier on these features with 5-fold stratified cross-validation. The mean cross-validation AUROC of 0.8128 indicates good discriminative performance for classifying malignant vs benign lesions. The final model was saved correctly and a prediction function was provided to output malignancy probabilities for new images.
Validation Metric: 0.8128

-------------------------------
Design: I propose to integrate MixUp augmentation into the training loop to improve generalization by blending image pairs and their labels. We will sample a mixing coefficient from a Beta distribution (α=0.4), combine inputs and targets accordingly, and compute a weighted BCE loss. This atomic change keeps the DenseNet121 backbone and existing transforms unchanged but enhances robustness. Finally, we will evaluate on the hold‐out set and print the best validation AUROC.
Code: import os
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from PIL import Image
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import numpy as np

# Configuration
DATA_CSV = "./input/mydataset.csv"
IMAGES_DIR = "./input/MyImages"
MODEL_PATH = "./working/densenet121_mixup.pth"
BATCH_SIZE = 32
NUM_EPOCHS = 5
LR = 1e-4
IMAGE_SIZE = 224
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
SEED = 42
MIXUP_ALPHA = 0.4

torch.manual_seed(SEED)
np.random.seed(SEED)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)


# Dataset class
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        image = Image.open(img_path).convert("RGB")
        if self.transform:
            image = self.transform(image)
        label = torch.tensor(row["binary_label"], dtype=torch.float32)
        return image, label


# MixUp functions
def mixup_data(x, y, alpha=MIXUP_ALPHA):
    if alpha > 0:
        lam = np.random.beta(alpha, alpha)
    else:
        lam = 1.0
    batch_size = x.size(0)
    index = torch.randperm(batch_size).to(DEVICE)
    mixed_x = lam * x + (1 - lam) * x[index]
    y_a, y_b = y, y[index]
    return mixed_x, y_a, y_b, lam


def mixup_criterion(criterion, pred, y_a, y_b, lam):
    return lam * criterion(pred, y_a) + (1 - lam) * criterion(pred, y_b)


# Transforms
train_transform = transforms.Compose(
    [
        transforms.RandomResizedCrop(IMAGE_SIZE),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)
val_transform = transforms.Compose(
    [
        transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


def main():
    # Load and prepare data
    df = pd.read_csv(DATA_CSV)
    df["binary_label"] = df["label"].apply(lambda x: 1 if x == "malignant" else 0)
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["binary_label"], random_state=SEED
    )
    train_ds = SkinDataset(train_df, IMAGES_DIR, transform=train_transform)
    val_ds = SkinDataset(val_df, IMAGES_DIR, transform=val_transform)
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    # Model setup
    model = models.densenet121(pretrained=True)
    in_features = model.classifier.in_features
    model.classifier = nn.Linear(in_features, 1)
    model = model.to(DEVICE)
    criterion = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)

    best_auroc = 0.0
    for epoch in range(1, NUM_EPOCHS + 1):
        model.train()
        running_loss = 0.0
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
            # Apply MixUp
            mixed_imgs, y_a, y_b, lam = mixup_data(imgs, labels)
            optimizer.zero_grad()
            outputs = model(mixed_imgs)
            loss = mixup_criterion(criterion, outputs, y_a, y_b, lam)
            loss.backward()
            optimizer.step()
            running_loss += loss.item() * imgs.size(0)
        epoch_loss = running_loss / len(train_ds)

        # Validation
        model.eval()
        all_preds, all_labels = [], []
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs = imgs.to(DEVICE)
                outputs = model(imgs)
                probs = torch.sigmoid(outputs).cpu().numpy().flatten()
                all_preds.extend(probs)
                all_labels.extend(labels.numpy().flatten())
        auroc = roc_auc_score(all_labels, all_preds)
        print(
            f"Epoch {epoch}/{NUM_EPOCHS} - Loss: {epoch_loss:.4f} - Val AUROC: {auroc:.4f}"
        )
        if auroc > best_auroc:
            best_auroc = auroc
            torch.save(model.state_dict(), MODEL_PATH)

    print(f"Best Validation AUROC: {best_auroc:.4f}")


def predict(image_folder, model_path=MODEL_PATH, batch_size=32):
    """
    Predict malignancy probabilities for images in a folder using the trained model.
    Args:
        image_folder (str): Path to the folder with .jpg images.
        model_path (str): Path to the saved model weights.
        batch_size (int): Inference batch size.
    Returns:
        dict: filename -> malignancy probability (0-1).
    """
    model = models.densenet121(pretrained=False)
    in_features = model.classifier.in_features
    model.classifier = nn.Linear(in_features, 1)
    model.load_state_dict(torch.load(model_path, map_location=DEVICE))
    model = model.to(DEVICE).eval()

    img_names = [f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")]
    results = {}
    transform = val_transform
    loader = DataLoader(img_names, batch_size=batch_size, shuffle=False)
    with torch.no_grad():
        for batch in loader:
            imgs = []
            for fname in batch:
                img = Image.open(os.path.join(image_folder, fname)).convert("RGB")
                imgs.append(transform(img))
            imgs = torch.stack(imgs).to(DEVICE)
            outputs = model(imgs)
            probs = torch.sigmoid(outputs).cpu().numpy().flatten()
            for fname, prob in zip(batch, probs):
                results[fname] = float(prob)
    return results


if __name__ == "__main__":
    main()

Results: The training script executed successfully without errors. The model was trained for 5 epochs using a DenseNet121 backbone with MixUp augmentation. The validation AUROC improved steadily, reaching a best value of 0.9019, indicating good classification performance for malignancy detection in skin lesions. The model weights were saved correctly for later inference.
Validation Metric: 0.9019

