import os
import pickle
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms
from xgboost import XGBClassifier

class ImageFolderDataset(Dataset):
    def __init__(self, filenames, folder, transform):
        self.filenames = filenames
        self.folder = folder
        self.transform = transform
    def __len__(self):
        return len(self.filenames)
    def __getitem__(self, idx):
        fname = self.filenames[idx]
        path = os.path.join(self.folder, fname)
        img = Image.open(path).convert('RGB')
        return self.transform(img), idx

def extract_image_features(image_folder):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    # Prepare list of image files and stable ordering
    filenames = sorted([f for f in os.listdir(image_folder) if f.lower().endswith(('.jpg','.png'))])
    # ImageNet preprocessing
    transform = transforms.Compose([
        transforms.Resize(256), transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
    ])
    ds = ImageFolderDataset(filenames, image_folder, transform)
    loader = DataLoader(ds, batch_size=32, shuffle=False, num_workers=4)
    # Load pretrained ResNet18 and remove final FC
    cnn = models.resnet18(pretrained=True)
    cnn = nn.Sequential(*list(cnn.children())[:-1]).to(device).eval()
    features = np.zeros((len(filenames), 512), dtype=np.float32)
    with torch.no_grad():
        for imgs, idxs in loader:
            imgs = imgs.to(device)
            out = cnn(imgs).view(imgs.size(0), -1).cpu().numpy()
            for i, idx in enumerate(idxs.numpy()):
                features[idx] = out[i]
    image_names = [os.path.splitext(f)[0] for f in filenames]
    return image_names, features

def main():
    # Load labels
    df = pd.read_csv('./input/mydataset.csv')
    df['label_binary'] = (df['label']=='malignant').astype(int)
    # Extract features
    img_folder = './input/MyImages'
    image_names, X = extract_image_features(img_folder)
    # Build label vector aligned to image_names
    label_map = dict(zip(df['image_name'], df['label_binary']))
    y = np.array([label_map[name] for name in image_names], dtype=int)
    # 5-fold CV
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for train_idx, val_idx in skf.split(X, y):
        X_train, X_val = X[train_idx], X[val_idx]
        y_train, y_val = y[train_idx], y[val_idx]
        model = XGBClassifier(use_label_encoder=False, eval_metric='logloss', random_state=42)
        model.fit(X_train, y_train)
        preds = model.predict_proba(X_val)[:,1]
        aucs.append(roc_auc_score(y_val, preds))
    print(f"Mean CV AUROC: {np.mean(aucs):.4f}")
    # Retrain on all data and save
    final_model = XGBClassifier(use_label_encoder=False, eval_metric='logloss', random_state=42)
    final_model.fit(X, y)
    os.makedirs('working', exist_ok=True)
    with open('working/xgb_model.pkl', 'wb') as f:
        pickle.dump(final_model, f)

def predict(image_folder):
    """
    Load the saved XGBoost model and ResNet18 feature extractor to predict malignancy.
    Args:
      image_folder (str): path to folder of .jpg/.png images
    Returns:
      dict: mapping image_name (without extension) to malignancy probability [0-1]
    """
    # Load model
    model = pickle.load(open('working/xgb_model.pkl','rb'))
    # Extract features
    image_names, X = extract_image_features(image_folder)
    probs = model.predict_proba(X)[:,1]
    return dict(zip(image_names, probs))

if __name__ == '__main__':
    main()
```
