# Transforms with RandomErasing augmentation
train_transform = transforms.Compose(
    [
        transforms.RandomResizedCrop(IMAGE_SIZE),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.RandomErasing(
            p=0.5, scale=(0.02, 0.33), ratio=(0.3, 3.3), value="random"
        ),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)
val_transform = transforms.Compose(
    [
        transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


def main():
    # Load data
    df = pd.read_csv(DATA_CSV)
    df["binary_label"] = df["label"].apply(lambda x: 1 if x == "malignant" else 0)
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["binary_label"], random_state=SEED
    )

    # Weighted sampler
    class_counts = train_df["binary_label"].value_counts().to_dict()
    weights = train_df["binary_label"].map(lambda x: 1.0 / class_counts[x]).values
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)

    train_ds = SkinDataset(train_df, IMAGES_DIR, transform=train_transform)
    val_ds = SkinDataset(val_df, IMAGES_DIR, transform=val_transform)
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    # Model setup
    model = models.densenet121(pretrained=True)
    in_features = model.classifier.in_features
    model.classifier = nn.Linear(in_features, 1)
    model = model.to(DEVICE)

    criterion = nn.BCEWithLogitsLoss(reduction="none")
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)

    best_auroc = 0.0
    for epoch in range(1, NUM_EPOCHS + 1):
        model.train()
        running_loss = 0.0
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
            optimizer.zero_grad()

            # CutMix augmentation
            if np.random.rand() < CUTMIX_PROB:
                lam = np.random.beta(CUTMIX_ALPHA, CUTMIX_ALPHA)
                rand_index = torch.randperm(imgs.size(0)).to(DEVICE)
                target_a = labels
                target_b = labels[rand_index]
                x1, y1, x2, y2 = rand_bbox(imgs.size(), lam)
                imgs[:, :, y1:y2, x1:x2] = imgs[rand_index, :, y1:y2, x1:x2]
                lam_adjusted = 1 - ((x2 - x1) * (y2 - y1) / (IMAGE_SIZE * IMAGE_SIZE))
                outputs = model(imgs)
                loss = (
                    lam_adjusted * criterion(outputs, target_a).mean()
                    + (1 - lam_adjusted) * criterion(outputs, target_b).mean()
                )
            else:
                outputs = model(imgs)
                loss = criterion(outputs, labels).mean()

            loss.backward()
            optimizer.step()
            running_loss += loss.item() * imgs.size(0)

        epoch_loss = running_loss / len(train_ds)

        # Validation with TTA (original + horizontal flip)
        model.eval()
        all_preds, all_labels = [], []
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs = imgs.to(DEVICE)
                # original
                outputs1 = model(imgs)
                probs1 = torch.sigmoid(outputs1)
                # flipped
                flipped = torch.flip(imgs, dims=[3])
                outputs2 = model(flipped)
                probs2 = torch.sigmoid(outputs2)
                # average
                probs = ((probs1 + probs2) / 2).cpu().numpy().flatten()
                all_preds.extend(probs)
                all_labels.extend(labels.numpy().flatten())
        auroc = roc_auc_score(all_labels, all_preds)
        print(
            f"Epoch {epoch}/{NUM_EPOCHS} - Loss: {epoch_loss:.4f} - Val AUROC: {auroc:.4f}"
        )
        if auroc > best_auroc:
            best_auroc = auroc
            torch.save(model.state_dict(), MODEL_PATH)

    print(f"Best Validation AUROC: {best_auroc:.4f}")


def predict(image_folder, model_path=MODEL_PATH, batch_size=32):
    """
    Load the trained model and predict malignancy probabilities for images in a folder using TTA.
    Args:
        image_folder (str): Path to folder containing .jpg images.
        model_path (str): Path to the saved model .pth file.
        batch_size (int): Batch size for inference.
    Returns:
        dict: Mapping from image filename to malignancy probability (0-1).
    """
    model = models.densenet121(pretrained=False)
    in_features = model.classifier.in_features
    model.classifier = nn.Linear(in_features, 1)
    model.load_state_dict(torch.load(model_path, map_location=DEVICE))
    model = model.to(DEVICE).eval()

    img_names = [f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")]
    transform = val_transform
    results = {}
    for i in range(0, len(img_names), batch_size):
        batch = img_names[i : i + batch_size]
        imgs = []
        for fname in batch:
            img = Image.open(os.path.join(image_folder, fname)).convert("RGB")
            imgs.append(transform(img))
        imgs = torch.stack(imgs).to(DEVICE)
        with torch.no_grad():
            out1 = model(imgs)
            out2 = model(torch.flip(imgs, dims=[3]))
            probs = torch.sigmoid((out1 + out2) / 2).cpu().numpy().flatten()
        for fname, prob in zip(batch, probs):
            results[fname] = float(prob)
    return results


