            optimizer.zero_grad()

            # CutMix augmentation
            r = np.random.rand()
            if r < CUTMIX_PROB:
                lam = np.random.beta(CUTMIX_ALPHA, CUTMIX_ALPHA)
                rand_index = torch.randperm(imgs.size(0)).to(DEVICE)
                target_a = labels
                target_b = labels[rand_index]
                x1, y1, x2, y2 = rand_bbox(imgs.size(), lam)
                imgs[:, :, y1:y2, x1:x2] = imgs[rand_index, :, y1:y2, x1:x2]
                lam_adjusted = 1 - ((x2 - x1) * (y2 - y1) / (IMAGE_SIZE * IMAGE_SIZE))
