Code: import os
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torchvision import models, transforms
from torch.utils.data import Dataset, DataLoader
from lightgbm import LGBMClassifier
import lightgbm as lgb
import joblib

# 1. Load and preprocess dataset
df = pd.read_csv("./input/mydataset.csv")
df["filepath"] = df["image_name"].apply(
    lambda x: os.path.join("./input/MyImages", f"{x}.jpg")
)
df = df[df["filepath"].apply(os.path.exists)].reset_index(drop=True)
df["target"] = (df["label"] == "malignant").astype(int)
freq = df["skin_tone"].value_counts(normalize=True).to_dict()
df["sw"] = df["skin_tone"].map(lambda x: 1.0 / freq.get(x, 1.0))

# 2. Feature extractor setup
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")


class Identity(nn.Module):
    def forward(self, x):
        return x


transform = transforms.Compose(
    [
        transforms.Resize(224),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


class ImgDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert("RGB")
        return self.transform(img), idx


# load pretrained ResNet18 and strip the classifier
resnet = models.resnet18(pretrained=True)
resnet.fc = Identity()
resnet = resnet.to(device).eval()

# extract features for all images
paths = df["filepath"].tolist()
dataset = ImgDataset(paths, transform)
loader = DataLoader(dataset, batch_size=32, num_workers=4, shuffle=False)
features = np.zeros((len(df), 512), dtype=np.float32)
with torch.no_grad():
    for imgs, idxs in loader:
        imgs = imgs.to(device)
        feats = resnet(imgs).cpu().numpy()
        features[idxs.numpy(), :] = feats

labels = df["target"].values
weights = df["sw"].values

# 3. 5‐fold CV with LGBMClassifier using callback-based early stopping
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs, best_iters = [], []

for train_idx, val_idx in skf.split(features, labels):
    X_tr, X_val = features[train_idx], features[val_idx]
    y_tr, y_val = labels[train_idx], labels[val_idx]
    w_tr, w_val = weights[train_idx], weights[val_idx]

    clf = LGBMClassifier(
        objective="binary", random_state=42, n_estimators=1000, n_jobs=-1
    )
    clf.fit(
        X_tr,
        y_tr,
        sample_weight=w_tr,
        eval_set=[(X_val, y_val)],
        eval_sample_weight=[w_val],
        eval_metric="auc",
        callbacks=[
            lgb.early_stopping(stopping_rounds=20),
            lgb.log_evaluation(period=0),
        ],
    )
    preds = clf.predict_proba(X_val)[:, 1]
    auc = roc_auc_score(y_val, preds)
    aucs.append(auc)
    best_iters.append(clf.best_iteration_)

mean_auc = np.mean(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f}")

# 4. Retrain on full data
final_iter = int(np.mean(best_iters))
final_clf = LGBMClassifier(
    objective="binary", random_state=42, n_estimators=final_iter, n_jobs=-1
)
final_clf.fit(features, labels, sample_weight=weights)
os.makedirs("./working", exist_ok=True)
joblib.dump(final_clf, "./working/lgbm_model.pkl")


# 5. Prediction function
def predict(folder_path):
    """
    Load the trained LightGBM model and ResNet feature extractor to predict malignancy probabilities.
    Args:
      folder_path (str): directory containing JPG images.
    Returns:
      dict: mapping filename to probability [0,1].
    """
    model = joblib.load("./working/lgbm_model.pkl")
    resnet_ft = models.resnet18(pretrained=True)
    resnet_ft.fc = Identity()
    resnet_ft = resnet_ft.to(device).eval()

    files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    paths = [os.path.join(folder_path, f) for f in files]
    ds = ImgDataset(paths, transform)
    dl = DataLoader(ds, batch_size=32, num_workers=4, shuffle=False)
    feats = np.zeros((len(paths), 512), dtype=np.float32)
    with torch.no_grad():
        for imgs, idxs in dl:
            imgs = imgs.to(device)
            out = resnet_ft(imgs).cpu().numpy()
            feats[idxs.numpy(), :] = out

    probs = model.predict_proba(feats)[:, 1]
    return {files[i]: float(probs[i]) for i in range(len(files))}


