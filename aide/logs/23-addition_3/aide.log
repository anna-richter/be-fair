            logits2 = model(imgs_flipped).squeeze(1)
            # Average probabilities
            probs = (torch.sigmoid(logits1) + torch.sigmoid(logits2)) / 2.0
            all_labels.extend(labels.cpu().numpy())
            all_probs.extend(probs.cpu().numpy())
    val_auc = roc_auc_score(all_labels, all_probs)
    print(f"Validation AUROC (with TTA): {val_auc:.4f}")

    # Save model
    os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
    torch.save(model.state_dict(), MODEL_PATH)

    # Prediction function with TTA
    def predict(image_folder):
        """
        Load the trained model and return a DataFrame of malignancy probabilities using TTA.
        Args:
          image_folder (str): path to folder containing new images (jpg/png).
        Returns:
          pandas.DataFrame with columns ['image_name','malignancy_probability'] and
          also saves './working/submission.csv'.
        """
        m = models.densenet121(pretrained=False)
        m.classifier = nn.Linear(m.classifier.in_features, 1)
        m.load_state_dict(torch.load(MODEL_PATH, map_location=device))
        m = m.to(device).eval()
        results = []
        for f in sorted(os.listdir(image_folder)):
            if f.lower().endswith((".jpg", ".jpeg", ".png")):
                img = Image.open(os.path.join(image_folder, f)).convert("RGB")
                inp = val_tf(img).unsqueeze(0).to(device)
                # original
                with torch.no_grad():
                    p1 = torch.sigmoid(m(inp)).item()
                # flipped
                with torch.no_grad():
                    p2 = torch.sigmoid(m(torch.flip(inp, dims=[3]))).item()
                prob = (p1 + p2) / 2.0
                results.append(
                    {
                        "image_name": os.path.splitext(f)[0],
                        "malignancy_probability": prob,
                    }
                )
        sub = pd.DataFrame(results)
        os.makedirs("./working", exist_ok=True)
        sub.to_csv("./working/submission.csv", index=False)
        return sub

    # If a test folder exists, run prediction
    test_folder = "./input/test_images"
    if os.path.isdir(test_folder):
        _ = predict(test_folder)

Results: The training script executed successfully without errors. The model trained for 3 epochs with decreasing training loss, indicating effective learning. The validation AUROC with test-time augmentation (TTA) reached 0.9121, demonstrating strong classification performance. The code also includes a weighted sampler to balance skin tones, addressing fairness, and a prediction function that applies TTA for robust malignancy probability estimation on new images.
Validation Metric: 0.9121

-------------------------------
Design: I propose to integrate multi-crop test-time augmentation via torchvision’s TenCrop, averaging predictions over 10 crops per image at validation and test time. This should improve robustness and boost AUROC without changing training. We update the validation loop to apply a TenCrop transform that outputs a stack of 10 normalized tensors per image, forward all crops through the model, average their sigmoid outputs, and compute AUROC on those. The predict() function is similarly updated to use the same TTA before saving submission.csv.
