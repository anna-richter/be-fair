2026-04-25 13:42:34,297 - INFO - OpenAI API response: We first extract deep features from all images using a pretrained ResNet18, then train a LightGBM classifier on these features, reweighting samples inversely to skin tone frequency for fairness. We perform stratified 5‐fold cross‐validation to compute the mean AUROC, then train a final model on the full dataset and save it. A `predict()` function loads the feature extractor and trained classifier to generate malignancy probabilities for new images. Finally, we print the mean cross‐validated AUROC on the hold‐out folds.

```python
import os
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torchvision import models, transforms
from torch.utils.data import Dataset, DataLoader
import lightgbm as lgb
import joblib

# 1. Load dataset
df = pd.read_csv('./input/mydataset.csv')
df['filepath'] = df['image_name'].apply(lambda x: os.path.join('./input/MyImages', f"{x}.jpg"))
df = df[df['filepath'].apply(os.path.exists)].reset_index(drop=True)
# Binary target: malignant=1 else 0
df['target'] = (df['label'] == 'malignant').astype(int)
# Skin tone weights for fairness
freq = df['skin_tone'].value_counts(normalize=True).to_dict()
df['sw'] = df['skin_tone'].map(lambda x: 1.0 / freq.get(x,1.0))

# 2. Feature extractor
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
class Identity(nn.Module):
    def forward(self, x): return x

transform = transforms.Compose([
    transforms.Resize(224),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
])

class ImgDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform
    def __len__(self):
        return len(self.paths)
    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert('RGB')
        return self.transform(img), idx

# Load pretrained ResNet18
resnet = models.resnet18(pretrained=True)
resnet.fc = Identity()
resnet = resnet.to(device).eval()

# Extract features
paths = df['filepath'].tolist()
dataset = ImgDataset(paths, transform)
loader = DataLoader(dataset, batch_size=32, num_workers=4, shuffle=False)
features = np.zeros((len(df), 512), dtype=np.float32)
with torch.no_grad():
    for imgs, idxs in loader:
        imgs = imgs.to(device)
        feats = resnet(imgs).cpu().numpy()
        features[idxs.numpy(), :] = feats

labels = df['target'].values
weights = df['sw'].values

# 3. 5-fold CV with LightGBM
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
for train_idx, val_idx in skf.split(features, labels):
    train_data = lgb.Dataset(features[train_idx], label=labels[train_idx], weight=weights[train_idx])
    val_data = lgb.Dataset(features[val_idx], label=labels[val_idx], reference=train_data)
    params = {
        'objective': 'binary',
        'metric': 'auc',
        'verbosity': -1,
        'boosting_type': 'gbdt',
        'seed': 42
    }
    gbm = lgb.train(params, train_data, valid_sets=[val_data], early_stopping_rounds=20, verbose_eval=False)
    preds = gbm.predict(features[val_idx], num_iteration=gbm.best_iteration)
    aucs.append(roc_auc_score(labels[val_idx], preds))
mean_auc = np.mean(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f}")

# 4. Train final model on full data
full_data = lgb.Dataset(features, label=labels, weight=weights)
final_model = lgb.train(params, full_data, num_boost_round=gbm.best_iteration)
os.makedirs('./working', exist_ok=True)
