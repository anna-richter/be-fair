Design: I propose replacing the single hold‐out split with 5‐fold stratified cross‐validation, training both DenseNet121 and EfficientNetB3 in each fold and ensembling predictions across folds and architectures. We keep mixup augmentation, the weighted sampler for skin‐tone balancing, TenCrop TTA, and other hyperparameters unchanged. Out‐of‐fold predictions will be used to compute a robust CV AUROC, and test‐time predictions will be averaged across all 10 models in a `predict()` function. This ensemble across folds reduces variance and typically improves overall AUROC without altering the fairness pipeline.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from torchvision import transforms, models
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import StratifiedKFold


class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None, is_test=False):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform
        self.is_test = is_test

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        if self.is_test:
            path = os.path.join(self.img_dir, row["image_name"])
            img = Image.open(path).convert("RGB")
            data = self.transform(img)
            return data, row["image_name"]
        else:
            path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
            img = Image.open(path).convert("RGB")
            data = self.transform(img)
            label = torch.tensor(
                1.0 if row["label"] == "malignant" else 0.0, dtype=torch.float32
            )
            return data, label, row["skin_tone"], row["image_name"], row["orig_idx"]


def mixup_data(x, y, alpha=0.4):
    lam = np.random.beta(alpha, alpha) if alpha > 0 else 1.0
    idx = torch.randperm(x.size(0), device=x.device)
    return lam * x + (1 - lam) * x[idx], y, y[idx], lam


def mixup_criterion(crit, pred, y_a, y_b, lam):
    return lam * crit(pred, y_a) + (1 - lam) * crit(pred, y_b)


def train_model(model, loader, criterion, optimizer, device, epochs, alpha):
    model.to(device)
    for epoch in range(epochs):
        model.train()
        running = 0.0
        for batch in loader:
            imgs, labels, *rest = batch
            imgs, labels = imgs.to(device), labels.to(device)
            inputs, y_a, y_b, lam = mixup_data(imgs, labels, alpha)
            optimizer.zero_grad()
            logits = model(inputs).squeeze(1)
            loss = mixup_criterion(criterion, logits, y_a, y_b, lam)
            loss.backward()
            optimizer.step()
            running += loss.item() * imgs.size(0)
        print(f"  Epoch {epoch+1}/{epochs} loss {running/len(loader.dataset):.4f}")
    return model


def get_predictions(models, loader, device):
    for m in models:
        m.eval()
    preds = {}
    with torch.no_grad():
        for batch in loader:
            if loader.dataset.is_test:
                imgs, names = batch
                B, NC, C, H, W = imgs.size()
                x = imgs.view(B * NC, C, H, W).to(device)
                allp = []
                for m in models:
                    l = m(x).squeeze(1)
                    p = torch.sigmoid(l).view(B, NC).mean(dim=1)
                    allp.append(p)
                avgp = torch.stack(allp).mean(0).cpu().numpy()
                for nm, p in zip(names, avgp):
                    preds[nm] = p
            else:
                imgs, labels, *_, orig = batch
                B, NC, C, H, W = imgs.size()
                x = imgs.view(B * NC, C, H, W).to(device)
                allp = []
                for m in models:
                    l = m(x).squeeze(1)
                    p = torch.sigmoid(l).view(B, NC).mean(dim=1)
                    allp.append(p)
                avgp = torch.stack(allp).mean(0).cpu().numpy()
                for idx, p in zip(orig.numpy(), avgp):
                    preds[int(idx)] = p
    return preds


def build_model(model_name):
    if model_name == "densenet121":
        m = models.densenet121(pretrained=True)
        m.classifier = nn.Linear(m.classifier.in_features, 1)
    else:
        m = models.efficientnet_b3(pretrained=True)
        in_f = m.classifier[1].in_features
        m.classifier[1] = nn.Linear(in_f, 1)
    return m


if __name__ == "__main__":
    IMG_DIR = "./input/MyImages"
    CSV_PATH = "./input/mydataset.csv"
    TEST_DIR = "./input/test_images"
    os.makedirs("./working/models", exist_ok=True)
    BATCH_SIZE, LR, EPOCHS, ALPHA = 32, 1e-4, 3, 0.4
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    df = pd.read_csv(CSV_PATH)
    df = df[df["label"].isin(["malignant", "benign", "non-neoplastic"])].copy()
    df["orig_idx"] = np.arange(len(df))
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

    train_tf = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
    to_t = transforms.Compose([transforms.ToTensor(), transforms.Normalize(mean, std)])
    val_tf = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.TenCrop(224),
            transforms.Lambda(lambda crops: torch.stack([to_t(c) for c in crops])),
        ]
    )

    oof = np.zeros(len(df), dtype=float)
    for fold, (tr_idx, vl_idx) in enumerate(skf.split(df, df["label"])):
        print(f"Fold {fold+1}")
        train_df = df.iloc[tr_idx]
        val_df = df.iloc[vl_idx]
        # sampler
        tones, counts = np.unique(train_df["skin_tone"], return_counts=True)
        freq = dict(zip(tones, counts))
        weights = [1.0 / freq[t] for t in train_df["skin_tone"].values]
        sampler = WeightedRandomSampler(
            weights, num_samples=len(weights), replacement=True
        )
        # datasets
        tr_ds = SkinLesionDataset(train_df, IMG_DIR, train_tf)
        vl_ds = SkinLesionDataset(val_df, IMG_DIR, val_tf)
        tr_loader = DataLoader(
            tr_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
        )
        vl_loader = DataLoader(
            vl_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4
        )
        # train models
        crit = nn.BCEWithLogitsLoss()
        m1 = build_model("densenet121")
        opt1 = torch.optim.Adam(m1.parameters(), lr=LR)
        m1 = train_model(m1, tr_loader, crit, opt1, device, EPOCHS, ALPHA)
        torch.save(m1.state_dict(), f"./working/models/densenet121_fold{fold}.pth")
        m2 = build_model("efficientnetb3")
        opt2 = torch.optim.Adam(m2.parameters(), lr=LR)
        m2 = train_model(m2, tr_loader, crit, opt2, device, EPOCHS, ALPHA)
        torch.save(m2.state_dict(), f"./working/models/efficientnetb3_fold{fold}.pth")
        preds = get_predictions([m1, m2], vl_loader, device)
        for idx, p in preds.items():
            oof[idx] = p

    y = np.array([1 if l == "malignant" else 0 for l in df["label"]])
    auc = roc_auc_score(y, oof)
    print(f"CV AUROC: {auc:.4f}")

    def predict(image_folder):
        """
        Load all fold models and predict malignancy probability for each image in folder.
        Returns a DataFrame with columns ['image_name','malignancy_probability'] and saves submission.csv.
        """
        # load models
        models_list = []
        for fname in sorted(os.listdir("./working/models")):
            path = os.path.join("./working/models", fname)
            if "densenet121" in fname:
                m = build_model("densenet121")
            else:
                m = build_model("efficientnetb3")
            m.load_state_dict(torch.load(path, map_location=device))
            m.to(device).eval()
            models_list.append(m)
        # test dataset
        test_files = [
            f
            for f in sorted(os.listdir(image_folder))
            if f.lower().endswith((".jpg", ".jpeg", ".png"))
        ]
        test_df = pd.DataFrame({"image_name": test_files})
        test_ds = SkinLesionDataset(test_df, image_folder, val_tf, is_test=True)
        test_loader = DataLoader(
            test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4
        )
        preds = get_predictions(models_list, test_loader, device)
        rows = []
        for nm, p in preds.items():
            rows.append(
                {"image_name": os.path.splitext(nm)[0], "malignancy_probability": p}
            )
        sub = pd.DataFrame(rows)
        sub.to_csv("./working/submission.csv", index=False)
        return sub

    if os.path.isdir(TEST_DIR):
        _ = predict(TEST_DIR)

