            if param.requires_grad:
                # Move shadow to the parameter's device
                self.shadow[name] = self.shadow[name].to(param.device)
                new_avg = (1.0 - self.decay) * param.data + self.decay * self.shadow[
                    name
                ]
                self.shadow[name] = new_avg.clone()

    def apply_shadow(self, model):
        for name, param in model.named_parameters():
            if param.requires_grad:
                # Ensure shadow is on the same device before copying
                param.data.copy_(self.shadow[name].to(param.device))


class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        img = Image.open(path).convert("RGB")
        x = self.transform(img) if self.transform else transforms.ToTensor()(img)
        y = torch.tensor(
            1.0 if row["label"] == "malignant" else 0.0, dtype=torch.float32
        )
        return x, y, row["skin_tone"], row["image_name"]


def mixup_data(x, y, alpha=0.4):
    lam = np.random.beta(alpha, alpha) if alpha > 0 else 1.0
    idx = torch.randperm(x.size(0), device=x.device)
    mixed = lam * x + (1 - lam) * x[idx]
    return mixed, y, y[idx], lam


def mixup_criterion(crit, pred, y_a, y_b, lam):
    return lam * crit(pred, y_a) + (1 - lam) * crit(pred, y_b)


def train_model(model, loader, criterion, optimizer, device, epochs, alpha, ema):
    model.to(device)
    for epoch in range(epochs):
        model.train()
        running = 0.0
        for imgs, labels, _, _ in loader:
            imgs, labels = imgs.to(device), labels.to(device)
            inputs, y_a, y_b, lam = mixup_data(imgs, labels, alpha)
            optimizer.zero_grad()
            logits = model(inputs).squeeze(1)
            loss = mixup_criterion(criterion, logits, y_a, y_b, lam)
            loss.backward()
            optimizer.step()
            if ema:
                ema.update(model)
            running += loss.item() * imgs.size(0)
        print(f"Epoch {epoch+1}/{epochs} loss: {running/len(loader.dataset):.4f}")
    return model


def evaluate_ensemble(models, loader, device):
    for m in models:
        m.eval()
    all_y, all_p = [], []
    with torch.no_grad():
        for imgs, labels, _, _ in loader:
            B, NC, C, H, W = imgs.size()
            x = imgs.view(B * NC, C, H, W).to(device)
            probs = []
            for m in models:
                logits = m(x).squeeze(1)
                p = torch.sigmoid(logits).view(B, NC).mean(1)
                probs.append(p)
            avg = torch.stack(probs, 0).mean(0)
            all_y.extend(labels.numpy())
            all_p.extend(avg.cpu().numpy())
    return roc_auc_score(all_y, all_p)


def predict(image_folder, model_paths, device, val_tf):
    """
    Predict malignancy probabilities for all images in image_folder using an ensemble of models.
    Args:
        image_folder (str): Path to directory containing test images.
        model_paths (list of tuples): Each tuple is (model_state_path, model_architecture_fn).
        device: torch device.
        val_tf: torchvision transform for validation (including TenCrop).
    Returns:
        pandas.DataFrame with columns ['image_name', 'malignancy_probability'] and saves to ./working/submission.csv.
    """
    models_ = []
    for path, arch in model_paths:
        m = arch(pretrained=False)
        if hasattr(m, "classifier") and isinstance(m.classifier, nn.Linear):
            in_f = m.classifier.in_features
            m.classifier = nn.Linear(in_f, 1)
        elif hasattr(m, "classifier") and isinstance(m.classifier, nn.Sequential):
            in_f = m.classifier[1].in_features
            m.classifier[1] = nn.Linear(in_f, 1)
        m.load_state_dict(torch.load(path, map_location=device))
        m.to(device).eval()
        models_.append(m)
    results = []
    for f in sorted(os.listdir(image_folder)):
        if f.lower().endswith((".jpg", ".jpeg", ".png")):
            img = Image.open(os.path.join(image_folder, f)).convert("RGB")
            crops = val_tf(img).view(-1, 3, 224, 224).to(device)
            ps = []
            with torch.no_grad():
                for m in models_:
                    p = torch.sigmoid(m(crops).squeeze(1)).mean().item()
                    ps.append(p)
            results.append(
                {
                    "image_name": os.path.splitext(f)[0],
                    "malignancy_probability": np.mean(ps),
                }
            )
    os.makedirs("./working", exist_ok=True)
    df_sub = pd.DataFrame(results)
    df_sub.to_csv("./working/submission.csv", index=False)
    return df_sub


if __name__ == "__main__":
    IMG_DIR = "./input/MyImages"
    CSV_PATH = "./input/mydataset.csv"
    TEST_DIR = "./input/test_images"
    MODEL1_PATH = "./working/densenet121_ema.pth"
    MODEL2_PATH = "./working/efficientnetb3_ema.pth"
    BATCH_SIZE, LR, EPOCHS, ALPHA = 32, 1e-4, 3, 0.4
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    df = pd.read_csv(CSV_PATH)
    df = df[df["label"].isin(["malignant", "benign", "non-neoplastic"])].copy()
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label"], random_state=42
    )

    train_tf = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
    to_tensor_norm = transforms.Compose(
        [transforms.ToTensor(), transforms.Normalize(mean, std)]
    )
    val_tf = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.TenCrop(224),
            transforms.Lambda(
                lambda crops: torch.stack([to_tensor_norm(c) for c in crops])
            ),
        ]
    )

    train_ds = SkinLesionDataset(train_df, IMG_DIR, train_tf)
    val_ds = SkinLesionDataset(val_df, IMG_DIR, val_tf)

    tones, counts = np.unique(train_df["skin_tone"], return_counts=True)
    freq = dict(zip(tones, counts))
    weights = [1.0 / freq[t] for t in train_df["skin_tone"].values]
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)

    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    criterion = nn.BCEWithLogitsLoss()

    # DenseNet121 + EMA
    model1 = models.densenet121(pretrained=True)
    model1.classifier = nn.Linear(model1.classifier.in_features, 1)
    ema1 = EMA(model1, decay=0.999)
    opt1 = torch.optim.Adam(model1.parameters(), lr=LR)
    model1 = train_model(
        model1, train_loader, criterion, opt1, device, EPOCHS, ALPHA, ema1
    )
    ema1.apply_shadow(model1)
    torch.save(model1.state_dict(), MODEL1_PATH)

    # EfficientNet-B3 + EMA
    model2 = models.efficientnet_b3(pretrained=True)
    in_f = model2.classifier[1].in_features
    model2.classifier[1] = nn.Linear(in_f, 1)
    ema2 = EMA(model2, decay=0.999)
    opt2 = torch.optim.Adam(model2.parameters(), lr=LR)
    model2 = train_model(
        model2, train_loader, criterion, opt2, device, EPOCHS, ALPHA, ema2
    )
    ema2.apply_shadow(model2)
    torch.save(model2.state_dict(), MODEL2_PATH)

    # Evaluate EMA-ensemble
    val_auc = evaluate_ensemble([model1, model2], val_loader, device)
    print(f"Validation AUROC (EMA Ensemble): {val_auc:.4f}")

    # Generate test predictions if present
    if os.path.isdir(TEST_DIR):
        predict(
            TEST_DIR,
            [(MODEL1_PATH, models.densenet121), (MODEL2_PATH, models.efficientnet_b3)],
            device,
            val_tf,
        )

