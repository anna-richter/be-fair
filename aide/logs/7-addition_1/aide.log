Design: I propose replacing the single hold‐out split with stratified 5‐fold cross‐validation of the EfficientNet‐B2 model, training each fold with mixup and TTA and saving the best checkpoint per fold based on validation AUROC. After all folds complete, we compute and print each fold’s AUROC and their mean as the final validation metric. We also implement a `predict(folder_path)` function that loads all fold models and returns an ensemble malignancy probability for each new image by averaging TTA predictions across models.
Code: import os
import numpy as np
import torch
import pandas as pd
from PIL import Image
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score


class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform
        self.label_map = {"malignant": 1.0, "benign": 0.0, "non-neoplastic": 0.0}

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.loc[idx]
        path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(self.label_map[row.label], dtype=torch.float32)
        return img, label


def mixup_data(x, y, alpha=0.4, device="cpu"):
    lam = np.random.beta(alpha, alpha) if alpha > 0 else 1.0
    batch_size = x.size(0)
    index = torch.randperm(batch_size).to(device)
    mixed_x = lam * x + (1 - lam) * x[index]
    return mixed_x, y, y[index], lam


def get_model(device):
    model = models.efficientnet_b2(pretrained=True)
    in_f = model.classifier[1].in_features
    model.classifier[1] = nn.Linear(in_f, 1)
    return model.to(device)


def predict(folder_path):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    mean, std = [0.485, 0.456, 0.225], [0.229, 0.224, 0.225]
    ts = transforms.ToTensor()
    norm = transforms.Normalize(mean, std)
    tta_tf = transforms.Compose(
        [
            transforms.Resize(280),
            transforms.TenCrop(260),
            transforms.Lambda(lambda crops: torch.stack([norm(ts(c)) for c in crops])),
        ]
    )
    # load all fold models
    models_list = []
    for f in range(5):
        m = get_model(device)
        m.load_state_dict(
            torch.load(f"working/model_fold_{f}.pth", map_location=device)
        )
        m.eval()
        models_list.append(m)
    records = []
    with torch.no_grad():
        for fname in sorted(os.listdir(folder_path)):
            if not fname.lower().endswith(".jpg"):
                continue
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            crops = tta_tf(img).to(device)  # (10, C, H, W)
            probs_per_model = []
            for m in models_list:
                logits = m(crops).squeeze(1)
                prob = torch.sigmoid(logits).mean().item()
                probs_per_model.append(prob)
            avg_prob = float(np.mean(probs_per_model))
            records.append({"image_name": fname, "malignancy_prob": avg_prob})
    return pd.DataFrame(records)


def main():
    torch.manual_seed(42)
    np.random.seed(42)
    df = pd.read_csv("input/mydataset.csv")
    img_dir = os.path.join("input", "MyImages")
    label_map = {"malignant": 1, "benign": 0, "non-neoplastic": 0}
    y = df.label.map(label_map).values

    mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
    train_tf = transforms.Compose(
        [
            transforms.RandomResizedCrop(260),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize(mean, std),
        ]
    )
    val_tf = transforms.Compose(
        [
            transforms.Resize(280),
            transforms.TenCrop(260),
            transforms.Lambda(
                lambda crops: torch.stack(
                    [
                        transforms.Normalize(mean, std)(transforms.ToTensor()(c))
                        for c in crops
                    ]
                )
            ),
        ]
    )

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    os.makedirs("working", exist_ok=True)
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    fold_aucs = []

    for fold, (train_idx, val_idx) in enumerate(skf.split(df, y)):
        print(f"Starting fold {fold+1}")
        train_df = df.iloc[train_idx].reset_index(drop=True)
        val_df = df.iloc[val_idx].reset_index(drop=True)
        train_ds = SkinDataset(train_df, img_dir, transform=train_tf)
        val_ds = SkinDataset(val_df, img_dir, transform=val_tf)
        train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
        val_loader = DataLoader(val_ds, batch_size=8, shuffle=False, num_workers=4)

        model = get_model(device)
        criterion = nn.BCEWithLogitsLoss()
        optimizer = optim.Adam(model.parameters(), lr=1e-4)
        best_auc = 0.0

        for epoch in range(8):
            model.train()
            for imgs, labels in train_loader:
                imgs, labels = imgs.to(device), labels.to(device)
                mixed_imgs, y_a, y_b, lam = mixup_data(
                    imgs, labels, alpha=0.4, device=device
                )
                optimizer.zero_grad()
                outputs = model(mixed_imgs).squeeze(1)
                loss = lam * criterion(outputs, y_a) + (1 - lam) * criterion(
                    outputs, y_b
                )
                loss.backward()
                optimizer.step()

            model.eval()
            all_labels, all_probs = [], []
            with torch.no_grad():
                for imgs, labels in val_loader:
                    b, tta, C, H, W = imgs.shape
                    imgs = imgs.view(-1, C, H, W).to(device)
                    logits = model(imgs).view(b, tta)
                    probs = torch.sigmoid(logits).mean(1).cpu().tolist()
                    all_probs.extend(probs)
                    all_labels.extend(labels.tolist())
            auc = roc_auc_score(all_labels, all_probs)
            print(f" Fold {fold+1} Epoch {epoch+1} AUC: {auc:.4f}")
            if auc > best_auc:
                best_auc = auc
                torch.save(model.state_dict(), f"working/model_fold_{fold}.pth")
        print(f" Best AUC for fold {fold+1}: {best_auc:.4f}")
        fold_aucs.append(best_auc)

    mean_auc = np.mean(fold_aucs)
    print("Fold AUCs:", ["{:.4f}".format(a) for a in fold_aucs])
    print(f"Mean CV AUC: {mean_auc:.4f}")

    # optional test prediction
    test_dir = os.path.join("input", "test_images")
    if os.path.exists(test_dir):
        submission = predict(test_dir)
        submission.to_csv("working/submission.csv", index=False)
        print("Saved submission.csv")


if __name__ == "__main__":
    main()

