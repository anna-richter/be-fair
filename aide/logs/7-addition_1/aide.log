    tta_tf = transforms.Compose([
        transforms.Resize(256),
        transforms.TenCrop(224),
        transforms.Lambda(lambda crops: torch.stack([normalize(to_tensor(c)) for c in crops]))
    ])

    records = []
    with torch.no_grad():
