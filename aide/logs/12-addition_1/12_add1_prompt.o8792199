                    torch.sigmoid(model(inp).squeeze(1))                        
                                out2 =                                          
                    torch.sigmoid(model(torch.flip(inp,                         
                    dims=[3])).squeeze(1))                                      
                                out3 =                                          
                    torch.sigmoid(model(torch.flip(inp,                         
                    dims=[2])).squeeze(1))                                      
                                prob = ((out1 + out2 +                          
                    out3) / 3.0).item()                                         
                            results[fname] = prob                               
                        return results                                          
                                                                                
                                                                                
