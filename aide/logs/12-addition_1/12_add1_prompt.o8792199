                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        bbx1 = np.clip(int(cx - cut_w //                        
                    2), 0, W)                                                   
                        bby1 = np.clip(int(cy - cut_h //                        
                    2), 0, H)                                                   
                        bbx2 = np.clip(int(cx + cut_w //                        
                    2), 0, W)                                                   
                        bby2 = np.clip(int(cy + cut_h //                        
                    2), 0, H)                                                   
                        x_cut = x.clone()                                       
                        x_cut[:, :, bby1:bby2, bbx1:bbx2] =                     
                    x[index, :, bby1:bby2, bbx1:bbx2]                           
                        lam_adjusted = 1.0 - ((bbx2 - bbx1)                     
                    * (bby2 - bby1) / (W * H))                                  
                        return x_cut, y_a, y_b,                                 
                    lam_adjusted                                                
                                                                                
                                                                                
