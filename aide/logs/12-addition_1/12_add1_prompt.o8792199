                        batch_size, _, H, W = x.size()                          
                        index =                                                 
                    torch.randperm(batch_size).to(device)                       
                        y_a, y_b = y, y[index]                                  
                        cut_rat = np.sqrt(1.0 - lam)                            
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
