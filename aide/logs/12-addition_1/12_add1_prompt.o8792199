                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    train_ds = SkinLesionDataset(df_train,                      
                    "input/MyImages", train_transform)                          
                    val_ds = SkinLesionDataset(df_val,                          
                    "input/MyImages", val_transform)                            
                                                                                
                    train_loader = DataLoader(                                  
                        train_ds, batch_size=32,                                
                    shuffle=True, num_workers=4,                                
                    pin_memory=True                                             
