                                torch.flip(inp, dims=[3]),                      
                                torch.flip(inp, dims=[2]),                      
                                torch.rot90(inp, k=1,                           
                    dims=(2, 3)),                                               
                                torch.rot90(inp, k=2,                           
                    dims=(2, 3)),                                               
                                torch.rot90(inp, k=3,                           
                    dims=(2, 3)),                                               
                            ]                                                   
                            pred = 0                                            
                            with torch.no_grad():                               
                                for var in variants:                            
                                    pred +=                                     
                    torch.sigmoid(model(var).squeeze(1))                        
                            prob = (pred /                                      
                    len(variants)).item()                                       
                            results[fname] = prob                               
                        return results                                          
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
