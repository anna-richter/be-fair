                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        idx =                                                   
                    torch.randperm(x.size(0)).to(x.device)                      
                        mixed_x = lam * x + (1 - lam) *                         
                    x[idx]                                                      
                        return mixed_x, y, y[idx], lam                          
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    tta_transforms, device):                                    
                        model.eval()                                            
                        all_probs = []                                          
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                probs = []                                      
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    probs.append(torch.sigm                     
                    oid(logit).item())                                          
                                all_probs.append(np.mean(pr                     
                    obs))                                                       
                        return all_probs                                        
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        WORK_DIR = "./working"                                  
                        os.makedirs(WORK_DIR,                                   
                    exist_ok=True)                                              
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 3                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        N_FOLDS = 5                                             
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize((0.485, 0.456,                      
                    0.406), (0.229, 0.224, 0.225)),                             
                            ]                                                   
                        )                                                       
                        base_transform = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize((0.485, 0.456,                      
                    0.406), (0.229, 0.224, 0.225)),                             
                            ]                                                   
                        )                                                       
                        tta_transforms = [                                      
                            base_transform,                                     
                            T.Compose(                                          
                                [                                               
                                    T.Resize((224, 224)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((224, 224)),                       
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((224, 224)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                        ]                                                       
                                                                                
                        # Prepare test paths                                    
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_preds =                                        
                    np.zeros(len(test_paths), dtype=float)                      
                        else:                                                   
                            test_paths = []                                     
                            test_preds = None                                   
                                                                                
                        skf =                                                   
                    StratifiedKFold(n_splits=N_FOLDS,                           
                    shuffle=True, random_state=SEED)                            
                        oof_preds = np.zeros(len(df),                           
                    dtype=float)                                                
                        oof_labels = df.label.values                            
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.label)):                         
                            print(f"Starting fold                               
                    {fold+1}/{N_FOLDS}")                                        
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                                                                                
                            train_ds =                                          
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                            val_ds =                                            
                    SkinLesionDataset(val_df, IMAGE_DIR,                        
                    base_transform)                                             
                            train_loader = DataLoader(                          
                                train_ds,                                       
                                batch_size=BATCH_SIZE,                          
                                shuffle=True,                                   
                                num_workers=4,                                  
                                pin_memory=True,                                
                            )                                                   
                            val_paths = [                                       
                                os.path.join(IMAGE_DIR,                         
                    f"{name}.jpg") for name in                                  
                    val_df.image_name                                           
                            ]                                                   
                                                                                
                            # Model                                             
                            model =                                             
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                            in_f =                                              
                    model.classifier.in_features                                
                            model.classifier =                                  
                    nn.Linear(in_f, 1)                                          
                            model = model.to(DEVICE)                            
                                                                                
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                            # Train                                             
                            for epoch in range(NUM_EPOCHS):                     
                                model.train()                                   
                                running_loss = 0.0                              
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs = imgs.to(DEVICE)                      
                                    labels =                                    
                    labels.unsqueeze(1).to(DEVICE)                              
                                    mixed, y_a, y_b, lam =                      
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                    optimizer.zero_grad()                       
                                    logits = model(mixed)                       
                                    loss = lam *                                
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                    loss.backward()                             
                                    optimizer.step()                            
                                    running_loss +=                             
                    loss.item() * imgs.size(0)                                  
                                print(                                          
                                    f"Fold {fold+1} Epoch                       
                    {epoch+1} loss:                                             
                    {running_loss/len(train_loader.dataset)                     
                    :.4f}"                                                      
                                )                                               
                                                                                
                            # OOF validation                                    
                            val_probs = predict(model,                          
                    val_paths, tta_transforms, DEVICE)                          
                            oof_preds[val_idx] = val_probs                      
                                                                                
                            # Test predictions                                  
                            if test_preds is not None:                          
                                fold_test = predict(model,                      
                    test_paths, tta_transforms, DEVICE)                         
                                test_preds +=                                   
                    np.array(fold_test) / N_FOLDS                               
                                                                                
                        # CV metric                                             
                        cv_auc = roc_auc_score(oof_labels,                      
                    oof_preds)                                                  
                        print(f"CV AUROC: {cv_auc:.4f}")                        
                                                                                
                        # Save submission                                       
                        if test_preds is not None:                              
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_preds,                                               
                                }                                               
                            )                                                   
                            submission.to_csv(os.path.join(                     
                    WORK_DIR, "submission.csv"),                                
                    index=False)                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
