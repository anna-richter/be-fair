                    0.406), (0.229, 0.224, 0.225)),                             
                            ]                                                   
                        )                                                       
                        tta_transforms = [                                      
                            base_t,                                             
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                        ]                                                       
                                                                                
                        # DataLoaders                                           
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model: EfficientNet-B1                                
                        model =                                                 
                    timm.create_model("efficientnet_b1",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Train                                                 
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running = 0.0                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
