                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    tta_transforms, device):                                    
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths using                            
                    multiple TTA transforms.                                    
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            tta_transforms: list of                             
                    transforms (each deterministic) to                          
                    apply for TTA                                               
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                p_list = []                                     
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    p_list.append(torch.sig                     
                    moid(logit).item())                                         
                                probs.append(float(np.mean(                     
                    p_list)))                                                   
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                                T.RandomErasing(                                
                                    p=0.5, scale=(0.02,                         
                    0.33), ratio=(0.3, 3.3), value="random"                     
                                ),                                              
                            ]                                                   
                        )                                                       
                        base_transform = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_h = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_v = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_hv = T.Compose(                                     
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_transforms = [base_transform,                       
                    tta_h, tta_v, tta_hv]                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model                                                 
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp                              
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            print(                                              
                                f"Epoch                                         
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {running_loss/len(train_loader.dataset)                     
                    :.4f}"                                                      
                            )                                                   
                                                                                
                        # Validation with multi-view TTA                        
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{name}.jpg")                     
                    for name in val_df.image_name]                              
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(model,                              
                    val_paths, tta_transforms, DEVICE)                          
                        val_roc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with                           
                    multi-view TTA: {val_roc:.4f}")                             
                                                                                
                        # Test-time predictions and                             
                    submission                                                  
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, tta_transforms, DEVICE)                         
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using                        
                    MixUp data augmentation and evaluated                       
                    with multi-view Test Time Augmentation                      
                    (TTA). The validation AUROC achieved                        
                    was 0.9145, indicating strong                               
                    performance in distinguishing malignant                     
                    from benign skin lesions.                                   
                    Validation Metric: 0.9145                                   
                                                                                
                    -------------------------------                             
                    Design: I propose switching from                            
                    EfficientNet‐B0 to the larger                               
                    EfficientNet‐B1 backbone and increasing                     
                    the input resolution to 240×240. This                       
                    boosts model capacity and spatial                           
                    detail without changing the rest of the                     
                    pipeline (MixUp, TTA, etc.), and should                     
                    improve validation AUROC. Below is the                      
                    updated training and inference script.                      
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(os.path.join(self.image_dir,                     
                    f"{row.image_name}.jpg")).convert(                          
                                "RGB"                                           
                            )                                                   
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha > 0 else 1.0                                       
                        idx =                                                   
                    torch.randperm(x.size(0)).to(x.device)                      
                        mixed_x = lam * x + (1 - lam) *                         
                    x[idx]                                                      
                        return mixed_x, y, y[idx], lam                          
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    tta_transforms, device):                                    
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                p_list = []                                     
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    p_list.append(torch.sig                     
                    moid(logit).item())                                         
                                probs.append(float(np.mean(                     
                    p_list)))                                                   
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load data                                             
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split                                                 
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df.label, random_state=SEED                        
                        )                                                       
                                                                                
                        # Transforms with 240×240 input                         
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize((0.485, 0.456,                      
                    0.406), (0.229, 0.224, 0.225)),                             
                            ]                                                   
                        )                                                       
                        base_t = T.Compose(                                     
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.ToTensor(),                                   
                                T.Normalize((0.485, 0.456,                      
                    0.406), (0.229, 0.224, 0.225)),                             
                            ]                                                   
                        )                                                       
                        tta_transforms = [                                      
                            base_t,                                             
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                            T.Compose(                                          
                                [                                               
                                    T.Resize((240, 240)),                       
                                    T.RandomHorizontalFlip(                     
                    p=1.0),                                                     
                                    T.RandomVerticalFlip(p=                     
                    1.0),                                                       
                                    T.ToTensor(),                               
                                    T.Normalize((0.485,                         
                    0.456, 0.406), (0.229, 0.224, 0.225)),                      
                                ]                                               
                            ),                                                  
                        ]                                                       
                                                                                
                        # DataLoaders                                           
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model: EfficientNet-B1                                
                        model =                                                 
                    timm.create_model("efficientnet_b1",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Train                                                 
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running = 0.0                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running += loss.item() *                        
                    imgs.size(0)                                                
                            print(f"Epoch                                       
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {running/len(train_ds):.4f}")                               
                                                                                
                        # Validate                                              
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{n}.jpg")                        
                    for n in val_df.image_name]                                 
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(model,                              
                    val_paths, tta_transforms, DEVICE)                          
                        val_auc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with                           
                    EfficientNet-B1 & TTA: {val_auc:.4f}")                      
                                                                                
                        # Test submission                                       
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, tta_transforms, DEVICE)                         
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using                        
                    EfficientNet-B1 with mixup augmentation                     
                    and TTA during validation. The training                     
                    loss consistently decreased over                            
                    epochs, and the final validation AUROC                      
                    was 0.9357, indicating strong                               
                    performance in distinguishing malignant                     
                    from benign skin lesions.                                   
                    Validation Metric: 0.9357                                   
                                                                                
                    -------------------------------                             
                    Design: We switch the backbone to                           
                    EfficientNet‐B1 and increase the input                      
                    resolution to 240×240, giving the model                     
                    more capacity and spatial detail. We                        
                    adjust all train/validation/TTA                             
                    transforms accordingly and reduce the                       
                    batch size to 16 to accommodate the                         
                    larger inputs. Everything else (MixUp,                      
                    multi‐view TTA, BCEWithLogitsLoss, Adam                     
                    optimizer, 5 epochs) stays the same,                        
                    then we print the validation AUROC and                      
                    write `submission.csv` if test images                       
                    are present.                                                
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    tta_transforms, device):                                    
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths using                            
                    multiple TTA transforms.                                    
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            tta_transforms: list of                             
                    transforms (each deterministic) to                          
                    apply for TTA                                               
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                p_list = []                                     
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    p =                                         
                    torch.sigmoid(logit).item()                                 
                                    p_list.append(p)                            
                                probs.append(float(np.mean(                     
                    p_list)))                                                   
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 16                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms at 240x240 for                             
                    EfficientNet-B1                                             
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        base_transform = T.Compose(                             
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_h = T.Compose(                                      
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_v = T.Compose(                                      
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_hv = T.Compose(                                     
                            [                                                   
                                T.Resize((240, 240)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_transforms = [base_transform,                       
                    tta_h, tta_v, tta_hv]                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model: EfficientNet-B1                                
                        model =                                                 
                    timm.create_model("efficientnet_b1",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp                              
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation with multi-view TTA                        
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{name}.jpg")                     
                    for name in val_df.image_name]                              
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(model,                              
                    val_paths, tta_transforms, DEVICE)                          
                        val_roc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with                           
                    EfficientNet-B1 @240x240 + TTA:                             
                    {val_roc:.4f}")                                             
                                                                                
                        # Test-time predictions and                             
                    submission                                                  
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, tta_transforms, DEVICE)                         
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without any errors. The                        
                    model was trained for 5 epochs with                         
                    MixUp augmentation and EfficientNet-B1                      
                    backbone at 240x240 resolution.                             
                    Validation was performed using                              
                    multi-view test-time augmentation                           
                    (TTA). The final validation AUROC                           
                    achieved was 0.8856, indicating good                        
                    discriminative performance for                              
                    malignant vs benign skin lesion                             
                    classification.                                             
                    Validation Metric: 0.8856                                   
                                                                                
                    -------------------------------                             
                    Design: We replace the BCE loss with a                      
                    FocalLoss (γ=2, α=0.25) to focus                            
                    training on hard‐to‐classify and                            
                    minority‐class examples, which can                          
                    boost AUROC. The FocalLoss is                               
                    implemented to handle mixed‐labels from                     
                    MixUp, and we leave all other training                      
                    settings, augmentations, and multi‐view                     
                    TTA unchanged. This atomic change often                     
                    yields better generalization on                             
                    imbalanced binary tasks like malignant                      
                    vs benign detection.                                        
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    class FocalLoss(nn.Module):                                 
                        def __init__(self, alpha=0.25,                          
                    gamma=2.0, reduction="mean"):                               
                            super().__init__()                                  
                            self.alpha = alpha                                  
                            self.gamma = gamma                                  
                            self.reduction = reduction                          
                            self.bce =                                          
                    nn.BCEWithLogitsLoss(reduction="none")                      
                                                                                
                        def forward(self, logits, targets):                     
                            loss = self.bce(logits,                             
                    targets)                                                    
                            p_t = torch.exp(-loss)                              
                            focal = self.alpha * (1 - p_t)                      
                    ** self.gamma * loss                                        
                            if self.reduction == "mean":                        
                                return focal.mean()                             
                            elif self.reduction == "sum":                       
                                return focal.sum()                              
                            return focal                                        
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    tta_transforms, device):                                    
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths using                            
                    multiple TTA transforms.                                    
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            tta_transforms: list of                             
                    transforms (each deterministic) to                          
                    apply for TTA                                               
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                p_list = []                                     
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    p_list.append(torch.sig                     
                    moid(logit).item())                                         
                                probs.append(float(np.mean(                     
                    p_list)))                                                   
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        base_transform = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_h = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_v = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_hv = T.Compose(                                     
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_transforms = [base_transform,                       
                    tta_h, tta_v, tta_hv]                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model                                                 
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        # Focal loss                                            
                        criterion = FocalLoss(alpha=0.25,                       
                    gamma=2.0, reduction="mean")                                
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp +                            
                    FocalLoss                                                   
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            print(                                              
                                f"Epoch                                         
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {running_loss/len(train_loader.dataset)                     
                    :.4f}"                                                      
                            )                                                   
                                                                                
                        # Validation with multi-view TTA                        
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{name}.jpg")                     
                    for name in val_df.image_name]                              
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(model,                              
                    val_paths, tta_transforms, DEVICE)                          
                        val_roc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with                           
                    FocalLoss + multi-view TTA:                                 
                    {val_roc:.4f}")                                             
                                                                                
                        # Test-time predictions and                             
                    submission                                                  
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, tta_transforms, DEVICE)                         
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without any errors. The                        
                    model was trained for 5 epochs using                        
                    MixUp data augmentation and FocalLoss                       
                    on an EfficientNet-B0 backbone.                             
                    Validation was performed with                               
                    multi-view test-time augmentation,                          
                    yielding a strong AUROC of 0.9357,                          
                    indicating good discriminatory                              
