                    # Keep only benign and malignant                            
                    df = df[df["label"].isin(["benign",                         
                    "malignant"])].reset_index(drop=True)                       
                    # Map labels: malignant=1, benign=0                         
                    df["target"] = (df["label"] ==                              
                    "malignant").astype(int)                                    
                                                                                
                    # 2. Build image path mapping                               
                    img_dir = "./input/MyImages"                                
                    mapping = {}                                                
                    for f in os.listdir(img_dir):                               
                        if ".jpg" in f.lower():                                 
                            base = f.split(".jpg")[0]                           
                            mapping[base] =                                     
                    os.path.join(img_dir, f)                                    
                    # Filter rows with existing files                           
                    df["path"] =                                                
                    df["image_name"].map(mapping)                               
                    df =                                                        
                    df.dropna(subset=["path"]).reset_index(                     
                    drop=True)                                                  
                                                                                
                                                                                
                    # 3. Define dataset & model for feature                     
                    extraction                                                  
                    class ImageDataset(Dataset):                                
                        def __init__(self, paths,                               
                    transform):                                                 
                            self.paths = paths                                  
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.paths)                              
                                                                                
                        def __getitem__(self, idx):                             
                            img =                                               
                    Image.open(self.paths[idx]).convert("RG                     
                    B")                                                         
                            return self.transform(img), idx                     
                                                                                
                                                                                
                    transform = transforms.Compose(                             
                        [                                                       
                            transforms.Resize(256),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.48                     
                    5, 0.456, 0.406], std=[0.229, 0.224,                        
                    0.225]),                                                    
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    backbone =                                                  
                    models.resnet18(pretrained=True)                            
                    backbone.fc = nn.Identity()                                 
                    backbone = backbone.to(device).eval()                       
                                                                                
                    # 4. Extract features                                       
                    all_paths = df["path"].tolist()                             
                    dataset = ImageDataset(all_paths,                           
                    transform)                                                  
                    loader = DataLoader(dataset,                                
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                    features = np.zeros((len(dataset),                          
                    512), dtype=np.float32)                                     
                    with torch.no_grad():                                       
                        for imgs, idxs in loader:                               
                            imgs = imgs.to(device)                              
                            feats =                                             
                    backbone(imgs).cpu().numpy()                                
                            features[idxs.numpy(), :] =                         
                    feats                                                       
                    labels = df["target"].values                                
                                                                                
                    # 5. 5-fold CV with LightGBM                                
                    kf = KFold(n_splits=5, shuffle=True,                        
                    random_state=42)                                            
                    aucs = []                                                   
                    for train_idx, val_idx in                                   
                    kf.split(features):                                         
                        clf =                                                   
                    LGBMClassifier(n_estimators=100,                            
                    random_state=42)                                            
                        clf.fit(features[train_idx],                            
                    labels[train_idx])                                          
                        probs =                                                 
                    clf.predict_proba(features[val_idx])[:,                     
                    1]                                                          
                        aucs.append(roc_auc_score(labels[va                     
                    l_idx], probs))                                             
                    print(f"Mean 5-fold AUROC:                                  
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # 6. Retrain final model on all data                        
                    final_clf =                                                 
                    LGBMClassifier(n_estimators=100,                            
                    random_state=42)                                            
                    final_clf.fit(features, labels)                             
                                                                                
                                                                                
                    def predict(image_paths):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    new images.                                                 
                        Args:                                                   
                            image_paths (list of str): file                     
                    paths to images.                                            
                        Returns:                                                
                            np.ndarray: probabilities of                        
                    malignant class for each image.                             
                        """                                                     
                        ds = ImageDataset(image_paths,                          
                    transform)                                                  
                        dl = DataLoader(ds, batch_size=64,                      
                    shuffle=False, num_workers=4)                               
                        feats = []                                              
                        with torch.no_grad():                                   
                            for imgs, _ in dl:                                  
                                imgs = imgs.to(device)                          
                                out =                                           
                    backbone(imgs).cpu().numpy()                                
                                feats.append(out)                               
                        feats = np.vstack(feats)                                
                        return                                                  
                    final_clf.predict_proba(feats)[:, 1]                        
                                                                                
                    Results: The script successfully                            
                    executed without errors. It extracted                       
                    image features using a pretrained                           
                    ResNet18 backbone and trained a                             
                    LightGBM classifier with 5-fold                             
                    cross-validation. The mean AUROC across                     
                    folds was 0.8406, indicating good                           
                    predictive performance for                                  
                    differentiating malignant from benign                       
                    skin lesions. The final model was                           
                    retrained on all data for deployment.                       
                    Validation Metric: 0.8406                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    ResNet18 end-to-end for binary                              
                    classification of skin lesions, mapping                     
                    malignant to 1 and benign to 0, and                         
                    dropping non‐neoplastic samples. Images                     
                    are resized to 224×224, augmented with                      
                    random flips and rotations, and                             
                    normalized using ImageNet statistics.                       
                    We split the data into stratified 80/20                     
                    train/validation sets, train for 5                          
                    epochs with BCEWithLogitsLoss and Adam,                     
                    and evaluate AUROC on the validation                        
                    set. A `predict()` function is provided                     
                    to return malignancy probabilities for                      
                    new image paths.                                            
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import models,                             
                    transforms                                                  
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            img_name = self.df.loc[idx,                         
                    "image_name"] + ".jpg"                                      
                            img_path =                                          
                    os.path.join(self.image_dir, img_name)                      
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = self.df.loc[idx,                            
                    "label_bin"]                                                
                            return image,                                       
                    torch.tensor(label,                                         
                    dtype=torch.float32)                                        
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    image_dir, batch_size=32):                                  
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file names (without                     
                    extension).                                                 
                        Returns a numpy array of                                
                    probabilities.                                              
                        """                                                     
                        device =                                                
                    next(model.parameters()).device                             
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        probs = []                                              
                        model.eval()                                            
                        with torch.no_grad():                                   
                            for i in range(0,                                   
                    len(image_paths), batch_size):                              
                                batch_paths = image_paths[i                     
                    : i + batch_size]                                           
                                imgs = []                                       
                                for name in batch_paths:                        
                                    img =                                       
                    Image.open(os.path.join(image_dir, name                     
                    + ".jpg")).convert("RGB")                                   
                                    imgs.append(transform(i                     
                    mg))                                                        
                                batch =                                         
                    torch.stack(imgs).to(device)                                
                                logits =                                        
                    model(batch).squeeze(1)                                     
                                batch_probs =                                   
                    torch.sigmoid(logits).cpu().numpy()                         
                                probs.extend(batch_probs.to                     
                    list())                                                     
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df =                                                    
                    df[df["label"].isin(["malignant",                           
                    "benign"])].copy()                                          
                        df["label_bin"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                        # Train/val split                                       
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["label_bin"],                                   
                    random_state=42                                             
                        )                                                       
                        # Transforms                                            
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    0),                                                         
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    transform=train_transform)                                  
                        val_ds = SkinLesionDataset(val_df,                      
                    IMAGE_DIR, transform=val_transform)                         
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                        # Model                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=1e-4)                     
                        # Training                                              
                        epochs = 5                                              
                        model.train()                                           
                        for epoch in range(epochs):                             
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        auroc = roc_auc_score(all_labels,                       
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {auroc:.4f}")                                               
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using a                      
                    ResNet18 backbone and achieved a                            
                    validation AUROC of 0.9034, indicating                      
                    good performance in distinguishing                          
                    malignant from benign skin lesions.                         
                    Data augmentation and proper                                
                    preprocessing were applied, and the                         
                    training and validation processes were                      
                    handled correctly.                                          
                    Validation Metric: 0.9034                                   
                                                                                
                    -------------------------------                             
                    Design: We will fine-tune a pretrained                      
                    EfficientNet-B0 model from the timm                         
                    library to distinguish malignant vs.                        
                    benign lesions, filtering out                               
                    non-neoplastic samples and mapping                          
                    malignant to 1 and benign to 0. Images                      
                    will be resized to 224×224 and                              
                    augmented with random flips and                             
                    rotations, then normalized with                             
                    ImageNet statistics. We split the                           
                    filtered data into a stratified 80/20                       
                    train/validation set, train for 5                           
                    epochs using BCEWithLogitsLoss and the                      
                    Adam optimizer, and evaluate AUROC on                       
                    the validation set. A `predict()`                           
                    function is provided to load new image                      
                    paths and return malignancy                                 
                    probabilities.                                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    transform, device):                                         
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths.                                 
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of strings                        
                    (full file paths to images)                                 
                            transform: torchvision                              
                    transform for preprocessing                                 
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                logit = model(img_t)                            
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                                probs.append(prob)                              
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = T.Compose(                              
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and Loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        val_ds = SkinLesionDataset(val_df,                      
                    IMAGE_DIR, val_transform)                                   
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=BATCH_SIZE,                      
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Model setup                                           
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_features =                                           
                    model.classifier.in_features                                
                        model.classifier =                                      
                    nn.Linear(in_features, 1)                                   
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop                                         
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                optimizer.zero_grad()                           
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels = []                                         
                        all_probs = []                                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        val_roc = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {val_roc:.4f}")                                             
                                                                                
                        # Example of saving a submission if                     
                    test set existed:                                           
                        # test_paths =                                          
                    sorted([os.path.join(IMAGE_DIR, fname)                      
                    for fname in os.listdir(IMAGE_DIR) if                       
                    fname.endswith(".jpg")])                                    
                        # test_probs = predict(model,                           
                    test_paths, val_transform, DEVICE)                          
                        # submission = pd.DataFrame({                           
                        #     "image_name":                                     
                    [os.path.splitext(os.path.basename(p))[                     
                    0] for p in test_paths],                                    
                        #     "malignant_probability":                          
                    test_probs                                                  
                        # })                                                    
                        #                                                       
                    submission.to_csv("./working/submission                     
                    .csv", index=False)                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script                                
                    successfully ran without any errors.                        
                    The model was trained for 5 epochs on                       
                    the skin lesion dataset using                               
                    EfficientNet-B0 with pretrained                             
                    weights. The training loss steadily                         
                    decreased from 0.5782 to 0.1784,                            
                    indicating good convergence. The                            
                    validation AUROC achieved was 0.9269,                       
                    which is a strong performance for                           
                    differentiating malignant from benign                       
                    lesions.                                                    
                    Validation Metric: 0.9269                                   
                                                                                
                    -------------------------------                             
                    Design: We freeze the pretrained ResNet                     
                    backbone so that only the final linear                      
                    layer is trained, which greatly reduces                     
                    computation when running without a                          
                    modern GPU. We also detect if CUDA is                       
                    unavailable and lower the number of                         
                    epochs and batch size accordingly, and                      
                    set DataLoader num_workers=0 to avoid                       
                    multiprocessing hangs. A documented                         
                    `predict()` function is provided for                        
                    reusability, and at the end we print                        
                    the validation AUROC score. This                            
                    approach should complete within the                         
                    time limit even on CPU-only                                 
                    environments.                                               
                    Code: import os                                             
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                    import random                                               
                                                                                
                                                                                
                    # Reproducibility                                           
                    def set_seed(seed=42):                                      
                        random.seed(seed)                                       
                        np.random.seed(seed)                                    
                        torch.manual_seed(seed)                                 
                        if torch.cuda.is_available():                           
                            torch.cuda.manual_seed_all(seed                     
                    )                                                           
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, image_paths,                         
                    labels, transform=None):                                    
                            self.image_paths = image_paths                      
                            self.labels = labels                                
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                                                                                
                        def __getitem__(self, idx):                             
                            img =                                               
                    Image.open(self.image_paths[idx]).conve                     
                    rt("RGB")                                                   
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(self.labels[idx],                              
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def predict(                                                
                        model: torch.nn.Module,                                 
                        image_paths: list,                                      
                        transform: T.Compose,                                   
                        device: torch.device,                                   
                    ) -> np.ndarray:                                            
                        """                                                     
                        Predicts the probability of                             
                    malignancy for each image.                                  
                        Args:                                                   
                          model: trained PyTorch model                          
                          image_paths: list of file paths                       
                    to images                                                   
                          transform: torchvision transforms                     
                    to apply                                                    
                          device: torch.device to run                           
                    inference on                                                
                        Returns:                                                
                          numpy array of malignancy                             
                    probabilities                                               
                        """                                                     
                        model.to(device).eval()                                 
                        probs = []                                              
                        with torch.no_grad():                                   
                            for p in image_paths:                               
                                img =                                           
                    Image.open(p).convert("RGB")                                
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                out = model(img_t)                              
                                prob =                                          
                    torch.sigmoid(out).item()                                   
                                probs.append(prob)                              
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        set_seed(42)                                            
                        # Read metadata                                         
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label_binary"] =                                    
                    df["label"].apply(lambda x: 1 if x ==                       
                    "malignant" else 0)                                         
                        # Gather image paths                                    
                        file_paths =                                            
                    glob.glob("./input/MyImages/*.jpg*")                        
                        image_paths, labels = [], []                            
                        for _, row in df.iterrows():                            
                            name = row["image_name"]                            
                            for p in file_paths:                                
                                if                                              
                    os.path.basename(p).startswith(name +                       
                    ".jpg"):                                                    
                                    image_paths.append(p)                       
                                    labels.append(row["labe                     
                    l_binary"])                                                 
                                    break                                       
                        # Split                                                 
                        train_paths, val_paths,                                 
                    train_labels, val_labels =                                  
                    train_test_split(                                           
                            image_paths, labels,                                
                    test_size=0.2, random_state=42,                             
                    stratify=labels                                             
                        )                                                       
                        # Transforms                                            
                        train_tf = T.Compose(                                   
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_tf = T.Compose(                                     
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=[0.485,                        
                    0.456, 0.406], std=[0.229, 0.224,                           
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        # Device and hyperparams                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        if device.type == "cpu":                                
                            epochs = 3                                          
                            batch_size = 16                                     
                        else:                                                   
                            epochs = 5                                          
                            batch_size = 32                                     
                        # DataLoaders with num_workers=0 to                     
                    avoid hangs                                                 
                        train_ds =                                              
                    SkinLesionDataset(train_paths,                              
                    train_labels, transform=train_tf)                           
                        val_ds =                                                
                    SkinLesionDataset(val_paths,                                
                    val_labels, transform=val_tf)                               
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=batch_size, shuffle=True,                        
                    num_workers=0                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=0)                                              
                        # Model                                                 
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        # Freeze backbone                                       
                        for param in model.parameters():                        
                            param.requires_grad = False                         
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                        # Only optimize final layer                             
                        optimizer =                                             
                    optim.Adam(model.fc.parameters(),                           
                    lr=1e-3)                                                    
                        criterion = nn.BCEWithLogitsLoss()                      
                        # Training                                              
                        for epoch in range(epochs):                             
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, lbls in train_loader:                     
                                imgs, lbls =                                    
                    imgs.to(device),                                            
                    lbls.to(device).unsqueeze(1)                                
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    lbls)                                                       
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            avg_loss = running_loss /                           
                    len(train_ds)                                               
                            print(f"Epoch                                       
                    {epoch+1}/{epochs} - loss:                                  
                    {avg_loss:.4f}")                                            
                        # Validation                                            
                        all_probs, all_labels = [], []                          
                        with torch.no_grad():                                   
                            model.eval()                                        
                            for imgs, lbls in val_loader:                       
                                imgs = imgs.to(device)                          
                                preds = model(imgs)                             
                                probs =                                         
                    torch.sigmoid(preds).cpu().numpy().flat                     
                    ten()                                                       
                                all_probs.extend(probs)                         
                                all_labels.extend(lbls.nump                     
                    y())                                                        
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any bugs. The                          
                    model was trained for 3 epochs on the                       
                    skin lesion dataset and achieved a                          
                    validation AUROC of 0.8185, indicating                      
                    a good ability to distinguish between                       
                    malignant and benign lesions. The                           
                    training loss decreased steadily over                       
                    epochs, showing effective learning.                         
                    Validation Metric: 0.8185                                   
                                                                                
                    -------------------------------                             
                    Design: We can greatly speed up and                         
                    stabilize training by freezing the                          
                    ResNet18 feature extractor and only                         
                    fine‐tuning the final classification                        
                    layer, which reduces compute and avoids                     
                    potential DataLoader deadlocks by                           
                    lowering `num_workers`. We reinitialize                     
                    `model.fc`, freeze all other layers,                        
                    and only optimize the head’s                                
                    parameters. This lets us train in just                      
                    a few seconds per epoch, print the                          
                    validation AUROC, and still provide a                       
                    reusable `predict()` function.                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.target,                                    
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    device="cpu"):                                              
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths.                             
                        Args:                                                   
                            model (torch.nn.Module):                            
                    trained binary classification model                         
                    (outputs logits).                                           
                            image_paths (List[str]): list                       
                    of file paths to JPEG images.                               
                            device (str): 'cpu' or 'cuda'.                      
                        Returns:                                                
                            numpy.ndarray: probabilities of                     
                    malignancy for each image.                                  
                        """                                                     
                        model.to(device).eval()                                 
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                logits = model(x)                               
                                p =                                             
                    torch.sigmoid(logits).item()                                
                                probs.append(p)                                 
                        return np.array(probs)                                  
                                                                                
                                                                                
                    def main():                                                 
                        # Load and prepare data                                 
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["target"], random_state=42                      
                        )                                                       
                        img_dir = "./input/MyImages"                            
                                                                                
                        # Transforms                                            
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_tf = transforms.Compose(                            
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, img_dir,                        
                    train_tf)                                                   
                        val_ds = SkinLesionDataset(val_df,                      
                    img_dir, val_tf)                                            
                        train_loader = DataLoader(                              
                            train_ds, batch_size=32,                            
                    shuffle=True, num_workers=2,                                
                    pin_memory=True                                             
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=32,                              
                    shuffle=False, num_workers=2,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Model: freeze backbone, only                          
                    fine-tune final layer                                       
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        for param in model.parameters():                        
                            param.requires_grad = False                         
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                                                                                
                        # Only parameters of fc will be                         
                    updated                                                     
                        optimizer =                                             
                    torch.optim.Adam(model.fc.parameters(),                     
                    lr=1e-3)                                                    
                        criterion = nn.BCEWithLogitsLoss()                      
                                                                                
                        # Training                                              
                        for epoch in range(3):                                  
                            model.train()                                       
                            total_loss = 0.0                                    
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(device)                          
                                labels =                                        
                    labels.unsqueeze(1).to(device)                              
                                optimizer.zero_grad()                           
                                logits = model(imgs)                            
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                total_loss += loss.item() *                     
                    imgs.size(0)                                                
                            print(f"Epoch {epoch+1} Train                       
                    Loss: {total_loss/len(train_ds):.4f}")                      
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_logits, all_labels = [], []                         
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).cpu().squeeze()                                 
                                all_logits.extend(logits.nu                     
                    mpy().tolist())                                             
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                        probs =                                                 
                    torch.sigmoid(torch.tensor(all_logits))                     
                    .numpy()                                                    
                        auc = roc_auc_score(all_labels,                         
                    probs)                                                      
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                        # Example of saving a submission if                     
                    needed                                                      
                        # test_paths =                                          
                    sorted([os.path.join(img_dir, f) for f                      
                    in os.listdir(img_dir)])                                    
                        # test_probs = predict(model,                           
                    test_paths, device=device)                                  
                        # submission = pd.DataFrame({                           
                        #     "image_name":                                     
                    [os.path.splitext(os.path.basename(p))[                     
                    0] for p in test_paths],                                    
                        #     "target": test_probs                              
                        # })                                                    
                        #                                                       
                    submission.to_csv("./working/submission                     
                    .csv", index=False)                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    was trained for 3 epochs with a frozen                      
                    backbone and fine-tuned final layer.                        
                    The training loss decreased steadily,                       
                    indicating learning progress. The                           
                    validation AUROC of 0.8089 suggests the                     
                    model has good discriminatory ability                       
                    between malignant and benign skin                           
                    lesions.                                                    
                    Validation Metric: 0.8089                                   
                                                                                
                    -------------------------------                             
                    Design: I fixed the shape mismatch by                       
                    removing the extra `unsqueeze(1)` on                        
                    the mixed labels—now `y_a` and `y_b`                        
                    (each of shape [batch,1]) directly                          
                    match the model logits for loss                             
                    computation. Everything else remains                        
                    the same, and we still output the final                     
                    validation AUROC. The `predict()`                           
                    function is included for easy reuse on                      
                    new image folders.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        """Returns mixed inputs, pairs of                       
                    targets, and lambda"""                                      
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    transform, device):                                         
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths.                                 
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            transform: torchvision                              
                    transform for preprocessing                                 
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                logit = model(img_t)                            
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                                probs.append(prob)                              
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = T.Compose(                              
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and Loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        val_ds = SkinLesionDataset(val_df,                      
                    IMAGE_DIR, val_transform)                                   
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=BATCH_SIZE,                      
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Model setup                                           
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_features =                                           
                    model.classifier.in_features                                
                        model.classifier =                                      
                    nn.Linear(in_features, 1)                                   
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp                              
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)  # shape                     
                    [batch,1]                                                   
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)  #                     
                    shape [batch,1]                                             
                                # Remove extra unsqueeze:                       
                    y_a and y_b already [batch,1]                               
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels = []                                         
                        all_probs = []                                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        val_roc = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {val_roc:.4f}")                                             
                                                                                
                        # If you have a test folder,                            
                    uncomment and use this to create a                          
                    submission:                                                 
                        # test_dir = "./input/TestImages"                       
                        # if os.path.isdir(test_dir):                           
                        #     test_paths =                                      
                    sorted([os.path.join(test_dir, f) for f                     
                    in os.listdir(test_dir) if                                  
                    f.endswith(".jpg")])                                        
                        #     test_probs = predict(model,                       
                    test_paths, val_transform, DEVICE)                          
                        #     submission = pd.DataFrame({                       
                        #         "image_name":                                 
                    [os.path.splitext(os.path.basename(p))[                     
                    0] for p in test_paths],                                    
                        #         "malignant_probability":                      
                    test_probs                                                  
                        #     })                                                
                        #     os.makedirs("./working",                          
                    exist_ok=True)                                              
                        #                                                       
                    submission.to_csv("./working/submission                     
                    .csv", index=False)                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained for 5 epochs using                        
                    MixUp data augmentation and                                 
                    EfficientNet-B0 as the backbone. The                        
                    training loss decreased steadily each                       
                    epoch, demonstrating effective                              
                    learning. The validation AUROC achieved                     
                    was 0.9284, indicating strong model                         
                    performance in distinguishing malignant                     
                    from benign skin lesions.                                   
                    Validation Metric: 0.9284                                   
                                                                                
                    -------------------------------                             
                    Design: We propose to improve                               
                    optimization and regularization by                          
                    switching to the AdamW optimizer with                       
                    weight decay and adding a cosine                            
                    annealing learning‐rate scheduler. This                     
                    scheduler will gradually decrease the                       
                    learning rate to help the model                             
                    converge smoothly and potentially                           
                    escape local minima, yielding better                        
                    generalization. We keep the existing                        
                    MixUp augmentation and EfficientNet‐B0                      
                    backbone but now train with AdamW                           
                    (weight decay=1e‐2) and step the                            
                    scheduler each epoch. The rest of the                       
                    training and evaluation pipeline                            
                    remains unchanged.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.optim import AdamW                               
                    from torch.optim.lr_scheduler import                        
                    CosineAnnealingLR                                           
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    transform, device):                                         
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths.                                 
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            transform: torchvision                              
                    transform for preprocessing                                 
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                logit = model(img_t)                            
                                prob =                                          
                    torch.sigmoid(logit).item()                                 
                                probs.append(prob)                              
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        WEIGHT_DECAY = 1e-2                                     
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = T.Compose(                              
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        val_ds = SkinLesionDataset(val_df,                      
                    IMAGE_DIR, val_transform)                                   
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                        val_loader = DataLoader(                                
                            val_ds, batch_size=BATCH_SIZE,                      
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        # Model setup                                           
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_features =                                           
                    model.classifier.in_features                                
                        model.classifier =                                      
                    nn.Linear(in_features, 1)                                   
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    AdamW(model.parameters(), lr=LR,                            
                    weight_decay=WEIGHT_DECAY)                                  
                        scheduler =                                             
                    CosineAnnealingLR(optimizer,                                
                    T_max=NUM_EPOCHS)                                           
                                                                                
                        # Training loop with MixUp and                          
                    scheduler                                                   
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            scheduler.step()                                    
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(                                              
                                f"Epoch                                         
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {epoch_loss:.4f}, LR:                                       
                    {scheduler.get_last_lr()[0]:.2e}"                           
                            )                                                   
                                                                                
                        # Validation                                            
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy().flatten())                                            
                        val_roc = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {val_roc:.4f}")                                             
                                                                                
                        # Create submission if test images                      
                    exist                                                       
                        test_dir = "./input/TestImages"                         
                        if os.path.isdir(test_dir):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(test_dir,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(test_dir)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, val_transform, DEVICE)                          
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    was trained for 5 epochs using MixUp                        
                    augmentation and cosine annealing                           
                    learning rate scheduler on the                              
                    EfficientNet-B0 architecture pretrained                     
                    on ImageNet. The validation AUROC                           
                    achieved was 0.9185, indicating strong                      
                    performance in classifying malignant vs                     
                    benign skin lesions.                                        
                    Validation Metric: 0.9185                                   
                                                                                
                    -------------------------------                             
                    Design: We can enhance the robustness                       
                    of our predictions by applying simple                       
                    test‐time augmentation (TTA): for each                      
                    validation image, we compute                                
                    predictions on both the original and a                      
                    horizontally flipped version, then                          
                    average their probabilities. This                           
                    requires minimal changes to the code                        
                    and typically yields a small but                            
                    consistent boost in AUROC. We will                          
                    implement TTA in our `predict()`                            
                    function and use it to evaluate the                         
                    validation set as well as any test set                      
                    for generating `submission.csv`.                            
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    transform, device, tta_transform=None):                     
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths, optionally                      
                    with TTA.                                                   
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            transform: torchvision                              
                    transform for preprocessing (original)                      
                            device: torch device                                
                            tta_transform: optional                             
                    torchvision transform (e.g., horizontal                     
                    flip) to apply for TTA                                      
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img_orig =                                      
                    transform(img).unsqueeze(0).to(device)                      
                                logit_orig =                                    
                    model(img_orig)                                             
                                prob_orig =                                     
                    torch.sigmoid(logit_orig).item()                            
                                if tta_transform is not                         
                    None:                                                       
                                    img_tta =                                   
                    tta_transform(img).unsqueeze(0).to(devi                     
                    ce)                                                         
                                    logit_tta =                                 
                    model(img_tta)                                              
                                    prob_tta =                                  
                    torch.sigmoid(logit_tta).item()                             
                                    prob = 0.5 * (prob_orig                     
                    + prob_tta)                                                 
                                else:                                           
                                    prob = prob_orig                            
                                probs.append(prob)                              
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = T.Compose(                              
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        # TTA transform: deterministic                          
                    horizontal flip                                             
                        val_transform_flip = T.Compose(                         
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and Loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model setup                                           
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_features =                                           
                    model.classifier.in_features                                
                        model.classifier =                                      
                    nn.Linear(in_features, 1)                                   
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp                              
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(f"Epoch                                       
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation with TTA                                   
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{name}.jpg")                     
                    for name in val_df.image_name]                              
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(                                    
                            model, val_paths,                                   
                    val_transform, DEVICE,                                      
                    tta_transform=val_transform_flip                            
                        )                                                       
                        val_roc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with TTA:                      
                    {val_roc:.4f}")                                             
                                                                                
                        # Test-time predictions                                 
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(                               
                                model, test_paths,                              
                    val_transform, DEVICE,                                      
                    tta_transform=val_transform_flip                            
                            )                                                   
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without errors. The model                      
                    was trained for 5 epochs using MixUp                        
                    augmentation and EfficientNet-B0                            
                    pretrained backbone. The validation                         
                    AUROC with test-time augmentation                           
                    (horizontal flip) achieved a strong                         
                    score of 0.9332, indicating good                            
                    discrimination between malignant and                        
                    benign skin lesions.                                        
                    Validation Metric: 0.9332                                   
                                                                                
                    -------------------------------                             
                    Design: We extend our test‐time                             
                    augmentation to include vertical and                        
                    combined horizontal+vertical flips in                       
                    addition to the original image,                             
                    averaging predictions over these four                       
                    versions. We construct four                                 
                    deterministic TTA transforms and modify                     
                    the predict() function to loop over                         
                    them, computing the mean probability.                       
                    This simple multi‐view averaging should                     
                    improve robustness and AUROC without                        
                    extra training. The rest of the                             
                    training pipeline remains unchanged.                        
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.optim as optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    from sklearn.model_selection import                         
                    train_test_split                                            
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import timm                                                 
                                                                                
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, image_dir,                       
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.image_dir,                                
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transform(img)                           
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    def predict(model, image_paths,                             
                    base_transform, tta_transforms,                             
                    device):                                                    
                        """                                                     
                        Predict malignancy probability for                      
                    a list of image file paths using                            
                    multiple TTA transforms.                                    
                        Args:                                                   
                            model: trained PyTorch model                        
                            image_paths: list of file paths                     
                    to images                                                   
                            base_transform: transform for                       
                    resizing/normalizing without flips                          
                            tta_transforms: list of                             
                    transforms (each deterministic) to                          
                    apply for TTA                                               
                            device: torch device                                
                        Returns:                                                
                            probs: list of float                                
                    probabilities between 0 and 1                               
                        """                                                     
                        model.eval()                                            
                        probs = []                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                # apply each TTA transform                      
                                p_list = []                                     
                                for t in tta_transforms:                        
                                    inp =                                       
                    t(img).unsqueeze(0).to(device)                              
                                    logit = model(inp)                          
                                    p =                                         
                    torch.sigmoid(logit).item()                                 
                                    p_list.append(p)                            
                                probs.append(float(np.mean(                     
                    p_list)))                                                   
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Settings                                              
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMAGE_DIR = "./input/MyImages"                          
                        TEST_DIR = "./input/TestImages"                         
                        SEED = 42                                               
                        BATCH_SIZE = 32                                         
                        NUM_EPOCHS = 5                                          
                        LR = 1e-4                                               
                        MIXUP_ALPHA = 0.2                                       
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        torch.manual_seed(SEED)                                 
                        np.random.seed(SEED)                                    
                                                                                
                        # Load and filter data                                  
                        df = pd.read_csv(DATA_CSV)                              
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                                                                                
                        # Split train/validation                                
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    random_state=SEED, stratify=df.label                        
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_transform = T.Compose(                            
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomVerticalFlip(),                         
                                T.RandomRotation(20),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        base_transform = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_h = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_v = T.Compose(                                      
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_hv = T.Compose(                                     
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(p=1.                     
                    0),                                                         
                                T.RandomVerticalFlip(p=1.0)                     
                    ,                                                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=(0.485,                        
                    0.456, 0.406), std=(0.229, 0.224,                           
                    0.225)),                                                    
                            ]                                                   
                        )                                                       
                        tta_transforms = [base_transform,                       
                    tta_h, tta_v, tta_hv]                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds =                                              
                    SkinLesionDataset(train_df, IMAGE_DIR,                      
                    train_transform)                                            
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4, pin_memory=True                              
                        )                                                       
                                                                                
                        # Model                                                 
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True)                                            
                        in_f = model.classifier.in_features                     
                        model.classifier = nn.Linear(in_f,                      
                    1)                                                          
                        model = model.to(DEVICE)                                
                                                                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Training loop with MixUp                              
                        for epoch in range(NUM_EPOCHS):                         
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                labels =                                        
                    labels.unsqueeze(1).to(DEVICE)                              
                                imgs_mix, y_a, y_b, lam =                       
                    mixup_data(imgs, labels, MIXUP_ALPHA)                       
                                optimizer.zero_grad()                           
                                logits = model(imgs_mix)                        
                                loss = lam *                                    
                    criterion(logits, y_a) + (1 - lam) *                        
                    criterion(logits, y_b)                                      
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * imgs.size(0)                                              
                            print(                                              
                                f"Epoch                                         
                    {epoch+1}/{NUM_EPOCHS}, Loss:                               
                    {running_loss/len(train_loader.dataset)                     
                    :.4f}"                                                      
                            )                                                   
                                                                                
                        # Validation with multi-view TTA                        
                        val_paths =                                             
                    [os.path.join(IMAGE_DIR, f"{name}.jpg")                     
                    for name in val_df.image_name]                              
                        val_labels = val_df.label.tolist()                      
                        val_probs = predict(model,                              
                    val_paths, base_transform,                                  
                    tta_transforms, DEVICE)                                     
                        val_roc = roc_auc_score(val_labels,                     
                    val_probs)                                                  
                        print(f"Validation AUROC with                           
                    multi-view TTA: {val_roc:.4f}")                             
                                                                                
                        # Test-time predictions and                             
                    submission                                                  
                        if os.path.isdir(TEST_DIR):                             
                            test_paths = sorted(                                
                                [                                               
                                    os.path.join(TEST_DIR,                      
                    f)                                                          
                                    for f in                                    
                    os.listdir(TEST_DIR)                                        
                                    if f.endswith(".jpg")                       
                                ]                                               
                            )                                                   
                            test_probs = predict(model,                         
                    test_paths, base_transform,                                 
                    tta_transforms, DEVICE)                                     
                            submission = pd.DataFrame(                          
                                {                                               
                                    "image_name": [                             
                                        os.path.splitext(os                     
                    .path.basename(p))[0] for p in                              
                    test_paths                                                  
                                    ],                                          
                                    "malignant_probability"                     
                    : test_probs,                                               
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            submission.to_csv("./working/su                     
                    bmission.csv", index=False)                                 
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The                            
                    training loss consistently decreased                        
                    over 5 epochs, indicating effective                         
                    model learning. The validation AUROC                        
                    with multi-view test-time augmentation                      
                    achieved a high score of 0.9387,                            
                    demonstrating strong model performance                      
                    in distinguishing malignant from benign                     
                    skin lesions.                                               
                    Validation Metric: 0.9387                                   
                                                                                
