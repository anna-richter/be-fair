                    response: We extract features from                          
                    images using a pretrained ResNet18                          
                    model (with the final fully connected                       
                    layer removed) and use these 512‐dim                        
                    embeddings to train a LightGBM binary                       
                    classifier (malignant vs benign,                            
                    dropping non‐neoplastic samples). We                        
                    apply standard resizing, centering,                         
                    and ImageNet normalization, then run a                      
                    5‐fold cross‐validation to compute the                      
                    mean AUROC. Finally, we retrain the                         
                    LightGBM on the full data and provide                       
                    a predict() function that takes a list                      
                    of image file paths and returns                             
                    malignancy probabilities.                                   
                                                                                
                    ```python                                                   
                    import os                                                   
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    KFold                                                       
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from lightgbm import LGBMClassifier                         
                    import torch                                                
                    import torch.nn as nn                                       
                    from torchvision import models,                             
                    transforms                                                  
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                                                                                
                    # 1. Load and preprocess metadata                           
                    df =                                                        
                    pd.read_csv('./input/mydataset.csv')                        
                    # Keep only benign and malignant                            
                    df = df[df['label'].isin(['benign',                         
                    'malignant'])].reset_index(drop=True)                       
                    # Map labels: malignant=1, benign=0                         
                    df['target'] = (df['label'] ==                              
                    'malignant').astype(int)                                    
                                                                                
                    # 2. Build image path mapping                               
                    img_dir = './input/MyImages'                                
                    mapping = {}                                                
                    for f in os.listdir(img_dir):                               
                        if '.jpg' in f.lower():                                 
                            base = f.split('.jpg')[0]                           
                            mapping[base] =                                     
                    os.path.join(img_dir, f)                                    
                    # Filter rows with existing files                           
                    df['path'] =                                                
                    df['image_name'].map(mapping)                               
                    df =                                                        
                    df.dropna(subset=['path']).reset_index                      
                    (drop=True)                                                 
                                                                                
                    # 3. Define dataset & model for                             
                    feature extraction                                          
                    class ImageDataset(Dataset):                                
                        def __init__(self, paths,                               
                    transform):                                                 
                            self.paths = paths                                  
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.paths)                              
                        def __getitem__(self, idx):                             
                            img =                                               
                    Image.open(self.paths[idx]).convert('R                      
                    GB')                                                        
                            return self.transform(img),                         
                    idx                                                         
                                                                                
                    transform = transforms.Compose([                            
                        transforms.Resize(256),                                 
                    transforms.CenterCrop(224),                                 
                        transforms.ToTensor(),                                  
                        transforms.Normalize(mean=[0.485,0                      
                    .456,0.406], std=[0.229,0.224,0.225])                       
                    ])                                                          
                                                                                
                    device = torch.device('cuda' if                             
                    torch.cuda.is_available() else 'cpu')                       
                    backbone =                                                  
                    models.resnet18(pretrained=True)                            
                    backbone.fc = nn.Identity()                                 
                    backbone = backbone.to(device).eval()                       
                                                                                
                    # 4. Extract features                                       
                    all_paths = df['path'].tolist()                             
                    dataset = ImageDataset(all_paths,                           
                    transform)                                                  
                    loader = DataLoader(dataset,                                
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                    features = np.zeros((len(dataset),                          
                    512), dtype=np.float32)                                     
                    with torch.no_grad():                                       
                        for imgs, idxs in loader:                               
                            imgs = imgs.to(device)                              
                            feats =                                             
                    backbone(imgs).cpu().numpy()                                
                            features[idxs.numpy(), :] =                         
                    feats                                                       
                    labels = df['target'].values                                
                                                                                
                    # 5. 5-fold CV with LightGBM                                
                    kf = KFold(n_splits=5, shuffle=True,                        
                    random_state=42)                                            
                    aucs = []                                                   
                    for train_idx, val_idx in                                   
                    kf.split(features):                                         
                        clf =                                                   
                    LGBMClassifier(n_estimators=100,                            
                    random_state=42)                                            
                        clf.fit(features[train_idx],                            
                    labels[train_idx])                                          
                        probs =                                                 
                    clf.predict_proba(features[val_idx])[:                      
                    ,1]                                                         
                        aucs.append(roc_auc_score(labels[v                      
                    al_idx], probs))                                            
                    print(f"Mean 5-fold AUROC:                                  
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # 6. Retrain final model on all data                        
                    final_clf =                                                 
                    LGBMClassifier(n_estimators=100,                            
                    random_state=42)                                            
                    final_clf.fit(features, labels)                             
                                                                                
                    def predict(image_paths):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    new images.                                                 
                        Args:                                                   
                            image_paths (list of str):                          
                    file paths to images.                                       
                        Returns:                                                
                            np.ndarray: probabilities of                        
                    malignant class for each image.                             
                        """                                                     
                        ds = ImageDataset(image_paths,                          
                    transform)                                                  
                        dl = DataLoader(ds, batch_size=64,                      
                    shuffle=False, num_workers=4)                               
                        feats = []                                              
                        with torch.no_grad():                                   
                            for imgs, _ in dl:                                  
                                imgs = imgs.to(device)                          
                                out =                                           
                    backbone(imgs).cpu().numpy()                                
                                feats.append(out)                               
                        feats = np.vstack(feats)                                
                        return                                                  
                    final_clf.predict_proba(feats)[:,1]                         
