                    [os.path.splitext(os.path.basename(p))                      
                    [0] for p in test_paths],                                   
                        #     "malignant_probability":                          
                    test_probs                                                  
                        # })                                                    
                        #                                                       
                    submission.to_csv("./working/submissio                      
                    n.csv", index=False)                                        
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                    ```                                                         
