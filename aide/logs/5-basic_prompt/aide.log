def predict(model, folder_path, device):
    """
    Predict malignancy probabilities for all images in folder_path.
    Args:
        model (torch.nn.Module): Trained PyTorch model.
        folder_path (str): Directory containing images.
    Returns:
        dict: {image_filename: probability of malignancy}
