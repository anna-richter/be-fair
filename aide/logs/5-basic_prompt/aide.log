Design: We can replace the unavailable XGBoost dependency with scikit-learn’s LogisticRegression, which is readily available. We’ll extract features with the timm model as before, perform 5-fold stratified CV using LogisticRegression to compute AUROC, then retrain on the full dataset and save the final model. The `predict` function will load this saved model to score new images, and at the end we’ll generate `submission.csv` for all images in the input folder.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
import timm
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from sklearn.linear_model import LogisticRegression
import joblib

# Constants
IMAGE_DIR = "./input/MyImages"
CSV_PATH = "./input/mydataset.csv"
MODEL_PATH = "./working/lr_model.pkl"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
BATCH_SIZE = 32
SEED = 42


# Dataset for feature extraction
class LesionDataset(Dataset):
    def __init__(self, image_paths, transform):
        self.paths = image_paths
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        path = self.paths[idx]
        img = Image.open(path).convert("RGB")
        return self.transform(img), os.path.basename(path)


# Image transform
transform = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)

# Load metadata
df = pd.read_csv(CSV_PATH)
df["image_path"] = df["image_name"].apply(lambda x: os.path.join(IMAGE_DIR, f"{x}.jpg"))
df["target"] = (df["label"] == "malignant").astype(int)
paths = df["image_path"].tolist()
labels = df["target"].values

# Build feature extractor
feature_extractor = timm.create_model(
    "efficientnet_b0", pretrained=True, num_classes=0
).to(DEVICE)
feature_extractor.eval()


def extract_features(image_paths):
    dataset = LesionDataset(image_paths, transform)
    loader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)
    feats = []
    with torch.no_grad():
        for imgs, _ in loader:
            imgs = imgs.to(DEVICE)
            out = feature_extractor(imgs)
            feats.append(out.cpu().numpy())
    return np.vstack(feats)


# Extract features once
features = extract_features(paths)

# 5-fold stratified CV with Logistic Regression
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
aucs = []
for train_idx, val_idx in skf.split(features, labels):
    X_train, X_val = features[train_idx], features[val_idx]
    y_train, y_val = labels[train_idx], labels[val_idx]
    model = LogisticRegression(max_iter=1000, random_state=SEED)
    model.fit(X_train, y_train)
    preds = model.predict_proba(X_val)[:, 1]
    aucs.append(roc_auc_score(y_val, preds))

mean_auc = np.mean(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f}")

# Retrain on full data and save final model
final_model = LogisticRegression(max_iter=1000, random_state=SEED)
final_model.fit(features, labels)
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
joblib.dump(final_model, MODEL_PATH)


def predict(image_folder):
    """
    Predict malignancy probabilities for images in a folder.
    Args:
      image_folder (str): path to a directory of .jpg images
    Returns:
      pandas.DataFrame: columns ['image_name','malignancy_score']
    """
    files = [f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")]
    paths = [os.path.join(image_folder, f) for f in files]
    feats = extract_features(paths)
    model = joblib.load(MODEL_PATH)
    probs = model.predict_proba(feats)[:, 1]
    return pd.DataFrame({"image_name": files, "malignancy_score": probs})


# Generate submission for all images in input folder
submission = predict(IMAGE_DIR)
submission.to_csv("./working/submission.csv", index=False)
print("Saved submission.csv to ./working")

Results: The training script executed successfully without errors. The EfficientNet-B0 model was used as a feature extractor, and logistic regression was applied with 5-fold stratified cross-validation, yielding a strong mean AUROC of 0.8688. The final logistic regression model was trained on the full dataset and saved, and the prediction function correctly generates malignancy probabilities for new images.
Validation Metric: 0.8688

