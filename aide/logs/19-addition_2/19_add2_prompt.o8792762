                    Design: We will fine-tune a pretrained                      
                    EfficientNet-B0, freezing all but its                       
                    final classification head for fast                          
                    convergence, and train across                               
                    stratified 5-folds to predict malignant                     
                    vs. non-malignant labels. During                            
                    evaluation, we compute overall AUROC as                     
                    well as AUROCs for dark (skin_tone≤3)                       
                    and light (skin_tone≥5) subgroups and                       
                    report their mean gap to ensure                             
                    fairness. Each fold’s model is saved,                       
                    and a `predict()` function loads all                        
                    five models to average their malignancy                     
                    probabilities for new images.                               
                    Code: import os                                             
                    import glob                                                 
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset for training and validation                       
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transforms):                                                
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transforms = transforms                        
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            img = self.transforms(img)                          
                            label = float(row.target)                           
                            skin_tone = int(row.skin_tone)                      
                            return img, label, skin_tone                        
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder_path):                                   
                        """                                                     
                        Load the 5 trained EfficientNet-B0                      
                    models and return malignancy                                
                    probabilities                                               
                        for every .jpg in folder_path.                          
                    Returns a DataFrame with columns                            
                    ['image_name','probability'].                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # define validation transforms                          
                        val_transforms = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        # load models                                           
                        model_paths =                                           
                    sorted(glob.glob("./working/model_fold_                     
                    *.pth"))                                                    
                        models = []                                             
                        for mp in model_paths:                                  
                            m =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False, num_classes=1)                            
                            m.load_state_dict(torch.load(mp                     
                    , map_location=device))                                     
                            m.to(device).eval()                                 
                            models.append(m)                                    
                        # predict                                               
                        records = []                                            
                        for img_file in                                         
                    sorted(glob.glob(os.path.join(folder_pa                     
                    th, "*.jpg"))):                                             
                            img =                                               
                    Image.open(img_file).convert("RGB")                         
                            inp =                                               
                    val_transforms(img).unsqueeze(0).to(dev                     
                    ice)                                                        
                            with torch.no_grad():                               
                                preds =                                         
                    [torch.sigmoid(m(inp)).item() for m in                      
                    models]                                                     
                            prob = float(np.mean(preds))                        
                            records.append({"image_name":                       
                    os.path.basename(img_file),                                 
                    "probability": prob})                                       
                        return pd.DataFrame(records)                            
                                                                                
                                                                                
                    def main():                                                 
                        # load and preprocess metadata                          
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df = df[df.skin_tone != -1].copy()                      
                        df["target"] = (df.label ==                             
                    "malignant").astype(int)                                    
                        img_dir = "./input/MyImages"                            
                        # transforms                                            
                        train_transforms = T.Compose(                           
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.RandomHorizontalFlip(),                       
                                T.RandomRotation(15),                           
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        val_transforms = T.Compose(                             
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs, dark_aucs, light_aucs = [],                       
                    [], []                                                      
                                                                                
                        for fold, (tr_idx, val_idx) in                          
                    enumerate(skf.split(df, df.target)):                        
                            train_df, val_df =                                  
                    df.iloc[tr_idx], df.iloc[val_idx]                           
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_transforms)                                           
                            val_ds = SkinDataset(val_df,                        
                    img_dir, val_transforms)                                    
                            tr_loader =                                         
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                            val_loader = DataLoader(val_ds,                     
                    batch_size=64, shuffle=False,                               
                    num_workers=2)                                              
                                                                                
                            # model                                             
                            model =                                             
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=1)                             
                            # freeze backbone                                   
                            for n, p in                                         
                    model.named_parameters():                                   
                                if "classifier" not in n:                       
                                    p.requires_grad = False                     
                            model.to(device)                                    
                            optim = torch.optim.Adam(                           
                                filter(lambda p:                                
                    p.requires_grad, model.parameters()),                       
                    lr=1e-3                                                     
                            )                                                   
                            loss_fn =                                           
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            # train for 3 epochs                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, lbls, _ in                            
                    tr_loader:                                                  
                                    imgs = imgs.to(device)                      
                                    lbls =                                      
                    lbls.to(device).unsqueeze(1)                                
                                    logits = model(imgs)                        
                                    loss = loss_fn(logits,                      
                    lbls)                                                       
                                    optim.zero_grad()                           
                                    loss.backward()                             
                                    optim.step()                                
                                                                                
                            # evaluate                                          
                            model.eval()                                        
                            preds, targets, tones = [], [],                     
                    []                                                          
                            with torch.no_grad():                               
                                for imgs, lbls, skin in                         
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    out = model(imgs)                           
                                    prob =                                      
                    torch.sigmoid(out).cpu().numpy().flatte                     
                    n()                                                         
                                    preds.extend(prob)                          
                                    targets.extend(lbls.num                     
                    py().flatten())                                             
                                    tones.extend(skin.numpy                     
                    ().flatten())                                               
                                                                                
                            overall =                                           
                    roc_auc_score(targets, preds)                               
                            # subgroup                                          
                            dark_idx = [i for i, t in                           
                    enumerate(tones) if t <= 3]                                 
                            light_idx = [i for i, t in                          
                    enumerate(tones) if t >= 5]                                 
                                                                                
                            def sub_auc(idxs):                                  
                                labs = [targets[i] for i in                     
                    idxs]                                                       
                                ps = [preds[i] for i in                         
                    idxs]                                                       
                                return roc_auc_score(labs,                      
                    ps) if len(set(labs)) > 1 else np.nan                       
                                                                                
                            da = sub_auc(dark_idx)                              
                            la = sub_auc(light_idx)                             
                                                                                
                            aucs.append(overall)                                
                            dark_aucs.append(da)                                
                            light_aucs.append(la)                               
                            # save fold model                                   
                            torch.save(model.state_dict(),                      
                    f"./working/model_fold_{fold}.pth")                         
                                                                                
                        # report                                                
                        mean_auc = np.mean(aucs)                                
                        std_auc = np.std(aucs)                                  
                        mean_gap =                                              
                    np.nanmean(np.abs(np.array(dark_aucs) -                     
                    np.array(light_aucs)))                                      
                        print(f"Mean AUROC: {mean_auc:.4f}                      
                    ± {std_auc:.4f}")                                           
                        print(f"Mean subgroup AUC gap:                          
                    {mean_gap:.4f}")                                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without errors or bugs.                        
                    The model was trained using                                 
                    EfficientNet-B0 with a 5-fold                               
                    cross-validation setup, freezing                            
                    backbone layers and training only the                       
                    classifier head for 3 epochs. The mean                      
                    overall AUROC achieved was                                  
                    approximately 0.6595 with a standard                        
                    deviation of 0.0229, indicating                             
                    moderate classification performance.                        
                    The mean subgroup AUROC gap between                         
                    light and dark skin tones was about                         
                    0.0679, showing some disparity but                          
                    relatively controlled fairness across                       
                    skin tones.                                                 
                    Validation Metric: 0.6595                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    DenseNet121 end-to-end with skin‐tone                       
                    balanced sampling to mitigate fairness                      
                    gaps, applying common augmentations and                     
                    training for 3 epochs per fold. We                          
                    perform 5-fold stratified                                   
                    cross-validation, weighting each sample                     
                    inversely by its skin‐tone group                            
                    frequency, and compute overall AUROC as                     
                    well as the mean AUC gap between dark                       
                    and light skin subgroups. After                             
                    cross‐validation we retrain on the full                     
                    dataset with the same balanced sampler                      
                    and save the final model. The                               
                    evaluation metric reported is the mean                      
                    overall AUROC across folds and the mean                     
                    subgroup AUC gap.                                           
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Configuration                                             
                    IMG_DIR = "./input/MyImages"                                
                    CSV_PATH = "./input/mydataset.csv"                          
                    MODEL_PATH =                                                
                    "./working/final_model.pth"                                 
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    BATCH_SIZE = 32                                             
                    NUM_EPOCHS = 3                                              
                    N_SPLITS = 5                                                
                    LR = 1e-4                                                   
                                                                                
                    # Prepare DataFrame                                         
                    df = pd.read_csv(CSV_PATH)                                  
                    df["label_bin"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                                                                                
                                                                                
                    # Define skin-tone group                                    
                    def tone_group(x):                                          
                        if x <= 3:                                              
                            return "dark"                                       
                        if x >= 5:                                              
                            return "light"                                      
                        return "mid"                                            
                                                                                
                                                                                
                    df["group"] =                                               
                    df["skin_tone"].apply(tone_group)                           
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            x = self.transform(img)                             
                            y = torch.tensor(row.label_bin,                     
                    dtype=torch.float32)                                        
                            return x, y                                         
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize(256),                                      
                            T.RandomResizedCrop(224),                           
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize(256),                                      
                            T.CenterCrop(224),                                  
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                                                                                
                    for fold, (tr_idx, va_idx) in                               
                    enumerate(skf.split(df,                                     
                    df["label_bin"])):                                          
                        tr_df = df.iloc[tr_idx]                                 
                        va_df = df.iloc[va_idx]                                 
                        # Compute weights inverse to group                      
                    freq                                                        
                        grp_counts =                                            
                    tr_df["group"].value_counts().to_dict()                     
                        weights = tr_df["group"].map(lambda                     
                    g: 1.0 / grp_counts[g]).values                              
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                        # DataLoaders                                           
                        train_ds = SkinDataset(tr_df,                           
                    IMG_DIR, train_tf)                                          
                        val_ds = SkinDataset(va_df,                             
                    IMG_DIR, val_tf)                                            
                        tr_ld = DataLoader(train_ds,                            
                    batch_size=BATCH_SIZE, sampler=sampler,                     
                    num_workers=4)                                              
                        va_ld = DataLoader(val_ds,                              
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                        # Model                                                 
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR,                       
                    weight_decay=1e-5)                                          
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(NUM_EPOCHS):                         
                            for xb, yb in tr_ld:                                
                                xb, yb = xb.to(DEVICE),                         
                    yb.to(DEVICE)                                               
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                loss = criterion(logits,                        
                    yb)                                                         
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validate                                              
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for xb, yb in va_ld:                                
                                xb = xb.to(DEVICE)                              
                                logits =                                        
                    model(xb).squeeze(1).cpu().numpy()                          
                                prob = 1 / (1 +                                 
                    np.exp(-logits))                                            
                                ys.extend(yb.numpy())                           
                                ps.extend(prob)                                 
                        overall_auc = roc_auc_score(ys, ps)                     
                        # Subgroup AUCs                                         
                        va_df =                                                 
                    va_df.reset_index(drop=True)                                
                        va_df["prob"] = ps                                      
                        dark = va_df[va_df["group"] ==                          
                    "dark"]                                                     
                        light = va_df[va_df["group"] ==                         
                    "light"]                                                    
                        auc_dark = (                                            
                            roc_auc_score(dark["label_bin"]                     
                    , dark["prob"]) if len(dark) > 0 else                       
                    np.nan                                                      
                        )                                                       
                        auc_light = (                                           
                            roc_auc_score(light["label_bin"                     
                    ], light["prob"]) if len(light) > 0                         
                    else np.nan                                                 
                        )                                                       
                        gap = abs(auc_light - auc_dark)                         
                        aucs.append(overall_auc)                                
                        gaps.append(gap)                                        
                        print(f"Fold {fold+1} AUROC:                            
                    {overall_auc:.4f}, gap: {gap:.4f}")                         
                                                                                
                    print(f"Mean AUROC: {np.mean(aucs):.4f}                     
                    ± {np.std(aucs):.4f}")                                      
                    print(f"Mean subgroup gap:                                  
                    {np.nanmean(gaps):.4f}")                                    
                                                                                
                    # Retrain on full data                                      
                    full_weights = df["group"].map(lambda                       
                    g: 1.0 /                                                    
                    df["group"].value_counts()[g]).values                       
                    full_sampler = WeightedRandomSampler(                       
                        full_weights,                                           
                    num_samples=len(full_weights),                              
                    replacement=True                                            
                    )                                                           
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_tf)                                                   
                    full_ld = DataLoader(                                       
                        full_ds, batch_size=BATCH_SIZE,                         
                    sampler=full_sampler, num_workers=4                         
                    )                                                           
                                                                                
                    final_model =                                               
                    models.densenet121(pretrained=True)                         
                    final_model.classifier =                                    
                    nn.Linear(final_model.classifier.in_fea                     
                    tures, 1)                                                   
                    final_model = final_model.to(DEVICE)                        
                    opt =                                                       
                    optim.Adam(final_model.parameters(),                        
                    lr=LR, weight_decay=1e-5)                                   
                    crit = nn.BCEWithLogitsLoss()                               
                    final_model.train()                                         
                    for epoch in range(NUM_EPOCHS):                             
                        for xb, yb in full_ld:                                  
                            xb, yb = xb.to(DEVICE),                             
                    yb.to(DEVICE)                                               
                            opt.zero_grad()                                     
                            loss =                                              
                    crit(final_model(xb).squeeze(1), yb)                        
                            loss.backward()                                     
                            opt.step()                                          
                    torch.save(final_model.state_dict(),                        
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    def predict(folder: str):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each image in the given folder.                             
                        Args:                                                   
                            folder (str): path to folder                        
                    containing .jpg images named like                           
                    'image_#.jpg'                                               
                        Returns:                                                
                            pandas.DataFrame with columns                       
                    ['image_name','malignant_probability']                      
                        """                                                     
                        tf = T.Compose(                                         
                            [                                                   
                                T.Resize(256),                                  
                                T.CenterCrop(224),                              
                                T.ToTensor(),                                   
                                T.Normalize([0.485, 0.456,                      
                    0.406], [0.229, 0.224, 0.225]),                             
                            ]                                                   
                        )                                                       
                        m =                                                     
                    models.densenet121(pretrained=False)                        
                        m.classifier =                                          
                    nn.Linear(m.classifier.in_features, 1)                      
                        m.load_state_dict(torch.load(MODEL_                     
                    PATH, map_location=DEVICE))                                 
                        m = m.to(DEVICE).eval()                                 
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder)):                                 
                            if                                                  
                    fname.lower().endswith(".jpg"):                             
                                img =                                           
                    Image.open(os.path.join(folder,                             
                    fname)).convert("RGB")                                      
                                x =                                             
                    tf(img).unsqueeze(0).to(DEVICE)                             
                                with torch.no_grad():                           
                                    logit = m(x).item()                         
                                prob = 1 / (1 +                                 
                    np.exp(-logit))                                             
                                results.append(                                 
                                    {"image_name":                              
                    fname.replace(".jpg", ""),                                  
                    "malignant_probability": prob}                              
                                )                                               
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example: if there were test images,                       
                    save submission                                             
                    # test_df =                                                 
                    predict("./input/test_images")                              
                    #                                                           
                    test_df.to_csv("./working/submission.cs                     
                    v", index=False)                                            
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    achieved a strong mean AUROC of                             
                    approximately 0.8897 with a low                             
                    standard deviation, indicating                              
                    consistent performance across folds.                        
                    The mean subgroup AUROC gap between                         
                    light and dark skin tones was minimal                       
                    at about 0.0214, demonstrating fairness                     
                    towards skin tone groups while                              
                    maintaining overall model performance.                      
                    The model was retrained on the full                         
                    dataset and saved correctly, and the                        
                    prediction function is well-implemented                     
                    for new image inference.                                    
                    Validation Metric: 0.8897                                   
                                                                                
                    -------------------------------                             
                    Design: I will fine-tune a pretrained                       
                    MobileNetV2 end‐to‐end using a weighted                     
                    sampler to address class imbalance,                         
                    training for three epochs per fold with                     
                    standard augmentations. We perform                          
                    stratified 5‐fold cross‐validation to                       
                    compute the mean overall AUROC and the                      
                    AUROC gap between light (skin_tone≥5)                       
                    and dark (skin_tone≤3) subgroups. After                     
                    cross‐validation we retrain on the full                     
                    dataset and save the final model, and                       
                    provide a `predict()` function to infer                     
                    malignancy probabilities on new images.                     
                    The evaluation metric is the mean                           
                    cross‐validated AUROC.                                      
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Configuration                                             
                    DATA_CSV = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    NUM_FOLDS = 5                                               
                    BATCH_SIZE = 32                                             
                    EPOCHS = 3                                                  
                    LR = 1e-4                                                   
                    MODEL_PATH =                                                
                    "./working/mobilenetv2_full.pth"                            
                                                                                
                                                                                
                    # Dataset definition                                        
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.labels =                                       
                    df["target"].values                                         
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Read and preprocess CSV                                   
                    df = pd.read_csv(DATA_CSV)                                  
                    df["target"] = df["label"].apply(lambda                     
                    x: 1 if x == "malignant" else 0)                            
                    # Define skin tone groups for fairness                      
                    evaluation                                                  
                    df["skin_tone_clean"] =                                     
                    df["skin_tone"].replace(-1, np.nan)                         
                                                                                
                    # Transforms                                                
                    train_transform = T.Compose(                                
                        [                                                       
                            T.Resize((256, 256)),                               
                            T.RandomResizedCrop(224),                           
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(20),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_transform = T.Compose(                                  
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                                                                                
                    # Model constructor                                         
                    def get_model():                                            
                        model =                                                 
                    models.mobilenet_v2(pretrained=True)                        
                        model.classifier =                                      
                    nn.Sequential(nn.Dropout(0.2),                              
                    nn.Linear(model.last_channel, 1))                           
                        return model.to(DEVICE)                                 
                                                                                
                                                                                
                    # Training function                                         
                    def train_one_epoch(model, loader,                          
                    optimizer, criterion):                                      
                        model.train()                                           
                        running_loss = 0.0                                      
                        for imgs, labels in loader:                             
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE).unsqueeze(1)                              
                            optimizer.zero_grad()                               
                            outputs = model(imgs)                               
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        return running_loss /                                   
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    # Evaluation function                                       
                    def evaluate(model, loader):                                
                        model.eval()                                            
                        preds, trues, tones = [], [], []                        
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(DEVICE)                          
                                out =                                           
                    model(imgs).cpu().numpy().flatten()                         
                                preds.extend(out)                               
                                trues.extend(labels.numpy()                     
                    .flatten())                                                 
                        preds =                                                 
                    torch.sigmoid(torch.tensor(preds)).nump                     
                    y()                                                         
                        trues = np.array(trues)                                 
                        auc = roc_auc_score(trues, preds)                       
                        # subgroup metrics                                      
                        tone_vals =                                             
                    df.iloc[loader.dataset.df.index]["skin_                     
                    tone_clean"].values                                         
                        mask_dark = tone_vals <= 3                              
                        mask_light = tone_vals >= 5                             
                        auc_dark = (                                            
                            roc_auc_score(trues[mask_dark],                     
                    preds[mask_dark])                                           
                            if mask_dark.sum() > 0                              
                            else np.nan                                         
                        )                                                       
                        auc_light = (                                           
                            roc_auc_score(trues[mask_light]                     
                    , preds[mask_light])                                        
                            if mask_light.sum() > 0                             
                            else np.nan                                         
                        )                                                       
                        return auc, auc_dark, auc_light                         
                                                                                
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=NUM_FOLDS,                         
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df["target"]),                      
                    1):                                                         
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        # Weighted sampler for class                            
                    imbalance                                                   
                        class_counts =                                          
                    df_train["target"].value_counts().to_di                     
                    ct()                                                        
                        weights =                                               
                    df_train["target"].map(lambda x: 1.0 /                      
                    class_counts[x]).values                                     
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    len(weights), replacement=True)                             
                        train_ds = SkinDataset(df_train,                        
                    IMG_DIR, train_transform)                                   
                        val_ds = SkinDataset(df_val,                            
                    IMG_DIR, val_transform)                                     
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, sampler=sampler,                     
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                        model = get_model()                                     
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        criterion = nn.BCEWithLogitsLoss()                      
                        for epoch in range(EPOCHS):                             
                            train_one_epoch(model,                              
                    train_loader, optimizer, criterion)                         
                        auc, auc_dark, auc_light =                              
                    evaluate(model, val_loader)                                 
                        gap = (                                                 
                            abs(auc_light - auc_dark)                           
                            if not np.isnan(auc_light) and                      
                    not np.isnan(auc_dark)                                      
                            else np.nan                                         
                        )                                                       
                        print(                                                  
                            f"Fold {fold}: AUROC={auc:.4f},                     
                    dark={auc_dark:.4f},                                        
                    light={auc_light:.4f}, gap={gap:.4f}"                       
                        )                                                       
                        aucs.append(auc)                                        
                        if not np.isnan(gap):                                   
                            gaps.append(gap)                                    
                                                                                
                    print(f"Mean CV AUROC:                                      
                    {np.mean(aucs):.4f} ±                                       
                    {np.std(aucs):.4f}")                                        
                    print(f"Mean subgroup AUROC gap:                            
                    {np.mean(gaps):.4f}")                                       
                                                                                
                    # Retrain on full dataset and save                          
                    final model                                                 
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_transform)                                            
                    # full training sampler as                                  
                    class-balanced                                              
                    class_counts_full =                                         
                    df["target"].value_counts().to_dict()                       
                    weights_full = df["target"].map(lambda                      
                    x: 1.0 / class_counts_full[x]).values                       
                    sampler_full =                                              
                    WeightedRandomSampler(weights_full,                         
                    len(weights_full), replacement=True)                        
                    full_loader = DataLoader(                                   
                        full_ds, batch_size=BATCH_SIZE,                         
                    sampler=sampler_full, num_workers=4                         
                    )                                                           
                    model_full = get_model()                                    
                    opt_full =                                                  
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=LR)                                                   
                    crit_full = nn.BCEWithLogitsLoss()                          
                    for epoch in range(EPOCHS):                                 
                        train_one_epoch(model_full,                             
                    full_loader, opt_full, crit_full)                           
                    torch.save(model_full.state_dict(),                         
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all .jpg images in folder_path.                         
                        Returns a DataFrame with columns                        
                    ['image_name','malignancy_prob'].                           
                        """                                                     
                        model = get_model()                                     
                        model.load_state_dict(torch.load(MO                     
                    DEL_PATH, map_location=DEVICE))                             
                        model.eval()                                            
                        results = []                                            
                        transform = val_transform                               
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    transform(img).unsqueeze(0).to(DEVICE)                      
                            with torch.no_grad():                               
                                out =                                           
                    model(inp).cpu().item()                                     
                                prob =                                          
                    torch.sigmoid(torch.tensor(out)).item()                     
                            results.append(                                     
                                {"image_name":                                  
                    os.path.splitext(fname)[0],                                 
                    "malignancy_prob": prob}                                    
                            )                                                   
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example usage:                                            
                    # preds_df =                                                
                    predict("./input/MyImages")                                 
                    #                                                           
                    preds_df.to_csv("./working/submission.c                     
                    sv", index=False)                                           
                                                                                
                    Results: The model training and                             
                    evaluation ran successfully without                         
                    errors. The 5-fold cross-validation                         
                    showed a strong overall AUROC of about                      
                    0.90, indicating good classification                        
                    performance. The subgroup AUROC gap                         
                    between light and dark skin tones was                       
                    low (mean gap ~0.024), demonstrating                        
                    fairness across skin tones without                          
                    sacrificing overall accuracy. The final                     
                    model was trained on the full dataset                       
                    and saved as requested. The prediction                      
                    function is implemented to return                           
                    malignancy probabilities for new                            
                    images.                                                     
                    Validation Metric: 0.9001                                   
                                                                                
                    -------------------------------                             
                    Design: I propose fine-tuning a                             
                    pretrained ResNeXt50_32x4d backbone for                     
                    binary malignant vs non-malignant                           
                    classification by replacing its final                       
                    layer. We'll perform 5-fold stratified                      
                    cross-validation to estimate the                            
                    model’s generalization performance and                      
                    compute the AUROC and subgroup AUROC                        
                    gap between dark (skin_tone≤3) and                          
                    light (skin_tone≥5) skin tones to                           
                    monitor fairness. After                                     
                    cross-validation, we'll retrain on the                      
                    full dataset and save the final model.                      
                    A `predict()` function will load the                        
                    saved model and output malignancy                           
                    probabilities for new images.                               
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Paths and constants                                       
                    DATA_CSV = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                    MODEL_PATH = "./working/model.pth"                          
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    N_SPLITS = 5                                                
                    BATCH_SIZE = 64                                             
                    EPOCHS = 3                                                  
                    LR = 1e-4                                                   
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df,                                  
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(IMG_DIR,                                       
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = 1 if row.label ==                           
                    "malignant" else 0                                          
                            skin_tone = int(row.skin_tone)                      
                            return img, label, skin_tone                        
                                                                                
                                                                                
                    # Transforms                                                
                    train_transform = T.Compose(                                
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.RandomRotation(15),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485, 0.456,                     
                    0.406], std=[0.229, 0.224, 0.225]),                         
                        ]                                                       
                    )                                                           
                    val_transform = T.Compose(                                  
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485, 0.456,                     
                    0.406], std=[0.229, 0.224, 0.225]),                         
                        ]                                                       
                    )                                                           
                                                                                
                    # Load data                                                 
                    df = pd.read_csv(DATA_CSV)                                  
                    df = df[df.label.isin(["malignant",                         
                    "benign", "non-neoplastic"])].copy()                        
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    y = (df.label ==                                            
                    "malignant").astype(int).values                             
                                                                                
                    aucs = []                                                   
                    gaps = []                                                   
                                                                                
                    for train_idx, val_idx in skf.split(df,                     
                    y):                                                         
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        ds_train =                                              
                    SkinLesionDataset(df_train,                                 
                    transform=train_transform)                                  
                        ds_val = SkinLesionDataset(df_val,                      
                    transform=val_transform)                                    
                        loader_train = DataLoader(                              
                            ds_train,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        loader_val = DataLoader(ds_val,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        model =                                                 
                    models.resnext50_32x4d(pretrained=True)                     
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                                                                                
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(EPOCHS):                             
                            for imgs, labels, _ in                              
                    loader_train:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.float().to(DEVICE)                                   
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        y_true, y_prob, tones = [], [], []                      
                        with torch.no_grad():                                   
                            for imgs, labels, skin_tones in                     
                    loader_val:                                                 
                                imgs = imgs.to(DEVICE)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                y_prob.extend(probs.tolist(                     
                    ))                                                          
                                y_true.extend(labels.numpy(                     
                    ).tolist())                                                 
                                tones.extend(skin_tones)                        
                                                                                
                        y_true = np.array(y_true)                               
                        y_prob = np.array(y_prob)                               
                        tones = np.array(tones)                                 
                        auc = roc_auc_score(y_true, y_prob)                     
                        aucs.append(auc)                                        
                                                                                
                        # subgroup AUCs                                         
                        mask_dark = tones <= 3                                  
                        mask_light = tones >= 5                                 
                        auc_dark = (                                            
                            roc_auc_score(y_true[mask_dark]                     
                    , y_prob[mask_dark])                                        
                            if mask_dark.sum() > 0                              
                            else np.nan                                         
                        )                                                       
                        auc_light = (                                           
                            roc_auc_score(y_true[mask_light                     
                    ], y_prob[mask_light])                                      
                            if mask_light.sum() > 0                             
                            else np.nan                                         
                        )                                                       
                        gap = abs(auc_light - auc_dark)                         
                        gaps.append(gap)                                        
                                                                                
                    # Print CV results                                          
                    mean_auroc = np.nanmean(aucs)                               
                    mean_gap = np.nanmean(gaps)                                 
                    print(f"Mean AUROC: {mean_auroc:.4f},                       
                    Mean subgroup AUC gap: {mean_gap:.4f}")                     
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinLesionDataset(df,                             
                    transform=train_transform)                                  
                    full_loader = DataLoader(full_ds,                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                    model_full =                                                
                    models.resnext50_32x4d(pretrained=True)                     
                    model_full.fc =                                             
                    nn.Linear(model_full.fc.in_features, 1)                     
                    model_full = model_full.to(DEVICE)                          
                    optimizer =                                                 
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=LR)                                                   
                    criterion = nn.BCEWithLogitsLoss()                          
                    model_full.train()                                          
                    for epoch in range(EPOCHS):                                 
                        for imgs, labels, _ in full_loader:                     
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.float().to(DEVICE)                                   
                            optimizer.zero_grad()                               
                            logits =                                            
                    model_full(imgs).squeeze(1)                                 
                            loss = criterion(logits,                            
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                    # Save model                                                
                    os.makedirs(os.path.dirname(MODEL_PATH)                     
                    , exist_ok=True)                                            
                    torch.save(model_full.state_dict(),                         
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    def predict(folder_path: str) -> dict:                      
                        """                                                     
                        Load the trained model and return a                     
                    dict mapping image filenames to                             
                    malignancy probability.                                     
                        Args:                                                   
                            folder_path (str): Path to a                        
                    folder containing images (e.g., .jpg)                       
                        Returns:                                                
                            dict: {filename:                                    
                    probability_of_malignancy}                                  
                        """                                                     
                        # load model                                            
                        mdl =                                                   
                    models.resnext50_32x4d(pretrained=False                     
                    )                                                           
                        mdl.fc =                                                
                    nn.Linear(mdl.fc.in_features, 1)                            
                        mdl.load_state_dict(torch.load(MODE                     
                    L_PATH, map_location=DEVICE))                               
                        mdl = mdl.to(DEVICE).eval()                             
                        tf = val_transform                                      
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                inp =                                           
                    tf(img).unsqueeze(0).to(DEVICE)                             
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.sigmoid(mdl(inp)).item()                              
                                results[fname] = prob                           
                        return results                                          
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    achieved a strong mean AUROC of 0.9236,                     
                    indicating high overall classification                      
                    performance. The mean subgroup AUC gap                      
                    of 0.03 shows that the model maintains                      
                    relatively fair performance across                          
                    different skin tones, minimizing bias                       
                    while preserving accuracy. The model                        
                    was retrained on the full dataset and                       
                    saved for inference, with a prediction                      
                    function provided as requested.                             
                    Validation Metric: 0.9236                                   
                                                                                
                    -------------------------------                             
                    Design: I propose to address class                          
                    imbalance by using a weighted binary                        
                    cross-entropy loss with a per‐fold                          
                    positive class weight (pos_weight =                         
                    number of negatives / number of                             
                    positives). This will focus learning on                     
                    the malignant class and is likely to                        
                    improve overall AUROC. We compute                           
                    pos_weight from the training labels in                      
                    each CV split and also for the final                        
                    full‐data retraining. The rest of the                       
                    pipeline (ResNeXt50, transforms, CV,                        
                    fairness metrics, predict()) remains                        
                    unchanged.                                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Paths and constants                                       
