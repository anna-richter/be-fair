                        """                                                     
                        mdl =                                                   
                    models.resnext50_32x4d(pretrained=Fals                      
                    e)                                                          
                        mdl.fc =                                                
                    nn.Linear(mdl.fc.in_features, 1)                            
                        mdl.load_state_dict(torch.load(MOD                      
                    EL_PATH, map_location=DEVICE))                              
                        mdl.to(DEVICE).eval()                                   
                        tf = val_transform                                      
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                inp =                                           
                    tf(img).unsqueeze(0).to(DEVICE)                             
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.sigmoid(mdl(inp)).item()                              
                                results[fname] = prob                           
                        return results                                          
