                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                        model = get_model()                                     
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        criterion = nn.BCEWithLogitsLoss()                      
                        for epoch in range(EPOCHS):                             
                            train_one_epoch(model,                              
                    train_loader, optimizer, criterion)                         
                        auc, auc_dark, auc_light =                              
                    evaluate(model, val_loader)                                 
                        gap = abs(auc_light - auc_dark) if                      
                    not np.isnan(auc_light) and not                             
                    np.isnan(auc_dark) else np.nan                              
                        print(f"Fold {fold}:                                    
                    AUROC={auc:.4f}, dark={auc_dark:.4f},                       
                    light={auc_light:.4f}, gap={gap:.4f}")                      
                        aucs.append(auc)                                        
                        if not np.isnan(gap):                                   
                            gaps.append(gap)                                    
                                                                                
                    print(f"Mean CV AUROC:                                      
                    {np.mean(aucs):.4f} ±                                       
                    {np.std(aucs):.4f}")                                        
                    print(f"Mean subgroup AUROC gap:                            
                    {np.mean(gaps):.4f}")                                       
                                                                                
                    # Retrain on full dataset and save                          
                    final model                                                 
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_transform)                                            
                    # full training sampler as                                  
                    class-balanced                                              
                    class_counts_full =                                         
                    df['target'].value_counts().to_dict()                       
                    weights_full = df['target'].map(lambda                      
                    x: 1.0/class_counts_full[x]).values                         
                    sampler_full =                                              
                    WeightedRandomSampler(weights_full,                         
