                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg",".png")                      
                    ):                                                          
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                inp =                                           
                    tf(img).unsqueeze(0).to(DEVICE)                             
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.sigmoid(mdl(inp)).item()                              
                                results[fname] = prob                           
                        return results                                          
                    ```                                                         
