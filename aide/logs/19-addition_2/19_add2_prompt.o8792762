                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                        # load models                                           
                        model_paths =                                           
                    sorted(glob.glob("./working/model_fold                      
                    _*.pth"))                                                   
                        models = []                                             
                        for mp in model_paths:                                  
                            m =                                                 
                    timm.create_model('efficientnet_b0',                        
                    pretrained=False, num_classes=1)                            
                            m.load_state_dict(torch.load(m                      
                    p, map_location=device))                                    
                            m.to(device).eval()                                 
                            models.append(m)                                    
                        # predict                                               
                        records = []                                            
                        for img_file in                                         
                    sorted(glob.glob(os.path.join(folder_p                      
                    ath,"*.jpg"))):                                             
                            img =                                               
                    Image.open(img_file).convert("RGB")                         
                            inp =                                               
                    val_transforms(img).unsqueeze(0).to(de                      
                    vice)                                                       
                            with torch.no_grad():                               
                                preds =                                         
                    [torch.sigmoid(m(inp)).item() for m in                      
                    models]                                                     
                            prob = float(np.mean(preds))                        
                            records.append({"image_name":o                      
                    s.path.basename(img_file),"probability                      
                    ":prob})                                                    
                        return pd.DataFrame(records)                            
                                                                                
                    def main():                                                 
                        # load and preprocess metadata                          
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df = df[df.skin_tone!=-1].copy()                        
                        df['target'] =                                          
                    (df.label=="malignant").astype(int)                         
                        img_dir = "./input/MyImages"                            
                        # transforms                                            
                        train_transforms = T.Compose([                          
                            T.Resize((224,224)),                                
                            T.RandomHorizontalFlip(),                           
                            T.RandomRotation(15),                               
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                        val_transforms = T.Compose([                            
                            T.Resize((224,224)),                                
                            T.ToTensor(),                                       
                            T.Normalize([0.485,0.456,0.406                      
                    ],[0.229,0.224,0.225])                                      
                        ])                                                      
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs, dark_aucs, light_aucs = [],                       
                    [], []                                                      
                                                                                
                        for fold, (tr_idx, val_idx) in                          
                    enumerate(skf.split(df, df.target)):                        
                            train_df, val_df =                                  
                    df.iloc[tr_idx], df.iloc[val_idx]                           
                            train_ds =                                          
                    SkinDataset(train_df, img_dir,                              
                    train_transforms)                                           
                            val_ds   = SkinDataset(val_df,                      
                    img_dir, val_transforms)                                    
                            tr_loader =                                         
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                            val_loader= DataLoader(val_ds,                      
                    batch_size=64, shuffle=False,                               
                    num_workers=2)                                              
                                                                                
                            # model                                             
                            model =                                             
                    timm.create_model('efficientnet_b0',                        
                    pretrained=True, num_classes=1)                             
                            # freeze backbone                                   
                            for n,p in                                          
                    model.named_parameters():                                   
                                if "classifier" not in n:                       
                                    p.requires_grad =                           
                    False                                                       
                            model.to(device)                                    
                            optim =                                             
                    torch.optim.Adam(filter(lambda p:                           
                    p.requires_grad, model.parameters()),                       
                    lr=1e-3)                                                    
                            loss_fn =                                           
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            # train for 3 epochs                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, lbls, _ in                            
                    tr_loader:                                                  
                                    imgs =                                      
                    imgs.to(device); lbls =                                     
                    lbls.to(device).unsqueeze(1)                                
                                    logits = model(imgs)                        
                                    loss = loss_fn(logits,                      
                    lbls)                                                       
                                    optim.zero_grad();                          
                    loss.backward(); optim.step()                               
                                                                                
                            # evaluate                                          
                            model.eval()                                        
                            preds, targets, tones = [],                         
                    [], []                                                      
                            with torch.no_grad():                               
                                for imgs, lbls, skin in                         
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    out = model(imgs)                           
                                    prob =                                      
                    torch.sigmoid(out).cpu().numpy().flatt                      
                    en()                                                        
                                    preds.extend(prob)                          
                                    targets.extend(lbls.nu                      
                    mpy().flatten())                                            
                                    tones.extend(skin.nump                      
                    y().flatten())                                              
                                                                                
                            overall =                                           
                    roc_auc_score(targets, preds)                               
                            # subgroup                                          
                            dark_idx  = [i for i,t in                           
                    enumerate(tones) if t<=3]                                   
                            light_idx = [i for i,t in                           
                    enumerate(tones) if t>=5]                                   
                            def sub_auc(idxs):                                  
                                labs = [targets[i] for i                        
                    in idxs]                                                    
                                ps  = [preds[i] for i in                        
                    idxs]                                                       
                                return roc_auc_score(labs,                      
                    ps) if len(set(labs))>1 else np.nan                         
                            da = sub_auc(dark_idx); la =                        
                    sub_auc(light_idx)                                          
                                                                                
                            aucs.append(overall);                               
                    dark_aucs.append(da);                                       
                    light_aucs.append(la)                                       
                            # save fold model                                   
                            torch.save(model.state_dict(),                      
                    f"./working/model_fold_{fold}.pth")                         
                                                                                
                        # report                                                
                        mean_auc = np.mean(aucs); std_auc                       
                    = np.std(aucs)                                              
                        mean_gap =                                              
                    np.nanmean(np.abs(np.array(dark_aucs)-                      
                    np.array(light_aucs)))                                      
                        print(f"Mean AUROC: {mean_auc:.4f}                      
                    ± {std_auc:.4f}")                                           
                        print(f"Mean subgroup AUC gap:                          
                    {mean_gap:.4f}")                                            
                                                                                
                    if __name__=="__main__":                                    
                        main()                                                  
                    ```                                                         
