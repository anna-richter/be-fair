                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        y_true, y_prob, tones = [], [], []                      
                        with torch.no_grad():                                   
