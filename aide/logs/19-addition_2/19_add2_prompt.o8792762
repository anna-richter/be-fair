                    ).flatten())                                                
                        preds =                                                 
                    torch.sigmoid(torch.tensor(preds)).num                      
                    py()                                                        
                        trues = np.array(trues)                                 
                        auc = roc_auc_score(trues, preds)                       
                        # subgroup metrics                                      
                        tone_vals =                                             
                    df.iloc[loader.dataset.df.index]['skin                      
                    _tone_clean'].values                                        
                        mask_dark = (tone_vals <= 3)                            
                        mask_light = (tone_vals >= 5)                           
                        auc_dark =                                              
                    roc_auc_score(trues[mask_dark],                             
                    preds[mask_dark]) if mask_dark.sum() >                      
                    0 else np.nan                                               
                        auc_light =                                             
                    roc_auc_score(trues[mask_light],                            
                    preds[mask_light]) if mask_light.sum()                      
                    > 0 else np.nan                                             
                        return auc, auc_dark, auc_light                         
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=NUM_FOLDS,                         
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df['target']),                      
                    1):                                                         
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
