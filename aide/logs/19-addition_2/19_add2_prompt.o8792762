                    N_SPLITS = 5                                                
                    BATCH_SIZE = 64                                             
                    EPOCHS = 3                                                  
                    LR = 1e-4                                                   
                    CUTMIX_PROB = 0.5                                           
                    CUTMIX_ALPHA = 1.0                                          
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df,                                  
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.df)                                 
