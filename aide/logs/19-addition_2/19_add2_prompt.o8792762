                    mask_light.sum() > 0 else np.nan                            
                        gaps.append(abs(auc_light -                             
                    auc_dark))                                                  
                                                                                
                    # Report CV results                                         
                    mean_auroc = np.nanmean(aucs)                               
                    mean_gap = np.nanmean(gaps)                                 
                    print(f"Mean AUROC: {mean_auroc:.4f},                       
                    Mean subgroup AUC gap:                                      
                    {mean_gap:.4f}")                                            
                                                                                
