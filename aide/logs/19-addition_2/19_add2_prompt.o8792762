                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = float(row.malignant)                        
                            skin = int(row.skin_tone)                           
                            return img, label, skin                             
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(                                                
                        model_path,                                             
