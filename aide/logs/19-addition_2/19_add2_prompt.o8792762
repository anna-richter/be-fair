                    weights_full = df["target"].map(lambda                      
                    x: 1.0 / class_counts_full[x]).values                       
                    sampler_full =                                              
                    WeightedRandomSampler(weights_full,                         
                    len(weights_full), replacement=True)                        
                    full_loader = DataLoader(                                   
                        full_ds, batch_size=BATCH_SIZE,                         
                    sampler=sampler_full, num_workers=4                         
                    )                                                           
                    model_full = get_model()                                    
                    opt_full =                                                  
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=LR)                                                   
                    crit_full = nn.BCEWithLogitsLoss()                          
                    for epoch in range(EPOCHS):                                 
                        train_one_epoch(model_full,                             
                    full_loader, opt_full, crit_full)                           
                    torch.save(model_full.state_dict(),                         
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probabilities                        
                    for all .jpg images in folder_path.                         
                        Returns a DataFrame with columns                        
                    ['image_name','malignancy_prob'].                           
                        """                                                     
                        model = get_model()                                     
                        model.load_state_dict(torch.load(MO                     
                    DEL_PATH, map_location=DEVICE))                             
                        model.eval()                                            
                        results = []                                            
                        transform = val_transform                               
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                            inp =                                               
                    transform(img).unsqueeze(0).to(DEVICE)                      
                            with torch.no_grad():                               
                                out =                                           
                    model(inp).cpu().item()                                     
                                prob =                                          
                    torch.sigmoid(torch.tensor(out)).item()                     
                            results.append(                                     
                                {"image_name":                                  
                    os.path.splitext(fname)[0],                                 
                    "malignancy_prob": prob}                                    
                            )                                                   
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example usage:                                            
                    # preds_df =                                                
                    predict("./input/MyImages")                                 
                    #                                                           
                    preds_df.to_csv("./working/submission.c                     
                    sv", index=False)                                           
                                                                                
