                    not np.isnan(auc_light)                                     
                            else np.nan                                         
                        )                                                       
                                                                                
                        aucs.append(auc)                                        
                        gaps.append(gap)                                        
                                                                                
                        # Save last fold model                                  
                        if fold == 4:                                           
                            os.makedirs("working",                              
                    exist_ok=True)                                              
                            torch.save(model.state_dict(),                      
                    "working/model.pth")                                        
                                                                                
                    # Print results                                             
                    print(f"Mean AUROC:                                         
                    {np.nanmean(aucs):.4f} ±                                    
                    {np.nanstd(aucs):.4f}")                                     
                    print(f"Mean subgroup AUC gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                                                                                
