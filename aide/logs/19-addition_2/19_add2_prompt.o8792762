                    imgs.to(DEVICE),                                            
                    labels.float().to(DEVICE)                                   
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        y_true, y_prob, tones = [], [], []                      
                        with torch.no_grad():                                   
