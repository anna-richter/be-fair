                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    # 5-fold CV                                                 
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df,                                     
                    df["malignant"])):                                          
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds =                                              
                    SkinLesionDataset(train_df, img_dir,                        
                    transform=train_tf)                                         
                        val_ds = SkinLesionDataset(val_df,                      
                    img_dir, transform=val_tf)                                  
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Train                                                 
                        for epoch in range(2):                                  
                            model.train()                                       
                            for imgs, labels, _ in                              
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        all_preds, all_labels, all_skin =                       
                    [], [], []                                                  
                        with torch.no_grad():                                   
                            for imgs, labels, skins in                          
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_preds.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.to                     
                    list())                                                     
                                all_skin.extend(skins.tolis                     
                    t())                                                        
                                                                                
                        auc = roc_auc_score(all_labels,                         
                    all_preds)                                                  
                        # subgroup AUCs                                         
                        dfv = pd.DataFrame({"pred":                             
                    all_preds, "label": all_labels, "skin":                     
                    all_skin})                                                  
                        dark = dfv[dfv.skin <= 3]                               
                        light = dfv[dfv.skin >= 5]                              
                        auc_dark = (                                            
                            roc_auc_score(dark.label,                           
                    dark.pred) if len(dark.label.unique())                      
                    > 1 else np.nan                                             
                        )                                                       
                        auc_light = (                                           
                            roc_auc_score(light.label,                          
                    light.pred)                                                 
                            if len(light.label.unique()) >                      
                    1                                                           
                            else np.nan                                         
                        )                                                       
                        gap = (                                                 
                            abs(auc_dark - auc_light)                           
                            if not np.isnan(auc_dark) and                       
                    not np.isnan(auc_light)                                     
                            else np.nan                                         
                        )                                                       
                                                                                
                        aucs.append(auc)                                        
                        gaps.append(gap)                                        
                                                                                
                        # Save last fold model                                  
                        if fold == 4:                                           
                            os.makedirs("working",                              
                    exist_ok=True)                                              
                            torch.save(model.state_dict(),                      
                    "working/model.pth")                                        
                                                                                
                    # Print results                                             
                    print(f"Mean AUROC:                                         
                    {np.nanmean(aucs):.4f} ±                                    
                    {np.nanstd(aucs):.4f}")                                     
                    print(f"Mean subgroup AUC gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                                                                                
