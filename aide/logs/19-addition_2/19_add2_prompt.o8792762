                    weight_decay=1e-5)                                          
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(NUM_EPOCHS):                         
                            for xb, yb in tr_ld:                                
                                xb, yb = xb.to(DEVICE),                         
                    yb.to(DEVICE)                                               
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                loss = criterion(logits,                        
                    yb)                                                         
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validate                                              
