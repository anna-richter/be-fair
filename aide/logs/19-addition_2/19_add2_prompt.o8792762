                    response: We fine-tune a pretrained                         
                    DenseNet121 end-to-end with skin‐tone                       
                    balanced sampling to mitigate fairness                      
                    gaps, applying common augmentations                         
                    and training for 3 epochs per fold. We                      
                    perform 5-fold stratified                                   
                    cross-validation, weighting each                            
                    sample inversely by its skin‐tone                           
                    group frequency, and compute overall                        
                    AUROC as well as the mean AUC gap                           
                    between dark and light skin subgroups.                      
                    After cross‐validation we retrain on                        
                    the full dataset with the same                              
                    balanced sampler and save the final                         
                    model. The evaluation metric reported                       
                    is the mean overall AUROC across folds                      
                    and the mean subgroup AUC gap.                              
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Configuration                                             
                    IMG_DIR = "./input/MyImages"                                
                    CSV_PATH = "./input/mydataset.csv"                          
                    MODEL_PATH =                                                
                    "./working/final_model.pth"                                 
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    BATCH_SIZE = 32                                             
                    NUM_EPOCHS = 3                                              
                    N_SPLITS = 5                                                
                    LR = 1e-4                                                   
                                                                                
                    # Prepare DataFrame                                         
                    df = pd.read_csv(CSV_PATH)                                  
                    df['label_bin'] = (df['label'] ==                           
                    'malignant').astype(int)                                    
                    # Define skin-tone group                                    
                    def tone_group(x):                                          
                        if x <= 3: return 'dark'                                
                        if x >= 5: return 'light'                               
                        return 'mid'                                            
                    df['group'] =                                               
                    df['skin_tone'].apply(tone_group)                           
                                                                                
                    # Dataset                                                   
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    f"{row.image_name}.jpg")                                    
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            x = self.transform(img)                             
                            y =                                                 
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.float32)                                        
                            return x, y                                         
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose([                                      
                        T.Resize(256),                                          
                        T.RandomResizedCrop(224),                               
                        T.RandomHorizontalFlip(),                               
                        T.RandomVerticalFlip(),                                 
                        T.ToTensor(),                                           
                        T.Normalize([0.485,0.456,0.406],[0                      
                    .229,0.224,0.225])                                          
                    ])                                                          
                    val_tf = T.Compose([                                        
                        T.Resize(256),                                          
                        T.CenterCrop(224),                                      
                        T.ToTensor(),                                           
                        T.Normalize([0.485,0.456,0.406],[0                      
                    .229,0.224,0.225])                                          
                    ])                                                          
                                                                                
                    # Cross-validation                                          
                    skf =                                                       
                    StratifiedKFold(n_splits=N_SPLITS,                          
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                                                                                
                    for fold, (tr_idx, va_idx) in                               
                    enumerate(skf.split(df,                                     
                    df['label_bin'])):                                          
                        tr_df = df.iloc[tr_idx]                                 
                        va_df = df.iloc[va_idx]                                 
                        # Compute weights inverse to group                      
                    freq                                                        
                        grp_counts =                                            
                    tr_df['group'].value_counts().to_dict(                      
                    )                                                           
                        weights =                                               
                    tr_df['group'].map(lambda g:                                
                    1.0/grp_counts[g]).values                                   
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                        # DataLoaders                                           
                        train_ds = SkinDataset(tr_df,                           
                    IMG_DIR, train_tf)                                          
                        val_ds = SkinDataset(va_df,                             
                    IMG_DIR, val_tf)                                            
                        tr_ld = DataLoader(train_ds,                            
                    batch_size=BATCH_SIZE,                                      
                    sampler=sampler, num_workers=4)                             
                        va_ld = DataLoader(val_ds,                              
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                        # Model                                                 
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features                      
                    , 1)                                                        
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR,                       
                    weight_decay=1e-5)                                          
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(NUM_EPOCHS):                         
                            for xb, yb in tr_ld:                                
                                xb, yb = xb.to(DEVICE),                         
                    yb.to(DEVICE)                                               
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(xb).squeeze(1)                                        
                                loss = criterion(logits,                        
                    yb)                                                         
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validate                                              
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for xb, yb in va_ld:                                
                                xb = xb.to(DEVICE)                              
                                logits =                                        
                    model(xb).squeeze(1).cpu().numpy()                          
                                prob =                                          
                    1/(1+np.exp(-logits))                                       
                                ys.extend(yb.numpy())                           
                                ps.extend(prob)                                 
                        overall_auc = roc_auc_score(ys,                         
                    ps)                                                         
                        # Subgroup AUCs                                         
                        va_df =                                                 
                    va_df.reset_index(drop=True)                                
                        va_df['prob'] = ps                                      
                        dark =                                                  
                    va_df[va_df['group']=='dark']                               
                        light =                                                 
                    va_df[va_df['group']=='light']                              
                        auc_dark =                                              
                    roc_auc_score(dark['label_bin'],                            
                    dark['prob']) if len(dark)>0 else                           
                    np.nan                                                      
                        auc_light =                                             
                    roc_auc_score(light['label_bin'],                           
                    light['prob']) if len(light)>0 else                         
                    np.nan                                                      
                        gap = abs(auc_light - auc_dark)                         
                        aucs.append(overall_auc)                                
                        gaps.append(gap)                                        
                        print(f"Fold {fold+1} AUROC:                            
                    {overall_auc:.4f}, gap: {gap:.4f}")                         
                                                                                
                    print(f"Mean AUROC:                                         
                    {np.mean(aucs):.4f} ±                                       
                    {np.std(aucs):.4f}")                                        
                    print(f"Mean subgroup gap:                                  
                    {np.nanmean(gaps):.4f}")                                    
                                                                                
                    # Retrain on full data                                      
                    full_weights = df['group'].map(lambda                       
                    g:                                                          
                    1.0/df['group'].value_counts()[g]).val                      
                    ues                                                         
                    full_sampler =                                              
                    WeightedRandomSampler(full_weights,                         
                    num_samples=len(full_weights),                              
                    replacement=True)                                           
                    full_ds = SkinDataset(df, IMG_DIR,                          
                    train_tf)                                                   
                    full_ld = DataLoader(full_ds,                               
                    batch_size=BATCH_SIZE,                                      
                    sampler=full_sampler, num_workers=4)                        
                                                                                
                    final_model =                                               
                    models.densenet121(pretrained=True)                         
                    final_model.classifier =                                    
                    nn.Linear(final_model.classifier.in_fe                      
                    atures, 1)                                                  
                    final_model = final_model.to(DEVICE)                        
                    opt =                                                       
                    optim.Adam(final_model.parameters(),                        
                    lr=LR, weight_decay=1e-5)                                   
                    crit = nn.BCEWithLogitsLoss()                               
                    final_model.train()                                         
                    for epoch in range(NUM_EPOCHS):                             
                        for xb, yb in full_ld:                                  
                            xb, yb = xb.to(DEVICE),                             
                    yb.to(DEVICE)                                               
                            opt.zero_grad()                                     
                            loss =                                              
                    crit(final_model(xb).squeeze(1), yb)                        
                            loss.backward()                                     
                            opt.step()                                          
                    torch.save(final_model.state_dict(),                        
                    MODEL_PATH)                                                 
                                                                                
                    def predict(folder: str):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    each image in the given folder.                             
                        Args:                                                   
                            folder (str): path to folder                        
                    containing .jpg images named like                           
                    'image_#.jpg'                                               
                        Returns:                                                
                            pandas.DataFrame with columns                       
                    ['image_name','malignant_probability']                      
                        """                                                     
                        tf = T.Compose([T.Resize(256),                          
                    T.CenterCrop(224),                                          
                                        T.ToTensor(),                           
                                        T.Normalize([0.485                      
                    ,0.456,0.406],[0.229,0.224,0.225])])                        
                        m =                                                     
                    models.densenet121(pretrained=False)                        
                        m.classifier =                                          
                    nn.Linear(m.classifier.in_features, 1)                      
                        m.load_state_dict(torch.load(MODEL                      
                    _PATH, map_location=DEVICE))                                
                        m = m.to(DEVICE).eval()                                 
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(folder)):                                 
                            if                                                  
                    fname.lower().endswith('.jpg'):                             
                                img =                                           
                    Image.open(os.path.join(folder,fname))                      
                    .convert("RGB")                                             
                                x =                                             
                    tf(img).unsqueeze(0).to(DEVICE)                             
                                with torch.no_grad():                           
                                    logit = m(x).item()                         
                                prob =                                          
                    1/(1+np.exp(-logit))                                        
                                results.append({'image_nam                      
                    e':fname.replace('.jpg',''),'malignant                      
                    _probability':prob})                                        
                        return pd.DataFrame(results)                            
                                                                                
                    # Example: if there were test images,                       
                    save submission                                             
