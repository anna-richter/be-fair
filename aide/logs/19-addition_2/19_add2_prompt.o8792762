                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    import torch.nn.functional as F                             
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Paths and constants                                       
                    DATA_CSV = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                    MODEL_DIR = "./working"                                     
                    MODEL_PATH = os.path.join(MODEL_DIR,                        
                    "model_full.pth")                                           
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    N_SPLITS = 5                                                
                    BATCH_SIZE = 64                                             
                    EPOCHS = 3                                                  
                    LR = 1e-4                                                   
                                                                                
                    # Focal Loss                                                
                    class FocalLoss(nn.Module):                                 
                        def __init__(self, gamma=2.0,                           
                    alpha=0.25, reduction='mean',                               
                    logits=True):                                               
                            super().__init__()                                  
                            self.gamma = gamma                                  
                            self.alpha = alpha                                  
                            self.reduction = reduction                          
                            self.logits = logits                                
                                                                                
                        def forward(self, inputs,                               
                    targets):                                                   
                            if self.logits:                                     
                                bce =                                           
                    F.binary_cross_entropy_with_logits(inp                      
                    uts, targets, reduction='none')                             
                                p = torch.sigmoid(inputs)                       
                            else:                                               
                                bce =                                           
                    F.binary_cross_entropy(inputs,                              
                    targets, reduction='none')                                  
                                p = inputs                                      
                            p_t = p * targets + (1 - p) *                       
                    (1 - targets)                                               
                            alpha_t = self.alpha * targets                      
                    + (1 - self.alpha) * (1 - targets)                          
                            loss = alpha_t * (1 - p_t) **                       
                    self.gamma * bce                                            
                            if self.reduction == 'mean':                        
                                return loss.mean()                              
                            elif self.reduction == 'sum':                       
                                return loss.sum()                               
                            return loss                                         
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df,                                  
