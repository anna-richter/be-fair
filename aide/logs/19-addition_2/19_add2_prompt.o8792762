                    probability_of_malignancy}                                  
                        """                                                     
                        mdl =                                                   
                    models.resnext50_32x4d(pretrained=False                     
                    )                                                           
                        mdl.fc =                                                
                    nn.Linear(mdl.fc.in_features, 1)                            
                        mdl.load_state_dict(torch.load(MODE                     
                    L_PATH, map_location=DEVICE))                               
                        mdl.to(DEVICE).eval()                                   
                        results = {}                                            
                        for fname in                                            
                    os.listdir(folder_path):                                    
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                # TTA                                           
                                inputs =                                        
                    torch.stack([tf(img) for tf in                              
                    tta_transforms], dim=0).to(DEVICE)                          
                                with torch.no_grad():                           
                                    logits =                                    
                    mdl(inputs).squeeze(1)                                      
                                    probs =                                     
                    torch.sigmoid(logits)                                       
                                results[fname] =                                
                    probs.mean().item()                                         
                        return results                                          
                                                                                
                                                                                
                    # Save submission if test dir exists                        
                    if os.path.isdir(TEST_DIR):                                 
                        preds = predict(TEST_DIR)                               
                        df_sub = pd.DataFrame(                                  
                            list(preds.items()),                                
                    columns=["image_name",                                      
                    "malignancy_prob"]                                          
                        )                                                       
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        df_sub.to_csv("./working/submission                     
                    .csv", index=False)                                         
                                                                                
                    ```                                                         
                                                                                
