                    imbalance                                                   
                        class_counts =                                          
                    df_train['target'].value_counts().to_d                      
                    ict()                                                       
                        weights =                                               
                    df_train['target'].map(lambda x:                            
                    1.0/class_counts[x]).values                                 
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    len(weights), replacement=True)                             
                        train_ds = SkinDataset(df_train,                        
