                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = float(row.malignant)                        
                            skin = int(row.skin_tone)                           
                            return img, label, skin                             
                                                                                
                    # Predict function                                          
                    def predict(model_path, img_folder,                         
                    batch_size=32, device="cuda" if                             
                    torch.cuda.is_available() else "cpu"):                      
                        """                                                     
                        Load a trained model and return                         
                    malignancy probabilities for all                            
                    images in img_folder.                                       
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        device = torch.device(device)                           
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(m                      
                    odel_path, map_location=device))                            
                        model.to(device).eval()                                 
                        transform = T.Compose([                                 
                            T.Resize(256),                                      
                    T.CenterCrop(224),                                          
                            T.ToTensor(),                                       
                    T.Normalize([0.485,0.456,0.406],[0.229                      
                    ,0.224,0.225])                                              
                        ])                                                      
                        fnames = sorted([f for f in                             
                    os.listdir(img_folder) if                                   
                    f.lower().endswith(".jpg")])                                
                        ds = [(fname,                                           
                    transform(Image.open(os.path.join(img_                      
                    folder, fname)).convert("RGB"))) for                        
                    fname in fnames]                                            
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False,                       
                    collate_fn=lambda x: list(zip(*x)))                         
                        results = []                                            
                        with torch.no_grad():                                   
                            for names, imgs in loader:                          
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                for n,p in                                      
                    zip(names,probs):                                           
                                    results.append({"image                      
                    _name": n, "probability": float(p)})                        
                        return pd.DataFrame(results)                            
                                                                                
                    # Load data                                                 
                    df =                                                        
                    pd.read_csv("input/mydataset.csv")                          
                    df["malignant"] = (df["label"] ==                           
                    "malignant").astype(int)                                    
                    img_dir = "input/MyImages"                                  
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose([                                      
                        T.RandomResizedCrop(224),                               
                    T.RandomHorizontalFlip(),                                   
                        T.ToTensor(),                                           
                    T.Normalize([0.485,0.456,0.406],[0.229                      
                    ,0.224,0.225])                                              
                    ])                                                          
                    val_tf = T.Compose([                                        
                        T.Resize(256), T.CenterCrop(224),                       
                        T.ToTensor(),                                           
                    T.Normalize([0.485,0.456,0.406],[0.229                      
                    ,0.224,0.225])                                              
                    ])                                                          
                                                                                
                    # 5-fold CV                                                 
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df,                                     
                    df["malignant"])):                                          
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds =                                              
                    SkinLesionDataset(train_df, img_dir,                        
                    transform=train_tf)                                         
                        val_ds = SkinLesionDataset(val_df,                      
                    img_dir, transform=val_tf)                                  
                        train_loader =                                          
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(device)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Train                                                 
                        for epoch in range(2):                                  
                            model.train()                                       
                            for imgs, labels, _ in                              
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        all_preds, all_labels, all_skin =                       
                    [], [], []                                                  
                        with torch.no_grad():                                   
                            for imgs, labels, skins in                          
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_preds.extend(probs.tol                      
                    ist())                                                      
                                all_labels.extend(labels.t                      
                    olist())                                                    
                                all_skin.extend(skins.toli                      
                    st())                                                       
                                                                                
                        auc = roc_auc_score(all_labels,                         
                    all_preds)                                                  
                        # subgroup AUCs                                         
                        dfv = pd.DataFrame({"pred":                             
                    all_preds, "label": all_labels,                             
                    "skin": all_skin})                                          
                        dark = dfv[dfv.skin <= 3]                               
                        light = dfv[dfv.skin >= 5]                              
                        auc_dark =                                              
                    roc_auc_score(dark.label, dark.pred)                        
                    if len(dark.label.unique())>1 else                          
                    np.nan                                                      
                        auc_light =                                             
                    roc_auc_score(light.label, light.pred)                      
                    if len(light.label.unique())>1 else                         
                    np.nan                                                      
                        gap = abs(auc_dark - auc_light) if                      
                    not np.isnan(auc_dark) and not                              
                    np.isnan(auc_light) else np.nan                             
                                                                                
                        aucs.append(auc)                                        
                        gaps.append(gap)                                        
                                                                                
                        # Save last fold model                                  
                        if fold == 4:                                           
                            os.makedirs("working",                              
                    exist_ok=True)                                              
                            torch.save(model.state_dict(),                      
                    "working/model.pth")                                        
                                                                                
                    # Print results                                             
                    print(f"Mean AUROC:                                         
                    {np.nanmean(aucs):.4f} ±                                    
                    {np.nanstd(aucs):.4f}")                                     
                    print(f"Mean subgroup AUC gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                    ```                                                         
