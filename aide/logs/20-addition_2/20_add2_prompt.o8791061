                                l1 = model(imgs)                                
                                l2 =                                            
                    model(torch.flip(imgs, [3]))                                
                                probs =                                         
                    ((torch.sigmoid(l1) +                                       
                    torch.sigmoid(l2)) /                                        
                    2).cpu().numpy().flatten()                                  
                                for f,p in zip(batch,                           
                    probs):                                                     
                                    out[f] = float(p)                           
                        return out                                              
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map({"malignant":1,"benign                      
