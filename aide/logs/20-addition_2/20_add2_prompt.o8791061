                        backbone.eval()                                         
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        img_paths = [                                           
                            os.path.join(folder_path, f)                        
                            for f in                                            
                    os.listdir(folder_path)                                     
                            if f.lower().endswith(".jpg")                       
                        ]                                                       
                        ds = PredictionDataset(img_paths,                       
                    transform)                                                  
                        loader = DataLoader(ds,                                 
                    batch_size=64, num_workers=4,                               
                    pin_memory=True)                                            
                        results = []                                            
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                feats =                                         
                    backbone(imgs.to(device)).cpu().numpy()                     
                                probs =                                         
                    clf.predict_proba(feats)[:, 1]                              
                                for n, p in zip(names,                          
                    probs):                                                     
                                    results.append((n, p))                      
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        # load data                                             
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label_bin"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                        # extract embeddings                                    
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        X = extract_embeddings(df,                              
                    "./input/MyImages", device)                                 
                        y = df["label_bin"].values                              
                        # sample weights inversely to skin                      
                    tone frequency                                              
                        freq =                                                  
                    df["skin_tone"].value_counts().to_dict(                     
                    )                                                           
                        w = df["skin_tone"].map(lambda x:                       
                    1.0 / freq[x]).values                                       
                        w *= len(w) / w.sum()                                   
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, val_idx in                               
                    skf.split(X, y):                                            
                            X_tr, y_tr, w_tr =                                  
                    X[train_idx], y[train_idx],                                 
                    w[train_idx]                                                
                            X_val, y_val = X[val_idx],                          
                    y[val_idx]                                                  
                            clf =                                               
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                            clf.fit(                                            
                                X_tr,                                           
                                y_tr,                                           
                                sample_weight=w_tr,                             
                                eval_set=[(X_val, y_val)],                      
                                eval_metric="auc",                              
                                early_stopping_rounds=50,                       
                                verbose=False,                                  
                            )                                                   
                            preds =                                             
                    clf.predict_proba(X_val)[:, 1]                              
                            aucs.append(roc_auc_score(y_val                     
                    , preds))                                                   
                        mean_auc = np.mean(aucs)                                
                        print(f"Mean AUROC:                                     
                    {mean_auc:.4f}")                                            
                        # retrain on full data                                  
                        final_clf =                                             
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                        final_clf.fit(X, y,                                     
                    sample_weight=w)                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        pickle.dump(final_clf,                                  
                    open("./working/classifier.pkl", "wb"))                     
                                                                                
