                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = 1 if row.label ==                           
                    "malignant" else 0                                          
                            skin_tone = row.skin_tone                           
                            return img, label, skin_tone,                       
                    row.image_name                                              
                                                                                
                                                                                
                    def get_sampler(df):                                        
                        # group by skin_tone                                    
                        tones = df.skin_tone.values                             
                        uniq, counts = np.unique(tones,                         
                    return_counts=True)                                         
                        inv_counts = {u: 1.0 / c for u, c                       
                    in zip(uniq, counts)}                                       
                        weights = np.array([inv_counts[t]                       
                    for t in tones], dtype=np.float32)                          
                        return                                                  
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                                                                                
                                                                                
                    # transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((256, 256)),                               
                            T.RandomResizedCrop(224),                           
                            T.RandomHorizontalFlip(),                           
                            T.ColorJitter(0.2, 0.2, 0.2,                        
                    0.1),                                                       
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)),                         
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)),                         
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    df =                                                        
                    pd.read_csv("./input/mydataset.csv")                        
                    # filter out rows without known label                       
                    df = df[df.label.isin(["benign",                            
                    "malignant"])].reset_index(drop=True)                       
                                                                                
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.label)):                         
                        train_df = df.iloc[train_idx]                           
                        val_df = df.iloc[val_idx]                               
                        train_ds =                                              
                    SkinLesionDataset(train_df,                                 
                    "./input/MyImages", transform=train_tf)                     
                        val_ds = SkinLesionDataset(val_df,                      
                    "./input/MyImages", transform=val_tf)                       
                        sampler = get_sampler(train_df)                         
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=2).to(                         
                            device                                              
                        )                                                       
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        # train                                                 
                        for epoch in range(5):                                  
                            model.train()                                       
                            for imgs, labels, _, _ in                           
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device),                                            
                    labels.float().to(device)                                   
                                logits =                                        
                    model(imgs).squeeze()                                       
                                loss = criterion(logits,                        
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                        # validate                                              
                        model.eval()                                            
                        all_labels, all_probs, all_tones =                      
                    [], [], []                                                  
                        with torch.no_grad():                                   
                            for imgs, labels, tones, _ in                       
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze().cpu().numpy()                         
                                probs = 1 / (1 +                                
                    np.exp(-logits))                                            
                                all_probs.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy())                                                      
                                all_tones.extend(tones.nump                     
                    y())                                                        
                        overall_auc =                                           
                    roc_auc_score(all_labels, all_probs)                        
                        # fairness groups                                       
                        lt_mask = np.array(all_tones) <= 3                      
                        dk_mask = np.array(all_tones) >= 5                      
                        auc_lt = (                                              
                            roc_auc_score(np.array(all_labe                     
                    ls)[lt_mask],                                               
                    np.array(all_probs)[lt_mask])                               
                            if lt_mask.sum() > 0                                
                            else np.nan                                         
                        )                                                       
                        auc_dk = (                                              
                            roc_auc_score(np.array(all_labe                     
                    ls)[dk_mask],                                               
                    np.array(all_probs)[dk_mask])                               
                            if dk_mask.sum() > 0                                
                            else np.nan                                         
                        )                                                       
                        gap = abs(auc_lt - auc_dk)                              
                        aucs.append(overall_auc)                                
                        gaps.append(gap)                                        
                        print(f"Fold {fold}:                                    
                    AUROC={overall_auc:.4f},                                    
                    gap={gap:.4f}")                                             
                                                                                
                    print(f"Mean AUROC:                                         
                    {np.nanmean(aucs):.4f}, Mean fairness                       
                    gap: {np.nanmean(gaps):.4f}")                               
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinLesionDataset(df,                             
                    "./input/MyImages", transform=train_tf)                     
                    sampler = get_sampler(df)                                   
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=sampler,                             
                    num_workers=4)                                              
                    model =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True,                                            
                    num_classes=2).to(device)                                   
                    opt =                                                       
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                    crit = nn.BCEWithLogitsLoss()                               
                    for epoch in range(5):                                      
                        model.train()                                           
                        for imgs, labels, _, _ in                               
                    full_loader:                                                
                            imgs, labels = imgs.to(device),                     
                    labels.float().to(device)                                   
                            loss =                                              
                    crit(model(imgs).squeeze(), labels)                         
                            opt.zero_grad()                                     
                            loss.backward()                                     
                            opt.step()                                          
                    # save                                                      
                    os.makedirs("./working", exist_ok=True)                     
                    torch.save(model.state_dict(),                              
                    "./working/model.pth")                                      
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        folder_path: path to folder                             
                    containing .jpg images                                      
                        returns: DataFrame with columns                         
                    ['image_name','malignancy_prob']                            
                        """                                                     
                        tf = val_tf                                             
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        m =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False,                                           
                    num_classes=2).to(device)                                   
                        m.load_state_dict(torch.load("./wor                     
                    king/model.pth", map_location=device))                      
                        m.eval()                                                
                        results = []                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    os.listdir(folder_path):                                    
                                if not                                          
                    fname.lower().endswith(".jpg"):                             
                                    continue                                    
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                logit = m(x).item()                             
                                prob = 1 / (1 +                                 
                    np.exp(-logit))                                             
                                results.append({"image_name                     
                    ": fname, "malignancy_prob": prob})                         
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example usage:                                            
                    # preds = predict('./input/MyImages')                       
                    #                                                           
                    preds.to_csv('./working/submission.csv'                     
                    , index=False)                                              
                                                                                
                    ```                                                         
                                                                                
