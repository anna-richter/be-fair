                                    loss = lam *                                
                    crit(preds, ya) + (1-lam) *                                 
                    crit(preds, yb)                                             
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                                                                                
                            # validate                                          
                            ys, ps, tones_v = [], [], []                        
                            model.eval()                                        
                            with torch.no_grad():                               
                                for x,y,t in dl_vl:                             
                                    x = x.to(device)                            
