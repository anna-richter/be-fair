                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path = os.path.join('input',                        
                    'MyImages',                                                 
                    f"{row['image_name']}.jpg")                                 
                            img =                                               
                    Image.open(path).convert('RGB')                             
                            img = self.transform(img)                           
                            st = int(row['skin_tone']) + 1                      
                    # shift -1->0                                               
                            label =                                             
                    float(row['label_idx'])                                     
                            return img, st, label                               
                                                                                
                    # Model                                                     
                    class LesionModel(nn.Module):                               
                        def __init__(self, num_skin=8,                          
                    emb_dim=16):                                                
                            super().__init__()                                  
                            self.backbone =                                     
                    timm.create_model('resnet50',                               
                    pretrained=True, num_classes=0,                             
                    global_pool='avg')                                          
                            feat_dim =                                          
                    self.backbone.num_features                                  
                            self.skin_emb =                                     
                    nn.Embedding(num_skin, emb_dim)                             
                            self.head = nn.Sequential(                          
                                nn.Linear(feat_dim+emb_dim                      
                    , 256),                                                     
                                nn.ReLU(),                                      
                                nn.Dropout(0.3),                                
                                nn.Linear(256,1)                                
                            )                                                   
                                                                                
                        def forward(self, x, st):                               
                            f = self.backbone(x)                                
                            se = self.skin_emb(st)                              
                            out = self.head(torch.cat([f,                       
                    se], dim=1))                                                
                            return out.squeeze(1)                               
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose([                                      
                        T.RandomResizedCrop(224),                               
                        T.RandomHorizontalFlip(),                               
                        T.RandomRotation(15),                                   
                        T.ColorJitter(0.2,0.2,0.2,0.1),                         
                        T.ToTensor(),                                           
                        T.Normalize([0.485,0.456,0.406],[0                      
                    .229,0.224,0.225])                                          
                    ])                                                          
                    val_tf = T.Compose([                                        
                        T.Resize(256),                                          
                        T.CenterCrop(224),                                      
                        T.ToTensor(),                                           
                        T.Normalize([0.485,0.456,0.406],[0                      
                    .229,0.224,0.225])                                          
                    ])                                                          
                                                                                
                    # Load data                                                 
                    df =                                                        
                    pd.read_csv('input/mydataset.csv')                          
                    # binary label                                              
                    df['label_idx'] =                                           
                    df['label'].map(lambda x: 1 if                              
                    x=='malignant' else 0)                                      
                    # fill missing skin_tone as -1                              
                    df['skin_tone'] =                                           
                    df['skin_tone'].fillna(-1).astype(int)                      
                                                                                
                    device = torch.device('cuda' if                             
                    torch.cuda.is_available() else 'cpu')                       
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold,(tr_idx,vl_idx) in                                 
                    enumerate(skf.split(df,                                     
                    df['label_idx'])):                                          
                        df_tr, df_vl = df.iloc[tr_idx],                         
                    df.iloc[vl_idx]                                             
                        # sampler for imbalance                                 
                        counts =                                                
                    df_tr['label_idx'].value_counts().sort                      
                    _index().values                                             
                        w = 1. / counts                                         
                        samp_w =                                                
                    w[df_tr['label_idx'].values]                                
                        sampler =                                               
                    WeightedRandomSampler(samp_w,                               
                    len(samp_w), replacement=True)                              
                                                                                
                        ds_tr = SkinLesionDataset(df_tr,                        
                    train_tf)                                                   
                        ds_vl = SkinLesionDataset(df_vl,                        
                    val_tf)                                                     
                        dl_tr = DataLoader(ds_tr,                               
                    batch_size=32, sampler=sampler,                             
                    num_workers=4, pin_memory=True)                             
                        dl_vl = DataLoader(ds_vl,                               
                    batch_size=64, shuffle=False,                               
                    num_workers=4, pin_memory=True)                             
                                                                                
                        model = LesionModel().to(device)                        
                        opt =                                                   
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        loss_fn = nn.BCEWithLogitsLoss()                        
                                                                                
                        best_auc = 0                                            
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, sts, lbs in dl_tr:                        
                                imgs, sts, lbs =                                
                    imgs.to(device), sts.to(device),                            
                    lbs.to(device)                                              
                                opt.zero_grad()                                 
                                out = model(imgs, sts)                          
                                loss = loss_fn(out, lbs)                        
                                loss.backward();                                
                    opt.step()                                                  
                            # validation                                        
                            model.eval()                                        
                            preds, trues = [], []                               
                            with torch.no_grad():                               
                                for imgs, sts, lbs in                           
                    dl_vl:                                                      
                                    imgs, sts =                                 
                    imgs.to(device), sts.to(device)                             
                                    out = model(imgs, sts)                      
                                    probs =                                     
                    torch.sigmoid(out).cpu().numpy()                            
                                    preds.extend(probs);                        
                    trues.extend(lbs.numpy())                                   
                            auc = roc_auc_score(trues,                          
                    preds)                                                      
                            if auc > best_auc:                                  
                                best_auc = auc                                  
                        print(f"Fold {fold+1} AUROC:                            
                    {best_auc:.4f}")                                            
                        aucs.append(best_auc)                                   
                                                                                
                    # save final model                                          
                    os.makedirs('working', exist_ok=True)                       
                    torch.save(model.state_dict(),                              
                    'working/model.pth')                                        
                    print(f"Mean AUROC:                                         
                    {np.mean(aucs):.4f}")                                       
                                                                                
                    # predict function                                          
                    def predict(image_folder: str):                             
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder.                                     
                        Args:                                                   
                          image_folder: path to folder                          
                    containing .jpg images                                      
                        Returns:                                                
                          pandas DataFrame with columns                         
                    ['image_name','probability']                                
                        """                                                     
                        m = LesionModel().to(device)                            
                        m.load_state_dict(torch.load('work                      
                    ing/model.pth', map_location=device))                       
                        m.eval()                                                
                        results = []                                            
                        files = [f for f in                                     
                    os.listdir(image_folder) if                                 
                    f.lower().endswith('.jpg')]                                 
                        for fname in files:                                     
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert('RGB')                                      
                            x =                                                 
                    val_tf(img).unsqueeze(0).to(device)                         
                            # assume unknown skin_tone as                       
                    -1->0                                                       
                            st = torch.tensor([0],                              
                    dtype=torch.long).to(device)                                
                            with torch.no_grad():                               
                                prob = torch.sigmoid(m(x,                       
                    st)).item()                                                 
                            results.append({'image_name':                       
                    fname, 'probability': prob})                                
                        return pd.DataFrame(results)                            
                    ```                                                         
