                                "malignant_probability":                        
                    list(preds.values())                                        
                            })                                                  
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            sub.to_csv("./working/submissi                      
                    on.csv", index=False)                                       
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
