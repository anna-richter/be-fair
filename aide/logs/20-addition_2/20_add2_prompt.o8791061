                    y.float().to(device)                                        
                                    mx, ya, yb, l =                             
                    mixup_data(x, y)                                            
                                    pred =                                      
                    model(mx).squeeze(1)                                        
                                    loss = l *                                  
                    loss_fn(pred, ya) + (1 - l) *                               
                    loss_fn(pred, yb)                                           
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                            # Validate                                          
                            model.eval()                                        
                            ys, ps, ts = [], [], []                             
                            with torch.no_grad():                               
                                for x, y, t in dl_va:                           
                                    x = x.to(device)                            
                                    probs =                                     
                    tta_predict_batch(model, x)                                 
                                    ys.extend(y.numpy())                        
                                    ps.extend(probs)                            
                                    ts.extend(t.numpy())                        
                            auc = roc_auc_score(ys, ps)                         
                            # Correct fairness gap: light                       
                    tones 1-3 vs dark tones 5-6                                 
                            dfv = pd.DataFrame({"y":ys,                         
                    "p":ps, "tone":ts})                                         
                            light =                                             
                    dfv[dfv.tone.isin([1,2,3])]                                 
                            dark =                                              
                    dfv[dfv.tone.isin([5,6])]                                   
                            if len(light)>0 and                                 
                    len(dark)>0:                                                
                                light_auc =                                     
                    roc_auc_score(light.y, light.p)                             
                                dark_auc =                                      
                    roc_auc_score(dark.y, dark.p)                               
                                gap = abs(light_auc -                           
                    dark_auc)                                                   
                            else:                                               
                                gap = np.nan                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                            aucs.append(auc)                                    
                            gaps.append(gap)                                    
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        # Save final model                                      
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                        # Generate test submission if                           
                    available                                                   
                        if                                                      
                    os.path.isdir("./input/test_images"):                       
                            preds = predict("model.pth",                        
                    "./input/test_images")                                      
                            sub = pd.DataFrame({                                
                                "image_name":                                   
