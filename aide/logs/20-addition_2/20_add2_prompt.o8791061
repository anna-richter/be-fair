                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation with                                   
