                    456,0.406],[0.229,0.224,0.225]),                            
                        ])                                                      
                        filenames =                                             
                    sorted(os.listdir(image_folder))                            
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
