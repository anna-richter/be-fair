                        probs = []                                              
                        for aug in aug_imgs:                                    
                            logits = model(aug)                                 
                            probs.append(torch.sigmoid(logi                     
                    ts).cpu().numpy())                                          
                        avg = np.mean(np.stack(probs,                           
                    axis=0), axis=0).flatten()                                  
                        return avg                                              
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        files = sorted([f for f in                              
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")])                                
                        results = {}                                            
                        loader = DataLoader(files,                              
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = torch.stack(                             
                                    [                                           
                                        tf(Image.open(os.pa                     
                    th.join(image_folder,                                       
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                probs =                                         
                    tta_predict_batch(model, imgs)                              
                                for f, p in zip(batch,                          
                    probs):                                                     
                                    results[f] = float(p)                       
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(5,                                
                    shuffle=True, random_state=42)                              
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        aucs, gaps = [], []                                     
                        for fold, (tr, va) in                                   
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_tr, df_va = df.iloc[tr],                         
                    df.iloc[va]                                                 
                            tones =                                             
                    df_tr["skin_tone"].values                                   
                            wc = dict(zip(*np.unique(tones,                     
                    return_counts=True)))                                       
                            weights = [1.0 / wc[t] for t in                     
                    tones]                                                      
                            sampler =                                           
                    WeightedRandomSampler(weights,                              
                    len(weights), True)                                         
                            dl_tr = DataLoader(                                 
                                LesionDataset(df_tr,                            
                    "./input/MyImages", tf),                                    
                                batch_size=32,                                  
                                sampler=sampler,                                
                                num_workers=2,                                  
                            )                                                   
                            dl_va = DataLoader(                                 
                                LesionDataset(df_va,                            
                    "./input/MyImages", tf),                                    
                                batch_size=32,                                  
                                shuffle=False,                                  
                                num_workers=2,                                  
                            )                                                   
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model.to(device)                                    
                            opt =                                               
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            loss_fn =                                           
                    nn.BCEWithLogitsLoss()                                      
                            for _ in range(5):                                  
                                model.train()                                   
                                for x, y, _ in dl_tr:                           
                                    x, y = x.to(device),                        
                    y.float().to(device)                                        
                                    mx, ya, yb, l =                             
                    mixup_data(x, y)                                            
                                    pred =                                      
                    model(mx).squeeze(1)                                        
                                    loss = l *                                  
                    loss_fn(pred, ya) + (1 - l) *                               
                    loss_fn(pred, yb)                                           
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                            model.eval()                                        
                            ys, ps, ts = [], [], []                             
                            with torch.no_grad():                               
                                for x, y, t in dl_va:                           
                                    x = x.to(device)                            
                                    probs =                                     
                    tta_predict_batch(model, x)                                 
                                    ys.extend(y.numpy())                        
                                    ps.extend(probs)                            
                                    ts.extend(t.numpy())                        
                            auc = roc_auc_score(ys, ps)                         
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": ts})                                       
                            lt = dfv[dfv.tone <= 3]                             
                            dk = dfv[dfv.tone >= 5]                             
                            gap = abs(                                          
                                roc_auc_score(lt.y, lt.p)                       
                                if len(lt) > 0                                  
                                else np.nan -                                   
                    roc_auc_score(dk.y, dk.p) if len(dk) >                      
                    0 else np.nan                                               
                            )                                                   
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                            aucs.append(auc)                                    
                            gaps.append(gap)                                    
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                        # optional test submission                              
                        if                                                      
                    os.path.isdir("./input/test_images"):                       
                            preds = predict("model.pth",                        
                    "./input/test_images")                                      
                            pd.DataFrame(                                       
                                {                                               
                                    "image_name":                               
                    list(preds.keys()),                                         
                                    "malignant_probability"                     
                    : list(preds.values()),                                     
                                }                                               
                            ).to_csv("./working/submission.                     
                    csv", index=False)                                          
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
