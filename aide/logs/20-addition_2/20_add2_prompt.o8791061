                        # sample weights inversely to skin                      
                    tone frequency                                              
                        freq =                                                  
                    df["skin_tone"].value_counts().to_dict(                     
                    )                                                           
                        w = df["skin_tone"].map(lambda x:                       
                    1.0 / freq[x]).values                                       
                        w *= len(w) / w.sum()                                   
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, val_idx in                               
                    skf.split(X, y):                                            
                            X_tr, y_tr, w_tr =                                  
                    X[train_idx], y[train_idx],                                 
                    w[train_idx]                                                
                            X_val, y_val = X[val_idx],                          
                    y[val_idx]                                                  
                            clf =                                               
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                            clf.fit(                                            
                                X_tr,                                           
                                y_tr,                                           
                                sample_weight=w_tr,                             
                                eval_set=[(X_val, y_val)],                      
                                eval_metric="auc",                              
                                callbacks=[lgb.early_stoppi                     
                    ng(stopping_rounds=50),                                     
                    lgb.log_evaluation(0)],                                     
                            )                                                   
                            preds =                                             
                    clf.predict_proba(X_val)[:, 1]                              
                            aucs.append(roc_auc_score(y_val                     
                    , preds))                                                   
                        mean_auc = np.mean(aucs)                                
                        print(f"Mean AUROC:                                     
                    {mean_auc:.4f}")                                            
                        # retrain on full data                                  
                        final_clf =                                             
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                        final_clf.fit(X, y,                                     
                    sample_weight=w)                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        pickle.dump(final_clf,                                  
                    open("./working/classifier.pkl", "wb"))                     
                                                                                
                    ```                                                         
                                                                                
