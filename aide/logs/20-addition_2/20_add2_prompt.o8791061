                    crit(preds, ya) + (1 - lam) *                               
                    crit(preds, yb)                                             
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                                                                                
                            model.eval()                                        
                            ys, ps, tones_v = [], [], []                        
                            with torch.no_grad():                               
                                for x, y, t in dl_vl:                           
                                    x = x.to(device)                            
                                    l1 = model(x)                               
                                    l2 =                                        
                    model(torch.flip(x, [3]))                                   
                                    probs = (                                   
                                        ((torch.sigmoid(l1)                     
                    + torch.sigmoid(l2)) / 2)                                   
                                        .cpu()                                  
                                        .numpy()                                
                                        .flatten()                              
                                    )                                           
                                    ys.extend(y.numpy())                        
                                    ps.extend(probs)                            
                                    tones_v.extend(t.numpy(                     
                    ))                                                          
                                                                                
                            auc = roc_auc_score(ys, ps)                         
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": tones_v})                                  
                            light = dfv[dfv.tone <= 3]                          
                            dark = dfv[dfv.tone >= 5]                           
                            g = abs(                                            
                                roc_auc_score(light.y,                          
                    light.p)                                                    
                                if len(light) > 0                               
                                else np.nan -                                   
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            )                                                   
                            aucs.append(auc)                                    
                            gaps.append(g)                                      
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={g:.4f}")                              
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
