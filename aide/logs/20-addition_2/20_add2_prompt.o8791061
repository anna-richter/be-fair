                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation with                                   
