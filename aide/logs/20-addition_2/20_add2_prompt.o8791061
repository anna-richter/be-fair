                            )                                                   
                            dl_va = DataLoader(                                 
                                LesionDataset(df_va,                            
                    "./input/MyImages", tf),                                    
                                batch_size=32,                                  
                    shuffle=False, num_workers=2                                
                            )                                                   
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model.to(device)                                    
                            opt =                                               
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            loss_fn =                                           
                    nn.BCEWithLogitsLoss()                                      
                            # Train                                             
                            for _ in range(5):                                  
                                model.train()                                   
                                for x, y, _ in dl_tr:                           
