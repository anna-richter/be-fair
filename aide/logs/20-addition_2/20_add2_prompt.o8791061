                    Validation Metric: 0.8915                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    ResNet50 from timm, concatenating a                         
                    learned skin tone embedding to the                          
                    image features before the                                   
                    classification head to mitigate bias.                       
                    We train with a weighted sampler to                         
                    address class imbalance and apply                           
                    standard augmentations, evaluating                          
                    performance via stratified 5-fold                           
                    cross-validation and reporting mean                         
                    AUROC. The best model is saved to                           
                    `working/model.pth`, and a `predict()`                      
                    function is provided for inference on                       
                    new image folders.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, transform):                      
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path = os.path.join("input",                        
                    "MyImages", f"{row['image_name']}.jpg")                     
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            img = self.transform(img)                           
                            st = int(row["skin_tone"]) + 1                      
                    # shift -1->0                                               
                            label = float(row["label_idx"])                     
                            return img, st, label                               
                                                                                
                                                                                
                    # Model                                                     
                    class LesionModel(nn.Module):                               
                        def __init__(self, num_skin=8,                          
                    emb_dim=16):                                                
                            super().__init__()                                  
                            self.backbone =                                     
                    timm.create_model(                                          
                                "resnet50",                                     
                    pretrained=True, num_classes=0,                             
                    global_pool="avg"                                           
                            )                                                   
                            feat_dim =                                          
                    self.backbone.num_features                                  
                            self.skin_emb =                                     
                    nn.Embedding(num_skin, emb_dim)                             
                            self.head = nn.Sequential(                          
                                nn.Linear(feat_dim +                            
                    emb_dim, 256),                                              
                                nn.ReLU(),                                      
                                nn.Dropout(0.3),                                
                                nn.Linear(256, 1),                              
                            )                                                   
                                                                                
                        def forward(self, x, st):                               
                            f = self.backbone(x)                                
                            se = self.skin_emb(st)                              
                            out = self.head(torch.cat([f,                       
                    se], dim=1))                                                
                            return out.squeeze(1)                               
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.RandomResizedCrop(224),                           
                            T.RandomHorizontalFlip(),                           
                            T.RandomRotation(15),                               
                            T.ColorJitter(0.2, 0.2, 0.2,                        
                    0.1),                                                       
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize(256),                                      
                            T.CenterCrop(224),                                  
                            T.ToTensor(),                                       
                            T.Normalize([0.485, 0.456,                          
                    0.406], [0.229, 0.224, 0.225]),                             
                        ]                                                       
                    )                                                           
                                                                                
                    # Load data                                                 
                    df = pd.read_csv("input/mydataset.csv")                     
                    # binary label                                              
                    df["label_idx"] =                                           
                    df["label"].map(lambda x: 1 if x ==                         
                    "malignant" else 0)                                         
                    # fill missing skin_tone as -1                              
                    df["skin_tone"] =                                           
                    df["skin_tone"].fillna(-1).astype(int)                      
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold, (tr_idx, vl_idx) in                               
                    enumerate(skf.split(df,                                     
                    df["label_idx"])):                                          
                        df_tr, df_vl = df.iloc[tr_idx],                         
                    df.iloc[vl_idx]                                             
                        # sampler for imbalance                                 
                        counts =                                                
                    df_tr["label_idx"].value_counts().sort_                     
                    index().values                                              
                        w = 1.0 / counts                                        
                        samp_w =                                                
                    w[df_tr["label_idx"].values]                                
                        sampler =                                               
                    WeightedRandomSampler(samp_w,                               
                    len(samp_w), replacement=True)                              
                                                                                
                        ds_tr = SkinLesionDataset(df_tr,                        
                    train_tf)                                                   
                        ds_vl = SkinLesionDataset(df_vl,                        
                    val_tf)                                                     
                        dl_tr = DataLoader(                                     
                            ds_tr, batch_size=32,                               
                    sampler=sampler, num_workers=4,                             
                    pin_memory=True                                             
                        )                                                       
                        dl_vl = DataLoader(                                     
                            ds_vl, batch_size=64,                               
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                        )                                                       
                                                                                
                        model = LesionModel().to(device)                        
                        opt =                                                   
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        loss_fn = nn.BCEWithLogitsLoss()                        
                                                                                
                        best_auc = 0                                            
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, sts, lbs in dl_tr:                        
                                imgs, sts, lbs =                                
                    imgs.to(device), sts.to(device),                            
                    lbs.to(device)                                              
                                opt.zero_grad()                                 
                                out = model(imgs, sts)                          
                                loss = loss_fn(out, lbs)                        
                                loss.backward()                                 
                                opt.step()                                      
                            # validation                                        
                            model.eval()                                        
                            preds, trues = [], []                               
                            with torch.no_grad():                               
                                for imgs, sts, lbs in                           
                    dl_vl:                                                      
                                    imgs, sts =                                 
                    imgs.to(device), sts.to(device)                             
                                    out = model(imgs, sts)                      
                                    probs =                                     
                    torch.sigmoid(out).cpu().numpy()                            
                                    preds.extend(probs)                         
                                    trues.extend(lbs.numpy(                     
                    ))                                                          
                            auc = roc_auc_score(trues,                          
                    preds)                                                      
                            if auc > best_auc:                                  
                                best_auc = auc                                  
                        print(f"Fold {fold+1} AUROC:                            
                    {best_auc:.4f}")                                            
                        aucs.append(best_auc)                                   
                                                                                
                    # save final model                                          
                    os.makedirs("working", exist_ok=True)                       
                    torch.save(model.state_dict(),                              
                    "working/model.pth")                                        
                    print(f"Mean AUROC:                                         
                    {np.mean(aucs):.4f}")                                       
                                                                                
                                                                                
                    # predict function                                          
                    def predict(image_folder: str):                             
                        """                                                     
                        Predict malignancy probability for                      
                    all images in a folder.                                     
                        Args:                                                   
                          image_folder: path to folder                          
                    containing .jpg images                                      
                        Returns:                                                
                          pandas DataFrame with columns                         
                    ['image_name','probability']                                
                        """                                                     
                        m = LesionModel().to(device)                            
                        m.load_state_dict(torch.load("worki                     
                    ng/model.pth", map_location=device))                        
                        m.eval()                                                
                        results = []                                            
                        files = [f for f in                                     
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        for fname in files:                                     
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                            x =                                                 
                    val_tf(img).unsqueeze(0).to(device)                         
                            # assume unknown skin_tone as                       
                    -1->0                                                       
                            st = torch.tensor([0],                              
                    dtype=torch.long).to(device)                                
                            with torch.no_grad():                               
                                prob = torch.sigmoid(m(x,                       
                    st)).item()                                                 
                            results.append({"image_name":                       
                    fname, "probability": prob})                                
                        return pd.DataFrame(results)                            
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a mean AUROC of                              
                    approximately 0.8913 across 5 folds,                        
                    indicating good overall performance in                      
                    classifying skin lesion malignancy. The                     
                    use of skin tone embedding and weighted                     
                    sampling appears to contribute to                           
                    balanced training, although specific                        
                    fairness metrics regarding AUROC gap                        
                    between light and dark skin tones were                      
                    not reported.                                               
                    Validation Metric: 0.8913                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    EfficientNet-B0, freezing its backbone                      
                    and training only the final                                 
                    classification layer to distinguish                         
                    malignant from benign lesions. We                           
                    perform an 80/20 stratified                                 
                    train/validation split on the binary                        
                    labels, using a weighted sampler during                     
                    training to address class imbalance. We                     
                    train for a few epochs with standard                        
                    augmentations and compute AUROC on the                      
                    hold-out validation set. Finally, we                        
                    save the model and provide a                                
                    `predict()` function that loads the                         
                    model and returns malignancy                                
                    probabilities for new images.                               
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedShuffleSplit                                      
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                                                                                
                    # Configuration                                             
                    DATA_DIR = "./input"                                        
                    IMG_DIR = os.path.join(DATA_DIR,                            
                    "MyImages")                                                 
                    CSV_PATH = os.path.join(DATA_DIR,                           
                    "mydataset.csv")                                            
                    MODEL_PATH = "./working/model.pth"                          
                    BATCH_SIZE = 32                                             
                    NUM_EPOCHS = 5                                              
                    LR = 1e-3                                                   
                    IMG_SIZE = 224                                              
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Load and preprocess CSV                                   
                    df = pd.read_csv(CSV_PATH)                                  
                    # Map labels: malignant->1, others->0                       
                    df["target"] = df["label"].apply(lambda                     
                    x: 1 if x == "malignant" else 0)                            
                                                                                
                    # Stratified split                                          
                    split =                                                     
                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                    train_idx, val_idx =                                        
                    next(split.split(df, df["target"]))                         
                    df_train, df_val = df.loc[train_idx],                       
                    df.loc[val_idx]                                             
                                                                                
                    # Transforms                                                
                    train_transform = T.Compose(                                
                        [                                                       
                            T.RandomResizedCrop(IMG_SIZE),                      
                            T.RandomHorizontalFlip(),                           
                            T.RandomVerticalFlip(),                             
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485, 0.456,                     
                    0.406], std=[0.229, 0.224, 0.225]),                         
                        ]                                                       
                    )                                                           
                    val_transform = T.Compose(                                  
                        [                                                       
                            T.Resize(256),                                      
                            T.CenterCrop(IMG_SIZE),                             
                            T.ToTensor(),                                       
                            T.Normalize(mean=[0.485, 0.456,                     
                    0.406], std=[0.229, 0.224, 0.225]),                         
                        ]                                                       
                    )                                                           
                                                                                
                    # Datasets                                                  
                    train_ds = SkinLesionDataset(df_train,                      
                    IMG_DIR, transform=train_transform)                         
                    val_ds = SkinLesionDataset(df_val,                          
                    IMG_DIR, transform=val_transform)                           
                                                                                
                    # Weighted sampler for imbalance                            
                    class_counts =                                              
                    df_train["target"].value_counts().sort_                     
                    index().values                                              
                    weights_per_class = 1.0 / class_counts                      
                    sample_weights = (                                          
                        df_train["target"].map({0:                              
                    weights_per_class[0], 1:                                    
                    weights_per_class[1]}).values                               
                    )                                                           
                    sampler = WeightedRandomSampler(                            
                        sample_weights,                                         
                    num_samples=len(sample_weights),                            
                    replacement=True                                            
                    )                                                           
                                                                                
                    train_loader = DataLoader(                                  
                        train_ds, batch_size=BATCH_SIZE,                        
                    sampler=sampler, num_workers=4                              
                    )                                                           
                    val_loader = DataLoader(val_ds,                             
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                    # Model setup                                               
                    model =                                                     
                    models.efficientnet_b0(pretrained=True)                     
                    # Freeze backbone                                           
                    for param in                                                
                    model.features.parameters():                                
                        param.requires_grad = False                             
                    # Replace classifier                                        
                    in_features =                                               
                    model.classifier[1].in_features                             
                    model.classifier = nn.Sequential(                           
                        nn.Dropout(p=0.2, inplace=True),                        
                    nn.Linear(in_features, 1)                                   
                    )                                                           
                    model = model.to(DEVICE)                                    
                    criterion = nn.BCEWithLogitsLoss()                          
                    optimizer =                                                 
                    optim.Adam(model.classifier.parameters(                     
                    ), lr=LR)                                                   
                                                                                
                    # Training loop                                             
                    for epoch in range(1, NUM_EPOCHS + 1):                      
                        model.train()                                           
                        running_loss = 0.0                                      
                        for imgs, labels in train_loader:                       
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE).unsqueeze(1)                              
                            optimizer.zero_grad()                               
                            outputs = model(imgs)                               
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        epoch_loss = running_loss /                             
                    len(train_ds)                                               
                        print(f"Epoch {epoch}/{NUM_EPOCHS},                     
                    Training Loss: {epoch_loss:.4f}")                           
                                                                                
                    # Validation                                                
                    model.eval()                                                
                    all_labels = []                                             
                    all_preds = []                                              
                    with torch.no_grad():                                       
                        for imgs, labels in val_loader:                         
                            imgs = imgs.to(DEVICE)                              
                            outputs = model(imgs)                               
                            probs =                                             
                    torch.sigmoid(outputs).cpu().numpy().fl                     
                    atten()                                                     
                            all_preds.extend(probs)                             
                            all_labels.extend(labels.numpy(                     
                    ).flatten())                                                
                    auroc = roc_auc_score(all_labels,                           
                    all_preds)                                                  
                    print(f"Validation AUROC: {auroc:.4f}")                     
                                                                                
                    # Save model                                                
                    os.makedirs(os.path.dirname(MODEL_PATH)                     
                    , exist_ok=True)                                            
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(image_folder):                                  
                        """                                                     
                        Load the trained model and predict                      
                    malignancy probabilities for images in                      
                    a folder.                                                   
                        Args:                                                   
                          image_folder (str): path to                           
                    folder containing JPEG images.                              
                        Returns:                                                
                          DataFrame with columns                                
                    ['image_name', 'malignancy_prob'].                          
                        """                                                     
                        df_out = []                                             
                        model =                                                 
                    models.efficientnet_b0(pretrained=False                     
                    )                                                           
                        in_feat =                                               
                    model.classifier[1].in_features                             
                        model.classifier =                                      
                    nn.Sequential(nn.Dropout(p=0.2),                            
                    nn.Linear(in_feat, 1))                                      
                        model.load_state_dict(torch.load(MO                     
                    DEL_PATH, map_location=DEVICE))                             
                        model.to(DEVICE).eval()                                 
                        for fname in                                            
                    os.listdir(image_folder):                                   
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                            img_t =                                             
                    val_transform(img).unsqueeze(0).to(DEVI                     
                    CE)                                                         
                            with torch.no_grad():                               
                                prob =                                          
                    torch.sigmoid(model(img_t)).item()                          
                            df_out.append({"image_name":                        
                    fname, "malignancy_prob": prob})                            
                        return pd.DataFrame(df_out)                             
                                                                                
                                                                                
                    # Example usage:                                            
                    # preds_df =                                                
                    predict('./input/MyImages')                                 
                    #                                                           
                    preds_df.to_csv('./working/submission.c                     
                    sv', index=False)                                           
                                                                                
                    Results: The training script executed                       
                    successfully without any errors or                          
                    bugs. The model trained for 5 epochs                        
                    with a steady decrease in training                          
                    loss, indicating effective learning.                        
                    The validation AUROC achieved was                           
                    0.8348, demonstrating good                                  
                    classification performance on the skin                      
                    lesion dataset. The code also includes                      
                    a prediction function that loads the                        
                    saved model and outputs malignancy                          
                    probabilities for new images,                               
                    fulfilling the task requirements.                           
                    Validation Metric: 0.8348                                   
                                                                                
                    -------------------------------                             
                    Design: I updated the model to output a                     
                    single logit per image (num_classes=1)                      
                    so that BCEWithLogitsLoss receives                          
                    matching shapes. I adjusted training                        
                    and inference to flatten logits and                         
                    apply sigmoid for probabilities. The                        
                    script performs 5-fold CV, prints fold                      
                    and mean AUROC and fairness gap,                            
                    retrains on all data, saves the model,                      
                    implements `predict()`, and writes                          
                    `submission.csv` in `./working`.                            
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = 1.0 if row.label ==                         
                    "malignant" else 0.0                                        
                            skin_tone = row.skin_tone                           
                            return img, label, skin_tone,                       
                    row.image_name                                              
                                                                                
                                                                                
                    def get_sampler(df):                                        
                        tones = df.skin_tone.values                             
                        uniq, counts = np.unique(tones,                         
                    return_counts=True)                                         
                        inv_counts = {u: 1.0 / c for u, c                       
                    in zip(uniq, counts)}                                       
                        weights = np.array([inv_counts[t]                       
                    for t in tones], dtype=np.float32)                          
                        return                                                  
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                                                                                
                                                                                
                    # transforms                                                
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.Resize((256, 256)),                               
                            T.RandomResizedCrop(224),                           
                            T.RandomHorizontalFlip(),                           
                            T.ColorJitter(0.2, 0.2, 0.2,                        
                    0.1),                                                       
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)),                         
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485, 0.456,                     
                    0.406), std=(0.229, 0.224, 0.225)),                         
                        ]                                                       
                    )                                                           
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    df =                                                        
                    pd.read_csv("./input/mydataset.csv")                        
                    df = df[df.label.isin(["benign",                            
                    "malignant"])].reset_index(drop=True)                       
                                                                                
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs, gaps = [], []                                         
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.label)):                         
                        train_df = df.iloc[train_idx]                           
                        val_df = df.iloc[val_idx]                               
                        train_ds =                                              
                    SkinLesionDataset(train_df,                                 
                    "./input/MyImages", transform=train_tf)                     
                        val_ds = SkinLesionDataset(val_df,                      
                    "./input/MyImages", transform=val_tf)                       
                        train_loader = DataLoader(                              
                            train_ds, batch_size=32,                            
                    sampler=get_sampler(train_df),                              
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=64, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=1).to(                         
                            device                                              
                        )                                                       
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # training                                              
                        for epoch in range(5):                                  
                            model.train()                                       
                            for imgs, labels, _, _ in                           
                    train_loader:                                               
                                imgs = imgs.to(device)                          
                                labels = labels.to(device)                      
                                logits =                                        
                    model(imgs).view(-1)                                        
                                loss = criterion(logits,                        
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # validation                                            
                        model.eval()                                            
                        all_labels, all_probs, all_tones =                      
                    [], [], []                                                  
                        with torch.no_grad():                                   
                            for imgs, labels, tones, _ in                       
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).view(-1).cpu().numpy()                          
                                probs = 1 / (1 +                                
                    np.exp(-logits))                                            
                                all_probs.extend(probs.toli                     
                    st())                                                       
                                all_labels.extend(labels.nu                     
                    mpy().tolist())                                             
                                all_tones.extend(tones.nump                     
                    y().tolist())                                               
                                                                                
                        overall_auc =                                           
                    roc_auc_score(all_labels, all_probs)                        
                        all_tones_arr = np.array(all_tones)                     
                        # define masks, exclude unknown                         
                    (-1)                                                        
                        lt_mask = (all_tones_arr <= 3) &                        
                    (all_tones_arr > 0)                                         
                        dk_mask = all_tones_arr >= 5                            
                        auc_lt = (                                              
                            roc_auc_score(np.array(all_labe                     
                    ls)[lt_mask],                                               
                    np.array(all_probs)[lt_mask])                               
                            if lt_mask.sum() > 0                                
                            else np.nan                                         
                        )                                                       
                        auc_dk = (                                              
                            roc_auc_score(np.array(all_labe                     
                    ls)[dk_mask],                                               
                    np.array(all_probs)[dk_mask])                               
                            if dk_mask.sum() > 0                                
                            else np.nan                                         
                        )                                                       
                        gap = abs(auc_lt - auc_dk)                              
                        aucs.append(overall_auc)                                
                        gaps.append(gap)                                        
                        print(f"Fold {fold}:                                    
                    AUROC={overall_auc:.4f},                                    
                    gap={gap:.4f}")                                             
                                                                                
                    print(f"Mean AUROC:                                         
                    {np.nanmean(aucs):.4f}, Mean fairness                       
                    gap: {np.nanmean(gaps):.4f}")                               
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinLesionDataset(df,                             
                    "./input/MyImages", transform=train_tf)                     
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, sampler=get_sampler(df),                     
                    num_workers=4)                                              
                    model =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True,                                            
                    num_classes=1).to(device)                                   
                    optimizer =                                                 
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                    criterion = nn.BCEWithLogitsLoss()                          
                    for epoch in range(5):                                      
                        model.train()                                           
                        for imgs, labels, _, _ in                               
                    full_loader:                                                
                            imgs = imgs.to(device)                              
                            labels = labels.to(device)                          
                            logits = model(imgs).view(-1)                       
                            loss = criterion(logits,                            
                    labels)                                                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                    # save model                                                
                    os.makedirs("./working", exist_ok=True)                     
                    torch.save(model.state_dict(),                              
                    "./working/model.pth")                                      
                                                                                
                                                                                
                    def predict(folder_path):                                   
                        """                                                     
                        Predict malignancy probability for                      
                    all .jpg images in folder_path.                             
                        Returns a DataFrame with columns                        
                    ['image_name','malignancy_prob'].                           
                        """                                                     
                        tf = val_tf                                             
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        m =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False,                                           
                    num_classes=1).to(device)                                   
                        m.load_state_dict(torch.load("./wor                     
                    king/model.pth", map_location=device))                      
                        m.eval()                                                
                        results = []                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    sorted(os.listdir(folder_path)):                            
                                if not                                          
                    fname.lower().endswith(".jpg"):                             
                                    continue                                    
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                logit =                                         
                    m(x).view(-1).item()                                        
                                prob = 1 / (1 +                                 
                    np.exp(-logit))                                             
                                results.append({"image_name                     
                    ": fname, "malignancy_prob": prob})                         
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # generate submission.csv                                   
                    submission =                                                
                    predict("./input/MyImages")                                 
                    submission.to_csv("./working/submission                     
                    .csv", index=False)                                         
                    print("Saved predictions to                                 
                    ./working/submission.csv")                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model was trained using 5-fold                              
                    stratified cross-validation with                            
                    EfficientNet-B0 backbone, achieving a                       
                    mean AUROC of approximately 0.807. The                      
                    fairness gap in AUROC between light and                     
                    dark skin tones was low (mean gap                           
                    ~0.031), indicating the model is fairly                     
                    balanced across skin tones. Finally,                        
                    the model was retrained on the full                         
                    dataset and saved, and predictions were                     
                    generated for the test images and saved                     
                    to a CSV file as required.                                  
                    Validation Metric: 0.8069                                   
                                                                                
                    -------------------------------                             
                    Design: I replaced the unsupported                          
                    `early_stopping_rounds` argument with                       
                    LightGBM’s callback API, using                              
                    `lgb.early_stopping` and                                    
                    `lgb.log_evaluation`, which preserves                       
                    early stopping behavior without causing                     
                    a TypeError. The cross-validation loop                      
                    now passes callbacks to `fit`, and we                       
                    still compute and print the mean AUROC.                     
                    The rest of the training and the                            
                    `predict()` function remain intact, and                     
                    the final model is retrained on all                         
                    data and saved to                                           
                    `./working/classifier.pkl`.                                 
                    Code: import os                                             
                    import pickle                                               
                    import pandas as pd                                         
                    import numpy as np                                          
                    import torch                                                
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms                          
                    from PIL import Image                                       
                    import timm                                                 
                    import lightgbm as lgb                                      
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                                                                                
                    class EmbeddingDataset(Dataset):                            
                        def __init__(self, image_names,                         
                    image_dir, transform):                                      
                            self.image_names = image_names                      
                            self.image_dir = image_dir                          
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.image_names)                        
                                                                                
                        def __getitem__(self, idx):                             
                            name = self.image_names[idx]                        
                            path =                                              
                    os.path.join(self.image_dir, name +                         
                    ".jpg")                                                     
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            img = self.transform(img)                           
                            return img, idx                                     
                                                                                
                                                                                
                    class PredictionDataset(Dataset):                           
                        def __init__(self, image_paths,                         
                    transform):                                                 
                            self.paths = image_paths                            
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.paths)                              
                                                                                
                        def __getitem__(self, idx):                             
                            path = self.paths[idx]                              
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            img = self.transform(img)                           
                            return img,                                         
                    os.path.basename(path)                                      
                                                                                
                                                                                
                    def extract_embeddings(df, image_dir,                       
                    device):                                                    
                        model = timm.create_model(                              
                            "efficientnet_b0",                                  
                    pretrained=True, num_classes=0,                             
                    global_pool="avg"                                           
                        ).to(device)                                            
                        model.eval()                                            
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        ds =                                                    
                    EmbeddingDataset(df["image_name"].value                     
                    s, image_dir, transform)                                    
                        loader = DataLoader(ds,                                 
                    batch_size=64, num_workers=4,                               
                    pin_memory=True)                                            
                        embeddings = np.zeros((len(df),                         
                    model.num_features), dtype=np.float32)                      
                        with torch.no_grad():                                   
                            for imgs, idxs in loader:                           
                                feats =                                         
                    model(imgs.to(device)).cpu().numpy()                        
                                embeddings[idxs.numpy(), :]                     
                    = feats                                                     
                        return embeddings                                       
                                                                                
                                                                                
                    def predict(folder_path: str) ->                            
                    pd.DataFrame:                                               
                        """                                                     
                        Load trained classifier and                             
                    backbone to compute malignancy                              
                    probabilities.                                              
                        Args:                                                   
                          folder_path: path to folder with                      
                    .jpg images                                                 
                        Returns:                                                
                          DataFrame with columns                                
                    ['image_name','malignancy_probability']                     
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # load classifier                                       
                        clf =                                                   
                    pickle.load(open("./working/classifier.                     
                    pkl", "rb"))                                                
                        # load backbone                                         
                        backbone = timm.create_model(                           
                            "efficientnet_b0",                                  
                    pretrained=True, num_classes=0,                             
                    global_pool="avg"                                           
                        ).to(device)                                            
                        backbone.eval()                                         
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(224),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        img_paths = [                                           
                            os.path.join(folder_path, f)                        
                            for f in                                            
                    os.listdir(folder_path)                                     
                            if f.lower().endswith(".jpg")                       
                        ]                                                       
                        ds = PredictionDataset(img_paths,                       
                    transform)                                                  
                        loader = DataLoader(ds,                                 
                    batch_size=64, num_workers=4,                               
                    pin_memory=True)                                            
                        results = []                                            
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                feats =                                         
                    backbone(imgs.to(device)).cpu().numpy()                     
                                probs =                                         
                    clf.predict_proba(feats)[:, 1]                              
                                for n, p in zip(names,                          
                    probs):                                                     
                                    results.append((n, p))                      
                        return pd.DataFrame(results,                            
                    columns=["image_name",                                      
                    "malignancy_probability"])                                  
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        # load data                                             
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["label_bin"] = (df["label"] ==                       
                    "malignant").astype(int)                                    
                        # extract embeddings                                    
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        X = extract_embeddings(df,                              
                    "./input/MyImages", device)                                 
                        y = df["label_bin"].values                              
                        # sample weights inversely to skin                      
                    tone frequency                                              
                        freq =                                                  
                    df["skin_tone"].value_counts().to_dict(                     
                    )                                                           
                        w = df["skin_tone"].map(lambda x:                       
                    1.0 / freq[x]).values                                       
                        w *= len(w) / w.sum()                                   
                        # 5-fold CV                                             
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                        for train_idx, val_idx in                               
                    skf.split(X, y):                                            
                            X_tr, y_tr, w_tr =                                  
                    X[train_idx], y[train_idx],                                 
                    w[train_idx]                                                
                            X_val, y_val = X[val_idx],                          
                    y[val_idx]                                                  
                            clf =                                               
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                            clf.fit(                                            
                                X_tr,                                           
                                y_tr,                                           
                                sample_weight=w_tr,                             
                                eval_set=[(X_val, y_val)],                      
                                eval_metric="auc",                              
                                callbacks=[lgb.early_stoppi                     
                    ng(stopping_rounds=50),                                     
                    lgb.log_evaluation(0)],                                     
                            )                                                   
                            preds =                                             
                    clf.predict_proba(X_val)[:, 1]                              
                            aucs.append(roc_auc_score(y_val                     
                    , preds))                                                   
                        mean_auc = np.mean(aucs)                                
                        print(f"Mean AUROC:                                     
                    {mean_auc:.4f}")                                            
                        # retrain on full data                                  
                        final_clf =                                             
                    lgb.LGBMClassifier(n_estimators=1000,                       
                    learning_rate=0.05)                                         
                        final_clf.fit(X, y,                                     
                    sample_weight=w)                                            
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        pickle.dump(final_clf,                                  
                    open("./working/classifier.pkl", "wb"))                     
                                                                                
                    Results: The training script executed                       
                    successfully without errors. It used a                      
                    pretrained EfficientNet-B0 backbone to                      
                    extract image embeddings, then trained                      
                    a LightGBM classifier with sample                           
                    weights to address skin tone imbalance.                     
                    The model achieved a strong mean AUROC                      
                    of approximately 0.8876 across 5-fold                       
                    cross-validation, indicating good                           
                    overall classification performance. The                     
                    final model was retrained on the full                       
                    dataset and saved for inference.                            
                    Validation Metric: 0.8876                                   
                                                                                
                    -------------------------------                             
                    Design: I propose enhancing the                             
                    training data pipeline with stronger                        
                    augmentations—using RandomResizedCrop,                      
                    flips, and ColorJitter—to improve model                     
                    generalization, especially on                               
                    underrepresented skin tones, while                          
                    keeping the core training loop and                          
                    fairness-aware sampling unchanged.                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames =                                             
                    sorted(os.listdir(image_folder))                            
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                probs =                                         
                    torch.sigmoid(model(imgs)).cpu().numpy(                     
                    ).flatten()                                                 
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                                                                                
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomVerticalFl                     
                    ip(),                                                       
                                transforms.ColorJitter(                         
                                    brightness=0.2,                             
                    contrast=0.2, saturation=0.2, hue=0.1                       
                                ),                                              
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        overall_aucs, gaps = [], []                             
                        for train_idx, val_idx in                               
                    skf.split(df, df["binary_label"]):                          
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                                                                                
                            train_ds = LesionDataset(                           
                                df_train,                                       
                    "./input/MyImages",                                         
                    transform=train_transform                                   
                            )                                                   
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages",                                         
                    transform=val_transform)                                    
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=4                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs, labels =                              
                    imgs.to(device),                                            
                    labels.float().to(device)                                   
                                    preds =                                     
                    model(imgs).squeeze(1)                                      
                                    loss = criterion(preds,                     
                    labels)                                                     
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1).cpu().numpy()                        
                                    probs = 1 / (1 +                            
                    np.exp(-logits))                                            
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        # retrain on full data                                  
                        full_ds = LesionDataset(df,                             
                    "./input/MyImages",                                         
                    transform=train_transform)                                  
                        tones_full = df["skin_tone"].values                     
                        unique, counts =                                        
                    np.unique(tones_full,                                       
                    return_counts=True)                                         
                        tone_counts = dict(zip(unique,                          
                    counts))                                                    
                        weights_full = [1.0 /                                   
                    tone_counts[t] for t in tones_full]                         
                        sampler_full =                                          
                    WeightedRandomSampler(                                      
                            weights_full,                                       
                    num_samples=len(weights_full),                              
                    replacement=True                                            
                        )                                                       
                        full_loader = DataLoader(                               
                            full_ds, batch_size=32,                             
                    sampler=sampler_full, num_workers=4                         
                        )                                                       
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.to(device)                                        
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        criterion = nn.BCEWithLogitsLoss()                      
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels, _ in                              
                    full_loader:                                                
                                imgs, labels =                                  
                    imgs.to(device),                                            
                    labels.float().to(device)                                   
                                preds =                                         
                    model(imgs).squeeze(1)                                      
                                loss = criterion(preds,                         
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The model training and                             
                    evaluation ran successfully without                         
                    errors. The cross-validation mean AUROC                     
                    of 0.8740 indicates good overall                            
                    classification performance. The                             
                    fairness gap between light and dark                         
                    skin tones is quite low at 0.0373,                          
                    showing the model maintains fairness                        
                    across skin tones without sacrificing                       
                    accuracy. The training completed well                       
                    within the time limit.                                      
                    Validation Metric: 0.874                                    
                                                                                
                    -------------------------------                             
                    Design: I propose integrating MixUp                         
                    augmentation during training, mixing                        
                    pairs of images and their labels to                         
                    improve generalization and robustness                       
                    without altering the fairness-aware                         
                    sampling. Specifically, we sample a                         
                    mixing coefficient from a Beta                              
                    distribution (α=0.2) and combine image                      
                    and label pairs within each batch                           
                    before computing the BCE loss. The rest                     
                    of the pipeline, including the weighted                     
                    sampler by skin tone and 5-fold                             
                    cross-validation, remains unchanged.                        
                    This atomic change often yields better                      
                    AUROC by providing smoother decision                        
                    boundaries. Below is the updated                            
                    training script with MixUp implemented.                     
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        """Returns mixed inputs, pairs of                       
                    targets, and lambda"""                                      
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    # Dataset definition                                        
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames = sorted(                                     
                            [f for f in                                         
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        )                                                       
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                probs =                                         
                    torch.sigmoid(model(imgs)).cpu().numpy(                     
                    ).flatten()                                                 
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    # Main training and evaluation                              
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        overall_aucs, gaps = [], []                             
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", transform)                              
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", transform)                              
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=2                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            # Train with MixUp                                  
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation                                        
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits =                                    
                    model(imgs).squeeze(1).cpu().numpy()                        
                                    probs = 1 / (1 +                            
                    np.exp(-logits))                                            
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a strong mean                                
                    cross-validated AUROC of 0.9010,                            
                    indicating excellent overall                                
                    classification performance.                                 
                    Additionally, the fairness gap between                      
                    light and dark skin tones was minimal,                      
                    with a mean gap of 0.0150,                                  
                    demonstrating good fairness in the                          
                    malignancy predictions across skin                          
                    tones. The training completed                               
                    efficiently within the time limit.                          
                    Validation Metric: 0.901                                    
                                                                                
                    -------------------------------                             
                    Design: We introduce a simple test‐time                     
                    augmentation (horizontal flip) during                       
                    validation: for each batch, we compute                      
                    model outputs on both the original and                      
                    flipped images, average their                               
                    probabilities, and use these for AUROC                      
                    calculation. This atomic change often                       
                    boosts performance without altering                         
                    training or fairness sampling. The rest                     
                    of the pipeline, including MixUp                            
                    training and weighted sampling, remains                     
                    unchanged.                                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    # Dataset definition                                        
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames = sorted(                                     
                            [f for f in                                         
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        )                                                       
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                # TTA: original +                               
                    horizontal flip                                             
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=[3]))                           
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                probs =                                         
                    probs.cpu().numpy().flatten()                               
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        overall_aucs, gaps = [], []                             
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", transform)                              
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", transform)                              
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=2                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            # Training with MixUp                               
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation with                                   
                    horizontal-flip TTA                                         
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits1 = model(imgs)                       
                                    logits2 =                                   
                    model(torch.flip(imgs, dims=[3]))                           
                                    probs =                                     
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                    probs =                                     
                    probs.cpu().numpy().flatten()                               
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a strong mean                                
                    cross-validated AUROC of 0.9065,                            
                    indicating good overall classification                      
                    performance for malignancy detection.                       
                    The mean fairness gap between light and                     
                    dark skin tone groups is low at 0.0190,                     
                    demonstrating the model maintains                           
                    fairness across skin tones without                          
                    sacrificing accuracy. The approach                          
                    using weighted sampling, MixUp                              
                    augmentation, and test-time                                 
                    augmentation contributed to these                           
                    robust results.                                             
                    Validation Metric: 0.9065                                   
                                                                                
                    -------------------------------                             
                    Design: I propose integrating a                             
                    OneCycleLR learning rate scheduler to                       
                    dynamically vary the learning rate                          
                    during training, which often improves                       
                    convergence and generalization. We set                      
                    a maximum LR of 1e-3 over the 5 epochs                      
                    and step the scheduler each batch,                          
                    leaving MixUp, weighted sampling, TTA,                      
                    and fairness sampling unchanged. This                       
                    atomic change should boost CV AUROC by                      
                    providing a smoother training schedule.                     
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                    import torch.optim as optim                                 
                    from torch.optim.lr_scheduler import                        
                    OneCycleLR                                                  
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    # Dataset definition                                        
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames = sorted(                                     
                            [f for f in                                         
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        )                                                       
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                # TTA: original +                               
                    horizontal flip                                             
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=[3]))                           
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                probs =                                         
                    probs.cpu().numpy().flatten()                               
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        overall_aucs, gaps = [], []                             
                        EPOCHS = 5                                              
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", transform)                              
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", transform)                              
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=2                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                                                                                
                            optimizer =                                         
                    optim.Adam(model.parameters(), lr=1e-4)                     
                            scheduler = OneCycleLR(                             
                                optimizer, max_lr=1e-3,                         
                    epochs=EPOCHS,                                              
                    steps_per_epoch=len(train_loader)                           
                            )                                                   
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            # Training with MixUp and                           
                    OneCycleLR                                                  
                            for epoch in range(EPOCHS):                         
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                    scheduler.step()                            
                                                                                
                            # Validation with                                   
                    horizontal-flip TTA                                         
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits1 = model(imgs)                       
                                    logits2 =                                   
                    model(torch.flip(imgs, dims=[3]))                           
                                    probs =                                     
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                    probs =                                     
                    probs.cpu().numpy().flatten()                               
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                                                                                
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a strong mean                                
                    cross-validation AUROC of approximately                     
                    0.878, indicating good overall                              
                    classification performance. The                             
                    fairness gap between light and dark                         
                    skin tones, measured as the AUROC                           
                    difference, is quite low at about                           
                    0.031, showing that the model is fairly                     
                    equitable across skin tones without                         
                    sacrificing accuracy. Training with                         
                    MixUp augmentation and OneCycleLR                           
                    scheduling appears effective within the                     
                    5-epoch training regime.                                    
                    Validation Metric: 0.8779                                   
                                                                                
                    -------------------------------                             
                    Design: I propose enhancing test-time                       
                    augmentation by including vertical                          
                    flips in addition to the existing                           
                    horizontal flips, averaging predictions                     
                    over four variants (original,                               
                    horizontal, vertical, and both flips).                      
                    This atomic change boosts robustness by                     
                    exposing the model to more symmetries                       
                    without altering the training or                            
                    fairness-aware sampling. We update both                     
                    the cross‐validation validation loop                        
                    and the `predict()` function to use                         
                    this four‐fold TTA, and report the mean                     
                    CV AUROC and fairness gap.                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames = sorted(                                     
                            [f for f in                                         
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        )                                                       
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                # 4-fold TTA: original,                         
                    h-flip, v-flip, hv-flip                                     
                                logits_orig = model(imgs)                       
                                logits_h =                                      
                    model(torch.flip(imgs, dims=[3]))                           
                                logits_v =                                      
                    model(torch.flip(imgs, dims=[2]))                           
                                logits_hv =                                     
                    model(torch.flip(imgs, dims=[2, 3]))                        
                                probs = (                                       
                                    torch.sigmoid(logits_or                     
                    ig)                                                         
                                    +                                           
                    torch.sigmoid(logits_h)                                     
                                    +                                           
                    torch.sigmoid(logits_v)                                     
                                    +                                           
                    torch.sigmoid(logits_hv)                                    
                                ) / 4.0                                         
                                probs =                                         
                    probs.cpu().numpy().flatten()                               
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        overall_aucs, gaps = [], []                             
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", transform)                              
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", transform)                              
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=2                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            # Training with MixUp                               
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation with 4-fold TTA                        
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits_orig =                               
                    model(imgs)                                                 
                                    logits_h =                                  
                    model(torch.flip(imgs, dims=[3]))                           
                                    logits_v =                                  
                    model(torch.flip(imgs, dims=[2]))                           
                                    logits_hv =                                 
                    model(torch.flip(imgs, dims=[2, 3]))                        
                                    probs = (                                   
                                        torch.sigmoid(logit                     
                    s_orig)                                                     
                                        +                                       
                    torch.sigmoid(logits_h)                                     
                                        +                                       
                    torch.sigmoid(logits_v)                                     
                                        +                                       
                    torch.sigmoid(logits_hv)                                    
                                    ) / 4.0                                     
                                    probs =                                     
                    probs.cpu().numpy().flatten()                               
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                        # Optionally generate                                   
                    submission.csv if test folder exists                        
                        test_folder = "./input/TestImages"                      
                        if os.path.isdir(test_folder):                          
                            preds = predict("model.pth",                        
                    test_folder)                                                
                            sub = pd.DataFrame(                                 
                                {                                               
                                    "image_name":                               
                    list(preds.keys()),                                         
                                    "malignancy_probability                     
                    ": list(preds.values()),                                    
                                }                                               
                            )                                                   
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
