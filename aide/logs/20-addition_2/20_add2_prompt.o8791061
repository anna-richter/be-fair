                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            # Training with MixUp                               
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # Validation with 4-way TTA                         
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    imgs_orig = imgs                            
                                    imgs_h =                                    
                    torch.flip(imgs_orig, dims=[3])                             
                                    imgs_v =                                    
                    torch.flip(imgs_orig, dims=[2])                             
                                    imgs_hv =                                   
                    torch.flip(imgs_h, dims=[2])                                
                                    logits = []                                 
                                    for aug in (imgs_orig,                      
                    imgs_h, imgs_v, imgs_hv):                                   
                                        logits.append(model                     
                    (aug))                                                      
                                    probs =                                     
                    torch.stack([torch.sigmoid(l) for l in                      
                    logits], dim=0).mean(                                       
                                        dim=0                                   
                                    )                                           
                                    probs =                                     
                    probs.cpu().numpy().flatten()                               
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "./working/model.pth")                                      
                        # if test images exist, generate                        
                    submission                                                  
                        test_dir = "./input/test_images"                        
                        if os.path.isdir(test_dir):                             
                            preds =                                             
                    predict("./working/model.pth",                              
                    test_dir)                                                   
                            sub = pd.DataFrame(                                 
                                {"image_name":                                  
                    list(preds.keys()), "probability":                          
                    list(preds.values())}                                       
                            )                                                   
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any bugs. The                          
                    model achieved a strong mean                                
                    cross-validation AUROC of approximately                     
                    0.8998, indicating good classification                      
                    performance. The fairness gap between                       
                    light and dark skin tones was minimal                       
                    at 0.02, suggesting that the model                          
                    performs fairly across different skin                       
                    tones without compromising overall                          
                    accuracy.                                                   
                    Validation Metric: 0.8998                                   
                                                                                
                    -------------------------------                             
                    Design: I propose enhancing test-time                       
                    augmentation by including vertical                          
                    flips alongside the existing horizontal                     
                    flips, averaging predictions over four                      
                    variants (original, horizontal,                             
                    vertical, both) in both the                                 
                    cross‐validation validation loop and                        
                    the `predict()` function. This atomic                       
                    change should boost robustness by                           
                    exposing the model to more symmetries                       
                    without altering training or                                
                    fairness‐aware sampling. The rest of                        
                    the pipeline—including MixUp, weighted                      
                    sampling, and 5‐fold CV—remains                             
                    unchanged.                                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join(self.img_dir,                      
                    row["image_name"] + ".jpg")                                 
                            ).convert("RGB")                                    
                            if self.transform:                                  
                                img = self.transform(img)                       
                            return img,                                         
                    row["binary_label"], row["skin_tone"]                       
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        files = sorted([f for f in                              
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")])                                
                        out = {}                                                
                        loader = DataLoader(files,                              
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                # 4-way TTA                                     
                                logits = []                                     
                                logits.append(model(imgs))                      
                                logits.append(model(torch.f                     
                    lip(imgs, dims=[3])))  # horizontal                         
                                logits.append(model(torch.f                     
                    lip(imgs, dims=[2])))  # vertical                           
                                logits.append(model(torch.f                     
                    lip(imgs, dims=[2, 3])))  # both                            
                                probs =                                         
                    torch.sigmoid(sum(logits) /                                 
                    4.0).cpu().numpy().flatten()                                
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        aucs, gaps = [], []                                     
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", transform)                              
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", transform)                              
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=2                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=2)                                              
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            # train                                             
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                            # validate with 4-way TTA                           
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits = [                                  
                                        model(imgs),                            
                                        model(torch.flip(im                     
                    gs, dims=[3])),                                             
                                        model(torch.flip(im                     
                    gs, dims=[2])),                                             
                                        model(torch.flip(im                     
                    gs, dims=[2, 3])),                                          
                                    ]                                           
                                    probs =                                     
                    torch.sigmoid(sum(logits) /                                 
                    4.0).cpu().numpy().flatten()                                
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                            auc = roc_auc_score(ys, ps)                         
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": tones_val})                                
                            light = dfv[dfv.tone <= 3]                          
                            dark = dfv[dfv.tone >= 5]                           
                            auc_l = roc_auc_score(light.y,                      
                    light.p) if len(light) > 0 else np.nan                      
                            auc_d = roc_auc_score(dark.y,                       
                    dark.p) if len(dark) > 0 else np.nan                        
                            gap = abs(auc_l - auc_d)                            
                            aucs.append(auc)                                    
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a mean cross-validation                      
                    AUROC of approximately 0.903,                               
                    indicating good overall performance in                      
                    classifying malignant vs benign                             
                    lesions. The fairness gap in AUROC                          
                    between light and dark skin tones was                       
                    minimal, around 0.021 on average,                           
                    suggesting the model is fairly balanced                     
                    across skin tones without compromising                      
                    performance.                                                
                    Validation Metric: 0.903                                    
                                                                                
                    -------------------------------                             
                    Design: I propose enhancing the                             
                    training data augmentation pipeline                         
                    with stronger, diverse transforms—using                     
                    RandomResizedCrop, random horizontal                        
                    and vertical flips, ColorJitter and                         
                    RandomErasing—to improve model                              
                    robustness and generalization,                              
                    especially on underrepresented skin                         
                    tones. We keep the weighted sampler,                        
                    MixUp, and horizontal-flip test‐time                        
                    augmentation unchanged, and only                            
                    replace the training transforms. This                       
                    atomic change often yields measurable                       
                    AUROC gains without touching model                          
                    architecture or training loop.                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.2):                            
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha > 0 else 1.0                                       
                        batch_size = x.size(0)                                  
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        return mixed_x, y, y[index], lam                        
                                                                                
                                                                                
                    # Dataset definition                                        
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join(self.img_dir,                      
                    row["image_name"] + ".jpg")                                 
                            ).convert("RGB")                                    
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = row["binary_label"]                         
                            tone = row["skin_tone"]                             
                            return img, label, tone                             
                                                                                
                                                                                
                    # Predict function                                          
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        files = sorted([f for f in                              
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")])                                
                        out = {}                                                
                        loader = DataLoader(files,                              
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(val_transfo                     
                    rm(img))                                                    
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=[3]))                           
                                probs = (                                       
                                    ((torch.sigmoid(logits1                     
                    ) + torch.sigmoid(logits2)) / 2)                            
                                    .cpu()                                      
                                    .numpy()                                    
                                    .flatten()                                  
                                )                                               
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        # Stronger training augmentations                       
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomVerticalFl                     
                    ip(),                                                       
                                transforms.ColorJitter(                         
                                    brightness=0.2,                             
                    contrast=0.2, saturation=0.2, hue=0.1                       
                                ),                                              
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                                transforms.RandomErasing(                       
                                    p=0.5, scale=(0.02,                         
                    0.2), ratio=(0.3, 3.3), value="random"                      
                                ),                                              
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        overall_aucs, gaps = [], []                             
                        for fold, (tr, va) in                                   
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_tr, df_va = df.iloc[tr],                         
                    df.iloc[va]                                                 
                            tones =                                             
                    df_tr["skin_tone"].values                                   
                            uniq, cnts = np.unique(tones,                       
                    return_counts=True)                                         
                            w = {u: 1.0 / c for u, c in                         
                    zip(uniq, cnts)}                                            
                            weights = [w[t] for t in tones]                     
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                            train_ds = LesionDataset(df_tr,                     
                    "./input/MyImages", train_transform)                        
                            val_ds = LesionDataset(df_va,                       
                    "./input/MyImages", val_transform)                          
                            tr_loader =                                         
                    DataLoader(train_ds, batch_size=32,                         
                    sampler=sampler, num_workers=4)                             
                            va_loader = DataLoader(val_ds,                      
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            opt =                                               
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            crit = nn.BCEWithLogitsLoss()                       
                            # train                                             
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    tr_loader:                                                  
                                    imgs, labels =                              
                    imgs.to(device),                                            
                    labels.float().to(device)                                   
                                    mixed, y1, y2, lam =                        
                    mixup_data(imgs, labels, alpha=0.2)                         
                                    preds =                                     
                    model(mixed).squeeze(1)                                     
                                    loss = lam *                                
                    crit(preds, y1) + (1 - lam) *                               
                    crit(preds, y2)                                             
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                            # validate with horizontal-flip                     
                    TTA                                                         
                            model.eval()                                        
                            ys, ps, tones_va = [], [], []                       
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    va_loader:                                                  
                                    imgs = imgs.to(device)                      
                                    l1 = model(imgs)                            
                                    l2 =                                        
                    model(torch.flip(imgs, dims=[3]))                           
                                    prob = (                                    
                                        ((torch.sigmoid(l1)                     
                    + torch.sigmoid(l2)) / 2)                                   
                                        .cpu()                                  
                                        .numpy()                                
                                        .flatten()                              
                                    )                                           
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(prob)                             
                                    tones_va.extend(tones.n                     
                    umpy())                                                     
                            auc = roc_auc_score(ys, ps)                         
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": tones_va})                                 
                            light = dfv[dfv.tone <= 3]                          
                            dark = dfv[dfv.tone >= 5]                           
                            al = roc_auc_score(light.y,                         
                    light.p) if len(light) > 0 else np.nan                      
                            ad = roc_auc_score(dark.y,                          
                    dark.p) if len(dark) > 0 else np.nan                        
                            gap = abs(al - ad)                                  
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. It                         
                    achieved a mean cross-validation AUROC                      
                    of approximately 0.8812, indicating                         
                    strong overall model performance. The                       
                    mean fairness gap in AUROC between                          
                    light and dark skin tones was low at                        
                    about 0.0238, demonstrating that the                        
                    model is relatively fair across                             
                    different skin tones without                                
                    compromising accuracy.                                      
                    Validation Metric: 0.8812                                   
                                                                                
                    -------------------------------                             
                    Design: I propose enhancing the                             
                    training data augmentation pipeline by                      
                    replacing the simple Resize+CenterCrop                      
                    with a stronger, diverse set of                             
                    transforms: RandomResizedCrop, random                       
                    horizontal and vertical flips,                              
                    ColorJitter, and RandomErasing. The                         
                    validation transform remains unchanged                      
                    to ensure consistent evaluation. This                       
                    atomic change should boost CV AUROC and                     
                    maintain fairness across skin tones                         
                    without altering the model architecture                     
                    or training logic. We keep the MixUp,                       
                    weighted sampler by skin tone, and                          
                    horizontal‐flip TTA intact.                                 
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        index =                                                 
                    torch.randperm(batch_size).to(x.device)                     
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index]                                                    
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = row["binary_label"]                         
                            skin_tone = row["skin_tone"]                        
                            return image, label, skin_tone                      
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load trained model and predict                          
                    malignancy probability for each image                       
                    in image_folder.                                            
                        Returns dict {image_name:                               
                    probability}.                                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        filenames = sorted(                                     
                            [f for f in                                         
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        )                                                       
                        out = {}                                                
                        loader = DataLoader(filenames,                          
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                for fn in batch:                                
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fn)).convert("RGB")                                         
                                    imgs.append(transform(i                     
                    mg))                                                        
                                imgs =                                          
                    torch.stack(imgs).to(device)                                
                                logits1 = model(imgs)                           
                                logits2 =                                       
                    model(torch.flip(imgs, dims=[3]))                           
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                probs =                                         
                    probs.cpu().numpy().flatten()                               
                                for fn, p in zip(batch,                         
                    probs):                                                     
                                    out[fn] = float(p)                          
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                                                                                
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224, scale=(0.8, 1.0)),                                   
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomVerticalFl                     
                    ip(),                                                       
                                transforms.ColorJitter(                         
                                    brightness=0.2,                             
                    contrast=0.2, saturation=0.2, hue=0.1                       
                                ),                                              
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                                transforms.RandomErasing(p=                     
                    0.5),                                                       
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        overall_aucs, gaps = [], []                             
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_train, df_val =                                  
                    df.iloc[train_idx], df.iloc[val_idx]                        
                            tones =                                             
                    df_train["skin_tone"].values                                
                            unique, counts =                                    
                    np.unique(tones, return_counts=True)                        
                            tone_counts = dict(zip(unique,                      
                    counts))                                                    
                            weights = [1.0 / tone_counts[t]                     
                    for t in tones]                                             
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                                                                                
                            train_ds =                                          
                    LesionDataset(df_train,                                     
                    "./input/MyImages", train_transform)                        
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", val_transform)                          
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=4                              
                            )                                                   
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            for epoch in range(5):                              
                                model.train()                                   
                                for imgs, labels, _ in                          
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.float().to(device)                                   
                                    mixed_imgs, y_a, y_b,                       
                    lam = mixup_data(imgs, labels,                              
                    alpha=0.2)                                                  
                                    preds =                                     
                    model(mixed_imgs).squeeze(1)                                
                                    loss = lam *                                
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            model.eval()                                        
                            ys, ps, tones_val = [], [], []                      
                            with torch.no_grad():                               
                                for imgs, labels, tones in                      
                    val_loader:                                                 
                                    imgs = imgs.to(device)                      
                                    logits1 = model(imgs)                       
                                    logits2 =                                   
                    model(torch.flip(imgs, dims=[3]))                           
                                    probs =                                     
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                    probs =                                     
                    probs.cpu().numpy().flatten()                               
                                    ys.extend(labels.numpy(                     
                    ))                                                          
                                    ps.extend(probs)                            
                                    tones_val.extend(tones.                     
                    numpy())                                                    
                                                                                
                            auc = roc_auc_score(ys, ps)                         
                            df_v = pd.DataFrame({"y": ys,                       
                    "p": ps, "tone": tones_val})                                
                            light = df_v[df_v.tone <= 3]                        
                            dark = df_v[df_v.tone >= 5]                         
                            auc_light =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            auc_dark =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = abs(auc_light - auc_dark)                     
                            overall_aucs.append(auc)                            
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(overall_aucs):.4f}")                            
                        print(f"Mean fairness gap (light vs                     
                    dark): {np.nanmean(gaps):.4f}")                             
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script ran                            
                    successfully without errors. The model                      
                    achieved a strong mean cross-validation                     
                    AUROC of approximately 0.89, indicating                     
                    good overall classification                                 
                    performance. The fairness gap between                       
                    light and dark skin tones is quite low                      
                    at about 0.031, showing the model is                        
                    fairly balanced across skin tones                           
                    without sacrificing accuracy. Training                      
                    completed efficiently within the time                       
                    limit.                                                      
                    Validation Metric: 0.8899                                   
                                                                                
                    -------------------------------                             
                    Design: We fix the fairness gap                             
                    computation by separately computing                         
                    AUROCs for the light and dark subgroups                     
                    and then taking their absolute                              
                    difference, instead of the malformed                        
                    inline ternary.  We explicitly handle                       
                    missing groups by setting their AUROC                       
                    to NaN and only computing the gap if                        
                    both are present.  We retain the 5-fold                     
                    CV training and print both the overall                      
                    AUROC and the fairness gap.  A reusable                     
                    predict() function is provided, and if                      
                    a test folder is detected, we save a                        
                    `submission.csv` in `./working`.                            
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        """Apply MixUp augmentation."""                         
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha > 0 else 1.0                                       
                        idx = torch.randperm(x.size(0),                         
                    device=x.device)                                            
                        mixed_x = lam * x + (1 - lam) *                         
                    x[idx]                                                      
                        return mixed_x, y, y[idx], lam                          
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    f"{row['image_name']}.jpg")                                 
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            if self.transform:                                  
                                img = self.transform(img)                       
                            return img,                                         
                    row["binary_label"], row["skin_tone"]                       
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load the trained model and predict                      
                    malignancy probabilities for all .jpg                       
                    in image_folder.                                            
                        Returns a dict mapping filename ->                      
                    probability.                                                
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        files = sorted([f for f in                              
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")])                                
                        out = {}                                                
                        loader = DataLoader(files,                              
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = torch.stack(                             
                                    [                                           
                                        tf(Image.open(os.pa                     
                    th.join(image_folder,                                       
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                l1 = model(imgs)                                
                                l2 = model(torch.flip(imgs,                     
                    [3]))                                                       
                                probs = (                                       
                                    ((torch.sigmoid(l1) +                       
                    torch.sigmoid(l2)) /                                        
                    2).cpu().numpy().flatten()                                  
                                )                                               
                                for f, p in zip(batch,                          
                    probs):                                                     
                                    out[f] = float(p)                           
                        return out                                              
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                                                                                
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224, scale=(0.8, 1.0)),                                   
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomVerticalFl                     
                    ip(),                                                       
                                transforms.ColorJitter(0.2,                     
                    0.2, 0.2, 0.1),                                             
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                                transforms.RandomErasing(                       
                                    p=0.5, scale=(0.02,                         
                    0.33), ratio=(0.3, 3.3), value="random"                     
                                ),                                              
                            ]                                                   
                        )                                                       
                        val_tf = transforms.Compose(                            
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        aucs, gaps = [], []                                     
                        for fold, (tr, vl) in                                   
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), start=1):                              
                            df_tr, df_vl = df.iloc[tr],                         
                    df.iloc[vl]                                                 
                            # balance by skin tone                              
                            tones =                                             
                    df_tr["skin_tone"].values                                   
                            cnt =                                               
                    dict(zip(*np.unique(tones,                                  
                    return_counts=True)))                                       
                            weights = [1.0 / cnt[t] for t                       
                    in tones]                                                   
                            sampler =                                           
                    WeightedRandomSampler(weights,                              
                    len(weights), replacement=True)                             
                            dl_tr = DataLoader(                                 
                                LesionDataset(df_tr,                            
                    "./input/MyImages", train_tf),                              
                                batch_size=32,                                  
                                sampler=sampler,                                
                                num_workers=2,                                  
                            )                                                   
                            dl_vl = DataLoader(                                 
                                LesionDataset(df_vl,                            
                    "./input/MyImages", val_tf),                                
                                batch_size=32,                                  
                                shuffle=False,                                  
                                num_workers=2,                                  
                            )                                                   
                                                                                
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model.to(device)                                    
                            opt =                                               
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            crit = nn.BCEWithLogitsLoss()                       
                                                                                
                            # train                                             
                            model.train()                                       
                            for epoch in range(5):                              
                                for x, y, _ in dl_tr:                           
                                    x = x.to(device)                            
                                    y =                                         
                    y.float().to(device)                                        
                                    mx, ya, yb, lam =                           
                    mixup_data(x, y, alpha=0.2)                                 
                                    preds =                                     
                    model(mx).squeeze(1)                                        
                                    loss = lam *                                
                    crit(preds, ya) + (1 - lam) *                               
                    crit(preds, yb)                                             
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                                                                                
                            # validate                                          
                            ys, ps, tones_v = [], [], []                        
                            model.eval()                                        
                            with torch.no_grad():                               
                                for x, y, t in dl_vl:                           
                                    x = x.to(device)                            
                                    l1 = model(x)                               
                                    l2 =                                        
                    model(torch.flip(x, [3]))                                   
                                    probs = (                                   
                                        ((torch.sigmoid(l1)                     
                    + torch.sigmoid(l2)) / 2)                                   
                                        .cpu()                                  
                                        .numpy()                                
                                        .flatten()                              
                                    )                                           
                                    ys.extend(y.numpy())                        
                                    ps.extend(probs)                            
                                    tones_v.extend(t.numpy(                     
                    ))                                                          
                                                                                
                            # overall AUROC                                     
                            auc = roc_auc_score(ys, ps)                         
                            # fairness gap                                      
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": tones_v})                                  
                            light = dfv[dfv.tone <= 3]                          
                            dark = dfv[dfv.tone >= 5]                           
                            light_auc =                                         
                    roc_auc_score(light.y, light.p) if                          
                    len(light) > 0 else np.nan                                  
                            dark_auc =                                          
                    roc_auc_score(dark.y, dark.p) if                            
                    len(dark) > 0 else np.nan                                   
                            gap = (                                             
                                abs(light_auc - dark_auc)                       
                                if (not np.isnan(light_auc)                     
                    and not np.isnan(dark_auc))                                 
                                else np.nan                                     
                            )                                                   
                                                                                
                            aucs.append(auc)                                    
                            gaps.append(gap)                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f},                                            
                    fairness_gap={gap:.4f}")                                    
                                                                                
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                                                                                
                        # save final model                                      
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                                                                                
                        # if test folder exists, produce                        
                    submission.csv                                              
                        test_folder = "./input/test_images"                     
                        if os.path.isdir(test_folder) and                       
                    any(                                                        
                            f.lower().endswith(".jpg") for                      
                    f in os.listdir(test_folder)                                
                        ):                                                      
                            preds = predict("model.pth",                        
                    test_folder)                                                
                            sub = pd.DataFrame(                                 
                                {                                               
                                    "image_name":                               
                    list(preds.keys()),                                         
                                    "malignant_probability"                     
                    : list(preds.values()),                                     
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script                                
                    successfully trained a ResNet18 model                       
                    on the skin lesion dataset with                             
                    balanced sampling by skin tone. The                         
                    model achieved a strong mean                                
                    cross-validation AUROC of approximately                     
                    0.893, indicating good overall                              
                    classification performance. The                             
                    fairness gap between light and dark                         
                    skin tones was minimal at around 0.023,                     
                    demonstrating the model's fairness                          
                    towards different skin tones without                        
                    compromising accuracy. The script also                      
                    includes a prediction function and                          
                    saves the final model for inference.                        
                    Validation Metric: 0.8928                                   
                                                                                
                    -------------------------------                             
                    Design: We will explicitly compute the                      
                    fairness gap as the absolute difference                     
                    between the AUROCs for light (tones                         
                    1–3) and dark (tones 5–6) skin groups,                      
                    filtering out unknown or middle tones.                      
                    This fixes the previous bug where only                      
                    the light‐skin AUROC was used.  The                         
                    rest of the training and inference                          
                    pipeline remains the same, and we will                      
                    print overall CV AUROC and the                              
                    corrected fairness gap, then save test                      
                    predictions to submission.csv.                              
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    def mixup_data(x, y, alpha=0.2):                            
                        lam = np.random.beta(alpha, alpha)                      
                    if alpha > 0 else 1.0                                       
                        idx = torch.randperm(x.size(0),                         
                    device=x.device)                                            
                        mixed_x = lam * x + (1 - lam) *                         
                    x[idx]                                                      
                        return mixed_x, y, y[idx], lam                          
                                                                                
                                                                                
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img = Image.open(                                   
                                os.path.join(self.img_dir,                      
                    row["image_name"] + ".jpg")                                 
                            ).convert("RGB")                                    
                            if self.transform:                                  
                                img = self.transform(img)                       
                            return img,                                         
                    row["binary_label"], row["skin_tone"]                       
                                                                                
                                                                                
                    def tta_predict_batch(model, imgs):                         
                        # imgs: tensor B,C,H,W                                  
                        aug_imgs = [                                            
                            imgs,                                               
                            torch.flip(imgs, (3,)),                             
                            torch.flip(imgs, (2,)),                             
                            torch.flip(torch.flip(imgs,                         
                    (2,)), (3,)),                                               
                            torch.rot90(imgs, 1, (2, 3)),                       
                            torch.rot90(imgs, 2, (2, 3)),                       
                            torch.rot90(imgs, 3, (2, 3)),                       
                        ]                                                       
                        probs = []                                              
                        for aug in aug_imgs:                                    
                            logits = model(aug)                                 
                            probs.append(torch.sigmoid(logi                     
                    ts).cpu().numpy())                                          
                        avg = np.mean(np.stack(probs,                           
                    axis=0), axis=0).flatten()                                  
                        return avg                                              
                                                                                
                                                                                
                    def predict(model_path, image_folder,                       
                    batch_size=32):                                             
                        """                                                     
                        Load a trained model and predict                        
                    malignancy probabilities for all .jpgs                      
                    in image_folder.                                            
                        Returns a dict mapping filename to                      
                    probability.                                                
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        files = sorted([f for f in                              
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")])                                
                        results = {}                                            
                        loader = DataLoader(files,                              
                    batch_size=batch_size, shuffle=False)                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = torch.stack(                             
                                    [                                           
                                        tf(Image.open(os.pa                     
                    th.join(image_folder,                                       
                    f)).convert("RGB"))                                         
                                        for f in batch                          
                                    ]                                           
                                ).to(device)                                    
                                probs =                                         
                    tta_predict_batch(model, imgs)                              
                                for f, p in zip(batch,                          
                    probs):                                                     
                                    results[f] = float(p)                       
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df["binary_label"] =                                    
                    df["label"].map(                                            
                            {"malignant": 1, "benign": 0,                       
                    "non-neoplastic": 0}                                        
                        )                                                       
                        skf = StratifiedKFold(5,                                
                    shuffle=True, random_state=42)                              
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        aucs, gaps = [], []                                     
                        for fold, (tr, va) in                                   
                    enumerate(skf.split(df,                                     
                    df["binary_label"]), 1):                                    
                            df_tr, df_va = df.iloc[tr],                         
                    df.iloc[va]                                                 
                            # Balance skin tones in                             
                    training                                                    
                            tones =                                             
                    df_tr["skin_tone"].values                                   
                            wc = dict(zip(*np.unique(tones,                     
                    return_counts=True)))                                       
                            weights = [1.0 / wc[t] for t in                     
                    tones]                                                      
                            sampler =                                           
                    WeightedRandomSampler(weights,                              
                    len(weights), True)                                         
                            dl_tr = DataLoader(                                 
                                LesionDataset(df_tr,                            
                    "./input/MyImages", tf),                                    
                                batch_size=32,                                  
                                sampler=sampler,                                
                                num_workers=2,                                  
                            )                                                   
                            dl_va = DataLoader(                                 
                                LesionDataset(df_va,                            
                    "./input/MyImages", tf),                                    
                                batch_size=32,                                  
                                shuffle=False,                                  
                                num_workers=2,                                  
                            )                                                   
                            model =                                             
                    models.resnet18(pretrained=True)                            
                            model.fc =                                          
                    nn.Linear(model.fc.in_features, 1)                          
                            model.to(device)                                    
                            opt =                                               
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            loss_fn =                                           
                    nn.BCEWithLogitsLoss()                                      
                            # Train                                             
                            for _ in range(5):                                  
                                model.train()                                   
                                for x, y, _ in dl_tr:                           
                                    x, y = x.to(device),                        
                    y.float().to(device)                                        
                                    mx, ya, yb, l =                             
                    mixup_data(x, y)                                            
                                    pred =                                      
                    model(mx).squeeze(1)                                        
                                    loss = l *                                  
                    loss_fn(pred, ya) + (1 - l) *                               
                    loss_fn(pred, yb)                                           
                                    opt.zero_grad()                             
                                    loss.backward()                             
                                    opt.step()                                  
                            # Validate                                          
                            model.eval()                                        
                            ys, ps, ts = [], [], []                             
                            with torch.no_grad():                               
                                for x, y, t in dl_va:                           
                                    x = x.to(device)                            
                                    probs =                                     
                    tta_predict_batch(model, x)                                 
                                    ys.extend(y.numpy())                        
                                    ps.extend(probs)                            
                                    ts.extend(t.numpy())                        
                            auc = roc_auc_score(ys, ps)                         
                            # Correct fairness gap: light                       
                    tones 1-3 vs dark tones 5-6                                 
                            dfv = pd.DataFrame({"y": ys,                        
                    "p": ps, "tone": ts})                                       
                            light = dfv[dfv.tone.isin([1,                       
                    2, 3])]                                                     
                            dark = dfv[dfv.tone.isin([5,                        
                    6])]                                                        
                            if len(light) > 0 and len(dark)                     
                    > 0:                                                        
                                light_auc =                                     
                    roc_auc_score(light.y, light.p)                             
                                dark_auc =                                      
                    roc_auc_score(dark.y, dark.p)                               
                                gap = abs(light_auc -                           
                    dark_auc)                                                   
                            else:                                               
                                gap = np.nan                                    
                            print(f"Fold {fold}:                                
                    AUROC={auc:.4f}, gap={gap:.4f}")                            
                            aucs.append(auc)                                    
                            gaps.append(gap)                                    
                        print(f"Mean CV AUROC:                                  
                    {np.nanmean(aucs):.4f}")                                    
                        print(f"Mean fairness gap:                              
                    {np.nanmean(gaps):.4f}")                                    
                        # Save final model                                      
                        torch.save(model.state_dict(),                          
                    "model.pth")                                                
                        # Generate test submission if                           
                    available                                                   
                        if                                                      
                    os.path.isdir("./input/test_images"):                       
                            preds = predict("model.pth",                        
                    "./input/test_images")                                      
                            sub = pd.DataFrame(                                 
                                {                                               
                                    "image_name":                               
                    list(preds.keys()),                                         
                                    "malignant_probability"                     
                    : list(preds.values()),                                     
                                }                                               
                            )                                                   
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
