                    LesionDataset(df_train,                                     
                    "./input/MyImages", train_transform)                        
                            val_ds = LesionDataset(df_val,                      
                    "./input/MyImages", val_transform)                          
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
