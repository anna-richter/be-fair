                    any(f.lower().endswith(".jpg") for f                        
                    in os.listdir(test_folder)):                                
                            preds = predict("model.pth",                        
                    test_folder)                                                
                            sub = pd.DataFrame({                                
                                "image_name":                                   
                    list(preds.keys()),                                         
                                "malignant_probability":                        
                    list(preds.values())                                        
                            })                                                  
                            os.makedirs("./working",                            
                    exist_ok=True)                                              
                            sub.to_csv("./working/submissi                      
                    on.csv", index=False)                                       
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
