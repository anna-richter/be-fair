    ]
    tfms = [
        transforms.Compose(base + norm),
        transforms.Compose(base + [transforms.RandomHorizontalFlip(p=1.0)] + norm),
        transforms.Compose(base + [transforms.RandomVerticalFlip(p=1.0)] + norm),
        transforms.Compose(base + [transforms.RandomHorizontalFlip(p=1.0), transforms.RandomVerticalFlip(p=1.0)] + norm)
    ]
    # accumulate features
    all_feats = None
    names_ref = None
    for tfm in tfms:
        feats, names = extract_features(model, device, image_paths, tfm)
        if all_feats is None:
            all_feats = feats
            names_ref = names
        else:
            all_feats += feats
    all_feats /= len(tfms)
    return all_feats, names_ref

def predict(image_folder: str) -> pd.DataFrame:
    files = sorted([f for f in os.listdir(image_folder)
                    if f.lower().endswith((".png",".jpg",".jpeg"))])
