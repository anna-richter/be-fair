    vit = timm.create_model("vit_base_patch16_224", pretrained=True)
    vit.reset_classifier(0)
    vit.to(device)

    print("Extracting 8-way TTA features...")
    X, _ = extract_features_tta(vit, device, paths)

    skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
    oof_preds = np.zeros(len(y), dtype=np.float32)
    params = {
        "objective": "binary",
        "metric": "auc",
        "verbosity": -1,
        "boosting_type": "gbdt",
        "seed": SEED,
    }

    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y), 1):
        X_tr, X_val = X[train_idx], X[val_idx]
        y_tr, y_val = y[train_idx], y[val_idx]
        lgb_tr = lgb.Dataset(X_tr, label=y_tr)
        lgb_val = lgb.Dataset(X_val, label=y_val, reference=lgb_tr)
        model = lgb.train(
            params,
            lgb_tr,
            valid_sets=[lgb_val],
            num_boost_round=1000,
            callbacks=[
                lgb.callback.early_stopping(50),
                lgb.callback.log_evaluation(period=0),
            ],
        )
        oof_preds[val_idx] = model.predict(X_val, num_iteration=model.best_iteration)
        joblib.dump(model, os.path.join(WORKING_DIR, f"lgbm_fold_{fold}.pkl"))
        auc = roc_auc_score(y_val, oof_preds[val_idx])
        print(f"Fold {fold} AUC: {auc:.4f}")
    cv_auc = roc_auc_score(y, oof_preds)
    print(f"Ensemble OOF CV AUC: {cv_auc:.4f}")

    # generate submission
    sub = predict(IMAGE_DIR)
    sub.to_csv(SUBMISSION_PATH, index=False)
    print(f"Saved submission to {SUBMISSION_PATH}")

