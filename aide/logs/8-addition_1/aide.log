```python
import os
import pandas as pd
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import joblib

# Set seeds
torch.manual_seed(42)
np.random.seed(42)

# Dataset
class ImageDataset(Dataset):
    def __init__(self, df, transform):
        self.paths = df["image_path"].values
        self.targets = df["target"].values
        self.weights = df["weight"].values
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert("RGB")
        img = self.transform(img)
        return img, torch.tensor(self.targets[idx], dtype=torch.float32), torch.tensor(self.weights[idx], dtype=torch.float32)

# Load metadata
df = pd.read_csv("input/mydataset.csv")
df["image_path"] = df["image_name"].apply(lambda x: os.path.join("input", "MyImages", f"{x}.jpg"))
df = df[df["label"].isin(["malignant", "benign", "non-neoplastic"])].reset_index(drop=True)
df["target"] = (df["label"] == "malignant").astype(int)
# sample weights for fairness
tone_counts = df["skin_tone"].value_counts()
df["weight"] = df["skin_tone"].map(lambda t: 1.0 / tone_counts[t])

# Transforms
train_tfms = transforms.Compose([
    transforms.Resize(256),
    transforms.RandomResizedCrop(224),
    transforms.RandomHorizontalFlip(),
    transforms.RandomRotation(15),
    transforms.ToTensor(),
    transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
])
val_tfms = transforms.Compose([
    transforms.Resize(256),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
])

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

def make_model():
    model = models.resnet50(pretrained=True)
    # Freeze all layers except layer4 and fc
    for name, param in model.named_parameters():
        if not name.startswith("layer4") and not name.startswith("fc"):
            param.requires_grad = False
    model.fc = nn.Linear(model.fc.in_features, 1)
    return model.to(device)

def train_epoch(model, loader, opt, criterion):
    model.train()
    total_loss = 0
    for imgs, targets, weights in loader:
        imgs, targets, weights = imgs.to(device), targets.to(device), weights.to(device)
        opt.zero_grad()
        logits = model(imgs).squeeze(1)
        loss = criterion(logits, targets)
        # apply sample weights
        loss = (loss * weights).mean()
        loss.backward()
        opt.step()
        total_loss += loss.item() * imgs.size(0)
    return total_loss / len(loader.dataset)

def eval_model(model, loader):
    model.eval()
    preds, trues = [], []
    with torch.no_grad():
        for imgs, targets, _ in loader:
            imgs = imgs.to(device)
            logits = model(imgs).squeeze(1).cpu().numpy()
            preds.extend(torch.sigmoid(torch.tensor(logits)).numpy())
            trues.extend(targets.numpy())
    return roc_auc_score(trues, preds)

# 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
for fold, (tr_idx, val_idx) in enumerate(skf.split(df, df["target"].values)):
    df_tr, df_val = df.iloc[tr_idx], df.iloc[val_idx]
    tr_ds = ImageDataset(df_tr, train_tfms)
    val_ds = ImageDataset(df_val, val_tfms)
    tr_loader = DataLoader(tr_ds, batch_size=32, shuffle=True, num_workers=2, pin_memory=True)
    val_loader = DataLoader(val_ds, batch_size=64, shuffle=False, num_workers=2, pin_memory=True)
    model = make_model()
    opt = torch.optim.AdamW(filter(lambda p: p.requires_grad, model.parameters()), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss(reduction="none")
    for epoch in range(5):
        train_epoch(model, tr_loader, opt, criterion)
    auc = eval_model(model, val_loader)
    print(f"Fold {fold} AUROC: {auc:.4f}")
    aucs.append(auc)
print(f"Mean CV AUROC: {np.mean(aucs):.4f}")

# Retrain on full data
full_ds = ImageDataset(df, train_tfms)
full_loader = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=2, pin_memory=True)
model_full = make_model()
opt_full = torch.optim.AdamW(filter(lambda p: p.requires_grad, model_full.parameters()), lr=1e-4)
criterion = nn.BCEWithLogitsLoss(reduction="none")
for epoch in range(5):
    print(f"Full train epoch {epoch}")
    train_epoch(model_full, full_loader, opt_full, criterion)
os.makedirs("working", exist_ok=True)
torch.save(model_full.state_dict(), "working/resnet50_ft.pth")

def predict(folder_path):
    """
    Predict malignancy probabilities for images in a folder.
    Args:
        folder_path (str): path to a directory of image files.
    Returns:
        dict: mapping filename to malignancy probability (0–1).
    """
    model = make_model()
    model.load_state_dict(torch.load("working/resnet50_ft.pth", map_location=device))
    model.eval()
    files = [f for f in os.listdir(folder_path) if f.lower().endswith((".jpg",".jpeg",".png"))]
    paths = [os.path.join(folder_path,f) for f in files]
    ds = ImageDataset(pd.DataFrame({"image_path":paths, "target":[0]*len(paths),"weight":[1]*len(paths)}), val_tfms)
    dl = DataLoader(ds, batch_size=64, shuffle=False, num_workers=2, pin_memory=True)
    probs = []
    with torch.no_grad():
        for imgs, _, _ in dl:
            imgs = imgs.to(device)
            logits = model(imgs).squeeze(1)
            probs.extend(torch.sigmoid(logits).cpu().numpy())
    return dict(zip(files, probs))

