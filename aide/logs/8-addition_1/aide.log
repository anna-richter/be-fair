    ]
    flips = [False, True]
    angles = [0, 90, 180, 270]
    all_feats = None
    names_ref = None
    for flip in flips:
        for angle in angles:
            ops = []
            if flip:
                ops.append(transforms.Lambda(lambda img: F.hflip(img)))
            if angle != 0:
                ops.append(transforms.Lambda(lambda img, a=angle: F.rotate(img, a)))
