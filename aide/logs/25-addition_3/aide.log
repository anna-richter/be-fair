Design: We will leverage a pretrained ResNet50 as a fixed feature extractor and train a logistic regression classifier on these embeddings for binary malignant vs non-malignant classification. To address fairness across skin tones, we weight each sample inversely proportional to its skin tone frequency. We will perform stratified 5‐fold cross‐validation to evaluate performance using AUROC, then retrain on the full dataset. Finally, we implement a predict(folder) function that preprocesses new images, extracts features, and returns malignancy probabilities.
Code: import os
import numpy as np
import pandas as pd
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms
from PIL import Image
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import joblib


# Dataset for feature extraction
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        image = Image.open(img_path).convert("RGB")
        if self.transform:
            image = self.transform(image)
        label = row.get("label_bin", 0)
        weight = row.get("weight", 1.0)
        return image, label, weight, row["image_name"]


# Feature extractor setup
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
base_model = models.resnet50(pretrained=True)
feature_extractor = torch.nn.Sequential(
    *(list(base_model.children())[:-1]), torch.nn.Flatten()
).to(device)
feature_extractor.eval()

transform = transforms.Compose(
    [
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


def extract_features(df, img_dir, batch_size=32):
    ds = SkinDataset(df, img_dir, transform)
    loader = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=4)
    feats, labels, weights, names = [], [], [], []
    with torch.no_grad():
        for imgs, labs, wts, nms in loader:
            imgs = imgs.to(device)
            out = feature_extractor(imgs).cpu().numpy()
            feats.append(out)
            labels.append(labs.numpy())
            weights.append(wts.numpy())
            names.extend(nms)
    return (np.vstack(feats), np.concatenate(labels), np.concatenate(weights), names)


# Load data
df = pd.read_csv("./input/mydataset.csv")
df["label_bin"] = (df["label"] == "malignant").astype(int)
counts = df["skin_tone"].value_counts().to_dict()
df["weight"] = df["skin_tone"].map(lambda x: 1.0 / counts.get(x, 1))

# Extract features
X, y, w, names = extract_features(df, "./input/MyImages")

# 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
scores = []
for train_idx, val_idx in skf.split(X, y):
    clf = LogisticRegression(max_iter=1000)
    clf.fit(X[train_idx], y[train_idx], sample_weight=w[train_idx])
    preds = clf.predict_proba(X[val_idx])[:, 1]
    scores.append(roc_auc_score(y[val_idx], preds))
print("Mean CV AUROC:", np.mean(scores))

# Retrain on full data and save
final_clf = LogisticRegression(max_iter=1000)
final_clf.fit(X, y, sample_weight=w)
joblib.dump(final_clf, os.path.join("model.joblib"))


def predict(folder):
    """
    Predict malignancy probabilities for all .jpg images in `folder`.
    Returns a dict {image_filename: probability}.
    """
    files = [f for f in os.listdir(folder) if f.lower().endswith(".jpg")]
    df2 = pd.DataFrame({"image_name": [os.path.splitext(f)[0] for f in files]})
    X2, _, _, _ = extract_features(df2, folder)
    clf = joblib.load("model.joblib")
    probs = clf.predict_proba(X2)[:, 1]
    return dict(zip(files, probs))


