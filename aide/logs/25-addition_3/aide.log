            )
            logits = model(mixed_x).squeeze(1)
            loss_a = criterion(logits, y_a)
            loss_b = criterion(logits, y_b)
            loss = lam * loss_a + (1 - lam) * loss_b
            loss = (loss * mixed_w).mean()
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            scheduler.step()

