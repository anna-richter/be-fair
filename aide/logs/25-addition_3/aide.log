Design: We will fine-tune a pretrained EfficientNet-B0 by freezing the bulk of its layers and training only a new linear head for binary malignant/benign classification. Each lesion sample is weighted inversely to its skin‐tone frequency and these weights are applied in a weighted BCE loss. We perform stratified 5‐fold cross‐validation on the malignant label and report mean AUROC. Finally, we retrain on the full dataset and save the model, supplying a `predict(folder)` function that loads the model and returns malignancy probabilities.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import StratifiedKFold
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import timm


# Dataset for loading images, labels, and sample weights
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transforms, weight_map):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transforms = transforms
        self.weight_map = weight_map

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        img = self.transforms(img)
        label = torch.tensor(row.label, dtype=torch.float32)
        weight = torch.tensor(self.weight_map[row.skin_tone], dtype=torch.float32)
        return img, label, weight


def train_one_epoch(model, loader, optimizer, device):
    model.train()
    total_loss = 0.0
    for imgs, labels, weights in loader:
        imgs = imgs.to(device)
        labels = labels.to(device).unsqueeze(1)
        weights = weights.to(device).unsqueeze(1)
        logits = model(imgs)
        loss = nn.BCEWithLogitsLoss(reduction="none")(logits, labels)
        loss = (loss * weights).mean()
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * imgs.size(0)
    return total_loss / len(loader.dataset)


def evaluate(model, loader, device):
    model.eval()
    ys, ps = [], []
    with torch.no_grad():
        for imgs, labels, _ in loader:
            imgs = imgs.to(device)
            logits = model(imgs)
            probs = torch.sigmoid(logits).cpu().numpy().flatten()
            ps.extend(probs.tolist())
            ys.extend(labels.numpy().flatten().tolist())
    return roc_auc_score(ys, ps)


def main():
    # Configuration
    df = pd.read_csv("./input/mydataset.csv")
    df["label"] = df.label.map(lambda x: 1 if x == "malignant" else 0)
    # compute inverse-frequency weights for skin_tone
    tone_counts = df.skin_tone.value_counts().to_dict()
    total = len(df)
    weight_map = {tone: total / count for tone, count in tone_counts.items()}
    # transforms
    transforms = T.Compose(
        [
            T.Resize(256),
            T.CenterCrop(224),
            T.ToTensor(),
            T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    aucs = []

    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df.label)):
        train_df = df.iloc[train_idx]
        val_df = df.iloc[val_idx]
        train_ds = SkinLesionDataset(
            train_df, "./input/MyImages", transforms, weight_map
        )
        val_ds = SkinLesionDataset(val_df, "./input/MyImages", transforms, weight_map)
        train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
        val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
        # model setup
        model = timm.create_model("efficientnet_b0", pretrained=True)
        # freeze all layers
        for p in model.parameters():
            p.requires_grad = False
        # replace classifier
        in_f = model.classifier.in_features
        model.classifier = nn.Linear(in_f, 1)
        model = model.to(device)
        optimizer = torch.optim.Adam(
            filter(lambda p: p.requires_grad, model.parameters()), lr=1e-4
        )
        # train
        train_one_epoch(model, train_loader, optimizer, device)
        # eval
        auc = evaluate(model, val_loader, device)
        print(f"Fold {fold+1} AUROC: {auc:.4f}")
        aucs.append(auc)

    mean_auc = np.mean(aucs)
    print(f"Mean CV AUROC: {mean_auc:.4f}")

    # Retrain on full data
    full_ds = SkinLesionDataset(df, "./input/MyImages", transforms, weight_map)
    full_loader = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=4)
    model = timm.create_model("efficientnet_b0", pretrained=True)
    for p in model.parameters():
        p.requires_grad = False
    in_f = model.classifier.in_features
    model.classifier = nn.Linear(in_f, 1)
    model = model.to(device)
    optimizer = torch.optim.Adam(
        filter(lambda p: p.requires_grad, model.parameters()), lr=1e-4
    )
    train_one_epoch(model, full_loader, optimizer, device)
    torch.save(model.state_dict(), "./working/efficientnet_model.pt")
    print("Model saved to ./working/efficientnet_model.pt")


if __name__ == "__main__":
    main()


def predict(folder):
    """
    Load the trained model and predict malignancy probabilities for all images in `folder`.
    Returns a dict {filename: probability}.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # load model
    model = timm.create_model("efficientnet_b0", pretrained=False)
    in_f = model.classifier.in_features
    model.classifier = nn.Linear(in_f, 1)
    model.load_state_dict(
        torch.load("./working/efficientnet_model.pt", map_location=device)
    )
    model = model.to(device).eval()
    # transforms
    transforms = T.Compose(
        [
            T.Resize(256),
            T.CenterCrop(224),
            T.ToTensor(),
            T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    results = {}
    with torch.no_grad():
        for fname in os.listdir(folder):
            if not fname.lower().endswith((".jpg", "png", "jpeg")):
                continue
            img = Image.open(os.path.join(folder, fname)).convert("RGB")
            img = transforms(img).unsqueeze(0).to(device)
            prob = torch.sigmoid(model(img)).item()
            results[fname] = prob
    return results

Results: The model training and evaluation completed successfully without any runtime errors. However, the achieved AUROC scores across the 5 folds are very low (around 0.5), indicating the model is performing close to random guessing. The use of inverse-frequency weighting for skin tones was implemented, but it did not lead to a meaningful improvement in predictive performance. The model was trained only for one epoch per fold, which is likely insufficient for convergence. Additionally, freezing all EfficientNet layers except the classifier likely limited the model's ability to learn relevant features from the data. Overall, the current training setup results in poor classification performance despite the fairness weighting.
Validation Metric: 0.5181

