Design: We will fine-tune a pretrained ResNet18 end-to-end to classify lesions as malignant or benign, using a weighted binary cross‐entropy loss where each sample’s weight is inversely proportional to its skin tone frequency to promote fairness.  We map malignant to 1 and others to 0 and split the data stratified by label into 80% train and 20% validation sets.  During training we resize and normalize images, train for a few epochs on GPU if available, and compute the validation AUROC to assess performance.  After training we save the model and implement a `predict(folder)` function that loads it, preprocesses new images, and returns malignancy probabilities for each.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models


# Dataset class
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        image = Image.open(img_path).convert("RGB")
        image = self.transform(image)
        label = torch.tensor(row.label_bin, dtype=torch.float32)
        weight = torch.tensor(row.sample_weight, dtype=torch.float32)
        return image, label, weight


def train_and_evaluate():
    # Load data
    df = pd.read_csv("./input/mydataset.csv")
    # Binary label: malignant=1, others=0
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    # Compute skin tone weights
    counts = df["skin_tone"].value_counts().to_dict()
    inv_counts = {tone: 1.0 / count for tone, count in counts.items()}
    df["sample_weight"] = df["skin_tone"].map(inv_counts)
    # Train/Val split stratified by malignant label
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label_bin"], random_state=42
    )
    # Transforms
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    # Datasets & loaders
    train_ds = SkinLesionDataset(train_df, "./input/MyImages", transform)
    val_ds = SkinLesionDataset(val_df, "./input/MyImages", transform)
    train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
    # Model
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = models.resnet18(pretrained=True)
    model.fc = nn.Linear(model.fc.in_features, 1)
    model = model.to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss(reduction="none")
    # Training
    epochs = 5
    for epoch in range(epochs):
        model.train()
        for imgs, labels, weights in train_loader:
            imgs, labels, weights = (
                imgs.to(device),
                labels.to(device),
                weights.to(device),
            )
            optimizer.zero_grad()
            logits = model(imgs).squeeze(1)
            losses = criterion(logits, labels)
            loss = (losses * weights).mean()
            loss.backward()
            optimizer.step()
    # Validation
    model.eval()
    all_logits = []
    all_labels = []
    with torch.no_grad():
        for imgs, labels, _ in val_loader:
            imgs = imgs.to(device)
            logits = model(imgs).squeeze(1).cpu().numpy()
            all_logits.extend(logits.tolist())
            all_labels.extend(labels.numpy().tolist())
    preds = 1 / (1 + np.exp(-np.array(all_logits)))
    auc = roc_auc_score(all_labels, preds)
    print(f"Validation AUROC: {auc:.4f}")
    # Save model
    torch.save(model.state_dict(), "./working/model.pth")
    return model


# Prediction function
def predict(folder_path):
    """
    Predict malignancy probabilities for all images in a folder.
    Returns a dict {image_filename: probability}.
    """
    # Load model
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = models.resnet18(pretrained=False)
    model.fc = nn.Linear(model.fc.in_features, 1)
    model.load_state_dict(torch.load("./working/model.pth", map_location=device))
    model = model.to(device).eval()
    # Prepare transform
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    # Load images
    files = [
        f
        for f in os.listdir(folder_path)
        if f.lower().endswith((".jpg", ".png", ".jpeg"))
    ]
    results = {}
    with torch.no_grad():
        for fname in files:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            inp = transform(img).unsqueeze(0).to(device)
            logit = model(inp).item()
            prob = 1.0 / (1.0 + np.exp(-logit))
            results[fname] = prob
    return results


if __name__ == "__main__":
    train_and_evaluate()

Results: The training script executed successfully, achieving a validation AUROC of 0.8844, which indicates good model performance in classifying malignant vs benign skin lesions. The approach incorporated sample weights inversely proportional to skin tone counts to address fairness, which should help reduce the AUROC gap across skin tones without compromising overall performance.
Validation Metric: 0.8844

