    crops = tta_tencrop(img_resized)
    batch = torch.stack([tta_normalize(tta_to_tensor(c)) for c in crops]).to(device)
    with torch.no_grad():
        logits = model(batch).squeeze(1)
        probs = torch.sigmoid(logits).cpu().numpy()
    return probs.mean()


