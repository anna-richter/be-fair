df['label_bin'] = (df['label'] == 'malignant').astype(int)
counts = df['skin_tone'].value_counts().to_dict()
df['weight'] = df['skin_tone'].map(lambda x: 1.0/counts.get(x,1))

# Extract features
X, y, w, names = extract_features(df, './input/MyImages')

# 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
scores = []
for train_idx, val_idx in skf.split(X, y):
    clf = LogisticRegression(max_iter=1000)
    clf.fit(X[train_idx], y[train_idx], sample_weight=w[train_idx])
    preds = clf.predict_proba(X[val_idx])[:,1]
    scores.append(roc_auc_score(y[val_idx], preds))
print("Mean CV AUROC:", np.mean(scores))

# Retrain on full data and save
final_clf = LogisticRegression(max_iter=1000)
final_clf.fit(X, y, sample_weight=w)
joblib.dump(final_clf, os.path.join('model.joblib'))

def predict(folder):
    """
    Predict malignancy probabilities for all .jpg images in `folder`.
    Returns a dict {image_filename: probability}.
    """
    files = [f for f in os.listdir(folder) if f.lower().endswith('.jpg')]
    df2 = pd.DataFrame({'image_name': [os.path.splitext(f)[0] for f in files]})
    X2, _, _, _ = extract_features(df2, folder)
    clf = joblib.load('model.joblib')
    probs = clf.predict_proba(X2)[:,1]
    return dict(zip(files, probs))

