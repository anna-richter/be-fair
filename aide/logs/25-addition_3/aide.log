from torch import nn
from torchvision import transforms, models
from torch.utils.data import Dataset, DataLoader
from PIL import Image
import lightgbm as lgb
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import joblib


class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        img = Image.open(path).convert("RGB")
        return self.transform(img)


class Identity(nn.Module):
    def forward(self, x):
        return x


def extract_features(df, img_dir="input/MyImages"):
    transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ]
    )
    ds = SkinDataset(df, img_dir, transform)
    loader = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    backbone = models.resnet18(pretrained=True)
    backbone.fc = Identity()
    backbone = backbone.to(device).eval()
    feats = []
    with torch.no_grad():
        for imgs in loader:
            imgs = imgs.to(device)
            f = backbone(imgs).cpu().numpy()
            feats.append(f)
    return np.vstack(feats)


def predict(folder):
    """
    Predict malignancy probabilities for all .jpg images in `folder`.
    Returns a dict {image_name: probability}.
    """
    names = [f[:-4] for f in os.listdir(folder) if f.lower().endswith(".jpg")]
    df = pd.DataFrame({"image_name": names})
    feats = extract_features(df, img_dir=folder)
    model = joblib.load("working/model.pkl")
    probs = model.predict_proba(feats)[:, 1]
    return dict(zip(names, probs))


if __name__ == "__main__":
    # Load and prepare data
    df = pd.read_csv("input/mydataset.csv")
    df["binary_label"] = (df["label"] == "malignant").astype(int)
    # Compute sample weights inversely to skin_tone frequency
    counts = df["skin_tone"].value_counts().to_dict()
    tone_w = {t: 1.0 / v for t, v in counts.items()}
    sample_w = df["skin_tone"].map(tone_w).values
    # Extract features
    features = extract_features(df)
    y = df["binary_label"].values
    # 5-fold CV evaluation
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aurocs = []
    for tr, va in skf.split(features, y):
        clf = lgb.LGBMClassifier(n_estimators=100, random_state=42)
        clf.fit(features[tr], y[tr], sample_weight=sample_w[tr])
        preds = clf.predict_proba(features[va])[:, 1]
        aurocs.append(roc_auc_score(y[va], preds))
    print(f"Mean AUROC: {np.mean(aurocs):.4f}")
    # Train final model on full data and save
    final_clf = lgb.LGBMClassifier(n_estimators=100, random_state=42)
    final_clf.fit(features, y, sample_weight=sample_w)
    os.makedirs("working", exist_ok=True)
    joblib.dump(final_clf, "working/model.pkl")

Results: The training script executed successfully without any errors or bugs. The model was trained using a ResNet18 backbone for feature extraction and LightGBM for classification with sample weighting to address fairness across skin tones. The 5-fold cross-validation yielded a mean AUROC of 0.8471, indicating good overall model performance. The script also saved the final trained model for later use in prediction.
Validation Metric: 0.8471

