Design: I propose adding test‐time augmentation (TTA) via TenCrop during validation and inference. This will average predictions over 10 spatial crops (corners and center, plus their horizontal flips), improving robustness without altering training. We'll modify the validation transform to output 10 crops per image, adjust the validation loop to average model outputs across those crops, and similarly apply TenCrop in the `predict` function. This single change should boost the AUROC by leveraging spatial invariance at evaluation time.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import transforms, models
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score


class SkinDataset(Dataset):
    def __init__(self, df, image_dir, transform=None, tta=False):
        self.df = df.reset_index(drop=True)
        self.image_dir = image_dir
        self.transform = transform
        self.tta = tta

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.image_dir, row["image_name"] + ".jpg")
        img = Image.open(img_path).convert("RGB")
        data = self.transform(img)  # if tta, this is a tensor of shape [10,C,H,W]
        label = torch.tensor(row["label_bin"], dtype=torch.float32)
        return data, label


def predict(folder_path):
    """
    Predict malignancy probabilities for images in folder_path using TTA TenCrop.

    Args:
        folder_path (str): Path to folder with images.

    Returns:
        dict: mapping image filename to malignancy probability (0-1).
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # load model
    model = models.densenet121(pretrained=False)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.load_state_dict(torch.load("working/best_model.pth", map_location=device))
    model.to(device).eval()

    # define TTA transform
    resize = transforms.Resize(256)
    tencrop = transforms.TenCrop(224)
    to_tensor = transforms.ToTensor()
    normalize = transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])

    probs = {}
    for fname in os.listdir(folder_path):
        if not fname.lower().endswith((".jpg", ".jpeg", ".png")):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        crops = tencrop(resize(img))
        batch = torch.stack([normalize(to_tensor(c)) for c in crops]).to(
            device
        )  # [10,C,H,W]
        with torch.no_grad():
            out = model(batch)  # [10,1]
            p = torch.sigmoid(out).mean().item()
        probs[fname] = p
    return probs


def main():
    # Load data
    df = pd.read_csv("input/mydataset.csv")
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label_bin"], random_state=42
    )

    # transforms
    mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
    train_transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.RandomResizedCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize(mean, std),
        ]
    )
    # validation TTA transform
    resize = transforms.Resize(256)
    tencrop = transforms.TenCrop(224)
    to_tensor = transforms.ToTensor()
    normalize = transforms.Normalize(mean, std)

    def val_transform(img):
        crops = tencrop(resize(img))
        tts = [normalize(to_tensor(c)) for c in crops]
        return torch.stack(tts)  # [10,C,H,W]

    # datasets & loaders
    train_ds = SkinDataset(train_df, "input/MyImages", transform=train_transform)
    val_ds = SkinDataset(val_df, "input/MyImages", transform=val_transform, tta=True)

    # weighted sampler
    counts = train_df["label_bin"].value_counts().to_dict()
    weights = train_df["label_bin"].apply(lambda x: 1.0 / counts[x]).values
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)

    train_loader = DataLoader(train_ds, batch_size=32, sampler=sampler, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=16, shuffle=False, num_workers=4)

    # model, loss, optimizer
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = models.densenet121(pretrained=True)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.to(device)
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    os.makedirs("working", exist_ok=True)
    best_auc = 0.0
    for epoch in range(1, 6):
        model.train()
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(device), labels.unsqueeze(1).to(device)
            optimizer.zero_grad()
            out = model(imgs)
            loss = criterion(out, labels)
            loss.backward()
            optimizer.step()

        # validation with TTA
        model.eval()
        all_labels, all_probs = [], []
        with torch.no_grad():
            for imgs, labels in val_loader:
                bs, ncrops, C, H, W = imgs.size()  # [bs,10,C,H,W]
                imgs = imgs.view(-1, C, H, W).to(device)
                labels = labels.to(device)
                out = model(imgs)  # [bs*10,1]
                out = out.view(bs, ncrops, -1)  # [bs,10,1]
                probs = torch.sigmoid(out).mean(dim=1)  # [bs,1]
                all_labels += labels.cpu().numpy().tolist()
                all_probs += probs.cpu().numpy().ravel().tolist()

        val_auc = roc_auc_score(all_labels, all_probs)
        print(f"Epoch {epoch}: Validation AUROC = {val_auc:.4f}")
        if val_auc > best_auc:
            best_auc = val_auc
            torch.save(model.state_dict(), "working/best_model.pth")
    print(f"Best Validation AUROC: {best_auc:.4f}")


if __name__ == "__main__":
    main()

Results: The training script executed successfully without any errors. The model, a DenseNet121, was trained for 5 epochs with TTA (TenCrop) applied during validation. The validation AUROC improved steadily each epoch, reaching a best AUROC of 0.9224, indicating good classification performance on the malignant vs benign skin lesion task.
Validation Metric: 0.9224

