Design: We replace the weighted BCE loss with a weighted Focal Loss (gamma=2) to focus the model on harder and potentially under‐represented examples without changing the rest of the pipeline. We define a `focal_loss` that applies sample weights and the modulating factor `(1-p_t)^γ` to each example’s BCE loss, then use it in both cross‐validation and full‐data retraining loops. Everything else—mixup, augmentations, TTA in validation, inverse‐frequency skin‐tone weighting, and the predict function—remains unchanged so we isolate the impact of focal loss on AUROC.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import StratifiedKFold
import torch
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import torchvision.models as models
import warnings

warnings.filterwarnings("ignore")


# Mixup implementation
def mixup_data(x, y, w, alpha=0.4):
    if alpha > 0:
        lam = np.random.beta(alpha, alpha)
    else:
        lam = 1
    batch_size = x.size()[0]
    if batch_size == 1:
        return x, y, w
    index = torch.randperm(batch_size).to(x.device)
    mixed_x = lam * x + (1 - lam) * x[index, :]
    y_a, y_b = y, y[index]
    w_a, w_b = w, w[index]
    mixed_y = lam * y_a + (1 - lam) * y_b
    mixed_w = lam * w_a + (1 - lam) * w_b
    return mixed_x, mixed_y, mixed_w


# Focal loss implementation
def focal_loss(logits, targets, weights, gamma=2.0):
    bce = nn.functional.binary_cross_entropy_with_logits(
        logits, targets, reduction="none"
    )
    probs = torch.sigmoid(logits)
    pt = probs * targets + (1 - probs) * (1 - targets)
    mod_factor = (1 - pt) ** gamma
    loss = weights * mod_factor * bce
    return loss.mean()


class SkinLesionDataset(Dataset):
    def __init__(self, df, image_dir, transforms):
        self.df = df.reset_index(drop=True)
        self.image_dir = image_dir
        self.transforms = transforms

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.image_dir, row["image_name"] + ".jpg")
        image = Image.open(img_path).convert("RGB")
        image = self.transforms(image)
        label = torch.tensor(row["target"], dtype=torch.float32)
        weight = torch.tensor(row["weight"], dtype=torch.float32)
        return image, label, weight


def predict(folder_path: str):
    """
    Predict malignancy probabilities for all .jpg images in folder_path using TTA (horizontal flip).
    Returns a dict {filename: probability}.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = models.densenet121(pretrained=False)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.load_state_dict(torch.load("./working/model.pth", map_location=device))
    model.to(device).eval()
    tx = T.Compose(
        [
            T.Resize(256),
            T.CenterCrop(224),
            T.ToTensor(),
            T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    results = {}
    for fname in os.listdir(folder_path):
        if not fname.lower().endswith(".jpg"):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        x = tx(img).unsqueeze(0).to(device)
        x_flip = torch.flip(x, dims=[3])
        with torch.no_grad():
            p1 = torch.sigmoid(model(x))
            p2 = torch.sigmoid(model(x_flip))
            prob = ((p1 + p2) / 2).item()
        results[fname] = prob
    return results


def main():
    torch.manual_seed(42)
    np.random.seed(42)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # load data
    df = pd.read_csv("./input/mydataset.csv")
    df["target"] = (df["label"] == "malignant").astype(int)
    freq = df["skin_tone"].value_counts().to_dict()
    df["weight"] = df["skin_tone"].map(lambda x: 1.0 / freq.get(x, 1))
    # 5-fold CV
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    cv_aucs = []
    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"])):
        train_df, val_df = df.iloc[train_idx], df.iloc[val_idx]
        train_tf = T.Compose(
            [
                T.RandomResizedCrop(224),
                T.RandomHorizontalFlip(),
                T.ToTensor(),
                T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
            ]
        )
        val_tf = T.Compose(
            [
                T.Resize(256),
                T.CenterCrop(224),
                T.ToTensor(),
                T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
            ]
        )
        train_ds = SkinLesionDataset(train_df, "./input/MyImages", train_tf)
        val_ds = SkinLesionDataset(val_df, "./input/MyImages", val_tf)
        train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
        val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
        # model & optimizer
        model = models.densenet121(pretrained=True)
        model.classifier = nn.Linear(model.classifier.in_features, 1)
        model = model.to(device)
        optimizer = optim.Adam(model.parameters(), lr=1e-4)
        # train
        model.train()
        for epoch in range(3):
            for imgs, labels, weights in train_loader:
                imgs, labels, weights = (
                    imgs.to(device),
                    labels.to(device),
                    weights.to(device),
                )
                inputs, targets, wts = mixup_data(imgs, labels, weights, alpha=0.4)
                logits = model(inputs).squeeze(1)
                loss = focal_loss(logits, targets, wts, gamma=2.0)
                optimizer.zero_grad()
                loss.backward()
                optimizer.step()
        # eval
        model.eval()
        all_labels, all_probs = [], []
        with torch.no_grad():
            for imgs, labels, _ in val_loader:
                imgs = imgs.to(device)
                logits1 = model(imgs).squeeze(1)
                logits2 = model(torch.flip(imgs, dims=[3])).squeeze(1)
                probs = (
                    ((torch.sigmoid(logits1) + torch.sigmoid(logits2)) / 2)
                    .cpu()
                    .numpy()
                )
                all_probs.extend(probs)
                all_labels.extend(labels.numpy())
        auc = roc_auc_score(all_labels, all_probs)
        print(f"Fold {fold+1} AUROC: {auc:.4f}")
        cv_aucs.append(auc)
    mean_auc = np.mean(cv_aucs)
    print(f"Mean CV AUROC with Focal Loss: {mean_auc:.4f}")
    # retrain on full data
    full_tf = T.Compose(
        [
            T.RandomResizedCrop(224),
            T.RandomHorizontalFlip(),
            T.ToTensor(),
            T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    full_ds = SkinLesionDataset(df, "./input/MyImages", full_tf)
    full_loader = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=4)
    model = models.densenet121(pretrained=True)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model = model.to(device)
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    model.train()
    for epoch in range(3):
        for imgs, labels, weights in full_loader:
            imgs, labels, weights = (
                imgs.to(device),
                labels.to(device),
                weights.to(device),
            )
            inputs, targets, wts = mixup_data(imgs, labels, weights, alpha=0.4)
            logits = model(inputs).squeeze(1)
            loss = focal_loss(logits, targets, wts, gamma=2.0)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    os.makedirs("./working", exist_ok=True)
    torch.save(model.state_dict(), "./working/model.pth")
    # optional submission if test dir exists
    for d in os.listdir("./input"):
        test_path = os.path.join("./input", d)
        if os.path.isdir(test_path) and d.lower().startswith("test"):
            preds = predict(test_path)
            sub = pd.DataFrame(
                list(preds.items()), columns=["image_name", "probability"]
            )
            sub.to_csv("./working/submission.csv", index=False)
            print(f"Saved submission.csv for test dir '{d}'")


if __name__ == "__main__":
    main()

Results: The training script executed successfully without any errors. The model achieved a good mean cross-validation AUROC of approximately 0.8868, indicating strong classification performance on the skin lesion dataset. The use of focal loss and mixup augmentation likely helped improve model robustness. The script also includes a prediction function with test-time augmentation and saves the trained model and optional submission file if test data is present.
