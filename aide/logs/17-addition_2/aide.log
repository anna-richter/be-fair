    # transforms
    train_tf = T.Compose([T.Resize(256), T.RandomResizedCrop(224), T.RandomHorizontalFlip(),
                          T.ToTensor(), T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])
    val_tf = T.Compose([T.Resize(256), T.CenterCrop(224), T.ToTensor(), 
