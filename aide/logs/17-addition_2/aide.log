            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
        scheduler.step()

    os.makedirs("./working", exist_ok=True)
    torch.save(model.state_dict(), "./working/model.pth")

    # Optional: create submission if test folder exists
    test_folder = "./input/test"
    if os.path.isdir(test_folder):
        preds = predict(test_folder)
        sub = pd.DataFrame(list(preds.items()), columns=["image_name", "target"])
