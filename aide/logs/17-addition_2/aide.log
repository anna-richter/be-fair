            p1 = torch.sigmoid(model(x))
            p2 = torch.sigmoid(model(x_h))
            p3 = torch.sigmoid(model(x_v))
            p4 = torch.sigmoid(model(x_hv))
            prob = (p1 + p2 + p3 + p4) / 4.0
            results[fname] = prob.item()
