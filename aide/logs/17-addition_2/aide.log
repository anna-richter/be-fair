            logits = model(inputs).squeeze(1)
            loss = focal_loss(logits, targets, wts, gamma=2.0)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    os.makedirs("./working", exist_ok=True)
    torch.save(model.state_dict(), "./working/model.pth")
    # optional submission if test dir exists
    for d in os.listdir("./input"):
        test_path = os.path.join("./input", d)
        if os.path.isdir(test_path) and d.lower().startswith("test"):
            preds = predict(test_path)
            sub = pd.DataFrame(
                list(preds.items()), columns=["image_name", "probability"]
            )
            sub.to_csv("./working/submission.csv", index=False)
            print(f"Saved submission.csv for test dir '{d}'")


if __name__ == "__main__":
    main()

