                                optimizer.zero_grad()                           
                                logits = model(imgs,                            
                    tones)                                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss +=                                 
