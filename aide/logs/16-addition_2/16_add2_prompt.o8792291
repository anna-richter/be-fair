                            feat_dim =                                          
                    self.backbone.num_features                                  
                            self.tone_emb =                                     
                    nn.Embedding(num_tones, 16)                                 
                            self.classifier =                                   
                    nn.Sequential(                                              
                                nn.Linear(feat_dim + 16,                        
                    128),                                                       
