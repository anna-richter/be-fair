                    torch.optim.lr_scheduler.CosineAnneali                      
                    ngLR(optimizer, T_max=epochs)                               
                                                                                
                        for epoch in range(1, epochs+1):                        
                            model.train()                                       
                            running_loss = 0.0                                  
                            for imgs, tones, labels in                          
                    train_loader:                                               
                                imgs, tones, labels =                           
                    imgs.to(device), tones.to(device),                          
                    labels.to(device)                                           
                                optimizer.zero_grad()                           
                                logits = model(imgs,                            
                    tones)                                                      
                                loss = criterion(logits,                        
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss +=                                 
