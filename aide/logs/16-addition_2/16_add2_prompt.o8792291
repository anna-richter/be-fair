                            T.RandomRotation(15),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485,0.456,                      
                    0.406), std=(0.229,0.224,0.225)),                           
                        ])                                                      
                        val_tf = T.Compose([                                    
                            T.Resize(224),                                      
                            T.CenterCrop(224),                                  
                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485,0.456,                      
