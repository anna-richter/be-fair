                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            tone =                                              
                    self.tone2idx[row["skin_tone"]]                             
                            tone = torch.tensor(tone,                           
                    dtype=torch.long)                                           
                            label =                                             
                    torch.tensor(row["label_bin"],                              
                    dtype=torch.float32)                                        
                            return img, tone, label                             
                                                                                
                                                                                
                    # Model definition                                          
