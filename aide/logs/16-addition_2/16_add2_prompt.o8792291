                            T.ToTensor(),                                       
                            T.Normalize(mean=(0.485,0.456,                      
                    0.406), std=(0.229,0.224,0.225)),                           
                        ])                                                      
                        results = {}                                            
                        with torch.no_grad():                                   
                            for fname in                                        
                    os.listdir(folder_path):                                    
                                if not                                          
                    fname.lower().endswith((".jpg",                             
                    ".png")):                                                   
                                    continue                                    
                                img =                                           
                    Image.open(os.path.join(folder_path,                        
                    fname)).convert("RGB")                                      
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                tone = torch.tensor([0],                        
                    device=device, dtype=torch.long)                            
                                prob =                                          
                    torch.sigmoid(model(x, tone)).item()                        
                                results[fname] = prob                           
                        return results                                          
                                                                                
                    def main():                                                 
                        device = "cuda" if                                      
                    torch.cuda.is_available() else "cpu"                        
                        df =                                                    
