                            for x,y in full_loader:                             
                                x, y = x.to(device),                            
                    y.to(device)                                                
                                l = crit(final_model(x),                        
                    y)                                                          
                                opt.zero_grad();                                
                    l.backward(); opt.step()                                    
                            sched_full.step()                                   
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        save_path =                                             
                    "./working/model_densenet121.pth"                           
