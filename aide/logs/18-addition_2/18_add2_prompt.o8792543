                        auc_light = (                                           
                            roc_auc_score(np.array(all_labe                     
                    ls)[light_mask],                                            
                    np.array(all_probs)[light_mask])                            
                            if light_mask.sum() > 0                             
                            else np.nan                                         
                        )                                                       
                        auc_dark = (                                            
                            roc_auc_score(np.array(all_labe                     
                    ls)[dark_mask],                                             
                    np.array(all_probs)[dark_mask])                             
                            if dark_mask.sum() > 0                              
                            else np.nan                                         
                        )                                                       
                        gap = (                                                 
                            abs(auc_light - auc_dark)                           
                            if not np.isnan(auc_light) and                      
                    not np.isnan(auc_dark)                                      
                            else np.nan                                         
                        )                                                       
                                                                                
                        print(                                                  
                            f"Fold {fold+1} AUROC:                              
                    overall={auc_all:.4f},                                      
                    light={auc_light:.4f},                                      
                    dark={auc_dark:.4f}, gap={gap:.4f}"                         
                        )                                                       
                        overall_aucs.append(auc_all)                            
                        light_aucs.append(auc_light)                            
                        dark_aucs.append(auc_dark)                              
                                                                                
