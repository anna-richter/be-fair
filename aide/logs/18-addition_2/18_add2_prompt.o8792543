                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUROC: {mean_auc:.4f}")                     
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinLesionDataset(df,                             
                    img_dir, transform=train_transforms)                        
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                    model_final =                                               
                    models.resnet34(pretrained=True)                            
                    model_final.fc =                                            
                    nn.Linear(model_final.fc.in_features,                       
                    2)                                                          
                    model_final = model_final.to(device)                        
                    criterion = nn.CrossEntropyLoss()                           
                    optimizer =                                                 
                    torch.optim.Adam(model_final.parameters                     
                    (), lr=1e-4)                                                
                                                                                
                    for epoch in range(5):                                      
                        model_final.train()                                     
                        for imgs, labels in                                     
                    tqdm(full_loader, desc=f"Full train                         
                    epoch {epoch+1}"):                                          
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            outputs = model_final(imgs)                         
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                    os.makedirs("./working", exist_ok=True)                     
                    torch.save(model_final.state_dict(),                        
                    "./working/model.pth")                                      
                                                                                
                                                                                
                    def predict(image_folder: str) ->                           
                    pd.DataFrame:                                               
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in a folder.                                 
                        Args:                                                   
                            image_folder (str): Path to                         
                    folder containing .jpg images.                              
                        Returns:                                                
                            pd.DataFrame: columns                               
                    ['image_name', 'malignancy_prob']                           
                        """                                                     
                        model =                                                 
                    models.resnet34(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 2)                          
                        model.load_state_dict(torch.load(".                     
                    /working/model.pth",                                        
                    map_location=device))                                       
                        model = model.to(device).eval()                         
                                                                                
                        image_files = [f for f in                               
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        preds = []                                              
                        transform = val_transforms                              
                        with torch.no_grad():                                   
                            for fname in image_files:                           
                                img =                                           
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                out = model(img_t)                              
                                prob = torch.softmax(out,                       
                    dim=1)[0, 1].item()                                         
                                preds.append({"image_name":                     
                    fname, "malignancy_prob": prob})                            
                        return pd.DataFrame(preds)                              
                                                                                
                                                                                
                    # Example usage:                                            
                    # df_preds =                                                
                    predict("./input/MyImages")                                 
                                                                                
                    ```                                                         
                                                                                
