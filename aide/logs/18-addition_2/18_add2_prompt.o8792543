                            # compute weights inverse to                        
                    skin-tone frequency                                         
                            tone_counts =                                       
                    train_df.tone_cat.value_counts().to_dic                     
                    t()                                                         
                            weights =                                           
                    train_df.tone_cat.map(lambda t: 1.0 /                       
                    tone_counts[t]).values                                      
                            sampler =                                           
                    WeightedRandomSampler(                                      
                                weights,                                        
                    num_samples=len(weights),                                   
                    replacement=True                                            
                            )                                                   
                                                                                
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    sampler=sampler, num_workers=4                              
