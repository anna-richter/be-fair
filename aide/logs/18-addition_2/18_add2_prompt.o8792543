                        all_probs, all_labels, all_tones =                      
                    [], [], []                                                  
                        with torch.no_grad():                                   
                            for x, y in val_loader:                             
                                x = x.to(device)                                
                                logits = model(x)                               
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(y.numpy()                     
                    .flatten())                                                 
                            # capture skin tones                                
                        all_tones = val_df.skin_tone.values                     
                        auc_all = roc_auc_score(all_labels,                     
                    all_probs)                                                  
                        # compute per-tone                                      
                        light_mask = all_tones == "light"                       
