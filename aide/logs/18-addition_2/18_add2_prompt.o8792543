                        f"light={np.nanmean(light_aucs):.4f                     
                    }, dark={np.nanmean(dark_aucs):.4f}, "                      
                        f"gap={abs(np.nanmean(light_aucs)-n                     
                    p.nanmean(dark_aucs)):.4f}"                                 
