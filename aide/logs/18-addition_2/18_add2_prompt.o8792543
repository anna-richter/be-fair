                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.4                      
                    85,0.456,0.406],                                            
                    std=[0.229,0.224,0.225])                                    
                        ])                                                      
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(X, y), 1):                              
                            df_train = df.iloc[train_idx]                       
                            df_val = df.iloc[val_idx]                           
                            train_ds =                                          
                    SkinLesionDataset(df_train, img_dir,                        
