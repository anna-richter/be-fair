                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            model.eval()                                        
                            all_probs, all_labels = [], []                      
                            with torch.no_grad():                               
                                for x,y in val_loader:                          
                                    x = x.to(device)                            
