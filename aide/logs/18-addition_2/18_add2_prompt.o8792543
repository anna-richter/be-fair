                            f"gap={abs(np.nanmean(light_auc                     
                    s)-np.nanmean(dark_aucs)):.4f}"                             
                        )                                                       
                                                                                
                        # retrain on full data                                  
                        full_ds = LesionDataset(df,                             
                    img_dir, transform=train_tf)                                
                        # sample weights for full data                          
                        full_tone_counts =                                      
                    df.tone_cat.value_counts().to_dict()                        
                        full_weights =                                          
                    df.tone_cat.map(lambda t: 1.0 /                             
