                    learning without ensembling or                              
                    extensive hyperparameter search and                         
                    reports the mean AUROC across folds.                        
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                    # Constants                                                 
                    DATA_CSV = "./input/mydataset.csv"                          
                    IMG_DIR = "./input/MyImages"                                
                    MODEL_PATH = "./working/model.pth"                          
                    N_FOLDS = 5                                                 
                    BATCH_SIZE = 32                                             
                    EPOCHS = 3                                                  
                    LR = 1e-4                                                   
                    IMG_SIZE = 224                                              
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                                                                                
                    # Dataset                                                   
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.float32)                                        
                            return img, label                                   
                                                                                
                                                                                
                    # Prepare data                                              
                    df = pd.read_csv(DATA_CSV)                                  
                    # Filter malignant (1) and benign (0),                      
                    drop non-neoplastic                                         
                    df = df[df.label.isin(["malignant",                         
                    "benign"])].copy()                                          
                    df["label_bin"] = (df.label ==                              
                    "malignant").astype(int)                                    
                    y = df["label_bin"].values                                  
                                                                                
                    # Transforms                                                
                    train_tf = transforms.Compose(                              
                        [                                                       
                            transforms.Resize((IMG_SIZE,                        
                    IMG_SIZE)),                                                 
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.RandomRotation(15),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_tf = transforms.Compose(                                
                        [                                                       
                            transforms.Resize((IMG_SIZE,                        
                    IMG_SIZE)),                                                 
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # Cross-validation                                          
                    skf = StratifiedKFold(n_splits=N_FOLDS,                     
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, y)):                                
                        train_df, val_df =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                        train_ds = LesionDataset(train_df,                      
                    IMG_DIR, transform=train_tf)                                
                        val_ds = LesionDataset(val_df,                          
                    IMG_DIR, transform=val_tf)                                  
                        train_loader = DataLoader(                              
                            train_ds,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        val_loader = DataLoader(val_ds,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        model =                                                 
                    models.resnet18(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    optim.Adam(model.parameters(), lr=LR)                       
                                                                                
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(EPOCHS):                             
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE),                                            
                    labels.to(DEVICE).unsqueeze(1)                              
                                optimizer.zero_grad()                           
                                outputs = model(imgs)                           
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Validate                                              
                        model.eval()                                            
                        preds, trues = [], []                                   
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(DEVICE)                          
                                out = model(imgs)                               
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatte                     
                    n()                                                         
                                preds.extend(probs)                             
                                trues.extend(labels.numpy()                     
                    .flatten())                                                 
                        auc = roc_auc_score(trues, preds)                       
                        print(f"Fold {fold+1} AUROC:                            
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    # Save final model                                          
                    torch.save(model.state_dict(),                              
                    MODEL_PATH)                                                 
                    print(f"Mean AUROC: {np.mean(aucs):.4f}                     
                    ± {np.std(aucs):.4f}")                                      
                                                                                
                                                                                
                    def predict(image_folder):                                  
                        """                                                     
                        Predict malignancy probability for                      
                    all .jpg images in `image_folder`.                          
                        Returns a DataFrame with columns:                       
                    image_name, malignancy_probability.                         
                        """                                                     
                        # Load model                                            
                        model =                                                 
                    models.resnet18(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 1)                          
                        model.load_state_dict(torch.load(MO                     
                    DEL_PATH, map_location=DEVICE))                             
                        model.to(DEVICE).eval()                                 
                                                                                
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize((IMG_SIZE                     
                    , IMG_SIZE)),                                               
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        results = []                                            
                        img_files = [f for f in                                 
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        loader = DataLoader(                                    
                            img_files,                                          
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    collate_fn=lambda x: x                                      
                        )                                                       
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                imgs = []                                       
                                names = []                                      
                                for fname in batch:                             
                                    img =                                       
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                    imgs.append(tf(img))                        
                                    names.append(os.path.sp                     
                    litext(fname)[0])                                           
                                imgs =                                          
                    torch.stack(imgs).to(DEVICE)                                
                                out = model(imgs)                               
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatte                     
                    n()                                                         
                                for name, p in zip(names,                       
                    probs):                                                     
                                    results.append({"image_                     
                    name": name, "malignancy_probability":                      
                    float(p)})                                                  
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example usage:                                            
                    # df_preds =                                                
                    predict("./input/MyImages")                                 
                    # print(df_preds.head())                                    
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    5-fold cross-validation resulted in                         
                    consistent AUROC scores around 0.88 to                      
                    0.90, with a mean AUROC of                                  
                    approximately 0.887 and a low standard                      
                    deviation, indicating stable model                          
                    performance. The model was saved                            
                    correctly, and the prediction function                      
                    is implemented to return malignancy                         
                    probabilities for new images. Overall,                      
                    the model demonstrates good performance                     
                    in classifying malignant vs benign                          
                    lesions.                                                    
                    Validation Metric: 0.8869                                   
                                                                                
                    -------------------------------                             
                    Design: We filter to malignant vs                           
                    benign cases and encode them as binary                      
                    labels. A pretrained ResNet34 is                            
                    fine-tuned with simple augmentations                        
                    and run through 5‐fold stratified                           
                    cross‐validation, measuring mean AUROC.                     
                    Finally, we retrain on the full                             
                    dataset, save the model, and provide a                      
                    `predict()` function to load the saved                      
                    weights and output malignancy                               
                    probabilities for new images.                               
                    Code: import os                                             
                    import random                                               
                    import numpy as np                                          
                    import pandas as pd                                         
                    from PIL import Image                                       
                    from tqdm import tqdm                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                    # Set random seeds for reproducibility                      
                    seed = 42                                                   
                    random.seed(seed)                                           
                    np.random.seed(seed)                                        
                    torch.manual_seed(seed)                                     
                    torch.cuda.manual_seed_all(seed)                            
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                                                                                
                    # Custom Dataset                                            
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label = row.label_enc                               
                            return img, label                                   
                                                                                
                                                                                
                    # Read and prepare data                                     
                    df =                                                        
                    pd.read_csv("./input/mydataset.csv")                        
                    df = df[df["label"].isin(["malignant",                      
                    "benign"])].copy()                                          
                    df["label_enc"] =                                           
                    df["label"].map({"benign": 0,                               
                    "malignant": 1})                                            
                    img_dir = "./input/MyImages"                                
                                                                                
                    # Transforms                                                
                    train_transforms = transforms.Compose(                      
                        [                                                       
                            transforms.RandomResizedCrop(22                     
                    4),                                                         
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_transforms = transforms.Compose(                        
                        [                                                       
                            transforms.Resize(256),                             
                            transforms.CenterCrop(224),                         
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # 5-fold CV                                                 
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=seed)                            
                    aucs = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.label_enc),                      
                    1):                                                         
                        print(f"Fold {fold}")                                   
                        df_train = df.iloc[train_idx]                           
                        df_val = df.iloc[val_idx]                               
                        train_ds =                                              
                    SkinLesionDataset(df_train, img_dir,                        
                    transform=train_transforms)                                 
                        val_ds = SkinLesionDataset(df_val,                      
                    img_dir, transform=val_transforms)                          
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.resnet34(pretrained=True)                            
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 2)                          
                        model = model.to(device)                                
                        criterion = nn.CrossEntropyLoss()                       
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Train for 3 epochs                                    
                        for epoch in range(3):                                  
                            model.train()                                       
                            for imgs, labels in                                 
                    train_loader:                                               
                                imgs, labels =                                  
                    imgs.to(device), labels.to(device)                          
                                optimizer.zero_grad()                           
                                outputs = model(imgs)                           
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Evaluate                                              
                        model.eval()                                            
                        all_preds = []                                          
                        all_targets = []                                        
                        with torch.no_grad():                                   
                            for imgs, labels in val_loader:                     
                                imgs = imgs.to(device)                          
                                outputs = model(imgs)                           
                                probs =                                         
                    torch.softmax(outputs, dim=1)[:,                            
                    1].cpu().numpy()                                            
                                all_preds.extend(probs)                         
                                all_targets.extend(labels.n                     
                    umpy())                                                     
                        auc = roc_auc_score(all_targets,                        
                    all_preds)                                                  
                        print(f"Fold {fold} AUROC:                              
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    mean_auc = np.mean(aucs)                                    
                    print(f"Mean CV AUROC: {mean_auc:.4f}")                     
                                                                                
                    # Retrain on full data                                      
                    full_ds = SkinLesionDataset(df,                             
                    img_dir, transform=train_transforms)                        
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                    model_final =                                               
                    models.resnet34(pretrained=True)                            
                    model_final.fc =                                            
                    nn.Linear(model_final.fc.in_features,                       
                    2)                                                          
                    model_final = model_final.to(device)                        
                    criterion = nn.CrossEntropyLoss()                           
                    optimizer =                                                 
                    torch.optim.Adam(model_final.parameters                     
                    (), lr=1e-4)                                                
                                                                                
                    for epoch in range(5):                                      
                        model_final.train()                                     
                        for imgs, labels in                                     
                    tqdm(full_loader, desc=f"Full train                         
                    epoch {epoch+1}"):                                          
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            outputs = model_final(imgs)                         
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                    os.makedirs("./working", exist_ok=True)                     
                    torch.save(model_final.state_dict(),                        
                    "./working/model.pth")                                      
                                                                                
                                                                                
                    def predict(image_folder: str) ->                           
                    pd.DataFrame:                                               
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in a folder.                                 
                        Args:                                                   
                            image_folder (str): Path to                         
                    folder containing .jpg images.                              
                        Returns:                                                
                            pd.DataFrame: columns                               
                    ['image_name', 'malignancy_prob']                           
                        """                                                     
                        model =                                                 
                    models.resnet34(pretrained=False)                           
                        model.fc =                                              
                    nn.Linear(model.fc.in_features, 2)                          
                        model.load_state_dict(torch.load(".                     
                    /working/model.pth",                                        
                    map_location=device))                                       
                        model = model.to(device).eval()                         
                                                                                
                        image_files = [f for f in                               
                    os.listdir(image_folder) if                                 
                    f.lower().endswith(".jpg")]                                 
                        preds = []                                              
                        transform = val_transforms                              
                        with torch.no_grad():                                   
                            for fname in image_files:                           
                                img =                                           
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                img_t =                                         
                    transform(img).unsqueeze(0).to(device)                      
                                out = model(img_t)                              
                                prob = torch.softmax(out,                       
                    dim=1)[0, 1].item()                                         
                                preds.append({"image_name":                     
                    fname, "malignancy_prob": prob})                            
                        return pd.DataFrame(preds)                              
                                                                                
                                                                                
                    # Example usage:                                            
                    # df_preds =                                                
                    predict("./input/MyImages")                                 
                                                                                
                    Results: The training and evaluation                        
                    script executed successfully without                        
                    any errors. The model achieved a mean                       
                    cross-validation AUROC of approximately                     
                    0.8781, indicating good discriminative                      
                    performance between malignant and                           
                    benign lesions. The final model was                         
                    retrained on the full dataset for 5                         
                    epochs and saved correctly. The                             
                    provided prediction function loads the                      
                    trained model and returns malignancy                        
                    probabilities for new images as                             
                    expected. There is no explicit mention                      
                    or evaluation of fairness regarding                         
                    skin tone in the output, but the core                       
                    functionality and performance metrics                       
                    are sound.                                                  
                    Validation Metric: 0.8781                                   
                                                                                
                    -------------------------------                             
                    Design: We fine-tune a pretrained                           
                    EfficientNet-B0 on the malignant vs                         
                    benign subset with class-balanced                           
                    cross-entropy and simple augmentations,                     
                    measuring overall AUROC and                                 
                    skin-tone-specific AUROC gaps over                          
                    5‐fold stratified cross-validation.                         
                    After CV, we retrain on the full                            
                    dataset and save the final model                            
                    weights. A `predict()` function loads                       
                    the saved model and returns malignancy                      
                    probabilities for a folder of new                           
                    images. We report mean AUROC and mean                       
                    skin-tone AUROC gap across folds.                           
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import timm                                                 
                                                                                
                    DATA_DIR = "./input/MyImages"                               
                    CSV_PATH = "./input/mydataset.csv"                          
                    MODEL_SAVE_PATH =                                           
                    "./working/efficientnetb0_skin_lesion.p                     
                    th"                                                         
                    DEVICE = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    IMG_SIZE = 224                                              
                    BATCH_SIZE = 32                                             
                    EPOCHS_CV = 3                                               
                    EPOCHS_FULL = 3                                             
                    N_FOLDS = 5                                                 
                                                                                
                                                                                
                    # Dataset                                                   
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None, with_labels=True):                          
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                            self.with_labels = with_labels                      
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            img =                                               
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                img = self.transform(img)                       
                            if self.with_labels:                                
                                label =                                         
                    torch.tensor(row.label_bin,                                 
                    dtype=torch.long)                                           
                                skin_tone = row.skin_tone                       
                                return img, label,                              
                    skin_tone                                                   
                            else:                                               
                                return img, row.image_name                      
                                                                                
                                                                                
                    # Transforms                                                
                    mean = [0.485, 0.456, 0.406]                                
                    std = [0.229, 0.224, 0.225]                                 
                    train_tf = T.Compose(                                       
                        [                                                       
                            T.RandomResizedCrop(IMG_SIZE),                      
                            T.RandomHorizontalFlip(),                           
                            T.ColorJitter(brightness=0.2,                       
                    contrast=0.2, saturation=0.2, hue=0.1),                     
                            T.ToTensor(),                                       
                            T.Normalize(mean, std),                             
                        ]                                                       
                    )                                                           
                    val_tf = T.Compose(                                         
                        [                                                       
                            T.Resize(IMG_SIZE + 32),                            
                            T.CenterCrop(IMG_SIZE),                             
                            T.ToTensor(),                                       
                            T.Normalize(mean, std),                             
                        ]                                                       
                    )                                                           
                                                                                
                    # Load and prepare data                                     
                    df = pd.read_csv(CSV_PATH)                                  
                    df = df[df.label.isin(["benign",                            
                    "malignant"])].copy()                                       
                    df["label_bin"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                    # skin_tone int as is; missing=-1                           
                                                                                
                    # Cross-validation                                          
                    skf = StratifiedKFold(n_splits=N_FOLDS,                     
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                    gaps = []                                                   
                                                                                
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.label_bin),                      
                    1):                                                         
                        df_train = df.iloc[train_idx]                           
                        df_val = df.iloc[val_idx]                               
                                                                                
                        # Class weights                                         
                        counts =                                                
                    df_train["label_bin"].value_counts().so                     
                    rt_index().values                                           
                        class_weights = torch.tensor(                           
                            [counts.sum() / c for c in                          
                    counts], dtype=torch.float                                  
                        ).to(DEVICE)                                            
                        criterion =                                             
                    nn.CrossEntropyLoss(weight=class_weight                     
                    s)                                                          
                                                                                
                        # Dataloaders                                           
                        ds_train =                                              
                    SkinLesionDataset(df_train, DATA_DIR,                       
                    transform=train_tf)                                         
                        ds_val = SkinLesionDataset(df_val,                      
                    DATA_DIR, transform=val_tf)                                 
                        loader_train = DataLoader(                              
                            ds_train,                                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                        )                                                       
                        loader_val = DataLoader(ds_val,                         
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                                                                                
                        # Model                                                 
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=2).to(                         
                            DEVICE                                              
                        )                                                       
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(EPOCHS_CV):                          
                            for imgs, labels, _ in                              
                    loader_train:                                               
                                imgs, labels =                                  
                    imgs.to(DEVICE), labels.to(DEVICE)                          
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    labels)                                                     
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # Eval                                                  
                        model.eval()                                            
                        y_true, y_prob, skin_tones = [],                        
                    [], []                                                      
                        with torch.no_grad():                                   
                            for imgs, labels, sts in                            
                    loader_val:                                                 
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                probs =                                         
                    torch.softmax(logits, dim=1)[:,                             
                    1].cpu().numpy()                                            
                                y_prob.extend(probs)                            
                                y_true.extend(labels.numpy(                     
                    ))                                                          
                                skin_tones.extend(sts.numpy                     
                    ())                                                         
                        y_true = np.array(y_true)                               
                        y_prob = np.array(y_prob)                               
                        skin_tones = np.array(skin_tones)                       
                                                                                
                        # Overall AUROC                                         
                        auc = roc_auc_score(y_true, y_prob)                     
                        # Skin-tone AUROC gap                                   
                        mask_dark = (skin_tones >= 1) &                         
                    (skin_tones <= 3)                                           
                        mask_light = (skin_tones >= 4) &                        
                    (skin_tones <= 6)                                           
                        gap = 0.0                                               
                        aucs_group = []                                         
                        for mask in [mask_dark,                                 
                    mask_light]:                                                
                            if len(np.unique(y_true[mask]))                     
                    > 1:                                                        
                                aucs_group.append(roc_auc_s                     
                    core(y_true[mask], y_prob[mask]))                           
                        if len(aucs_group) == 2:                                
                            gap = abs(aucs_group[0] -                           
                    aucs_group[1])                                              
                        aucs.append(auc)                                        
                        gaps.append(gap)                                        
                        print(f"Fold {fold}:                                    
                    AUROC={auc:.4f}, skin-tone AUROC                            
                    gap={gap:.4f}")                                             
                                                                                
                    print(f"Mean AUROC: {np.mean(aucs):.4f}                     
                    ± {np.std(aucs):.4f}")                                      
                    print(f"Mean skin-tone AUROC gap:                           
                    {np.mean(gaps):.4f}")                                       
                                                                                
                    # Retrain on full data                                      
                    ds_full = SkinLesionDataset(df,                             
                    DATA_DIR, transform=train_tf)                               
                    loader_full = DataLoader(ds_full,                           
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                    counts =                                                    
                    df["label_bin"].value_counts().sort_ind                     
                    ex().values                                                 
                    class_weights =                                             
                    torch.tensor([counts.sum() / c for c in                     
                    counts], dtype=torch.float).to(                             
                        DEVICE                                                  
                    )                                                           
                    criterion =                                                 
                    nn.CrossEntropyLoss(weight=class_weight                     
                    s)                                                          
                    model_full =                                                
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=2).to(                         
                        DEVICE                                                  
                    )                                                           
                    optimizer =                                                 
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=1e-4)                                                 
                    model_full.train()                                          
                    for epoch in range(EPOCHS_FULL):                            
                        for imgs, labels, _ in loader_full:                     
                            imgs, labels = imgs.to(DEVICE),                     
                    labels.to(DEVICE)                                           
                            preds = model_full(imgs)                            
                            loss = criterion(preds, labels)                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                    torch.save(model_full.state_dict(),                         
                    MODEL_SAVE_PATH)                                            
                    print(f"Final model saved to                                
                    {MODEL_SAVE_PATH}")                                         
                                                                                
                                                                                
                    def predict(model_path: str,                                
                    image_folder: str, batch_size: int =                        
                    32):                                                        
                        """                                                     
                        Load trained model from model_path                      
                    and predict malignancy probabilities                        
                    for all images in image_folder.                             
                        Returns a DataFrame with columns                        
                    ['image_name', 'malignancy_prob'].                          
                        """                                                     
                        # Load model                                            
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False, num_classes=2)                            
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=DEVICE))                             
                        model.to(DEVICE).eval()                                 
                        # Gather images                                         
                        files = [                                               
                            f                                                   
                            for f in                                            
                    os.listdir(image_folder)                                    
                            if f.lower().endswith((".jpg",                      
                    "png", "jpeg"))                                             
                        ]                                                       
                        df_pred =                                               
                    pd.DataFrame({"image_name":                                 
                    [os.path.splitext(f)[0] for f in                            
                    files]})                                                    
                                                                                
                        # Dataset                                               
                        class PredDataset(Dataset):                             
                            def __init__(self, df, folder,                      
                    tf):                                                        
                                self.df, self.folder,                           
                    self.tf = df, folder, tf                                    
                                                                                
                            def __len__(self):                                  
                                return len(self.df)                             
                                                                                
                            def __getitem__(self, idx):                         
                                name =                                          
                    self.df.iloc[idx].image_name                                
                                path =                                          
                    os.path.join(self.folder, name +                            
                    ".jpg")                                                     
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                img = self.tf(img)                              
                                return img, name                                
                                                                                
                        ds = PredDataset(df_pred,                               
                    image_folder, val_tf)                                       
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False,                       
                    num_workers=4)                                              
                        probs = []                                              
                        with torch.no_grad():                                   
                            for imgs, names in loader:                          
                                imgs = imgs.to(DEVICE)                          
                                logits = model(imgs)                            
                                p = torch.softmax(logits,                       
                    dim=1)[:, 1].cpu().numpy()                                  
                                for nm, pv in zip(names,                        
                    p):                                                         
                                    probs.append((nm, pv))                      
                        df_out = pd.DataFrame(probs,                            
                    columns=["image_name",                                      
                    "malignancy_prob"])                                         
                        return df_out                                           
                                                                                
                    Results: The model training and                             
                    evaluation script ran successfully                          
                    without errors. The 5-fold                                  
                    cross-validation showed a consistent                        
                    AUROC around 0.82 with a low skin-tone                      
                    AUROC gap averaging about 0.035,                            
                    indicating fair performance across skin                     
                    tones. The final model was trained on                       
                    the full dataset and saved as                               
                    requested. The predict function is                          
                    implemented to output malignancy                            
                    probabilities for new images.                               
                    Validation Metric: 0.8193                                   
                                                                                
                    -------------------------------                             
                    Design: We fine‐tune a pretrained                           
                    DenseNet121 on the malignant vs benign                      
                    subset using simple augmentations and                       
                    class‐balanced sampling. We perform                         
                    5‐fold stratified cross‐validation to                       
                    estimate the mean AUROC. After                              
                    cross‐validation we retrain on the full                     
                    dataset for a few epochs and save the                       
                    final model weights. A                                      
                    predict(image_folder) function is                           
                    provided to load the saved model and                        
                    return malignancy probabilities for new                     
                    images.                                                     
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # Dataset                                                   
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = torch.tensor(row.y,                         
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    # Transforms                                                
                    train_tf = transforms.Compose(                              
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.RandomHorizontalFlip                     
                    (),                                                         
                            transforms.RandomRotation(10),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                    val_tf = transforms.Compose(                                
                        [                                                       
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,                        
                    0.456, 0.406], [0.229, 0.224, 0.225]),                      
                        ]                                                       
                    )                                                           
                                                                                
                    # Load and prepare data                                     
                    df =                                                        
                    pd.read_csv("./input/mydataset.csv")                        
                    df = df[df.label.isin(["benign",                            
                    "malignant"])].copy()                                       
                    df["y"] = (df.label ==                                      
                    "malignant").astype(int)                                    
                    img_dir = "./input/MyImages"                                
                                                                                
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    skf = StratifiedKFold(n_splits=5,                           
                    shuffle=True, random_state=42)                              
                    aucs = []                                                   
                                                                                
                    # 5-fold CV                                                 
                    for fold, (train_idx, val_idx) in                           
                    enumerate(skf.split(df, df.y)):                             
                        train_df = df.iloc[train_idx]                           
                        val_df = df.iloc[val_idx]                               
                        train_ds = LesionDataset(train_df,                      
                    img_dir, transform=train_tf)                                
                        val_ds = LesionDataset(val_df,                          
                    img_dir, transform=val_tf)                                  
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        model =                                                 
                    models.densenet121(pretrained=True)                         
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model = model.to(device)                                
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                        criterion = nn.BCEWithLogitsLoss()                      
                                                                                
                        # train for few epochs                                  
                        for epoch in range(3):                                  
                            model.train()                                       
                            for x, y in train_loader:                           
                                x, y = x.to(device),                            
                    y.to(device).unsqueeze(1)                                   
                                pred = model(x)                                 
                                loss = criterion(pred, y)                       
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                                                                                
                        # validation                                            
                        model.eval()                                            
                        all_probs, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for x, y in val_loader:                             
                                x = x.to(device)                                
                                logits = model(x)                               
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                all_probs.extend(probs)                         
                                all_labels.extend(y.numpy()                     
                    .flatten())                                                 
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Fold {fold+1} AUROC:                            
                    {auc:.4f}")                                                 
                        aucs.append(auc)                                        
                                                                                
                    print(f"Mean AUROC: {np.mean(aucs):.4f}                     
                    ± {np.std(aucs):.4f}")                                      
                                                                                
                    # Retrain on full data                                      
                    full_ds = LesionDataset(df, img_dir,                        
                    transform=train_tf)                                         
                    full_loader = DataLoader(full_ds,                           
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                    final_model =                                               
                    models.densenet121(pretrained=True)                         
                    final_model.classifier =                                    
                    nn.Linear(final_model.classifier.in_fea                     
                    tures, 1)                                                   
                    final_model = final_model.to(device)                        
                    opt =                                                       
                    torch.optim.Adam(final_model.parameters                     
                    (), lr=1e-4)                                                
                    crit = nn.BCEWithLogitsLoss()                               
                    for epoch in range(3):                                      
                        final_model.train()                                     
                        for x, y in full_loader:                                
                            x, y = x.to(device),                                
                    y.to(device).unsqueeze(1)                                   
                            l = crit(final_model(x), y)                         
                            opt.zero_grad()                                     
                            l.backward()                                        
                            opt.step()                                          
                    os.makedirs("./working", exist_ok=True)                     
                    torch.save(final_model.state_dict(),                        
                    "./working/model_densenet121.pth")                          
                    print("Final model saved to                                 
                    ./working/model_densenet121.pth")                           
                                                                                
                                                                                
                    def predict(image_folder):                                  
                        """                                                     
                        Predict malignancy probabilities                        
                    for all .jpg images in image_folder.                        
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(                                  
                            torch.load("./working/model_den                     
                    senet121.pth", map_location=device)                         
                        )                                                       
                        model = model.to(device).eval()                         
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(image_folder)):                           
                            if not                                              
                    fname.lower().endswith(".jpg"):                             
                                continue                                        
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                            x =                                                 
                    tf(img).unsqueeze(0).to(device)                             
                            with torch.no_grad():                               
                                prob =                                          
                    torch.sigmoid(model(x)).item()                              
                            results.append({"image_name":                       
                    fname, "probability": prob})                                
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # Example usage:                                            
                    # preds = predict('./input/MyImages')                       
                    #                                                           
                    preds.to_csv('./working/submission.csv'                     
                    , index=False)                                              
                                                                                
                    Results: The training script executed                       
                    successfully without errors. The model                      
                    achieved a strong mean AUROC of                             
                    approximately 0.899 with low variance                       
                    across 5-fold cross-validation,                             
                    indicating robust performance. The                          
                    final model was saved properly, and the                     
                    prediction function is correctly                            
                    implemented for inference on new                            
                    images.                                                     
                    Validation Metric: 0.8987                                   
                                                                                
                    -------------------------------                             
                    Design: We filter the dataset to only                       
                    malignant vs benign labels and apply a                      
                    5‐fold stratified split. We fine-tune a                     
                    pretrained MobileNetV2 for 5 epochs per                     
                    fold with simple flips and normalize to                     
                    ImageNet stats, computing AUROC on each                     
                    validation fold. After reporting mean                       
                    and standard deviation of AUROC, we                         
                    retrain on the full dataset for 3                           
                    epochs and save the model to                                
                    `./model.pth`. A                                            
                    `predict(image_folder)` function loads                      
                    this saved model and returns malignancy                     
                    probabilities for each image in a                           
                    DataFrame.                                                  
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # Dataset for skin lesions                                  
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = torch.tensor(row.label,                     
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        running_loss = 0.0                                      
                        for imgs, labels in loader:                             
                            imgs, labels = imgs.to(device),                     
                    labels.to(device)                                           
                            optimizer.zero_grad()                               
                            outputs = model(imgs).view(-1)                      
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        return running_loss /                                   
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        preds = []                                              
                        targets = []                                            
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(device)                          
                                outputs =                                       
                    model(imgs).view(-1)                                        
                                probs =                                         
                    torch.sigmoid(outputs).cpu().numpy()                        
                                preds.extend(probs)                             
                                targets.extend(labels.numpy                     
                    ())                                                         
                        return np.array(targets),                               
                    np.array(preds)                                             
                                                                                
                                                                                
                    def predict(image_folder: str,                              
                    model_path: str = "./model.pth",                            
                    batch_size: int = 32):                                      
                        """                                                     
                        Predict malignancy probabilities                        
                    for all images in image_folder.                             
                        Returns a pandas DataFrame with                         
                    columns ['image_name',                                      
                    'malignancy_prob'].                                         
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # load model                                            
                        model =                                                 
                    models.mobilenet_v2(pretrained=False)                       
                        model.classifier[1] =                                   
                    nn.Linear(model.last_channel, 1)                            
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        # transform                                             
                        transform = transforms.Compose(                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        # gather image files                                    
                        imgs = [f for f in                                      
                    os.listdir(image_folder) if                                 
                    f.lower().endswith((".jpg", ".png"))]                       
                        names = []                                              
                        data = []                                               
                        for fname in imgs:                                      
                            img =                                               
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                            data.append(transform(img))                         
                            names.append(os.path.splitext(f                     
                    name)[0])                                                   
                        dataset =                                               
                    torch.utils.data.TensorDataset(torch.st                     
                    ack(data))                                                  
                        loader = DataLoader(dataset,                            
                    batch_size=batch_size, shuffle=False)                       
                        probs = []                                              
                        with torch.no_grad():                                   
                            for batch in loader:                                
                                inputs =                                        
                    batch[0].to(device)                                         
                                out =                                           
                    model(inputs).view(-1)                                      
                                probs.extend(torch.sigmoid(                     
                    out).cpu().numpy())                                         
                        return pd.DataFrame({"image_name":                      
                    names, "malignancy_prob": probs})                           
                                                                                
                                                                                
                    def main():                                                 
                        # paths                                                 
                        csv_path = "./input/mydataset.csv"                      
                        img_dir = "./input/MyImages"                            
                        # read and filter                                       
                        df = pd.read_csv(csv_path)                              
                        df = df[df.label.isin(["malignant",                     
                    "benign"])].copy()                                          
                        df["label"] =                                           
                    df.label.map({"benign": 0, "malignant":                     
                    1})                                                         
                        X = df.image_name.values                                
                        y = df.label.values                                     
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                                                                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        aucs = []                                               
                                                                                
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        val_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(X, y), 1):                              
                            df_train = df.iloc[train_idx]                       
                            df_val = df.iloc[val_idx]                           
                            train_ds =                                          
                    SkinLesionDataset(df_train, img_dir,                        
                    transform=train_transform)                                  
                            val_ds =                                            
                    SkinLesionDataset(df_val, img_dir,                          
                    transform=val_transform)                                    
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                            # model                                             
                            model =                                             
                    models.mobilenet_v2(pretrained=True)                        
                            model.classifier[1] =                               
                    nn.Linear(model.last_channel, 1)                            
                            model = model.to(device)                            
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                                                                                
                            # train                                             
                            for epoch in range(5):                              
                                train_one_epoch(model,                          
                    train_loader, criterion, optimizer,                         
                    device)                                                     
                            # eval                                              
                            t, p = evaluate(model,                              
                    val_loader, device)                                         
                            auc = roc_auc_score(t, p)                           
                            print(f"Fold {fold} AUROC:                          
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
                            torch.cuda.empty_cache()                            
                                                                                
                        mean_auc = np.mean(aucs)                                
                        std_auc = np.std(aucs)                                  
                        print(f"Mean AUROC: {mean_auc:.4f},                     
                    Std: {std_auc:.4f}")                                        
                                                                                
                        # retrain on full data                                  
                        full_ds = SkinLesionDataset(df,                         
                    img_dir, transform=train_transform)                         
                        full_loader = DataLoader(full_ds,                       
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        model_full =                                            
                    models.mobilenet_v2(pretrained=True)                        
                        model_full.classifier[1] =                              
                    nn.Linear(model_full.last_channel, 1)                       
                        model_full = model_full.to(device)                      
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model_full.parameters(                     
                    ), lr=1e-4)                                                 
                        for epoch in range(3):                                  
                            train_one_epoch(model_full,                         
                    full_loader, criterion, optimizer,                          
                    device)                                                     
                        # save                                                  
                        torch.save(model_full.state_dict(),                     
                    "./model.pth")                                              
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training script executed                       
                    successfully without any errors. The                        
                    model achieved a strong and consistent                      
                    AUROC across the 5 stratified folds,                        
                    with a mean AUROC of 0.8909 and a low                       
                    standard deviation of 0.0047,                               
                    indicating stable performance. The                          
                    training duration was efficient,                            
                    completing well within the time limit.                      
                    Overall, the approach using MobileNetV2                     
                    and standard augmentation appears                           
                    effective for the skin lesion                               
                    classification task.                                        
                    Validation Metric: 0.8909                                   
                                                                                
                    -------------------------------                             
                    Design: We map numeric skin_tone values                     
                    into ‘light’ and ‘dark’ categories                          
                    (treating 1–3 as light, 5–6 as dark,                        
                    and others as medium), update our                           
                    stratification and evaluation logic to                      
                    use these categories, and calculate                         
                    per-group AUROCs correctly. We then                         
                    train using 5‐fold stratified splits on                     
                    the combined label+tone categories,                         
                    print fold and mean metrics, retrain on                     
                    the full set, save the model, and                           
                    provide a predict() function to score                       
                    new images.                                                 
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms,                         
                    models                                                      
                                                                                
                                                                                
                    # Dataset class                                             
                    class LesionDataset(Dataset):                               
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    row.image_name + ".jpg")                                    
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label = torch.tensor(row.y,                         
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
                    # Prediction function                                       
                    def predict(image_folder,                                   
                    model_path="./working/model_densenet121                     
                    .pth", batch_size=32):                                      
                        """                                                     
                        Predict malignancy probabilities                        
                    for all .jpg images in image_folder.                        
                        Returns a DataFrame with columns                        
                    ['image_name','probability'].                               
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        model =                                                 
                    models.densenet121(pretrained=False)                        
                        model.classifier =                                      
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model = model.to(device).eval()                         
                                                                                
                        results = []                                            
                        imgs = [f for f in                                      
                    sorted(os.listdir(image_folder)) if                         
                    f.lower().endswith(".jpg")]                                 
                        for i in range(0, len(imgs),                            
                    batch_size):                                                
                            batch = imgs[i : i +                                
                    batch_size]                                                 
                            tensors = []                                        
                            for fname in batch:                                 
                                img =                                           
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                tensors.append(tf(img))                         
                            x =                                                 
                    torch.stack(tensors).to(device)                             
                            with torch.no_grad():                               
                                probs =                                         
                    torch.sigmoid(model(x)).cpu().numpy().f                     
                    latten()                                                    
                            for fname, p in zip(batch,                          
                    probs):                                                     
                                results.append({"image_name                     
                    ": fname, "probability": p})                                
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    def main():                                                 
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        # Transforms                                            
                        train_tf = transforms.Compose(                          
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    0),                                                         
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                        val_tf = transforms.Compose(                            
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.ToTensor(),                          
                                transforms.Normalize([0.485                     
                    , 0.456, 0.406], [0.229, 0.224,                             
                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # Load data                                             
                        df =                                                    
                    pd.read_csv("./input/mydataset.csv")                        
                        df = df[df.label.isin(["benign",                        
                    "malignant"])].copy()                                       
                        df["y"] = (df.label ==                                  
                    "malignant").astype(int)                                    
                        if "skin_tone" not in df.columns:                       
                            raise ValueError(                                   
                                "Dataset must contain a                         
                    'skin_tone' column for fairness                             
                    stratification."                                            
                            )                                                   
                                                                                
                        # Map numeric skin_tone to                              
                    categories                                                  
                        def tone_cat(x):                                        
                            if x in [1, 2, 3]:                                  
                                return "light"                                  
                            elif x in [5, 6]:                                   
                                return "dark"                                   
                            else:                                               
                                return "medium"                                 
                                                                                
                        df["tone_cat"] =                                        
                    df.skin_tone.apply(tone_cat)                                
                                                                                
                        # Stratification key                                    
                        df["stratify"] =                                        
                    df["y"].astype(str) + "_" +                                 
                    df["tone_cat"]                                              
                                                                                
                        img_dir = "./input/MyImages"                            
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        overall_aucs, light_aucs, dark_aucs                     
                    = [], [], []                                                
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df.stratify)):                      
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                            train_ds =                                          
                    LesionDataset(train_df, img_dir,                            
                    transform=train_tf)                                         
                            val_ds = LesionDataset(val_df,                      
                    img_dir, transform=val_tf)                                  
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4)                                
                            val_loader = DataLoader(val_ds,                     
                    batch_size=32, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                            model =                                             
                    models.densenet121(pretrained=True)                         
                            model.classifier =                                  
                    nn.Linear(model.classifier.in_features,                     
                    1)                                                          
                            model = model.to(device)                            
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                                                                                
                            # Train                                             
                            for epoch in range(3):                              
                                model.train()                                   
                                for x, y in train_loader:                       
                                    x, y = x.to(device),                        
                    y.to(device).unsqueeze(1)                                   
                                    pred = model(x)                             
                                    loss = criterion(pred,                      
                    y)                                                          
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            # Validate                                          
                            model.eval()                                        
                            all_probs, all_labels = [], []                      
                            with torch.no_grad():                               
                                for x, y in val_loader:                         
                                    x = x.to(device)                            
                                    logits = model(x)                           
                                    probs =                                     
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                    all_probs.extend(probs)                     
                                    all_labels.extend(y.num                     
                    py().flatten())                                             
                            tones = val_df.tone_cat.values                      
                            auc_all =                                           
                    roc_auc_score(all_labels, all_probs)                        
                            light_mask = tones == "light"                       
                            dark_mask = tones == "dark"                         
                            auc_light = (                                       
                                roc_auc_score(                                  
                                    np.array(all_labels)[li                     
                    ght_mask],                                                  
                    np.array(all_probs)[light_mask]                             
                                )                                               
                                if light_mask.sum() > 0                         
                                else np.nan                                     
                            )                                                   
                            auc_dark = (                                        
                                roc_auc_score(                                  
                                    np.array(all_labels)[da                     
                    rk_mask],                                                   
                    np.array(all_probs)[dark_mask]                              
                                )                                               
                                if dark_mask.sum() > 0                          
                                else np.nan                                     
                            )                                                   
                            gap = (                                             
                                abs(auc_light - auc_dark)                       
                                if not np.isnan(auc_light)                      
                    and not np.isnan(auc_dark)                                  
                                else np.nan                                     
                            )                                                   
                                                                                
                            print(                                              
                                f"Fold {fold+1} AUROC:                          
                    overall={auc_all:.4f},                                      
                    light={auc_light:.4f},                                      
                    dark={auc_dark:.4f}, gap={gap:.4f}"                         
                            )                                                   
                            overall_aucs.append(auc_all)                        
                            light_aucs.append(auc_light)                        
                            dark_aucs.append(auc_dark)                          
                                                                                
                        print(                                                  
                            f"Mean AUROC:                                       
                    overall={np.nanmean(overall_aucs):.4f}±                     
                    {np.nanstd(overall_aucs):.4f}, "                            
                            f"light={np.nanmean(light_aucs)                     
                    :.4f},                                                      
                    dark={np.nanmean(dark_aucs):.4f}, "                         
                            f"gap={abs(np.nanmean(light_auc                     
                    s)-np.nanmean(dark_aucs)):.4f}"                             
                        )                                                       
                                                                                
                        # Retrain on full data                                  
                        full_ds = LesionDataset(df,                             
                    img_dir, transform=train_tf)                                
                        full_loader = DataLoader(full_ds,                       
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        final_model =                                           
                    models.densenet121(pretrained=True)                         
                        final_model.classifier =                                
                    nn.Linear(final_model.classifier.in_fea                     
                    tures, 1)                                                   
                        final_model =                                           
                    final_model.to(device)                                      
                        opt =                                                   
                    torch.optim.Adam(final_model.parameters                     
                    (), lr=1e-4)                                                
                        crit = nn.BCEWithLogitsLoss()                           
                        for epoch in range(3):                                  
                            final_model.train()                                 
                            for x, y in full_loader:                            
                                x, y = x.to(device),                            
                    y.to(device).unsqueeze(1)                                   
                                l = crit(final_model(x), y)                     
                                opt.zero_grad()                                 
                                l.backward()                                    
                                opt.step()                                      
                                                                                
                        os.makedirs("./working",                                
                    exist_ok=True)                                              
                        save_path =                                             
                    "./working/model_densenet121.pth"                           
                        torch.save(final_model.state_dict()                     
                    , save_path)                                                
                        print(f"Final model saved to                            
                    {save_path}")                                               
                                                                                
                        # If there were a test folder, we                       
                    could generate submission.csv:                              
                        test_folder = "./input/test_images"                     
                        if os.path.isdir(test_folder):                          
                            sub = predict(test_folder,                          
                    model_path=save_path)                                       
                            sub.to_csv("./working/submissio                     
                    n.csv", index=False)                                        
                            print("Submission saved to                          
                    ./working/submission.csv")                                  
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
                    Results: The training and evaluation                        
                    script ran successfully without errors.                     
                    The model achieved a strong overall                         
                    AUROC of approximately 0.901 with a low                     
                    gap in AUROC between light and dark                         
                    skin tones (0.0131), indicating fair                        
                    performance across skin tones. This                         
                    suggests the model is both accurate and                     
                    fair in malignancy classification on                        
                    the dataset provided. The final model                       
                    was saved correctly for inference.                          
                    Validation Metric: 0.9009                                   
                                                                                
                    -------------------------------                             
                    Design: I propose to balance skin-tone                      
                    representation during training by using                     
                    a WeightedRandomSampler that                                
                    oversamples underrepresented tones. For                     
                    each fold, compute sample weights as                        
                    the inverse frequency of each tone                          
                    category in the training split, and                         
                    pass a WeightedRandomSampler to the                         
                    DataLoader instead of shuffle. This                         
                    will encourage the model to learn                           
                    equally from light, medium, and dark                        
                    skin tones and reduce AUROC gap without                     
                    altering the overall architecture or                        
                    training pipeline.                                          
                    Code: import os                                             
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
