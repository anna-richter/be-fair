                                for x, y in train_loader:                       
                                    x, y = x.to(device),                        
                    y.to(device).unsqueeze(1)                                   
                                    loss =                                      
                    criterion(model(x), y)                                      
                                    optimizer.zero_grad()                       
                                    loss.backward()                             
                                    optimizer.step()                            
                                                                                
                            model.eval()                                        
                            all_probs, all_labels = [], []                      
                            with torch.no_grad():                               
                                for x, y in val_loader:                         
                                    x = x.to(device)                            
                                    logits1 = model(x)                          
