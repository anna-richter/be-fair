                    full_loader, criterion, optimizer,                          
                    device)                                                     
                        # save                                                  
                        torch.save(model_full.state_dict()                      
                    , "./model.pth")                                            
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
