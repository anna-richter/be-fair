                        for i in range(0, len(imgs),                            
                    batch_size):                                                
                            batch = imgs[i : i +                                
                    batch_size]                                                 
                            tensors = []                                        
                            for fname in batch:                                 
                                img =                                           
                    Image.open(os.path.join(image_folder,                       
                    fname)).convert("RGB")                                      
                                tensors.append(tf(img))                         
                            x =                                                 
                    torch.stack(tensors).to(device)                             
                            with torch.no_grad():                               
                                probs =                                         
