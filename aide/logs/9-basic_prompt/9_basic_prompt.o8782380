                    # Task description                                          
                                                                                
                    ## Task goal                                                
                                                                                
                    I am a dermatologist, I have collected                      
                    data about skin lesions with my                             
                    colleagues over the last years. Now I                       
                    want to train an AI on this dataset                         
                    that can differentiate malignant and                        
                    benign lesions. The idea is that I                          
                    upload a folder with new images and the                     
                    model returns the probability between 0                     
                    and 1 for each image that the image                         
                    shows a malignant skin lesion.                              
                                                                                
                    ## Task evaluation                                          
                                                                                
                    Area under the receiver operator curve                      
                    (AUROC)                                                     
                                                                                
                    # Previous (buggy) implementation                           
                                                                                
                    ```python                                                   
                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    import torchvision.transforms as T                          
                    import torchvision.models as models                         
                    from torch.cuda.amp import autocast,                        
                    GradScaler                                                  
                                                                                
                                                                                
                    class SkinDataset(Dataset):                                 
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.loc[idx]                              
                            path =                                              
                    os.path.join(self.img_dir,                                  
                    row["image_name"] + ".jpg")                                 
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            x = self.transform(img)                             
                            y = torch.tensor(row["target"],                     
                    dtype=torch.float32)                                        
                            return x, y                                         
                                                                                
                                                                                
                    def predict(model_paths, image_paths,                       
                    transform, device):                                         
                        """                                                     
                        Predict average probability of                          
                    malignancy using an ensemble of models.                     
                        Args:                                                   
                            model_paths: list of filesystem                     
                    paths to saved PyTorch model .pt files.                     
                            image_paths: list of image file                     
                    paths.                                                      
                            transform: torchvision                              
                    transform to apply.                                         
                            device: torch.device to run                         
                    inference on.                                               
                        Returns:                                                
                            dict mapping image_path ->                          
                    averaged probability of malignancy.                         
                        """                                                     
                        models_list = []                                        
                        for mp in model_paths:                                  
                            m =                                                 
                    models.mobilenet_v3_small(pretrained=Fa                     
                    lse)                                                        
                            # replace last layer                                
                            m.classifier[3] =                                   
                    nn.Linear(m.classifier[3].in_features,                      
                    1)                                                          
                            m.load_state_dict(torch.load(mp                     
                    , map_location=device))                                     
                            m.to(device)                                        
                            m.eval()                                            
                            models_list.append(m)                               
                                                                                
                        results = {}                                            
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                probs = []                                      
                                for m in models_list:                           
                                    logits = m(x)                               
                                    probs.append(torch.sigm                     
                    oid(logits).item())                                         
                                results[path] =                                 
                    float(np.mean(probs))                                       
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
                        MODEL_DIR = "./working/models"                          
                        os.makedirs(MODEL_DIR,                                  
                    exist_ok=True)                                              
                                                                                
                        # Read and prepare                                      
                        df = pd.read_csv(DATA_CSV)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                                                                                
                        # Transforms                                            
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        transform = T.Compose(                                  
                            [                                                   
                                T.Resize((224, 224)),                           
                                T.ToTensor(),                                   
                                T.Normalize(mean=mean,                          
                    std=std),                                                   
                            ]                                                   
                        )                                                       
                                                                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df, df["target"])):                     
                            train_df = df.iloc[train_idx]                       
                            val_df = df.iloc[val_idx]                           
                                                                                
                            train_ds =                                          
                    SkinDataset(train_df, IMG_DIR,                              
                    transform)                                                  
                            val_ds = SkinDataset(val_df,                        
                    IMG_DIR, transform)                                         
                            train_loader = DataLoader(                          
                                train_ds, batch_size=32,                        
                    shuffle=True, num_workers=4,                                
                    pin_memory=True                                             
                            )                                                   
                            val_loader = DataLoader(                            
                                val_ds, batch_size=32,                          
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                            )                                                   
                                                                                
                            # MobileNetV3 smallest for                          
                    speed                                                       
                            model =                                             
                    models.mobilenet_v3_small(pretrained=Tr                     
                    ue)                                                         
                            model.classifier[3] =                               
                    nn.Linear(model.classifier[3].in_featur                     
                    es, 1)                                                      
                            model = model.to(device)                            
                                                                                
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            scaler = GradScaler()                               
                                                                                
                            best_auc = 0.0                                      
                            best_path =                                         
                    os.path.join(MODEL_DIR,                                     
                    f"fold_{fold}.pt")                                          
                                                                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.to(device).unsqueeze(1)                              
                                    optimizer.zero_grad()                       
                                    with autocast():                            
                                        logits =                                
                    model(imgs)                                                 
                                        loss =                                  
                    criterion(logits, labels)                                   
                                    scaler.scale(loss).back                     
                    ward()                                                      
                                    scaler.step(optimizer)                      
                                    scaler.update()                             
                                                                                
                                # Validation                                    
                                model.eval()                                    
                                all_logits, all_labels =                        
                    [], []                                                      
                                with torch.no_grad():                           
                                    for imgs, labels in                         
                    val_loader:                                                 
                                        imgs =                                  
                    imgs.to(device)                                             
                                        logits =                                
                    model(imgs)                                                 
                                        probs =                                 
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                                        all_logits.extend(p                     
                    robs)                                                       
                                        all_labels.extend(l                     
                    abels.numpy())                                              
                                auc =                                           
                    roc_auc_score(all_labels, all_logits)                       
                                print(f"Fold {fold} Epoch                       
                    {epoch+1}/3 val AUROC: {auc:.4f}")                          
                                if auc > best_auc:                              
                                    best_auc = auc                              
                                    torch.save(model.state_                     
                    dict(), best_path)                                          
                                                                                
                            print(f"Fold {fold} best AUROC:                     
                    {best_auc:.4f}")                                            
                            aucs.append(best_auc)                               
                                                                                
                        mean_auc = np.mean(aucs)                                
                        std_auc = np.std(aucs)                                  
                        print(f"5-fold CV AUROC:                                
                    mean={mean_auc:.4f},                                        
                    std={std_auc:.4f}")                                         
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
