                                if auc > best_auc:                              
                                    best_auc = auc                              
                                    torch.save(model.state                      
                    _dict(), best_path)                                         
                                                                                
                            print(f"Fold {fold} best                            
                    AUROC: {best_auc:.4f}")                                     
                            aucs.append(best_auc)                               
                                                                                
                        mean_auc = np.mean(aucs)                                
                        std_auc = np.std(aucs)                                  
                        print(f"5-fold CV AUROC:                                
                    mean={mean_auc:.4f},                                        
                    std={std_auc:.4f}")                                         
                                                                                
