                                for m in models_list:                           
                                    logits = m(x)                               
                                    probs.append(torch.sig                      
                    moid(logits).item())                                        
                                results[path] =                                 
                    float(np.mean(probs))                                       
                        return results                                          
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
                        MODEL_DIR = "./working/models"                          
                        os.makedirs(MODEL_DIR,                                  
                    exist_ok=True)                                              
                                                                                
                        # Read and prepare                                      
                        df = pd.read_csv(DATA_CSV)                              
                        df["target"] = (df["label"] ==                          
                    "malignant").astype(int)                                    
                                                                                
                        # Transforms                                            
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        transform = T.Compose([                                 
                            T.Resize((224, 224)),                               
                            T.ToTensor(),                                       
                            T.Normalize(mean=mean,                              
                    std=std),                                                   
                        ])                                                      
                                                                                
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        skf = StratifiedKFold(n_splits=5,                       
                    shuffle=True, random_state=42)                              
                        aucs = []                                               
                                                                                
                        for fold, (train_idx, val_idx) in                       
                    enumerate(skf.split(df,                                     
                    df["target"])):                                             
