                    {epoch+1}/{epochs}, Loss:                                   
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation with TTA                                   
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels in                                 
                    val_loader:                                                 
                                imgs = imgs.to(DEVICE)                          
                                logits1 =                                       
                    model(imgs).squeeze(1)                                      
                                logits2 =                                       
                    model(torch.flip(imgs,                                      
                    dims=[3])).squeeze(1)                                       
                                avg_logits = (logits1 +                         
                    logits2) / 2                                                
                                probs =                                         
                    torch.sigmoid(avg_logits).cpu().numpy(                      
                    )                                                           
                                all_probs.extend(probs.tol                      
                    ist())                                                      
                                all_labels.extend(labels.n                      
                    umpy().tolist())                                            
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC with TTA:                      
                    {auc:.4f}")                                                 
                                                                                
