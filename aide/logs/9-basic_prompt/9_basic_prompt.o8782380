                            else:                                               
                                img =                                           
                    transforms.ToTensor()(img)                                  
                            return img,                                         
                    os.path.splitext(fname)[0]                                  
                                                                                
                                                                                
                    def predict(                                                
                        image_folder: str,                                      
                        model: nn.Module,                                       
                        device: torch.device,                                   
                        transform=None,                                         
                        batch_size=32,                                          
                        num_workers=4,                                          
                    ) -> pd.DataFrame:                                          
                        """                                                     
                        Predict malignant probabilities on                      
                    all JPGs in `image_folder` using                            
