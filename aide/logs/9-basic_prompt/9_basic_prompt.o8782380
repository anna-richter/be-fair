                    # MixUp helper                                              
                    def mixup_data(x, y, alpha=0.4):                            
                        '''Returns mixed inputs, pairs of                       
                    targets, and lambda'''                                      
                        if alpha > 0:                                           
                            lam = np.random.beta(alpha,                         
                    alpha)                                                      
                        else:                                                   
                            lam = 1.0                                           
                        batch_size = x.size()[0]                                
                        if torch.cuda.is_available():                           
                            index =                                             
                    torch.randperm(batch_size).cuda()                           
                        else:                                                   
                            index =                                             
                    torch.randperm(batch_size)                                  
                        mixed_x = lam * x + (1 - lam) *                         
                    x[index, :]                                                 
                        y_a, y_b = y, y[index]                                  
                        return mixed_x, y_a, y_b, lam                           
                                                                                
