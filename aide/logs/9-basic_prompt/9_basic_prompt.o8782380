                    SkinDataset(train_df, IMG_DIR,                              
                    transform)                                                  
                            val_ds = SkinDataset(val_df,                        
                    IMG_DIR, transform)                                         
                            train_loader =                                      
                    DataLoader(train_ds, batch_size=32,                         
                    shuffle=True, num_workers=4,                                
                    pin_memory=True)                                            
                            val_loader =                                        
                    DataLoader(val_ds, batch_size=32,                           
                    shuffle=False, num_workers=4,                               
                    pin_memory=True)                                            
                                                                                
                            # MobileNetV3 smallest for                          
                    speed                                                       
                            model =                                             
                    models.mobilenet_v3_small(pretrained=T                      
                    rue)                                                        
                            model.classifier[3] =                               
                    nn.Linear(model.classifier[3].in_featu                      
                    res, 1)                                                     
                            model = model.to(device)                            
                                                                                
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    torch.optim.Adam(model.parameters(),                        
                    lr=1e-4)                                                    
                            scaler = GradScaler()                               
                                                                                
                            best_auc = 0.0                                      
                            best_path =                                         
                    os.path.join(MODEL_DIR,                                     
                    f"fold_{fold}.pt")                                          
                                                                                
                            for epoch in range(3):                              
                                model.train()                                   
                                for imgs, labels in                             
                    train_loader:                                               
                                    imgs = imgs.to(device)                      
                                    labels =                                    
                    labels.to(device).unsqueeze(1)                              
                                    optimizer.zero_grad()                       
                                    with autocast():                            
                                        logits =                                
                    model(imgs)                                                 
                                        loss =                                  
                    criterion(logits, labels)                                   
                                    scaler.scale(loss).bac                      
                    kward()                                                     
                                    scaler.step(optimizer)                      
                                    scaler.update()                             
                                                                                
