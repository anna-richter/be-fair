                    mpy().tolist())                                             
                        auc = roc_auc_score(all_labels,                         
                    all_probs)                                                  
                        print(f"Validation AUROC:                               
                    {auc:.4f}")                                                 
                                                                                
                        # Save test predictions                                 
                        preds_df = predict(IMG_DIR, model,                      
                    DEVICE, val_tf, batch_size=32,                              
                    num_workers=4)                                              
                        os.makedirs("./working",                                
