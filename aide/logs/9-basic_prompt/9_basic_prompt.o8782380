                            device: torch.device.                               
                        Returns:                                                
                            dict mapping image_path ->                          
                    probability of malignancy.                                  
                        """                                                     
                        model.eval()                                            
                        probs = {}                                              
                        with torch.no_grad():                                   
                            for path in image_paths:                            
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                x =                                             
                    transform(img).unsqueeze(0).to(device)                      
                                logit = model(x)                                
                                p =                                             
                    torch.sigmoid(logit).item()                                 
                                probs[path] = p                                 
                        return probs                                            
                                                                                
                                                                                
                    def main():                                                 
                        # Paths                                                 
                        DATA_CSV = "./input/mydataset.csv"                      
                        IMG_DIR = "./input/MyImages"                            
