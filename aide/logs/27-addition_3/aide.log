Design: We will fine-tune an EfficientNet-B0 pretrained on ImageNet for binary classification, mapping “malignant” to 1 and others to 0. To promote fairness, we compute sample weights inversely proportional to each skin_tone’s frequency and apply them in the loss. We perform stratified 5-fold cross‐validation on the malignancy label to estimate AUROC, then retrain on the full dataset and save the final model. A predict(folder_path) function loads the saved model and returns malignancy probabilities for new images.
Code: import os
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
import timm


# Dataset class
class LesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        x = self.transform(img)
        y = torch.tensor(row.binary_label, dtype=torch.float32)
        w = torch.tensor(row.weight, dtype=torch.float32)
        return x, y, w


# Train & validate for one fold
def train_validate(train_df, val_df, img_dir, device):
    # transforms
    train_tfms = transforms.Compose(
        [
            transforms.RandomResizedCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ColorJitter(),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    val_tfms = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    train_ds = LesionDataset(train_df, img_dir, train_tfms)
    val_ds = LesionDataset(val_df, img_dir, val_tfms)
    train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)

    model = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1).to(
        device
    )
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss(reduction="none")

    for epoch in range(3):
        model.train()
        for x, y, w in train_loader:
            x, y, w = x.to(device), y.to(device), w.to(device)
            logits = model(x).squeeze(1)
            loss = criterion(logits, y)
            loss = (loss * w).mean()
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    # validate
    model.eval()
    ys, ps = [], []
    with torch.no_grad():
        for x, y, _ in val_loader:
            x = x.to(device)
            logits = model(x).squeeze(1)
            probs = torch.sigmoid(logits).cpu().numpy()
            ys.append(y.numpy())
            ps.append(probs)
    ys = np.concatenate(ys)
    ps = np.concatenate(ps)
    auc = roc_auc_score(ys, ps)
    return auc


# Main
def main():
    device = "cuda" if torch.cuda.is_available() else "cpu"
    df = pd.read_csv("./input/mydataset.csv")
    # binary label
    df["binary_label"] = (df.label == "malignant").astype(int)
    # sample weights by skin_tone
    freq = df.skin_tone.value_counts().to_dict()
    inv = {k: 1 / v for k, v in freq.items()}
    inv_mean = np.mean(list(inv.values()))
    df["weight"] = df.skin_tone.map(lambda t: inv[t] / inv_mean)
    # 5-fold CV
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for train_idx, val_idx in skf.split(df, df.binary_label):
        train_df = df.iloc[train_idx]
        val_df = df.iloc[val_idx]
        auc = train_validate(train_df, val_df, "./input/MyImages", device)
        aucs.append(auc)
        print(f"Fold AUROC: {auc:.4f}")
    mean_auc, std_auc = np.mean(aucs), np.std(aucs)
    print(f"Mean CV AUROC: {mean_auc:.4f} ± {std_auc:.4f}")
    # retrain on full data
    full_auc = train_validate(df, df, "./input/MyImages", device)  # quick pass
    # save final model
    final_model = timm.create_model(
        "efficientnet_b0", pretrained=True, num_classes=1
    ).to(device)
    optimizer = torch.optim.Adam(final_model.parameters(), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss(reduction="none")
    tfms = transforms.Compose(
        [
            transforms.RandomResizedCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ColorJitter(),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    loader = DataLoader(
        LesionDataset(df, "./input/MyImages", tfms),
        batch_size=32,
        shuffle=True,
        num_workers=4,
    )
    for epoch in range(3):
        final_model.train()
        for x, y, w in loader:
            x, y, w = x.to(device), y.to(device), w.to(device)
            logits = final_model(x).squeeze(1)
            loss = criterion(logits, y)
            loss = (loss * w).mean()
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    os.makedirs("./working", exist_ok=True)
    torch.save(final_model.state_dict(), "./working/model.pt")
    print("Final model saved to ./working/model.pt")


# Prediction function
def predict(folder_path, model_path="./working/model.pt", batch_size=32, device="cpu"):
    """
    Load the trained model and predict malignancy probabilities for all .jpg images in folder_path.
    Returns a DataFrame with columns: image_name, malignancy_probability.
    """
    tfm = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    model = timm.create_model("efficientnet_b0", pretrained=False, num_classes=1).to(
        device
    )
    model.load_state_dict(torch.load(model_path, map_location=device))
    model.eval()
    files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    ds = []
    for f in files:
        img = Image.open(os.path.join(folder_path, f)).convert("RGB")
        x = tfm(img)
        ds.append((f, x))
    loader = DataLoader([x for _, x in ds], batch_size=batch_size, shuffle=False)
    probs = []
    with torch.no_grad():
        for batch in loader:
            batch = batch.to(device)
            logits = model(batch).squeeze(1)
            probs.extend(torch.sigmoid(logits).cpu().numpy())
    results = pd.DataFrame(
        {
            "image_name": [os.path.splitext(f)[0] for f, _ in ds],
            "malignancy_probability": probs,
        }
    )
    return results


if __name__ == "__main__":
    main()

