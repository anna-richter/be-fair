            logit2 = model(torch.flip(img_t, dims=[3])).squeeze(1)
            prob = torch.sigmoid((logit1 + logit2) / 2).item()
        results.append({"image_name": fname, "probability": prob})
    return pd.DataFrame(results)

if __name__ == "__main__":
