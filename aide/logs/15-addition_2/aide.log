        model = pickle.load(f)
    img_files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    preds = []
    for i in range(0, len(img_files), BATCH_SIZE):
        batch = img_files[i:i+BATCH_SIZE]
        imgs_o, imgs_f = [], []
        for fname in batch:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            imgs_o.append(base_transform(img))
            imgs_f.append(flip_transform(img))
        bo = torch.stack(imgs_o).to(device)
        bf = torch.stack(imgs_f).to(device)
        with torch.no_grad():
            e_o = feature_model(bo).cpu().numpy()
            e_f = feature_model(bf).cpu().numpy()
        e = (e_o + e_f)/2.0
        probs = model.predict_proba(e)[:,1]
        preds.extend(list(zip(batch, probs)))
    return pd.DataFrame(preds, columns=["image_name", "malignancy_probability"])

