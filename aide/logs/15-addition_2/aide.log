    ds = SkinLesionDataset(df, IMG_DIR, transform)
    loader = DataLoader(
        ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS
    )
    feats, tones, labels = [], [], []
    with torch.no_grad():
        for imgs, tns, lbs in loader:
            imgs = imgs.to(device)
            emb = feat_model(imgs).cpu().numpy()
            feats.append(emb)
            tones.append(tns.numpy())
            labels.append(lbs.numpy())
    return np.vstack(feats), np.concatenate(tones), np.concatenate(labels)


# Extract embeddings
print("Extracting original embeddings...")
feats_o, tones, labels = extract_embeddings(base_tf)
print("Extracting horizontal flip embeddings...")
feats_h, _, _ = extract_embeddings(hflip_tf)
print("Extracting vertical flip embeddings...")
feats_v, _, _ = extract_embeddings(vflip_tf)

# 5-fold CV with triple-TTA and sample weighting
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
aucs, gaps = [], []
for tr_idx, val_idx in skf.split(feats_o, labels):
    Xtr, Xvo, Xvh, Xvv = (
        feats_o[tr_idx],
        feats_o[val_idx],
        feats_h[val_idx],
        feats_v[val_idx],
    )
    Xval = (Xvo + Xvh + Xvv) / 3.0
    ytr, yval = labels[tr_idx], labels[val_idx]
    tones_tr, tones_val = tones[tr_idx], tones[val_idx]
    # compute sample weights to balance skin tone groups
    sw_tr = compute_sample_weight("balanced", tones_tr)
    clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
    clf.fit(feats_o[tr_idx], ytr, sample_weight=sw_tr)
    preds = clf.predict_proba(Xval)[:, 1]
    auc = roc_auc_score(yval, preds)
    aucs.append(auc)
    # fairness gap
    m_light = (tones_val > 0) & (tones_val <= 3)
    m_dark = tones_val >= 5
    if m_light.sum() > 0 and m_dark.sum() > 0:
        auc_l = roc_auc_score(yval[m_light], preds[m_light])
        auc_d = roc_auc_score(yval[m_dark], preds[m_dark])
        gaps.append(abs(auc_l - auc_d))
    else:
        gaps.append(0.0)

print(f"CV AUROC with H+V Flip TTA & skin-tone weighting: {np.mean(aucs):.4f}")
print(f"Avg AUROC gap (light vs dark): {np.mean(gaps):.4f}")

# Retrain final model on full data with weights
sw_all = compute_sample_weight("balanced", tones)
final_clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
final_clf.fit(feats_o, labels, sample_weight=sw_all)
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
with open(MODEL_PATH, "wb") as f:
    pickle.dump(final_clf, f)


def predict(folder_path):
    """
    Predict malignancy probability using triple TTA (orig, horizontal, vertical flips).
    Args:
      folder_path (str): Directory containing .jpg images.
    Returns:
      pd.DataFrame with columns ['image_name','malignancy_probability'].
    """
    with open(MODEL_PATH, "rb") as f:
        model = pickle.load(f)
    imgs = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    results = []
    for i in range(0, len(imgs), BATCH_SIZE):
        batch = imgs[i : i + BATCH_SIZE]
        to, th, tv = [], [], []
        for fn in batch:
            img = Image.open(os.path.join(folder_path, fn)).convert("RGB")
            to.append(base_tf(img))
            th.append(hflip_tf(img))
            tv.append(vflip_tf(img))
        bo = torch.stack(to).to(device)
        bh = torch.stack(th).to(device)
        bv = torch.stack(tv).to(device)
        with torch.no_grad():
            eo = feat_model(bo).cpu().numpy()
            eh = feat_model(bh).cpu().numpy()
            ev = feat_model(bv).cpu().numpy()
        E = (eo + eh + ev) / 3.0
        probs = model.predict_proba(E)[:, 1]
        results.extend(zip(batch, probs))
    return pd.DataFrame(results, columns=["image_name", "malignancy_probability"])


# Optionally produce submission if a test folder exists
test_folder = "./input/test_images"
if os.path.isdir(test_folder):
    df_sub = predict(test_folder)
    os.makedirs(os.path.dirname(SUBMISSION_PATH), exist_ok=True)
    df_sub.to_csv(SUBMISSION_PATH, index=False)
    print(f"Saved submission to {SUBMISSION_PATH}")

