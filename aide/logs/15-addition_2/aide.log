import os
import numpy as np
import pandas as pd
from PIL import Image
import torch
import torch.nn as nn
from torchvision import models, transforms
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import xgboost as xgb
import joblib

# 1. Load metadata and prepare labels
df = pd.read_csv("./input/mydataset.csv")
# binary label: malignant=1, others=0
df["y"] = (df["label"] == "malignant").astype(int)
image_names = df["image_name"].values
skin_tones = df["skin_tone"].values
labels = df["y"].values
N = len(df)

# 2. Feature extraction using DenseNet121
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = models.densenet121(pretrained=True)
# build feature extractor
feature_extractor = (
    nn.Sequential(model.features, nn.ReLU(inplace=True), nn.AdaptiveAvgPool2d((1, 1)))
    .to(device)
    .eval()
)

tfms = transforms.Compose(
    [
        transforms.Resize(224),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


class ImgDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, i):
        img = Image.open(self.paths[i]).convert("RGB")
        return self.transform(img)


# prepare all image paths
img_dir = "./input/MyImages"
paths = [os.path.join(img_dir, f"{n}.jpg") for n in image_names]

# extract features in batches
batch_size = 32
ds = ImgDataset(paths, tfms)
dl = DataLoader(ds, batch_size=batch_size, num_workers=4, pin_memory=True)
feats = []
with torch.no_grad():
    for batch in dl:
        b = batch.to(device)
        out = feature_extractor(b).view(b.size(0), -1)
        feats.append(out.cpu().numpy())
X = np.vstack(feats)

# 3. compute sample weights to balance light and dark skin-tone groups
mask_light = skin_tones <= 3
mask_dark = skin_tones >= 5
n_light = mask_light.sum()
n_dark = mask_dark.sum()
w_light = N / (2 * n_light) if n_light > 0 else 1.0
w_dark = N / (2 * n_dark) if n_dark > 0 else 1.0
sample_weights = np.ones(N, dtype=float)
sample_weights[mask_light] = w_light
sample_weights[mask_dark] = w_dark

# 4. 5-fold stratified CV with XGBoost
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
all_preds = np.zeros(N)
gaps = []
for train_idx, val_idx in skf.split(X, labels):
    clf = xgb.XGBClassifier(
        n_estimators=100,
        use_label_encoder=False,
        eval_metric="logloss",
        random_state=42,
    )
    clf.fit(X[train_idx], labels[train_idx], sample_weight=sample_weights[train_idx])
    proba = clf.predict_proba(X[val_idx])[:, 1]
    all_preds[val_idx] = proba
    # compute AUROC for light/dark on this fold
    y_val = labels[val_idx]
    st_val = skin_tones[val_idx]
    mask_l = st_val <= 3
    mask_d = st_val >= 5
    auc_l = roc_auc_score(y_val[mask_l], proba[mask_l]) if mask_l.sum() > 0 else np.nan
    auc_d = roc_auc_score(y_val[mask_d], proba[mask_d]) if mask_d.sum() > 0 else np.nan
    if not np.isnan(auc_l) and not np.isnan(auc_d):
        gaps.append(abs(auc_l - auc_d))
# overall and gap
overall_auc = roc_auc_score(labels, all_preds)
avg_gap = np.mean(gaps) if gaps else np.nan
print(f"CV Overall AUROC: {overall_auc:.4f}")
print(f"Avg AUROC gap (light vs dark): {avg_gap:.4f}")

# 5. retrain on full data and save model & features
final_clf = xgb.XGBClassifier(
    n_estimators=100, use_label_encoder=False, eval_metric="logloss", random_state=42
)
final_clf.fit(X, labels, sample_weight=sample_weights)
joblib.dump(final_clf, "./working/final_xgb_model.pkl")
joblib.dump(feature_extractor.cpu(), "./working/feature_extractor.pkl")


# 6. prediction function
def predict(folder_path):
    """
    Predict malignancy probabilities for all .jpg images in folder_path.
    Returns a dict {image_name: probability}.
    """
    # load models
    fe = joblib.load("./working/feature_extractor.pkl").to(device).eval()
    clf = joblib.load("./working/final_xgb_model.pkl")
    # prepare dataset
    files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    paths = [os.path.join(folder_path, f) for f in files]
    ds = ImgDataset(paths, tfms)
    dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)
    feats = []
    with torch.no_grad():
        for batch in dl:
            b = batch.to(device)
            out = fe(b).view(b.size(0), -1)
            feats.append(out.cpu().numpy())
    Xnew = np.vstack(feats)
    probs = clf.predict_proba(Xnew)[:, 1]
    return dict(zip(files, probs))

