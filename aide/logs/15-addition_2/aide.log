```python
import os
import numpy as np
import pandas as pd
from PIL import Image
import torch
import torchvision
from torchvision import transforms
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from xgboost import XGBClassifier

# Custom dataset to load images
class ImageDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        name = self.df.loc[idx, 'image_name'] + '.jpg'
        path = os.path.join(self.img_dir, name)
        img = Image.open(path).convert('RGB')
        img = self.transform(img)
        tone = self.df.loc[idx, 'skin_tone']
        return img, tone, idx

# Load data
df = pd.read_csv('./input/mydataset.csv')
# Binary target: malignant=1, else=0
df['target'] = (df['label'] == 'malignant').astype(int)
# Replace missing skin_tone (-1) with median of valid tones
median_tone = df.loc[df['skin_tone'] > 0, 'skin_tone'].median()
df['skin_tone'] = df['skin_tone'].replace(-1, median_tone)

# Image transforms
transform = transforms.Compose([
    transforms.Resize(256),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
])

# Device and feature extractor
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
resnet = torchvision.models.resnet50(pretrained=True)
feature_extractor = torch.nn.Sequential(*list(resnet.children())[:-1]).to(device)
feature_extractor.eval()

# Prepare dataloader for feature extraction
dataset = ImageDataset(df, './input/MyImages', transform)
loader = DataLoader(dataset, batch_size=32, num_workers=4, pin_memory=True)

# Extract features
features = np.zeros((len(df), 2048), dtype=np.float32)
tones = np.zeros(len(df), dtype=np.float32)
with torch.no_grad():
    for imgs, skin_tones, idxs in loader:
        imgs = imgs.to(device)
        out = feature_extractor(imgs)  # (B,2048,1,1)
        out = out.view(out.size(0), -1).cpu().numpy()
        features[idxs.numpy()] = out
        tones[idxs.numpy()] = skin_tones.numpy()

X = features
y = df['target'].values

# 5-fold CV for AUROC and fairness gap
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs, gaps = [], []
for train_idx, val_idx in skf.split(X, y):
    X_train, X_val = X[train_idx], X[val_idx]
    y_train, y_val = y[train_idx], y[val_idx]
    tones_val = tones[val_idx]
    clf = XGBClassifier(use_label_encoder=False, eval_metric='logloss', random_state=42)
    clf.fit(X_train, y_train)
    proba = clf.predict_proba(X_val)[:,1]
    auc = roc_auc_score(y_val, proba)
    # Fairness: AUROC gap between light (<=3) and dark (>=5)
    light = tones_val <= 3
    dark = tones_val >= 5
    if light.sum() >= 2 and dark.sum() >= 2:
        auc_l = roc_auc_score(y_val[light], proba[light])
        auc_d = roc_auc_score(y_val[dark], proba[dark])
        gaps.append(abs(auc_l - auc_d))
    else:
        gaps.append(np.nan)
    aucs.append(auc)

print(f'CV AUROC: {np.nanmean(aucs):.4f} ± {np.nanstd(aucs):.4f}')
print(f'Mean AUROC gap (light vs dark): {np.nanmean(gaps):.4f}')

# Retrain on full data
final_clf = XGBClassifier(use_label_encoder=False, eval_metric='logloss', random_state=42)
final_clf.fit(X, y)

def predict(folder_path):
    """
    Predict malignancy probabilities for all .jpg images in folder_path.
    Returns a DataFrame with columns ['image_name','malignancy_probability'].
    """
    files = sorted([f for f in os.listdir(folder_path) if f.lower().endswith('.jpg')])
    df_new = pd.DataFrame({'image_name': [os.path.splitext(f)[0] for f in files],
                           'skin_tone': median_tone})
    ds_new = ImageDataset(df_new, folder_path, transform)
    loader_new = DataLoader(ds_new, batch_size=32, num_workers=4, pin_memory=True)
    feats_new = np.zeros((len(df_new), 2048), dtype=np.float32)
    with torch.no_grad():
        for imgs, _, idxs in loader_new:
            imgs = imgs.to(device)
            out = feature_extractor(imgs).view(imgs.size(0), -1).cpu().numpy()
            feats_new[idxs.numpy()] = out
    prob = final_clf.predict_proba(feats_new)[:,1]
    return pd.DataFrame({'image_name': df_new['image_name'], 'malignancy_probability': prob})

# Example usage for test folder
test_folder = './input/test'
if os.path.exists(test_folder):
    sub = predict(test_folder)
    os.makedirs('./working', exist_ok=True)
    sub.to_csv('./working/submission.csv', index=False)
```
