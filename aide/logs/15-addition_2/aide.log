import os
import pickle
import numpy as np
import pandas as pd
from PIL import Image
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
import timm
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

# Configuration
IMG_DIR = "./input/MyImages"
CSV_PATH = "./input/mydataset.csv"
MODEL_PATH = "./working/lgbm_model_tta.pkl"
BATCH_SIZE = 32
SEED = 42
NUM_WORKERS = 4


# Dataset for embedding extraction
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        return self.transform(img), row.skin_tone, row.label


# Load data
df = pd.read_csv(CSV_PATH)
df["label"] = (df["label"] == "malignant").astype(int)

# Prepare transforms
base_transform = transforms.Compose(
    [
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)
flip_transform = transforms.Compose(
    [
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.RandomHorizontalFlip(p=1.0),
        transforms.ToTensor(),
        transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)

# Device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load pretrained EfficientNet-B0 and remove head
feature_model = timm.create_model("efficientnet_b0", pretrained=True)
if hasattr(feature_model, "fc"):
    feature_model.fc = torch.nn.Identity()
elif hasattr(feature_model, "classifier"):
    feature_model.classifier = torch.nn.Identity()
feature_model.to(device).eval()


# Function to extract embeddings given a transform
def extract_embeddings(transform):
    ds = SkinLesionDataset(df, IMG_DIR, transform)
    loader = DataLoader(
        ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS
    )
    feats, tones, labels = [], [], []
    with torch.no_grad():
        for imgs, tns, lbs in loader:
            imgs = imgs.to(device)
            emb = feature_model(imgs).cpu().numpy()
            feats.append(emb)
            tones.append(tns.numpy())
            labels.append(lbs.numpy())
    return np.vstack(feats), np.concatenate(tones), np.concatenate(labels)


# Extract original and flipped embeddings
print("Extracting base embeddings...")
feats_orig, tones, labels = extract_embeddings(base_transform)
print("Extracting flipped embeddings...")
feats_flip, _, _ = extract_embeddings(flip_transform)

# 5-fold stratified CV with TTA
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
aucs, gaps = [], []
for train_idx, val_idx in skf.split(feats_orig, labels):
    X_tr, X_val_orig = feats_orig[train_idx], feats_orig[val_idx]
    X_val_flip = feats_flip[val_idx]
    X_val = (X_val_orig + X_val_flip) / 2.0
    y_tr, y_val = labels[train_idx], labels[val_idx]
    tones_val = tones[val_idx]
    clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
    clf.fit(X_tr, y_tr)
    y_pred = clf.predict_proba(X_val)[:, 1]
    auc = roc_auc_score(y_val, y_pred)
    aucs.append(auc)
    mask_light = (tones_val > 0) & (tones_val <= 3)
    mask_dark = tones_val >= 5
    if mask_light.sum() > 0 and mask_dark.sum() > 0:
        auc_l = roc_auc_score(y_val[mask_light], y_pred[mask_light])
        auc_d = roc_auc_score(y_val[mask_dark], y_pred[mask_dark])
        gaps.append(abs(auc_l - auc_d))
    else:
        gaps.append(0.0)

print(f"CV AUROC with TTA: {np.mean(aucs):.4f}")
print(f"Avg AUROC gap (light vs dark) with TTA: {np.mean(gaps):.4f}")

# Retrain on full data (original only)
final_clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
final_clf.fit(feats_orig, labels)
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
with open(MODEL_PATH, "wb") as f:
    pickle.dump(final_clf, f)


# Predict function with TTA
def predict(folder_path):
    """
    Predict malignancy probability with TTA horizontal flip.
    Args:
      folder_path (str): path to directory of .jpg images.
    Returns:
      pd.DataFrame: ['image_name', 'malignancy_probability'].
    """
    with open(MODEL_PATH, "rb") as f:
        model = pickle.load(f)
    img_files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    preds = []
    for i in range(0, len(img_files), BATCH_SIZE):
        batch = img_files[i : i + BATCH_SIZE]
        imgs_o, imgs_f = [], []
        for fname in batch:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            imgs_o.append(base_transform(img))
            imgs_f.append(flip_transform(img))
        bo = torch.stack(imgs_o).to(device)
        bf = torch.stack(imgs_f).to(device)
        with torch.no_grad():
            e_o = feature_model(bo).cpu().numpy()
            e_f = feature_model(bf).cpu().numpy()
        e = (e_o + e_f) / 2.0
        probs = model.predict_proba(e)[:, 1]
        preds.extend(list(zip(batch, probs)))
    return pd.DataFrame(preds, columns=["image_name", "malignancy_probability"])


