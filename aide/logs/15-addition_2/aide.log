import os
import pickle
import numpy as np
import pandas as pd
from PIL import Image
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
import timm
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

# Configuration
IMG_DIR = "./input/MyImages"
CSV_PATH = "./input/mydataset.csv"
MODEL_PATH = "./working/lgbm_model.pkl"
BATCH_SIZE = 32
SEED = 42


# Dataset for embedding extraction
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        return self.transform(img), row.skin_tone, row.label, row.image_name


# Load data
df = pd.read_csv(CSV_PATH)
# Binary label: malignant=1, else=0
df["label"] = (df["label"] == "malignant").astype(int)
# Prepare transforms
transform = transforms.Compose(
    [
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)
# Device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load pretrained EfficientNet-B0 and remove head
feature_model = timm.create_model("efficientnet_b0", pretrained=True)
# Replace classifier with identity to get features
if hasattr(feature_model, "fc"):
    feature_model.fc = torch.nn.Identity()
elif hasattr(feature_model, "classifier"):
    feature_model.classifier = torch.nn.Identity()
feature_model.to(device).eval()

# Extract embeddings
dataset = SkinLesionDataset(df, IMG_DIR, transform)
loader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)
all_feats = []
all_tones = []
all_labels = []
for imgs, tones, labels, names in loader:
    imgs = imgs.to(device)
    with torch.no_grad():
        feats = feature_model(imgs)
    all_feats.append(feats.cpu().numpy())
    all_tones.append(tones.numpy())
    all_labels.append(labels.numpy())
feats = np.vstack(all_feats)
tones = np.concatenate(all_tones)
labels = np.concatenate(all_labels)

# 5-fold stratified CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
aucs, gaps = [], []
for train_idx, val_idx in skf.split(feats, labels):
    X_tr, X_val = feats[train_idx], feats[val_idx]
    y_tr, y_val = labels[train_idx], labels[val_idx]
    tones_val = tones[val_idx]
    # Train LightGBM
    clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
    clf.fit(X_tr, y_tr)
    # Predict
    y_pred = clf.predict_proba(X_val)[:, 1]
    auc = roc_auc_score(y_val, y_pred)
    aucs.append(auc)
    # Fairness: define light vs dark
    mask_light = (tones_val > 0) & (tones_val <= 3)
    mask_dark = tones_val >= 5
    # Compute subgroup AUROCs if possible
    if mask_light.sum() > 0 and mask_dark.sum() > 0:
        auc_light = roc_auc_score(y_val[mask_light], y_pred[mask_light])
        auc_dark = roc_auc_score(y_val[mask_dark], y_pred[mask_dark])
        gaps.append(abs(auc_light - auc_dark))
    else:
        gaps.append(0.0)

mean_auc = np.mean(aucs)
mean_gap = np.mean(gaps)
print(f"CV AUROC: {mean_auc:.4f}")
print(f"Avg AUROC gap (light vs dark): {mean_gap:.4f}")

# Retrain on full data
final_clf = lgb.LGBMClassifier(n_estimators=100, random_state=SEED)
final_clf.fit(feats, labels)
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
with open(MODEL_PATH, "wb") as f:
    pickle.dump(final_clf, f)


# Predict function
def predict(folder_path):
    """
    Predict malignancy probability for images in folder_path.
    Args:
      folder_path (str): path to directory containing .jpg images.
    Returns:
      pd.DataFrame with columns ['image_name', 'malignancy_probability'].
    """
    # Load model
    with open(MODEL_PATH, "rb") as f:
        model = pickle.load(f)
    # Prepare list of images
    img_files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    preds = []
    # Process in batches
    for i in range(0, len(img_files), BATCH_SIZE):
        batch_files = img_files[i : i + BATCH_SIZE]
        imgs = []
        for fname in batch_files:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            imgs.append(transform(img))
        batch = torch.stack(imgs).to(device)
        with torch.no_grad():
            feats_batch = feature_model(batch).cpu().numpy()
        probs = model.predict_proba(feats_batch)[:, 1]
        for fname, p in zip(batch_files, probs):
            preds.append((fname, p))
    return pd.DataFrame(preds, columns=["image_name", "malignancy_probability"])

