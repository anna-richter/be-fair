        batch = imgs[i:i+BATCH_SIZE]
        t_o, t_h, t_v = [], [], []
        for fn in batch:
            img = Image.open(os.path.join(folder_path,fn)).convert("RGB")
            t_o.append(base_tf(img)); t_h.append(hflip_tf(img)); t_v.append(vflip_tf(img))
        bo = torch.stack(t_o).to(device); bh = torch.stack(t_h).to(device); bv = torch.stack(t_v).to(device)
