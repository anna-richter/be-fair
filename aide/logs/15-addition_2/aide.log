            to.append(base_tf(img))
            th.append(hflip_tf(img))
            tv.append(vflip_tf(img))
            tr.append(rot90_tf(img))
        bo = torch.stack(to).to(device)
        bh = torch.stack(th).to(device)
        bv = torch.stack(tv).to(device)
        br = torch.stack(tr).to(device)
        with torch.no_grad():
            e_o = feat_model(bo).cpu().numpy()
            e_h = feat_model(bh).cpu().numpy()
            e_v = feat_model(bv).cpu().numpy()
            e_r = feat_model(br).cpu().numpy()
        E = (e_o + e_h + e_v + e_r) / 4.0
        # ensemble prediction
        probs = np.zeros(len(batch))
        for m in models:
            probs += m.predict_proba(E)[:, 1]
        probs /= len(models)
        results.extend(zip(batch, probs))
    return pd.DataFrame(results, columns=["image_name", "malignancy_probability"])


# Generate submission if test data exists
if os.path.isdir(TEST_FOLDER):
    df_sub = predict(TEST_FOLDER)
    os.makedirs(os.path.dirname(SUBMISSION_PATH), exist_ok=True)
