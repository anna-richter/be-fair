Design: We replace the missing XGBoost dependency with scikit-learn’s RandomForestClassifier (which supports sample weights) to train on the DenseNet features, preserving our fairness adjustment across skin tones. We perform 5-fold stratified CV, computing overall AUROC and the light vs dark skin AUROC gap, then retrain on the full dataset and save both the feature extractor and classifier. The predict() function loads these objects and returns malignancy probabilities for any folder of JPEGs, and if a test folder exists it will write a `submission.csv` in `./working`.
Code: import os
import numpy as np
import pandas as pd
from PIL import Image
import torch
import torch.nn as nn
from torchvision import models, transforms
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from sklearn.ensemble import RandomForestClassifier
import joblib

# reproducibility
np.random.seed(42)
torch.manual_seed(42)

# 1. Load metadata and labels
df = pd.read_csv("./input/mydataset.csv")
df["y"] = (df["label"] == "malignant").astype(int)
image_names = df["image_name"].values
skin_tones = df["skin_tone"].values
labels = df["y"].values
N = len(df)

# 2. Prepare DenseNet121 feature extractor
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
base = models.densenet121(pretrained=True)
feature_extractor = (
    nn.Sequential(base.features, nn.ReLU(inplace=True), nn.AdaptiveAvgPool2d((1, 1)))
    .to(device)
    .eval()
)

# 3. Image transforms and dataset
tfms = transforms.Compose(
    [
        transforms.Resize(224),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


class ImgDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, i):
        img = Image.open(self.paths[i]).convert("RGB")
        return self.transform(img)


img_dir = "./input/MyImages"
paths = [os.path.join(img_dir, f"{n}.jpg") for n in image_names]
ds = ImgDataset(paths, tfms)
dl = DataLoader(ds, batch_size=32, num_workers=4, pin_memory=True)

# 4. Extract features
feats = []
with torch.no_grad():
    for batch in dl:
        b = batch.to(device)
        out = feature_extractor(b).view(b.size(0), -1)
        feats.append(out.cpu().numpy())
X = np.vstack(feats)

# 5. Compute sample weights for fairness
mask_light = (skin_tones >= 1) & (skin_tones <= 3)
mask_dark = skin_tones >= 5
sample_weights = np.ones(N, dtype=float)
if mask_light.sum() > 0:
    sample_weights[mask_light] = N / (2 * mask_light.sum())
if mask_dark.sum() > 0:
    sample_weights[mask_dark] = N / (2 * mask_dark.sum())

# 6. 5-fold stratified CV with RandomForest
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
all_preds = np.zeros(N)
gaps = []
for train_idx, val_idx in skf.split(X, labels):
    clf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
    clf.fit(X[train_idx], labels[train_idx], sample_weight=sample_weights[train_idx])
    proba = clf.predict_proba(X[val_idx])[:, 1]
    all_preds[val_idx] = proba
    # AUROC by skin-tone
    yv = labels[val_idx]
    stv = skin_tones[val_idx]
    ml = (stv >= 1) & (stv <= 3)
    md = stv >= 5
    if ml.sum() > 0 and md.sum() > 0:
        auc_l = roc_auc_score(yv[ml], proba[ml])
        auc_d = roc_auc_score(yv[md], proba[md])
        gaps.append(abs(auc_l - auc_d))

overall_auc = roc_auc_score(labels, all_preds)
avg_gap = np.mean(gaps) if gaps else np.nan
print(f"CV Overall AUROC: {overall_auc:.4f}")
print(f"Avg AUROC gap (light vs dark): {avg_gap:.4f}")

# 7. Retrain on full data and save models
final_clf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
final_clf.fit(X, labels, sample_weight=sample_weights)
os.makedirs("./working", exist_ok=True)
torch.save(feature_extractor.cpu(), "./working/feature_extractor.pth")
joblib.dump(final_clf, "./working/final_rf_model.pkl")


# 8. Prediction function
def predict(folder_path):
    """
    Predict malignancy probabilities for all .jpg images in folder_path.
    Returns a dict {image_name: probability}.
    """
    fe = torch.load("./working/feature_extractor.pth").to(device).eval()
    clf = joblib.load("./working/final_rf_model.pkl")
    files = [f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")]
    paths = [os.path.join(folder_path, f) for f in files]
    ds_ = ImgDataset(paths, tfms)
    dl_ = DataLoader(ds_, batch_size=32, num_workers=4, pin_memory=True)
    feats_ = []
    with torch.no_grad():
        for batch in dl_:
            b = batch.to(device)
            out = fe(b).view(b.size(0), -1)
            feats_.append(out.cpu().numpy())
    Xnew = np.vstack(feats_)
    probs = clf.predict_proba(Xnew)[:, 1]
    return dict(zip(files, probs))


# 9. If test data exists, generate submission.csv
test_folder = "./input/test_images"
if os.path.isdir(test_folder):
    preds = predict(test_folder)
    df_sub = pd.DataFrame(
        {"image_name": list(preds.keys()), "probability": list(preds.values())}
    )
    df_sub.to_csv("./working/submission.csv", index=False)
    print("Saved submission.csv")

Results: The training and evaluation script ran successfully without any bugs. The model achieved a strong overall AUROC of 0.8320, indicating good discriminatory ability between malignant and benign lesions. The fairness metric, measured as the average AUROC gap between light and dark skin tones, is low at 0.0244, demonstrating that the model maintains equitable performance across skin tones without compromising overall accuracy.
Validation Metric: 0.832

-------------------------------
Design: I propose improving the current TTA pipeline by adding vertical flips alongside horizontal flips, averaging embeddings from the original image, its horizontal flip, and its vertical flip. This simple extension of TTA often yields more robust representations and can boost AUROC without retraining the feature extractor. We will extract three sets of embeddings (original, horizontal flip, vertical flip), average them during cross‐validation and inference, and report the new CV AUROC and light/dark gap. Finally, we retrain on the original embeddings and update the predict function to include both flips in its TTA.
