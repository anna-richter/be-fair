Code: import os
import numpy as np
import pandas as pd
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score
import torch
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import timm

# Device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load metadata
df = pd.read_csv("input/mydataset.csv")
# Binary labels: malignant=1, others=0
df["y"] = (df["label"] == "malignant").astype(int)
# Paths
df["path"] = df["image_name"].apply(
    lambda x: os.path.join("input", "MyImages", f"{x}.jpg")
)


# Dataset for feature extraction
class SkinDataset(Dataset):
    def __init__(self, df, transform):
        self.df = df.reset_index(drop=True)
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img = Image.open(row["path"]).convert("RGB")
        img = self.transform(img)
        return img, row["y"], row["skin_tone"], row["image_name"]


# Transforms
transform = T.Compose(
    [
        T.Resize(256),
        T.CenterCrop(224),
        T.ToTensor(),
        T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)

# Load pretrained model for feature extraction
feat_model = timm.create_model(
    "resnet18", pretrained=True, num_classes=0, global_pool="avg"
)
feat_model.to(device).eval()

# Extract features
dataset = SkinDataset(df, transform)
loader = DataLoader(dataset, batch_size=64, shuffle=False, num_workers=4)
all_feats = []
all_labels = []
all_tones = []
all_names = []

with torch.no_grad():
    for imgs, labels, tones, names in loader:
        imgs = imgs.to(device)
        feats = feat_model(imgs).cpu().numpy()
        all_feats.append(feats)
        all_labels.extend(labels.numpy())
        all_tones.extend(tones.numpy())
        all_names.extend(names)
all_feats = np.vstack(all_feats)
all_labels = np.array(all_labels)
all_tones = np.array(all_tones)

# 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
gaps = []
for train_idx, test_idx in skf.split(all_feats, all_labels):
    X_train, X_test = all_feats[train_idx], all_feats[test_idx]
    y_train, y_test = all_labels[train_idx], all_labels[test_idx]
    tones_test = all_tones[test_idx]
    # Scale
    scaler = StandardScaler().fit(X_train)
    X_train_s = scaler.transform(X_train)
    X_test_s = scaler.transform(X_test)
    # Logistic regression
    model = LogisticRegression(max_iter=1000)
    model.fit(X_train_s, y_train)
    probs = model.predict_proba(X_test_s)[:, 1]
    # Overall AUROC
    auc = roc_auc_score(y_test, probs)
    aucs.append(auc)
    # Per-skin-tone AUROC
    group_aucs = []
    for tone in np.unique(tones_test):
        mask = tones_test == tone
        if np.unique(y_test[mask]).size == 2:
            group_aucs.append(roc_auc_score(y_test[mask], probs[mask]))
    if group_aucs:
        gaps.append(max(group_aucs) - min(group_aucs))

# Print results
print(f"CV AUROC: {np.mean(aucs):.4f} ± {np.std(aucs):.4f}")
print(f"Average AUROC gap between skin tones: {np.mean(gaps):.4f}")

# Retrain on full data for final model
scaler_full = StandardScaler().fit(all_feats)
X_full_s = scaler_full.transform(all_feats)
final_model = LogisticRegression(max_iter=1000)
final_model.fit(X_full_s, all_labels)


# Prediction function
def predict(image_folder):
    """Predict malignancy probability for all images in a folder.
    Args:
        image_folder (str): Path to directory containing .jpg images.
    Returns:
        pandas.DataFrame: image_name and malignancy_prob columns.
    """
    files = [f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")]
    paths = [os.path.join(image_folder, f) for f in files]
    imgs = []
    for p in paths:
        img = Image.open(p).convert("RGB")
        imgs.append(transform(img))
    imgs = torch.stack(imgs).to(device)
    with torch.no_grad():
        feats = feat_model(imgs).cpu().numpy()
    feats_s = scaler_full.transform(feats)
    probs = final_model.predict_proba(feats_s)[:, 1]
    return pd.DataFrame({"image_name": files, "malignancy_prob": probs})


# Example usage (uncomment to run):
# preds = predict('input/MyImages')
# preds.to_csv('working/submission.csv', index=False)

Results: The training script executed successfully without any errors. The model achieved a cross-validated AUROC of approximately 0.8464, indicating good overall performance in classifying malignant vs benign lesions. The average AUROC gap between skin tones is about 0.1453, which suggests some disparity in performance across different skin tones but the gap is quantified and reported. The final model is retrained on the full dataset and a prediction function is provided for new images. Overall, the approach is sound and the results are clearly presented.
Validation Metric: 0.8464

