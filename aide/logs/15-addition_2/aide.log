```python
import os
import pandas as pd
import numpy as np
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import xgboost as xgb
import joblib

class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df
        self.img_dir = img_dir
        self.transform = transform
    def __len__(self):
        return len(self.df)
    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        path = os.path.join(self.img_dir, row['image_name'] + '.jpg')
        img = Image.open(path).convert('RGB')
        return self.transform(img), row['skin_tone']

def extract_features(model, loader, device):
    feats, skins = [], []
    with torch.no_grad():
        for imgs, st in loader:
            imgs = imgs.to(device)
            out = model(imgs)
            feats.append(out.cpu().numpy())
            skins.append(st.numpy())
    return np.vstack(feats), np.concatenate(skins)

def main():
    # Load and preprocess labels
    IMG_DIR = './input/MyImages'
    df = pd.read_csv('./input/mydataset.csv')
    df['label_bin'] = (df['label'] == 'malignant').astype(int)
    # Replace missing skin_tone (-1) with median of valid tones
    med = df.loc[df['skin_tone']>=0, 'skin_tone'].median()
    df['skin_tone'] = df['skin_tone'].replace(-1, med)
    # Image transforms
    transform = transforms.Compose([
        transforms.Resize((224,224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])
    ])
    # Feature extraction
    dataset = SkinLesionDataset(df, IMG_DIR, transform)
    loader = DataLoader(dataset, batch_size=32, shuffle=False, num_workers=4)
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    feat_model = models.resnet50(pretrained=True)
    feat_model.fc = torch.nn.Identity()
    feat_model = feat_model.to(device).eval()
    X_img, skin_tones = extract_features(feat_model, loader, device)
    X = np.hstack([X_img, skin_tones.reshape(-1,1)])
    y = df['label_bin'].values

    # 5-fold CV
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs, gaps = [], []
    for train_idx, val_idx in skf.split(X, y):
        X_tr, X_va = X[train_idx], X[val_idx]
        y_tr, y_va = y[train_idx], y[val_idx]
        st_va = skin_tones[val_idx]
        clf = xgb.XGBClassifier(use_label_encoder=False, eval_metric='logloss')
        clf.fit(X_tr, y_tr)
        yp = clf.predict_proba(X_va)[:,1]
        auc = roc_auc_score(y_va, yp)
        # fairness gap
        light = st_va <= 3
        dark = st_va >= 5
        if light.sum()>0 and dark.sum()>0:
            auc_l = roc_auc_score(y_va[light], yp[light])
            auc_d = roc_auc_score(y_va[dark], yp[dark])
            gap = abs(auc_l - auc_d)
        else:
            gap = np.nan
        aucs.append(auc)
        gaps.append(gap)
    print(f"Mean CV AUROC: {np.nanmean(aucs):.4f}")
    print(f"Mean CV AUROC Gap (light vs dark): {np.nanmean(gaps):.4f}")

    # Retrain on full data and save
    final_clf = xgb.XGBClassifier(use_label_encoder=False, eval_metric='logloss')
    final_clf.fit(X, y)
    # Save both model and median for missing skin_tone
    joblib.dump({'model': final_clf, 'skin_median': med}, './working/model.pkl')

def predict(image_folder):
    """
    Predict malignancy probabilities for images in image_folder.
    Returns DataFrame with ['image_name','malignancy_prob'] and
    writes submission.csv to './working'.
    """
    # Load model and preprocessing info
    chk = joblib.load('./working/model.pkl')
    clf, med = chk['model'], chk['skin_median']
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    feat_model = models.resnet50(pretrained=True)
    feat_model.fc = torch.nn.Identity()
    feat_model = feat_model.to(device).eval()
    transform = transforms.Compose([
        transforms.Resize((224,224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])
    ])
    imgs, names = [], []
    for fn in sorted(os.listdir(image_folder)):
        if fn.lower().endswith('.jpg'):
            img = Image.open(os.path.join(image_folder, fn)).convert('RGB')
            imgs.append(transform(img))
            names.append(fn[:-4])
    imgs = torch.stack(imgs).to(device)
    with torch.no_grad():
        feats = feat_model(imgs).cpu().numpy()
    skin_arr = np.full((len(names),1), med)
    X_new = np.hstack([feats, skin_arr])
    probs = clf.predict_proba(X_new)[:,1]
    out = pd.DataFrame({'image_name': names, 'malignancy_prob': probs})
    out.to_csv('./working/submission.csv', index=False)
    return out

if __name__ == '__main__':
    main()
