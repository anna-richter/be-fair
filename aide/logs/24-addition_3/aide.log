Design: We fine-tune a pretrained EfficientNet-B0 model with a per‐sample weighted binary cross‐entropy loss where weights are inverse frequencies of each skin‐tone group to improve fairness. We perform 5‐fold stratified cross‐validation on the binary malignancy label, computing AUROC for each fold to gauge performance. After CV, we retrain the model on the full dataset for a few epochs and save the final model. A `predict(folder_path)` function loads the saved model and returns malignancy probabilities for all images in a given directory.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch import nn
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import timm

# Configuration
DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/model.pth"
N_FOLDS = 5
RANDOM_STATE = 42
EPOCHS_CV = 3
EPOCHS_FULL = 5
BATCH_SIZE = 32
LR = 1e-4
IMG_SIZE = 224

# Read data
df = pd.read_csv(DATA_CSV)
# Encode label: malignant=1, else=0
df["target"] = (df["label"] == "malignant").astype(int)
# Skin tone groups, fill missing as own group
df["skin_tone"] = df["skin_tone"].fillna(-1).astype(int)
groups = df["skin_tone"].unique()
# Compute inverse-frequency weights per group
counts = df["skin_tone"].value_counts().to_dict()
inv_freq = {g: 1.0 / counts[g] for g in counts}
# Normalize so average weight = 1
mean_w = np.mean(list(inv_freq.values()))
group_weights = {g: w / mean_w for g, w in inv_freq.items()}
df["group_weight"] = df["skin_tone"].map(group_weights)


# Dataset
class LesionDataset(Dataset):
    def __init__(self, df, transform):
        self.df = df.reset_index(drop=True)
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(IMG_DIR, row["image_name"] + ".jpg")
        image = Image.open(img_path).convert("RGB")
        x = self.transform(image)
        y = torch.tensor(row["target"], dtype=torch.float32)
        w = torch.tensor(row["group_weight"], dtype=torch.float32)
        return x, y, w


# Transforms
train_transform = T.Compose(
    [
        T.Resize((IMG_SIZE, IMG_SIZE)),
        T.RandomHorizontalFlip(),
        T.RandomRotation(15),
        T.ToTensor(),
        T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)
val_transform = T.Compose(
    [
        T.Resize((IMG_SIZE, IMG_SIZE)),
        T.ToTensor(),
        T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ]
)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")


def train_one(model, loader, optimizer, criterion):
    model.train()
    total_loss = 0.0
    for x, y, w in loader:
        x, y, w = x.to(device), y.to(device), w.to(device)
        preds = model(x).squeeze(1)
        loss = criterion(preds, y)
        # per-sample BCEWithLogitsLoss -> multiply weights
        loss = (loss * w).mean()
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * x.size(0)
    return total_loss / len(loader.dataset)


def validate(model, loader):
    model.eval()
    ys, ps = [], []
    with torch.no_grad():
        for x, y, _ in loader:
            x = x.to(device)
            preds = model(x).squeeze(1)
            probs = torch.sigmoid(preds).cpu().numpy()
            ys.extend(y.numpy())
            ps.extend(probs)
    return roc_auc_score(ys, ps)


# 5-fold CV
skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=RANDOM_STATE)
aucs = []
for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"])):
    df_train = df.iloc[train_idx]
    df_val = df.iloc[val_idx]
    ds_train = LesionDataset(df_train, train_transform)
    ds_val = LesionDataset(df_val, val_transform)
    loader_train = DataLoader(
        ds_train, batch_size=BATCH_SIZE, shuffle=True, num_workers=4
    )
    loader_val = DataLoader(ds_val, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)
    # Model
    model = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1).to(
        device
    )
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)
    bce = nn.BCEWithLogitsLoss(reduction="none")
    # Train
    for epoch in range(EPOCHS_CV):
        train_loss = train_one(model, loader_train, optimizer, bce)
    auc = validate(model, loader_val)
    print(f"Fold {fold+1} AUROC: {auc:.4f}")
    aucs.append(auc)
print(f"Mean CV AUROC: {np.mean(aucs):.4f}")

# Retrain on full data
full_ds = LesionDataset(df, train_transform)
full_loader = DataLoader(full_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=4)
model_full = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1).to(
    device
)
opt_full = torch.optim.Adam(model_full.parameters(), lr=LR)
bce = nn.BCEWithLogitsLoss(reduction="none")
for epoch in range(EPOCHS_FULL):
    loss = train_one(model_full, full_loader, opt_full, bce)
    print(f"Full train epoch {epoch+1}/{EPOCHS_FULL} loss: {loss:.4f}")
# Save model
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
torch.save(model_full.state_dict(), MODEL_PATH)


def predict(folder_path):
    """
    Load saved model and predict malignancy probabilities for all images in folder_path.
    Returns a dict: {filename: probability}.
    """
    model = timm.create_model("efficientnet_b0", pretrained=False, num_classes=1).to(
        device
    )
    model.load_state_dict(torch.load(MODEL_PATH, map_location=device))
    model.eval()
    transform = val_transform
    results = {}
    for fn in sorted(os.listdir(folder_path)):
        if fn.lower().endswith((".jpg", ".png", ".jpeg")):
            img = Image.open(os.path.join(folder_path, fn)).convert("RGB")
            x = transform(img).unsqueeze(0).to(device)
            with torch.no_grad():
                prob = torch.sigmoid(model(x).squeeze(1)).item()
            results[fn] = prob
    return results


