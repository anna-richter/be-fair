print(f"Mean CV AUROC: {mean_auc:.4f} ± {std_auc:.4f}")

# Retrain on full data with sampler
full_ds = SkinDataset(df, IMG_DIR, transform=train_tf)
full_sampler = WeightedRandomSampler(
    weights=df["sample_weight"].values, num_samples=len(df), replacement=True
)
full_loader = DataLoader(
    full_ds, batch_size=BATCH_SIZE, sampler=full_sampler, num_workers=4
)
model_full = models.densenet121(pretrained=True)
model_full.classifier = nn.Linear(model_full.classifier.in_features, 1)
model_full = model_full.to(DEVICE)
optimizer = optim.Adam(model_full.parameters(), lr=1e-4)
criterion = nn.BCEWithLogitsLoss()
for epoch in range(EPOCHS_FULL):
    loss = train_one_epoch(model_full, full_loader, optimizer, criterion)
    print(f"Full Train Epoch {epoch+1}/{EPOCHS_FULL}: Loss={loss:.4f}")

os.makedirs("./working", exist_ok=True)
torch.save(model_full.state_dict(), MODEL_PATH)
print("Saved model to", MODEL_PATH)


def predict(folder_path):
    """
    Load the trained model and predict malignancy probabilities for all images in folder_path.
    Returns a dict mapping filename to probability.
    """
    model = models.densenet121(pretrained=False)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    model.to(DEVICE).eval()
    results = {}
    for fname in os.listdir(folder_path):
        if not fname.lower().endswith((".jpg", ".png", ".jpeg")):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        inp = val_tf(img).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            prob = torch.sigmoid(model(inp).squeeze(1)).item()
        results[fname] = prob
    return results

