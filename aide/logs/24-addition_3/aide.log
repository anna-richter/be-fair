            rx = np.random.randint(W); ry = np.random.randint(H)
            rw = int(W * np.sqrt(1-lam)); rh = int(H * np.sqrt(1-lam))
            x1 = np.clip(rx - rw//2, 0, W); x2 = np.clip(rx + rw//2, 0, W)
            y1 = np.clip(ry - rh//2, 0, H); y2 = np.clip(ry + rh//2, 0, H)
            imgs[:, :, y1:y2, x1:x2] = imgs2[:, :, y1:y2, x1:x2]
