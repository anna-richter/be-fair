Design: We fine-tune a pretrained Vision Transformer (ViT-B/16) to classify malignant vs non-malignant lesions, treating “malignant” as the positive class and the rest as negative.  To ensure fairness across skin tones, we employ a WeightedRandomSampler that balances samples by inverse skin-tone frequency during training.  We split the dataset into an 80/20 stratified train/validation set on the binary label, train for a few epochs with a BCEWithLogitsLoss, and evaluate AUROC on the hold-out set.  Finally, we save the trained model and provide a `predict(folder_path)` function that loads the model and returns malignancy probabilities for any folder of new images.
Code: import os
import glob
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import torch
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from torchvision import transforms
import timm


# Dataset class
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.loc[idx]
        img_path = os.path.join(self.img_dir, f"{row.image_name}.jpg")
        image = Image.open(img_path).convert("RGB")
        if self.transform:
            image = self.transform(image)
        label = float(row.label_bin)
        return image, label


# Prediction function
def predict(folder_path: str, batch_size: int = 32):
    """
    Load the saved model and predict malignancy probabilities for all images in folder_path.
    Returns a pandas DataFrame with columns ['image_name','malignancy_probability'].
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # define transform (same as validation)
    transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    # load model
    model = timm.create_model("vit_base_patch16_224", pretrained=False, num_classes=1)
    model.load_state_dict(
        torch.load(os.path.join("working", "model.pth"), map_location=device)
    )
    model.to(device).eval()
    # gather images
    paths = sorted(glob.glob(os.path.join(folder_path, "*.jpg")))
    names = [os.path.splitext(os.path.basename(p))[0] for p in paths]
    dataset = [(p, n) for p, n in zip(paths, names)]
    probs = []
    with torch.no_grad():
        for i in range(0, len(dataset), batch_size):
            batch = dataset[i : i + batch_size]
            imgs = [transform(Image.open(p).convert("RGB")) for p, _ in batch]
            x = torch.stack(imgs).to(device)
            logits = model(x).view(-1)
            probs.extend(torch.sigmoid(logits).cpu().numpy().tolist())
    return pd.DataFrame({"image_name": names, "malignancy_probability": probs})


def main():
    # load data
    df = pd.read_csv(os.path.join("input", "mydataset.csv"))
    # binarize label: malignant=1, others=0
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    # split train/val
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label_bin"], random_state=42
    )
    # transforms
    train_tf = transforms.Compose(
        [
            transforms.RandomResizedCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    val_tf = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    # datasets
    img_dir = os.path.join("input", "MyImages")
    train_ds = SkinLesionDataset(train_df, img_dir, train_tf)
    val_ds = SkinLesionDataset(val_df, img_dir, val_tf)
    # sampler for fairness by skin_tone
    counts = train_df["skin_tone"].value_counts().to_dict()
    weights = train_df["skin_tone"].map(lambda x: 1.0 / counts.get(x, 1)).values
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)
    # dataloaders
    train_loader = DataLoader(train_ds, batch_size=32, sampler=sampler, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
    # model, loss, optimizer
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = timm.create_model("vit_base_patch16_224", pretrained=True, num_classes=1)
    model.to(device)
    criterion = torch.nn.BCEWithLogitsLoss()
    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-5)
    # train
    epochs = 5
    for epoch in range(epochs):
        model.train()
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            logits = model(imgs).view(-1)
            loss = criterion(logits, labels)
            loss.backward()
            optimizer.step()
    # validate
    model.eval()
    all_preds, all_labels = [], []
    with torch.no_grad():
        for imgs, labels in val_loader:
            imgs = imgs.to(device)
            logits = model(imgs).view(-1)
            probs = torch.sigmoid(logits).cpu().numpy()
            all_preds.extend(probs.tolist())
            all_labels.extend(labels.numpy().tolist())
    auc = roc_auc_score(all_labels, all_preds)
    print(f"Validation AUROC: {auc:.4f}")
    # save model
    os.makedirs("working", exist_ok=True)
    torch.save(model.state_dict(), os.path.join("working", "model.pth"))


if __name__ == "__main__":
    main()

Results: The training script ran successfully without any errors. The model was trained for 5 epochs using a weighted sampler to address fairness across skin tones. The validation AUROC achieved was 0.8436, indicating good overall classification performance. The use of a weighted sampler likely helped in reducing bias towards underrepresented skin tones, promoting fairness without compromising accuracy.
Validation Metric: 0.8436

-------------------------------
Design: We replace per‐sample loss weighting with a WeightedRandomSampler to oversample underrepresented skin tones, ensuring each batch contains a balanced mix of skin tones. We remove per‐sample weights from the loss and use a standard BCEWithLogitsLoss, constructing the DataLoader with sampling probabilities inverse to each group’s frequency. This change should enhance fairness by equalizing exposure to all skin‐tone groups during training, potentially improving overall AUROC and reducing fairness gaps. We perform 5‐fold stratified cross‐validation to report the mean AUROC, then retrain on the full dataset and save the final DenseNet121 model. The `predict()` function remains unchanged for inference on new images.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from torchvision import transforms, models

# Paths and parameters
DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/densenet121_fair_sampler.pth"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
N_FOLDS = 5
BATCH_SIZE = 16
EPOCHS_CV = 3
EPOCHS_FULL = 5
SEED = 42
torch.manual_seed(SEED)
np.random.seed(SEED)

# Load metadata
df = pd.read_csv(DATA_CSV)
df["target"] = (df["label"] == "malignant").astype(int)
# Compute sample weights for oversampling: inverse of skin-tone frequency
tone_counts = df["skin_tone"].value_counts().to_dict()
tone_weights = {tone: 1.0 / count for tone, count in tone_counts.items()}
df["sample_weight"] = df["skin_tone"].map(lambda x: tone_weights.get(x, 1.0))


# Dataset
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row["target"], dtype=torch.float32)
        return img, label


# Transforms
train_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)
val_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


def train_one_epoch(model, loader, optimizer, criterion):
    model.train()
    total_loss = 0.0
    for imgs, labels in loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        optimizer.zero_grad()
        logits = model(imgs).squeeze(1)
        loss = criterion(logits, labels)
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * imgs.size(0)
    return total_loss / len(loader.dataset)


def eval_model(model, loader):
    model.eval()
    preds, trues = [], []
    with torch.no_grad():
        for imgs, labels in loader:
            imgs = imgs.to(DEVICE)
            logits = model(imgs).squeeze(1)
            probs = torch.sigmoid(logits).cpu().numpy()
            preds.extend(probs.tolist())
            trues.extend(labels.numpy().tolist())
    return roc_auc_score(trues, preds)


# Cross-validation
skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
aucs = []
for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"])):
    df_train, df_val = df.iloc[train_idx], df.iloc[val_idx]
    train_ds = SkinDataset(df_train, IMG_DIR, transform=train_tf)
    val_ds = SkinDataset(df_val, IMG_DIR, transform=val_tf)
    # Weighted sampler for training
    sampler = WeightedRandomSampler(
        weights=df_train["sample_weight"].values,
        num_samples=len(df_train),
        replacement=True,
    )
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)
    # Model and optimizer
    model = models.densenet121(pretrained=True)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model = model.to(DEVICE)
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss()
    # Train
    for epoch in range(EPOCHS_CV):
        _ = train_one_epoch(model, train_loader, optimizer, criterion)
    # Evaluate
    auc = eval_model(model, val_loader)
    print(f"Fold {fold+1} AUROC: {auc:.4f}")
    aucs.append(auc)

mean_auc, std_auc = np.mean(aucs), np.std(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f} ± {std_auc:.4f}")

# Retrain on full data with sampler
full_ds = SkinDataset(df, IMG_DIR, transform=train_tf)
full_sampler = WeightedRandomSampler(
    weights=df["sample_weight"].values, num_samples=len(df), replacement=True
)
full_loader = DataLoader(
    full_ds, batch_size=BATCH_SIZE, sampler=full_sampler, num_workers=4
)
model_full = models.densenet121(pretrained=True)
model_full.classifier = nn.Linear(model_full.classifier.in_features, 1)
model_full = model_full.to(DEVICE)
optimizer = optim.Adam(model_full.parameters(), lr=1e-4)
criterion = nn.BCEWithLogitsLoss()
for epoch in range(EPOCHS_FULL):
    loss = train_one_epoch(model_full, full_loader, optimizer, criterion)
    print(f"Full Train Epoch {epoch+1}/{EPOCHS_FULL}: Loss={loss:.4f}")

os.makedirs("./working", exist_ok=True)
torch.save(model_full.state_dict(), MODEL_PATH)
print("Saved model to", MODEL_PATH)


def predict(folder_path):
    """
    Load the trained model and predict malignancy probabilities for all images in folder_path.
    Returns a dict mapping filename to probability.
    """
    model = models.densenet121(pretrained=False)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    model.to(DEVICE).eval()
    results = {}
    for fname in os.listdir(folder_path):
        if not fname.lower().endswith((".jpg", ".png", ".jpeg")):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        inp = val_tf(img).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            prob = torch.sigmoid(model(inp).squeeze(1)).item()
        results[fname] = prob
    return results

Results: The training script executed successfully without any errors. The cross-validation results show a strong and consistent AUROC around 0.90, indicating good model performance. The training loss steadily decreased during full data training, suggesting effective learning. The use of a weighted sampler based on skin tone frequencies likely contributed to fairness across skin tones, although explicit fairness metrics are not reported. Overall, the model appears well-trained and ready for deployment.
Validation Metric: 0.9025

-------------------------------
Design: We add MixUp data augmentation during training to improve generalization and robustness, which often boosts AUROC.  In each training batch we sample a mixing coefficient from a Beta distribution, mix pairs of images and their labels linearly, and compute the loss as a weighted sum of the two targets.  All other parts of the pipeline, including the weighted sampler for fairness across skin tones, remain unchanged.  This atomic change should increase both overall performance and stability across folds.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from torchvision import transforms, models

# Paths and parameters
DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/densenet121_mixup_sampler.pth"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
N_FOLDS = 5
BATCH_SIZE = 16
EPOCHS_CV = 3
EPOCHS_FULL = 5
SEED = 42
MIXUP_ALPHA = 0.4

torch.manual_seed(SEED)
np.random.seed(SEED)

# Load metadata
df = pd.read_csv(DATA_CSV)
df["target"] = (df["label"] == "malignant").astype(int)
# Compute sample weights for oversampling: inverse of skin-tone frequency
tone_counts = df["skin_tone"].value_counts().to_dict()
tone_weights = {tone: 1.0 / count for tone, count in tone_counts.items()}
df["sample_weight"] = df["skin_tone"].map(lambda x: tone_weights.get(x, 1.0))


# Dataset
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row["target"], dtype=torch.float32)
        return img, label


# Transforms
train_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)
val_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


def mixup_data(x, y, alpha=MIXUP_ALPHA):
    """Returns mixed inputs, pairs of targets, and lambda"""
    if alpha > 0:
        lam = np.random.beta(alpha, alpha)
    else:
        lam = 1.0
    batch_size = x.size()[0]
    index = torch.randperm(batch_size).to(DEVICE)
    mixed_x = lam * x + (1 - lam) * x[index, :]
    y_a, y_b = y, y[index]
    return mixed_x, y_a, y_b, lam


def train_one_epoch(model, loader, optimizer, criterion):
    model.train()
    total_loss = 0.0
    for imgs, labels in loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        # apply MixUp
        mixed_imgs, targets_a, targets_b, lam = mixup_data(imgs, labels)
        optimizer.zero_grad()
        logits = model(mixed_imgs).squeeze(1)
        loss = lam * criterion(logits, targets_a) + (1 - lam) * criterion(
            logits, targets_b
        )
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * imgs.size(0)
    return total_loss / len(loader.dataset)


def eval_model(model, loader):
    model.eval()
    preds, trues = [], []
    with torch.no_grad():
        for imgs, labels in loader:
            imgs = imgs.to(DEVICE)
            logits = model(imgs).squeeze(1)
            probs = torch.sigmoid(logits).cpu().numpy()
            preds.extend(probs.tolist())
            trues.extend(labels.numpy().tolist())
    return roc_auc_score(trues, preds)


# Cross-validation
skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
aucs = []
for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"])):
    df_train, df_val = df.iloc[train_idx], df.iloc[val_idx]
    train_ds = SkinDataset(df_train, IMG_DIR, transform=train_tf)
    val_ds = SkinDataset(df_val, IMG_DIR, transform=val_tf)
    sampler = WeightedRandomSampler(
        weights=df_train["sample_weight"].values,
        num_samples=len(df_train),
        replacement=True,
    )
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)
    model = models.densenet121(pretrained=True)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model = model.to(DEVICE)
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    criterion = nn.BCEWithLogitsLoss()
    for epoch in range(EPOCHS_CV):
        _ = train_one_epoch(model, train_loader, optimizer, criterion)
    auc = eval_model(model, val_loader)
    print(f"Fold {fold+1} AUROC: {auc:.4f}")
    aucs.append(auc)

mean_auc, std_auc = np.mean(aucs), np.std(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f} ± {std_auc:.4f}")

# Retrain on full data with sampler + mixup
full_ds = SkinDataset(df, IMG_DIR, transform=train_tf)
full_sampler = WeightedRandomSampler(
    weights=df["sample_weight"].values, num_samples=len(df), replacement=True
)
full_loader = DataLoader(
    full_ds, batch_size=BATCH_SIZE, sampler=full_sampler, num_workers=4
)
model_full = models.densenet121(pretrained=True)
model_full.classifier = nn.Linear(model_full.classifier.in_features, 1)
model_full = model_full.to(DEVICE)
optimizer = optim.Adam(model_full.parameters(), lr=1e-4)
criterion = nn.BCEWithLogitsLoss()
for epoch in range(EPOCHS_FULL):
    loss = train_one_epoch(model_full, full_loader, optimizer, criterion)
    print(f"Full Train Epoch {epoch+1}/{EPOCHS_FULL}: Loss={loss:.4f}")

os.makedirs("./working", exist_ok=True)
torch.save(model_full.state_dict(), MODEL_PATH)
print("Saved model to", MODEL_PATH)


def predict(folder_path):
    """
    Load the trained model and predict malignancy probabilities for all images in folder_path.
    Returns a dict mapping filename to probability.
    """
    model = models.densenet121(pretrained=False)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    model.to(DEVICE).eval()
    results = {}
    for fname in os.listdir(folder_path):
        if not fname.lower().endswith((".jpg", ".png", ".jpeg")):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        inp = val_tf(img).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            prob = torch.sigmoid(model(inp).squeeze(1)).item()
        results[fname] = prob
    return results

Results: The training script ran successfully without errors. The cross-validation AUROC scores are consistently high around 0.89, indicating good model performance. The loss decreased steadily during full training, showing effective learning. The use of a weighted sampler based on skin tone frequencies and MixUp augmentation likely helped improve fairness and robustness. The model was saved correctly and a prediction function was implemented as requested.
Validation Metric: 0.8914

-------------------------------
Design: I fixed the shape mismatch by replacing the generic `.squeeze()` calls with `.squeeze(1)` (and equivalently flattening logits) so that even a batch of size 1 yields a 1-D tensor of shape `[batch_size]`. This ensures that `binary_cross_entropy_with_logits` always receives inputs and targets of matching shapes. The same adjustment is applied during validation to get consistent probability vectors. The rest of the training and cross‐validation pipeline remains unchanged, and we print fold‐wise and mean AUROCs at the end.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import torchvision.models as models


class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = row.malignant
        weight = row.weight
        return (
            img,
            torch.tensor(label, dtype=torch.float32),
            torch.tensor(weight, dtype=torch.float32),
        )


def get_model(device):
    model = models.mobilenet_v2(pretrained=True)
    model.classifier = nn.Sequential(nn.Dropout(0.2), nn.Linear(model.last_channel, 1))
    return model.to(device)


def predict(folder_path):
    """
    Load the saved model and predict malignancy probability for each image in folder_path.
    Returns dict {filename: probability}.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = get_model(device)
    model.load_state_dict(torch.load("./working/model.pth", map_location=device))
    model.eval()
    transform = T.Compose(
        [
            T.Resize(256),
            T.CenterCrop(224),
            T.ToTensor(),
            T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    preds = {}
    for fname in sorted(os.listdir(folder_path)):
        if not fname.lower().endswith((".jpg", ".png")):
            continue
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        x = transform(img).unsqueeze(0).to(device)
        with torch.no_grad():
            prob = torch.sigmoid(model(x)).squeeze(1).item()
        preds[fname] = prob
    return preds


if __name__ == "__main__":
    # Load and prepare data
    df = pd.read_csv("./input/mydataset.csv")
    df["malignant"] = (df["label"] == "malignant").astype(int)
    # Compute per-sample weights for fairness by skin tone
    freq = df["skin_tone"].value_counts().to_dict()
    df["weight"] = df["skin_tone"].map(lambda s: 1.0 / freq.get(s, 1))

    # Transforms
    train_tf = T.Compose(
        [
            T.RandomResizedCrop(224),
            T.RandomHorizontalFlip(),
            T.ToTensor(),
            T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    val_tf = T.Compose(
        [
            T.Resize(256),
            T.CenterCrop(224),
            T.ToTensor(),
            T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []

    # 5-fold cross-validation
    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["malignant"])):
        df_train = df.iloc[train_idx]
        df_val = df.iloc[val_idx]
        ds_train = SkinLesionDataset(df_train, "./input/MyImages", transform=train_tf)
        ds_val = SkinLesionDataset(df_val, "./input/MyImages", transform=val_tf)
        dl_train = DataLoader(ds_train, batch_size=32, shuffle=True, num_workers=2)
        dl_val = DataLoader(ds_val, batch_size=32, shuffle=False, num_workers=2)

        model = get_model(device)
        optim = torch.optim.Adam(model.parameters(), lr=1e-4)

        # Training
        model.train()
        for epoch in range(3):
            for xb, yb, wb in dl_train:
                xb, yb, wb = xb.to(device), yb.to(device), wb.to(device)
                optim.zero_grad()
                logits = model(xb).squeeze(1)  # ensure shape [batch_size]
                loss = F.binary_cross_entropy_with_logits(logits, yb, weight=wb)
                loss.backward()
                optim.step()

        # Validation
        model.eval()
        y_true, y_pred = [], []
        with torch.no_grad():
            for xb, yb, _ in dl_val:
                xb = xb.to(device)
                probs = torch.sigmoid(model(xb)).squeeze(1).cpu().numpy()
                y_pred.extend(probs.tolist())
                y_true.extend(yb.numpy().tolist())
        auc = roc_auc_score(y_true, y_pred)
        print(f"Fold {fold+1} AUROC: {auc:.4f}")
        aucs.append(auc)

    print(f"Mean AUROC: {np.mean(aucs):.4f}")

    # Retrain on full data and save final model
    full_ds = SkinLesionDataset(df, "./input/MyImages", transform=train_tf)
    full_dl = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=2)
    model = get_model(device)
    optim = torch.optim.Adam(model.parameters(), lr=1e-4)
    model.train()
    for epoch in range(3):
        for xb, yb, wb in full_dl:
            xb, yb, wb = xb.to(device), yb.to(device), wb.to(device)
            optim.zero_grad()
            logits = model(xb).squeeze(1)
            loss = F.binary_cross_entropy_with_logits(logits, yb, weight=wb)
            loss.backward()
            optim.step()
    os.makedirs("./working", exist_ok=True)
    torch.save(model.state_dict(), "./working/model.pth")

    # If test images are provided, generate submission.csv
    test_folder = "./input/MyTestImages"
    if os.path.exists(test_folder):
        preds = predict(test_folder)
        pd.DataFrame(list(preds.items()), columns=["image", "malignancy_prob"]).to_csv(
            "./working/submission.csv", index=False
        )

Results: The training script ran successfully without errors. The 5-fold cross-validation shows consistent AUROC scores around 0.87 to 0.90, with a mean AUROC of 0.8846, indicating good model performance. The use of per-sample weights based on skin tone frequencies likely helped improve fairness across skin tones while maintaining overall accuracy.
Validation Metric: 0.8846

-------------------------------
Design: We integrate a OneCycleLR learning rate scheduler to provide dynamic learning rate adjustment for better convergence and generalization. A higher max learning rate of 1e-3 over each fold’s training schedule and the full training schedule will be used. The scheduler is stepped per batch during training with minimal modifications to the existing training loop. All other components (weighted sampler for fairness, architecture, cross‐validation) remain unchanged to isolate the effect of scheduling on AUROC.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
import torch.optim as optim
from torch.optim.lr_scheduler import OneCycleLR
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from torchvision import transforms, models

# Paths and parameters
DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/densenet121_with_onecycle.pth"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
N_FOLDS = 5
BATCH_SIZE = 16
EPOCHS_CV = 3
EPOCHS_FULL = 5
MAX_LR = 1e-3
SEED = 42
torch.manual_seed(SEED)
np.random.seed(SEED)

# Load metadata
df = pd.read_csv(DATA_CSV)
df["target"] = (df["label"] == "malignant").astype(int)
tone_counts = df["skin_tone"].value_counts().to_dict()
tone_weights = {tone: 1.0 / c for tone, c in tone_counts.items()}
df["sample_weight"] = df["skin_tone"].map(lambda x: tone_weights.get(x, 1.0))


# Dataset
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img = Image.open(
            os.path.join(self.img_dir, row["image_name"] + ".jpg")
        ).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row["target"], dtype=torch.float32)
        return img, label


# Transforms
train_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)
val_tf = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


def train_one_epoch(model, loader, optimizer, criterion, scheduler):
    model.train()
    total_loss = 0.0
    for imgs, labels in loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        optimizer.zero_grad()
        logits = model(imgs).squeeze(1)
        loss = criterion(logits, labels)
        loss.backward()
        optimizer.step()
        scheduler.step()
        total_loss += loss.item() * imgs.size(0)
    return total_loss / len(loader.dataset)


def eval_model(model, loader):
    model.eval()
    preds, trues = [], []
    with torch.no_grad():
        for imgs, labels in loader:
            imgs = imgs.to(DEVICE)
            logits = model(imgs).squeeze(1)
            probs = torch.sigmoid(logits).cpu().numpy()
            preds.extend(probs.tolist())
            trues.extend(labels.numpy().tolist())
    return roc_auc_score(trues, preds)


# Cross-validation
skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
aucs = []
for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["target"])):
    df_train, df_val = df.iloc[train_idx], df.iloc[val_idx]
    train_ds = SkinDataset(df_train, IMG_DIR, transform=train_tf)
    val_ds = SkinDataset(df_val, IMG_DIR, transform=val_tf)
    sampler = WeightedRandomSampler(
        df_train["sample_weight"].values, len(df_train), replacement=True
    )
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, sampler=sampler, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    model = models.densenet121(pretrained=True)
    model.classifier = nn.Linear(model.classifier.in_features, 1)
    model = model.to(DEVICE)
    optimizer = optim.Adam(model.parameters(), lr=MAX_LR)
    steps_per_epoch = len(train_loader)
    scheduler = OneCycleLR(
        optimizer, max_lr=MAX_LR, steps_per_epoch=steps_per_epoch, epochs=EPOCHS_CV
    )
    criterion = nn.BCEWithLogitsLoss()

    for epoch in range(EPOCHS_CV):
        loss = train_one_epoch(model, train_loader, optimizer, criterion, scheduler)
    auc = eval_model(model, val_loader)
    print(f"Fold {fold+1} AUROC: {auc:.4f}")
    aucs.append(auc)

mean_auc, std_auc = np.mean(aucs), np.std(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f} ± {std_auc:.4f}")

# Retrain on full data
full_ds = SkinDataset(df, IMG_DIR, transform=train_tf)
full_sampler = WeightedRandomSampler(
    df["sample_weight"].values, len(df), replacement=True
)
full_loader = DataLoader(
    full_ds, batch_size=BATCH_SIZE, sampler=full_sampler, num_workers=4
)

model_full = models.densenet121(pretrained=True)
model_full.classifier = nn.Linear(model_full.classifier.in_features, 1)
model_full = model_full.to(DEVICE)
optimizer = optim.Adam(model_full.parameters(), lr=MAX_LR)
scheduler = OneCycleLR(
    optimizer, max_lr=MAX_LR, steps_per_epoch=len(full_loader), epochs=EPOCHS_FULL
)
criterion = nn.BCEWithLogitsLoss()

for epoch in range(EPOCHS_FULL):
    loss = train_one_epoch(model_full, full_loader, optimizer, criterion, scheduler)
    print(f"Full Train Epoch {epoch+1}/{EPOCHS_FULL}: Loss={loss:.4f}")

os.makedirs("./working", exist_ok=True)
torch.save(model_full.state_dict(), MODEL_PATH)
print("Saved model to", MODEL_PATH)


def predict(folder_path):
    """
    Predict malignancy probabilities for all images in folder_path.
    Args:
      folder_path (str): directory of images.
    Returns:
