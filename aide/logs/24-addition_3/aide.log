        inp = val_tf(img).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            views = [
                inp,
                torch.flip(inp, [3]),
                torch.rot90(inp, 1, [2, 3]),
                torch.rot90(inp, 2, [2, 3]),
                torch.rot90(inp, 3, [2, 3]),
            ]
            logits_sum = sum(model(v).squeeze(1) for v in views)
            results[fname] = torch.sigmoid(logits_sum / len(views)).item()
    return results


if os.path.isdir(TEST_DIR):
    preds = predict(TEST_DIR)
    sub = pd.DataFrame(list(preds.items()), columns=["image_name", "probability"])
    os.makedirs(os.path.dirname(SUBMISSION_PATH), exist_ok=True)
    sub.to_csv(SUBMISSION_PATH, index=False)
    print(f"Saved submission to {SUBMISSION_PATH}")

