2026-04-25 15:09:57,784 - INFO - OpenAI API response: We fine-tune a pretrained ResNet18 on binary labels (malignant vs. non-malignant) and use a WeightedRandomSampler based on skin tone to balance groups for fairness. We perform 5-fold stratified cross-validation computing AUROC on each fold, then retrain on the full dataset and save the final model. A `predict(folder_path)` function loads the saved model and returns malignant probabilities for each image. Below is the implementation.

```python
import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
import torchvision.transforms as T
import timm
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score

DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/model.pth"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Dataset
class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row.label_bin, dtype=torch.float32)
        tone = row.skin_tone
        return img, label, tone

# Transforms
transform = T.Compose([
    T.Resize((224,224)),
    T.ToTensor(),
    T.Normalize(mean=(0.485,0.456,0.406), std=(0.229,0.224,0.225))
])

# Load and prepare data
df = pd.read_csv(DATA_CSV)
# Binary label: malignant=1, else=0
df['label_bin'] = (df.label == 'malignant').astype(int)
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []

# Cross-validation
for train_idx, val_idx in skf.split(df, df['label_bin']):
    df_train = df.iloc[train_idx]
    df_val = df.iloc[val_idx]
    # compute sample weights by skin tone in train
    tone_counts = df_train.skin_tone.value_counts().to_dict()
    weights = df_train.skin_tone.map(lambda t: 1.0 / tone_counts[t]).values
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)
    train_ds = SkinDataset(df_train, IMG_DIR, transform)
    val_ds = SkinDataset(df_val, IMG_DIR, transform)
    train_loader = DataLoader(train_ds, batch_size=32, sampler=sampler, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
    # Model
    model = timm.create_model('resnet18', pretrained=True, num_classes=1).to(DEVICE)
    criterion = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
    # Train for 3 epochs
    model.train()
    for epoch in range(3):
        for imgs, labels, _ in train_loader:
            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
            optimizer.zero_grad()
            logits = model(imgs)
            loss = criterion(logits, labels)
            loss.backward()
            optimizer.step()
    # Validate
    model.eval()
    all_labels, all_probs = [], []
    with torch.no_grad():
        for imgs, labels, _ in val_loader:
            imgs = imgs.to(DEVICE)
            logits = model(imgs).cpu().squeeze(1)
            probs = torch.sigmoid(logits)
            all_labels.extend(labels.numpy())
            all_probs.extend(probs.numpy())
    auc = roc_auc_score(all_labels, all_probs)
    aucs.append(auc)
# Print CV result
mean_auc = np.mean(aucs)
print(f"CV AUROC: {mean_auc:.4f}")

# Retrain on full data
# sampler on full data
tone_counts = df.skin_tone.value_counts().to_dict()
weights = df.skin_tone.map(lambda t: 1.0 / tone_counts[t]).values
sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)
full_ds = SkinDataset(df, IMG_DIR, transform)
full_loader = DataLoader(full_ds, batch_size=32, sampler=sampler, num_workers=4)
model = timm.create_model('resnet18', pretrained=True, num_classes=1).to(DEVICE)
criterion = nn.BCEWithLogitsLoss()
optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
model.train()
for epoch in range(3):
    for imgs, labels, _ in full_loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
        optimizer.zero_grad()
        loss = criterion(model(imgs), labels)
        loss.backward()
        optimizer.step()
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
torch.save(model.state_dict(), MODEL_PATH)

def predict(folder_path: str) -> pd.DataFrame:
    """
    Load saved model and predict malignancy probability for images in folder_path.
    Returns a DataFrame with columns ['image_name', 'malignancy_prob'].
    """
    # load model
    mdl = timm.create_model('resnet18', pretrained=False, num_classes=1).to(DEVICE)
    mdl.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    mdl.eval()
    tf = transform
    records = []
    with torch.no_grad():
        for fname in os.listdir(folder_path):
            if not fname.lower().endswith((".jpg", ".png")):
                continue
            path = os.path.join(folder_path, fname)
            img = Image.open(path).convert("RGB")
            img_t = tf(img).unsqueeze(0).to(DEVICE)
            prob = torch.sigmoid(mdl(img_t)).cpu().item()
            records.append({"image_name": os.path.splitext(fname)[0], "malignancy_prob": prob})
    return pd.DataFrame(records)

# Example usage:
# df_preds = predict("./input/MyImages")
# print(df_preds.head())
```
