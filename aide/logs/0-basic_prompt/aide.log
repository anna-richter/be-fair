```python
import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as transforms
import torchvision.models as models
import lightgbm as lgb

# Configuration
DATA_CSV = "input/mydataset.csv"
IMG_DIR = "input/MyImages"
SUBMISSION_PATH = "working/submission.csv"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
BATCH_SIZE = 64
RANDOM_STATE = 42

# Image dataset for feature extraction
class ImageDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform
    def __len__(self):
        return len(self.paths)
    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert("RGB")
        return self.transform(img)

# Feature extractor: pretrained ResNet50 without final fc
def get_feature_extractor():
    model = models.resnet50(pretrained=True)
    model.fc = nn.Identity()
    model = model.to(DEVICE).eval()
    return model

# Extract features for a list of image paths
def extract_features(model, paths, transform, batch_size=BATCH_SIZE):
    dataset = ImageDataset(paths, transform)
    loader = DataLoader(dataset, batch_size=batch_size, shuffle=False, num_workers=4, pin_memory=True)
    feats = []
    with torch.no_grad():
        for imgs in loader:
            imgs = imgs.to(DEVICE)
            out = model(imgs)
            feats.append(out.cpu().numpy())
    return np.vstack(feats)

# Prediction function: load images from folder, extract features, predict probabilities, save CSV
def predict(lgb_model, feat_model, transform, folder_path, output_csv=SUBMISSION_PATH):
    os.makedirs(os.path.dirname(output_csv), exist_ok=True)
    files = sorted([f for f in os.listdir(folder_path) if f.lower().endswith((".jpg", ".png"))])
    paths = [os.path.join(folder_path, f) for f in files]
    feats = extract_features(feat_model, paths, transform)
    probs = lgb_model.predict_proba(feats)[:, 1]
    df_out = pd.DataFrame({"image_name": files, "malignancy_proba": probs})
    df_out.to_csv(output_csv, index=False)
    print(f"Saved predictions to {output_csv}")

def main():
    # Load metadata
    df = pd.read_csv(DATA_CSV)
    # Binary label: malignant vs others
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    # Full image paths
    df["img_path"] = df["image_name"].astype(str) + ".jpg"
    df["img_path"] = df["img_path"].apply(lambda x: os.path.join(IMG_DIR, x))

    # Train/validation split
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label_bin"], random_state=RANDOM_STATE
    )

    # Transforms
    transform = transforms.Compose([
        transforms.Resize((224,224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
    ])

    # Feature extraction
    feat_model = get_feature_extractor()
    print("Extracting train features...")
    X_train = extract_features(feat_model, train_df["img_path"].tolist(), transform)
    print("Extracting validation features...")
    X_val = extract_features(feat_model, val_df["img_path"].tolist(), transform)
    y_train = train_df["label_bin"].values
    y_val = val_df["label_bin"].values

    # Train LightGBM
    lgb_model = lgb.LGBMClassifier(n_estimators=100, random_state=RANDOM_STATE)
    lgb_model.fit(X_train, y_train)

    # Validation performance
    val_probs = lgb_model.predict_proba(X_val)[:,1]
    auc = roc_auc_score(y_val, val_probs)
    print(f"Validation AUROC: {auc:.4f}")

    # Generate submission for all images in IMG_DIR
    predict(lgb_model, feat_model, transform, IMG_DIR)

if __name__ == "__main__":
    main()
```
