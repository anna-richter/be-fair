    df = pd.read_csv(DATA_CSV)
    # Binary label: malignant vs others
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    # Full image paths
    df["img_path"] = df["image_name"].astype(str) + ".jpg"
    df["img_path"] = df["img_path"].apply(lambda x: os.path.join(IMG_DIR, x))

    # Train/validation split
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label_bin"], random_state=RANDOM_STATE
    )

    # Transforms
    transform = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ]
    )

    # Feature extraction
    feat_model = get_feature_extractor()
    print("Extracting train features...")
    X_train = extract_features(feat_model, train_df["img_path"].tolist(), transform)
    print("Extracting validation features...")
    X_val = extract_features(feat_model, val_df["img_path"].tolist(), transform)
    y_train = train_df["label_bin"].values
    y_val = val_df["label_bin"].values

    # Train LightGBM
    lgb_model = lgb.LGBMClassifier(n_estimators=100, random_state=RANDOM_STATE)
    lgb_model.fit(X_train, y_train)

    # Validation performance
    val_probs = lgb_model.predict_proba(X_val)[:, 1]
    auc = roc_auc_score(y_val, val_probs)
    print(f"Validation AUROC: {auc:.4f}")

    # Generate submission for all images in IMG_DIR
    predict(lgb_model, feat_model, transform, IMG_DIR)


if __name__ == "__main__":
    main()

