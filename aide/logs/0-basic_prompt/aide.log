        [
            T.Resize((224, 224)),
            T.ToTensor(),
            T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
        ]
    )
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["malignant"])):
        train_df, val_df = df.iloc[train_idx], df.iloc[val_idx]
        train_ds = LesionDataset(train_df, img_dir, transform)
        val_ds = LesionDataset(val_df, img_dir, transform)
        train_loader = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
        val_loader = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)
        model = timm.create_model("efficientnet_b0", pretrained=True, num_classes=1).to(
            device
        )
        criterion = nn.BCEWithLogitsLoss()
        optimizer = optim.Adam(model.parameters(), lr=1e-4)
        # Train 2 epochs per fold
        for epoch in range(2):
            model.train()
            for imgs, labels in train_loader:
                imgs, labels = imgs.to(device), labels.to(device)
                optimizer.zero_grad()
                logits = model(imgs).squeeze(1)
                loss = criterion(logits, labels)
                loss.backward()
                optimizer.step()
        # Evaluate
        model.eval()
        all_labels, all_scores = [], []
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs = imgs.to(device)
                logits = model(imgs).squeeze(1)
                probs = torch.sigmoid(logits).cpu().numpy()
                all_scores.extend(probs.tolist())
                all_labels.extend(labels.numpy().tolist())
        auc = roc_auc_score(all_labels, all_scores)
        print(f"Fold {fold+1} AUROC: {auc:.4f}")
        aucs.append(auc)
    mean_auc = np.mean(aucs)
    print(f"Mean CV AUROC: {mean_auc:.4f}")
    # Retrain on full dataset
    full_ds = LesionDataset(df, img_dir, transform)
    full_loader = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=4)
    model_full = timm.create_model(
        "efficientnet_b0", pretrained=True, num_classes=1
    ).to(device)
    optimizer = optim.Adam(model_full.parameters(), lr=1e-4)
    for epoch in range(3):
        model_full.train()
        for imgs, labels in full_loader:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            logits = model_full(imgs).squeeze(1)
            loss = criterion(logits, labels)
            loss.backward()
            optimizer.step()
    # Save final model
    os.makedirs("./working", exist_ok=True)
    torch.save(model_full.state_dict(), "./working/model.pth")
    # Generate submission.csv
    predict("./input/MyImages", model_path="./working/model.pth")


if __name__ == "__main__":
    main()

Results: The training script successfully trained an EfficientNet-B0 model for skin lesion classification using 5-fold cross-validation. The model achieved a mean AUROC of 0.8762 across folds, indicating good predictive performance. The final model was retrained on the full dataset and saved, and a prediction function was implemented to output malignancy probabilities for new images.
Validation Metric: 0.8762

