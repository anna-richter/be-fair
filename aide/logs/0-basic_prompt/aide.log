Design: I propose adding simple test-time augmentation (TTA) by averaging model predictions on the original and horizontally flipped images. This should yield more robust probability estimates and improve the AUROC. We will modify both the validation loop and the `predict()` function to apply a horizontal flip and average the sigmoid outputs. The rest of the training pipeline remains unchanged.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from torch.optim import Adam


class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, f"{row.image_name}.jpg")
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row.label, dtype=torch.float32)
        return img, label


def predict(folder_path, model, device, transform):
    """
    Predict malignancy probability for all .jpg images in folder_path using TTA (horizontal flip).
    Returns a DataFrame with columns ['image_name', 'malignancy_prob'] and writes submission.csv.
    """
    model.eval()
    results = []
    files = sorted([f for f in os.listdir(folder_path) if f.lower().endswith(".jpg")])
    with torch.no_grad():
        for fname in files:
            img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
            x1 = transform(img).unsqueeze(0).to(device)
            x2 = transform(img.transpose(Image.FLIP_LEFT_RIGHT)).unsqueeze(0).to(device)
            out1 = model(x1)
            out2 = model(x2)
            prob = (torch.sigmoid(out1) + torch.sigmoid(out2)) / 2.0
            prob = prob.item()
            name = os.path.splitext(fname)[0]
            results.append((name, prob))
    sub_df = pd.DataFrame(results, columns=["image_name", "malignancy_prob"])
    os.makedirs("working", exist_ok=True)
    sub_df.to_csv("working/submission.csv", index=False)
    return sub_df


def main():
    # Settings
    DATA_CSV = "input/mydataset.csv"
    IMG_DIR = "input/MyImages"
    DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    EPOCHS = 3
    BATCH_SIZE = 32
    LR = 1e-4

    # Load data
    df = pd.read_csv(DATA_CSV)
    df["label"] = (df["label"] == "malignant").astype(int)
    train_df, val_df = train_test_split(
        df, test_size=0.2, stratify=df["label"], random_state=42
    )

    # Transforms
    mean = [0.485, 0.456, 0.406]
    std = [0.229, 0.224, 0.225]
    train_transform = transforms.Compose(
        [
            transforms.RandomResizedCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize(mean, std),
        ]
    )
    val_transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean, std),
        ]
    )

    # DataLoaders
    train_ds = SkinLesionDataset(train_df, IMG_DIR, transform=train_transform)
    val_ds = SkinLesionDataset(val_df, IMG_DIR, transform=val_transform)
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    # Model
    model = models.densenet121(pretrained=True)
    in_ftrs = model.classifier.in_features
    model.classifier = nn.Linear(in_ftrs, 1)
    model = model.to(DEVICE)

    # Loss & optimizer
    criterion = nn.BCEWithLogitsLoss()
    optimizer = Adam(model.parameters(), lr=LR)

    # Training loop
    for epoch in range(1, EPOCHS + 1):
        model.train()
        running_loss = 0.0
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
            optimizer.zero_grad()
            outputs = model(imgs)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
            running_loss += loss.item() * imgs.size(0)
        epoch_loss = running_loss / len(train_loader.dataset)

        # Validation with horizontal-flip TTA
        model.eval()
        all_preds = []
        all_labels = []
        with torch.no_grad():
            for imgs, labels in val_loader:
                imgs = imgs.to(DEVICE)
                # original
                out1 = model(imgs)
                # horizontal flip
                imgs_flipped = torch.flip(imgs, dims=[3])
                out2 = model(imgs_flipped)
                probs = (torch.sigmoid(out1) + torch.sigmoid(out2)) / 2.0
                all_preds.extend(probs.cpu().numpy().flatten())
                all_labels.extend(labels.numpy().flatten())
        auc = roc_auc_score(all_labels, all_preds)
        print(
            f"Epoch {epoch}/{EPOCHS} - Loss: {epoch_loss:.4f} - Val AUROC (TTA): {auc:.4f}"
