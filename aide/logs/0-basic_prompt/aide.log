import timm

# Configuration
IMG_DIR = "./input/MyImages"
CSV_PATH = "./input/mydataset.csv"
MODEL_PATH = "working/model.pth"
BATCH_SIZE = 32
NUM_EPOCHS = 5
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load and prepare data
df = pd.read_csv(CSV_PATH)
df["label_bin"] = df["label"].apply(lambda x: 1 if x == "malignant" else 0)
train_df, val_df = train_test_split(
    df, test_size=0.2, stratify=df["label_bin"], random_state=42
)

# Transforms
train_transform = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)
val_transform = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ]
)


class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_name"] + ".jpg")
        img = Image.open(img_path).convert("RGB")
        img = self.transform(img)
        label = torch.tensor(row["label_bin"], dtype=torch.float32)
        return img, label


# DataLoaders
train_loader = DataLoader(
    SkinDataset(train_df, IMG_DIR, train_transform),
    batch_size=BATCH_SIZE,
    shuffle=True,
    num_workers=4,
)
val_loader = DataLoader(
    SkinDataset(val_df, IMG_DIR, val_transform),
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=4,
)

# Model, loss, optimizer
model = timm.create_model("mobilenetv3_large_100", pretrained=True, num_classes=1).to(
    DEVICE
)
criterion = nn.BCEWithLogitsLoss()
optimizer = optim.Adam(model.parameters(), lr=1e-4)

# Training loop
for epoch in range(NUM_EPOCHS):
    model.train()
    running_loss = 0.0
    for imgs, labels in train_loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        optimizer.zero_grad()
        outputs = model(imgs).squeeze(1)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        running_loss += loss.item()
    print(
        f"Epoch {epoch+1}/{NUM_EPOCHS} Training Loss: {running_loss/len(train_loader):.4f}"
    )

# Validation
model.eval()
all_probs, all_labels = [], []
with torch.no_grad():
    for imgs, labels in val_loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        logits = model(imgs).squeeze(1)
        probs = torch.sigmoid(logits)
        all_probs.extend(probs.cpu().numpy())
        all_labels.extend(labels.cpu().numpy())
auc = roc_auc_score(all_labels, all_probs)
print(f"Validation AUROC: {auc:.4f}")

# Save model
os.makedirs("working", exist_ok=True)
torch.save(model.state_dict(), MODEL_PATH)


def predict(folder_path: str) -> pd.DataFrame:
    """
    Load the trained model and predict malignancy probability for each image in folder_path.
    Returns a DataFrame with columns ['image_name','malignancy_probability'] and
    saves it to 'working/submission.csv'.
    """
    # Load model
    m = timm.create_model("mobilenetv3_large_100", pretrained=False, num_classes=1)
    m.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    m.to(DEVICE).eval()
    # Prepare list of images
    files = sorted(
        [
            f
            for f in os.listdir(folder_path)
            if f.lower().endswith((".jpg", ".png", ".jpeg"))
        ]
    )
    results = []
    for fname in files:
        img = Image.open(os.path.join(folder_path, fname)).convert("RGB")
        tensor = val_transform(img).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            prob = torch.sigmoid(m(tensor).squeeze(1)).item()
        results.append(
            {"image_name": os.path.splitext(fname)[0], "malignancy_probability": prob}
        )
    submission = pd.DataFrame(results)
    submission.to_csv("working/submission.csv", index=False)
    return submission


# Generate submission
predict("./input/MyImages")

