                    imgs.to(device), labels.to(device)                          
                            optimizer.zero_grad()                               
                            logits =                                            
                    model(imgs).squeeze(1)                                      
                            loss = criterion(logits,                            
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    imgs.size(0)                                                
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(device)                          
                                # original                                      
                                logits1 =                                       
                    model(imgs).squeeze(1)                                      
                                # horizontal flip TTA                           
                                imgs_flipped =                                  
                    torch.flip(imgs, dims=[3])                                  
                                logits2 =                                       
                    model(imgs_flipped).squeeze(1)                              
                                probs =                                         
                    (torch.sigmoid(logits1) +                                   
                    torch.sigmoid(logits2)) / 2.0                               
                                ys.extend(labels.numpy())                       
                                ps.extend(probs.cpu().nump                      
                    y())                                                        
                        return roc_auc_score(ys, ps)                            
                                                                                
