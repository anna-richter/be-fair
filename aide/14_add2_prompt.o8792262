                            loss = criterion(logits,                            
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    imgs.size(0)                                                
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
