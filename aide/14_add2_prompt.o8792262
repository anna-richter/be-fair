                        model = model.to(DEVICE)                                
                        criterion = nn.BCEWithLogitsLoss()                      
                        optimizer =                                             
                    torch.optim.Adam(model.parameters(),                        
                    lr=LR)                                                      
                        # Train                                                 
                        model.train()                                           
                        for epoch in range(NUM_EPOCHS):                         
                            for imgs, targets, *_ in                            
                    train_loader:                                               
                                imgs = imgs.to(DEVICE)                          
                                targets =                                       
                    targets.float().unsqueeze(1).to(DEVICE)                     
                                preds = model(imgs)                             
                                loss = criterion(preds,                         
                    targets)                                                    
                                optimizer.zero_grad()                           
                                loss.backward()                                 
                                optimizer.step()                                
                        # Validate                                              
                        model.eval()                                            
                        preds_list, targets_list,                               
                    tones_list = [], [], []                                     
                        with torch.no_grad():                                   
                            for imgs, targets, tones, _ in                      
