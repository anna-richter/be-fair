                    shuffle=True, num_workers=4,                                
                    pin_memory=True                                             
                    )                                                           
                    val_loader = DataLoader(                                    
                        val_ds, batch_size=32,                                  
                    shuffle=False, num_workers=4,                               
                    pin_memory=True                                             
                    )                                                           
                                                                                
                    # model, loss, optimizer                                    
                    device = torch.device("cuda" if                             
                    torch.cuda.is_available() else "cpu")                       
                    model =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True,                                            
                    num_classes=1).to(device)                                   
                    criterion =                                                 
                    nn.BCEWithLogitsLoss(reduction="none")                      
                    optimizer =                                                 
                    optim.Adam(model.parameters(), lr=1e-4)                     
                                                                                
                    # training loop                                             
                    best_auc = 0.0                                              
                    for epoch in range(5):                                      
                        model.train()                                           
                        for imgs, labels, weights in                            
                    train_loader:                                               
                            imgs, labels, weights =                             
                    imgs.to(device), labels.to(device),                         
                    weights.to(device)                                          
                            logits = model(imgs).squeeze(1)                     
                            loss = criterion(logits,                            
                    labels)                                                     
                            loss = (loss * weights).mean()                      
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                        # validation                                            
                        model.eval()                                            
                        all_preds, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for imgs, labels, _ in                              
                    val_loader:                                                 
                                imgs = imgs.to(device)                          
                                logits =                                        
                    model(imgs).squeeze(1)                                      
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy()                         
                                all_preds.extend(probs)                         
                                all_labels.extend(labels.nu                     
                    mpy())                                                      
                        val_auc = roc_auc_score(all_labels,                     
                    all_preds)                                                  
                        print(f"Epoch {epoch+1} Validation                      
                    AUROC: {val_auc:.4f}")                                      
                        if val_auc > best_auc:                                  
                            best_auc = val_auc                                  
                            os.makedirs("working",                              
                    exist_ok=True)                                              
                            torch.save(model.state_dict(),                      
                    "working/model.pth")                                        
                                                                                
                    print(f"Best Validation AUROC:                              
                    {best_auc:.4f}")                                            
                                                                                
                                                                                
                    # prediction function                                       
                    def predict(img_folder,                                     
                    model_path="working/model.pth"):                            
                        """                                                     
                        Given a folder of images, returns a                     
                    DataFrame with columns:                                     
                          image_name (str): file name                           
                          probability (float): malignancy                       
                    probability                                                 
                        """                                                     
                        # load model                                            
                        device_ = torch.device("cuda" if                        
                    torch.cuda.is_available() else "cpu")                       
                        m =                                                     
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False, num_classes=1)                            
                        m.load_state_dict(torch.load(model_                     
                    path, map_location=device_))                                
                        m.to(device_).eval()                                    
                        # transform                                             
                        tf = transforms.Compose(                                
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.CenterCrop(224),                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean,                      
                    std),                                                       
                            ]                                                   
                        )                                                       
                        results = []                                            
                        for fn in                                               
                    sorted(os.listdir(img_folder)):                             
                            if fn.lower().endswith((".png",                     
                    ".jpg", ".jpeg")):                                          
                                path =                                          
                    os.path.join(img_folder, fn)                                
                                img =                                           
                    Image.open(path).convert("RGB")                             
                                inp =                                           
                    tf(img).unsqueeze(0).to(device_)                            
                                with torch.no_grad():                           
                                    prob =                                      
                    torch.sigmoid(m(inp).squeeze(1)).item()                     
                                results.append({"image_name                     
                    ": fn, "probability": prob})                                
                        return pd.DataFrame(results)                            
                                                                                
                                                                                
                    # generate submission if test folder                        
                    exists                                                      
                    test_folder = "./input/test"                                
                    if os.path.isdir(test_folder):                              
                        sub = predict(test_folder)                              
                        sub.to_csv("working/submission.csv"                     
                    , index=False)                                              
                                                                                
