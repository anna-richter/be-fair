                    tone_counts.get(x, 1)).values                               
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                        train_ds = SkinDataset(train_df,                        
                    transform=train_tf)                                         
                        val_ds = SkinDataset(val_df,                            
                    transform=val_tf)                                           
                        train_loader = DataLoader(                              
