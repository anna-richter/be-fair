                            loss_a = criterion(logits,                          
                    y_a)                                                        
                            loss_b = criterion(logits,                          
                    y_b)                                                        
                            loss = (lam * loss_a + (1 -                         
                    lam) * loss_b).mean()                                       
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    imgs.size(0)                                                
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                imgs = imgs.to(device)                          
