                    row["image_name"] + ".jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            if self.transform:                                  
                                image =                                         
                    self.transform(image)                                       
                            label =                                             
                    torch.tensor(row["target"],                                 
                    dtype=torch.float32)                                        
                            return image, label                                 
                                                                                
                                                                                
