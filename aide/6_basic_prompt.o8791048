                        print(f"Validation AUROC with                           
                    EfficientNet-B0 + 10-Crop TTA:                              
                    {roc_auc:.4f}")                                             
                                                                                
                        # Save model                                            
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        torch.save(model.state_dict(),                          
                    "working/model.pth")                                        
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
