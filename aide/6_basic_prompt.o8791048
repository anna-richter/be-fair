                    StratifiedShuffleSplit(n_splits=1,                          
                    test_size=0.2, random_state=42)                             
                        train_idx, val_idx =                                    
                    next(splitter.split(df, df["target"]))                      
                        df_train, df_val =                                      
                    df.iloc[train_idx], df.iloc[val_idx]                        
                                                                                
                        # Weighted sampler for class                            
                    balancing                                                   
                        class_counts =                                          
                    df_train["target"].value_counts().to_di                     
                    ct()                                                        
                        weights =                                               
                    df_train["target"].apply(lambda x: 1.0                      
                    / class_counts[x]).values                                   
                        sampler =                                               
                    WeightedRandomSampler(weights,                              
                    num_samples=len(weights),                                   
                    replacement=True)                                           
                                                                                
                        # Transforms for EfficientNet-B3                        
