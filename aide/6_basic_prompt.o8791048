                        scheduler =                                             
                    torch.optim.lr_scheduler.CosineAnnealin                     
                    gLR(optimizer, T_max=epochs)                                
                                                                                
                        # Training loop                                         
                        for epoch in range(epochs):                             
                            model.train()                                       
                            running_loss = 0.0                                  
                            for images, labels in tqdm(                         
                                train_loader, desc=f"Epoch                      
                    {epoch+1}/{epochs} Training"                                
                            ):                                                  
                                images, labels =                                
                    images.to(device),                                          
                    labels.to(device).unsqueeze(1)                              
                                optimizer.zero_grad()                           
                                outputs = model(images)                         
                                loss = criterion(outputs,                       
                    labels)                                                     
                                loss.backward()                                 
                                optimizer.step()                                
                                running_loss += loss.item()                     
                    * images.size(0)                                            
                            scheduler.step()                                    
                            epoch_loss = running_loss /                         
                    len(train_loader.dataset)                                   
                            print(f"Epoch {epoch+1} Loss:                       
                    {epoch_loss:.4f}")                                          
                                                                                
                        # Validation with 10-Crop TTA                           
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
                        with torch.no_grad():                                   
                            for images, labels in                               
                    tqdm(val_loader, desc="Validating with                      
                    10-Crop TTA"):                                              
                                # images: [B,10,3,224,224]                      
