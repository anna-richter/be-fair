import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
from torch import nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
from torchvision.models import resnet18, ResNet18_Weights
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.metrics import roc_auc_score

# Dataset that returns images (and labels or names)
class ImageDataset(Dataset):
    def __init__(self, image_names, image_dir, labels=None, transform=None):
        self.image_names = image_names
        self.labels = labels
        self.image_dir = image_dir
        self.transform = transform

    def __len__(self):
        return len(self.image_names)

    def __getitem__(self, idx):
        name = self.image_names[idx]
        path = os.path.join(self.image_dir, name + ".jpg")
        img = Image.open(path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        if self.labels is not None:
            return img, self.labels[idx]
        else:
            return img, name

def extract_features(model, loader, device):
    model.eval()
    feats = []
    items = []
    with torch.no_grad():
        for batch in loader:
            imgs = batch[0].to(device)
            out = model(imgs)
            feats.append(out.cpu().numpy())
            items.extend(batch[1])
    feats = np.vstack(feats)
    return feats, items

def predict(image_folder, backbone, clf_pipeline, transform, batch_size=64, device=None):
    """
    Predict malignant probability for each image in image_folder.
    Args:
      image_folder (str): path to folder of .jpg images
      backbone (torch.nn.Module): feature extractor with .fc=Identity
      clf_pipeline: sklearn Pipeline with predict_proba
      transform: torchvision transform
      batch_size (int)
      device: torch.device
    Returns:
      pd.DataFrame with columns ['image_name','malignant_probability']
    """
    if device is None:
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # prepare test dataset
    files = sorted([f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")])
    names = [os.path.splitext(f)[0] for f in files]
    ds = ImageDataset(names, image_folder, labels=None, transform=transform)
    loader = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=4)
    feats, img_names = extract_features(backbone, loader, device)
    probs = clf_pipeline.predict_proba(feats)[:,1]
    return pd.DataFrame({"image_name": img_names, "malignant_probability": probs})

def main():
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    # 1) Load and filter data
    df = pd.read_csv("./input/mydataset.csv")
    df = df[df.label.isin(["benign", "malignant"])][["image_name", "label"]].reset_index(drop=True)
    X = df.image_name.tolist()
    y = (df.label == "malignant").astype(int).tolist()

    # 2) Build pretrained backbone -> Identity feature extractor
    weights = ResNet18_Weights.IMAGENET1K_V1
    backbone = resnet18(weights=weights)
    backbone.fc = nn.Identity()
    backbone = backbone.to(device)

    # 3) Transforms (no augmentation for feature extraction)
    feat_transform = transforms.Compose([
        transforms.Resize((224,224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=weights.meta["mean"], std=weights.meta["std"])
    ])

    # 4) Extract features for all images once
    ds_all = ImageDataset(X, "./input/MyImages", labels=y, transform=feat_transform)
    loader_all = DataLoader(ds_all, batch_size=64, shuffle=False, num_workers=4)
    features, labels = extract_features(backbone, loader_all, device)
    labels = np.array(labels)

    # 5) 5-fold CV for logistic regression
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for fold, (train_idx, val_idx) in enumerate(skf.split(features, labels)):
        X_train, X_val = features[train_idx], features[val_idx]
        y_train, y_val = labels[train_idx], labels[val_idx]
        pipe = Pipeline([
            ("scaler", StandardScaler()),
            ("clf", LogisticRegression(max_iter=1000))
        ])
        pipe.fit(X_train, y_train)
        preds = pipe.predict_proba(X_val)[:,1]
        auc = roc_auc_score(y_val, preds)
        print(f"Fold {fold} AUROC: {auc:.4f}")
        aucs.append(auc)
    mean_auc = np.mean(aucs)
    print(f"Mean CV AUROC: {mean_auc:.4f}")

    # 6) Train on full data
    final_pipe = Pipeline([
        ("scaler", StandardScaler()),
        ("clf", LogisticRegression(max_iter=1000))
    ])
    final_pipe.fit(features, labels)

    # 7) Generate submission
    os.makedirs("./working", exist_ok=True)
    submission = predict("./input/MyImages", backbone, final_pipe, feat_transform, batch_size=64, device=device)
    submission.to_csv("./working/submission.csv", index=False)
    print("Saved submission.csv")

if __name__ == "__main__":
    main()
