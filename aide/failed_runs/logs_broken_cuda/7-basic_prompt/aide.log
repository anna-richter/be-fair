import os
import random
import numpy as np
import pandas as pd
from PIL import Image
import torch
from torch import nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

# fix seeds
SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

# 1. Load metadata
df = pd.read_csv("input/mydataset.csv")
df["binary_label"] = (df["label"] == "malignant").astype(int)
image_names = df["image_name"].values
image_paths = [os.path.join("input", "MyImages", f"{n}.jpg") for n in image_names]
y = df["binary_label"].values

# 2. Prepare device, backbone, feature extractor, transforms
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
enet = models.efficientnet_b0(pretrained=True).to(device).eval()
feature_extractor = nn.Sequential(
    enet.features,
    enet.avgpool,
    nn.Flatten()
).to(device)
transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])
])

class SkinDataset(Dataset):
    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform
    def __len__(self):
        return len(self.paths)
    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert("RGB")
        return self.transform(img), idx

def extract_features(paths, batch_size=64, num_workers=4):
    ds = SkinDataset(paths, transform)
    loader = DataLoader(ds, batch_size=batch_size, shuffle=False,
                        num_workers=num_workers, pin_memory=True)
    feats = np.zeros((len(paths), enet.classifier.in_features), dtype=np.float32)
    with torch.no_grad():
        for batch_x, idxs in loader:
            batch_x = batch_x.to(device)
            batch_f = feature_extractor(batch_x).cpu().numpy()
            feats[idxs.numpy()] = batch_f
    return feats

# 3. Extract features once
features = extract_features(image_paths)

# 4. 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
aucs = []
for tr, va in skf.split(features, y):
    X_tr, X_va = features[tr], features[va]
    y_tr, y_va = y[tr], y[va]
    clf = lgb.LGBMClassifier(n_estimators=200, learning_rate=0.05,
                             random_state=SEED, n_jobs=-1)
    clf.fit(X_tr, y_tr)
    pred = clf.predict_proba(X_va)[:,1]
    aucs.append(roc_auc_score(y_va, pred))
mean_auc = np.mean(aucs)
print(f"Mean 5-fold AUROC: {mean_auc:.4f}")

# 5. Train final model
final_clf = lgb.LGBMClassifier(n_estimators=200, learning_rate=0.05,
                               random_state=SEED, n_jobs=-1)
final_clf.fit(features, y)

def predict(image_dir, batch_size=64, num_workers=4):
    img_files = sorted([f for f in os.listdir(image_dir) if f.lower().endswith(".jpg")])
    paths = [os.path.join(image_dir, f) for f in img_files]
    feats = extract_features(paths, batch_size=batch_size, num_workers=num_workers)
    probs = final_clf.predict_proba(feats)[:,1]
    return pd.DataFrame({"image_name": img_files, "malignant_prob": probs})

# 6. Generate submission
submission = predict("input/MyImages")
os.makedirs("working", exist_ok=True)
submission.to_csv("working/submission.csv", index=False)
print("Saved working/submission.csv")
