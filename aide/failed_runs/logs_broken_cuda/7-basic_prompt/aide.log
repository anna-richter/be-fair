    loader_val = DataLoader(ds_val, batch_size=32, shuffle=False, num_workers=4)

    model = make_model()
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    # train 2 epochs
