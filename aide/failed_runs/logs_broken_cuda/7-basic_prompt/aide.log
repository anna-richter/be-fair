```python
import os
import pandas as pd
import numpy as np
from skimage.io import imread
from skimage.color import rgb2gray
from skimage.transform import resize
from skimage.feature import hog
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score


def extract_hog(image_path, resize_shape=(128, 128)):
    img = imread(image_path)
    gray = rgb2gray(img) if img.ndim == 3 else img
    gray_resized = resize(gray, resize_shape, anti_aliasing=True)
    feats = hog(
        gray_resized, pixels_per_cell=(16, 16), cells_per_block=(2, 2), orientations=9
    )
    return feats


def predict(input_folder, model):
    files = [
        f for f in os.listdir(input_folder) if f.lower().endswith((".jpg", ".png"))
    ]
    feats = [extract_hog(os.path.join(input_folder, f)) for f in files]
    X_new = np.vstack(feats)
    probs = model.predict_proba(X_new)[:, 1]
    return pd.DataFrame({"image_name": files, "malignant_probability": probs})


def main():
    # Load labels
    df = pd.read_csv("./input/mydataset.csv")
    df["file_path"] = df["image_name"].apply(
        lambda x: os.path.join("./input/MyImages", f"{x}.jpg")
    )
    df["target"] = (df["label"] == "malignant").astype(int)

    # Extract HOG features
    X = np.vstack([extract_hog(fp) for fp in df["file_path"]])
    y = df["target"].values

    # 5-fold CV for AUROC
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for train_idx, val_idx in skf.split(X, y):
        X_tr, X_val = X[train_idx], X[val_idx]
        y_tr, y_val = y[train_idx], y[val_idx]
        clf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
        clf.fit(X_tr, y_tr)
        prob = clf.predict_proba(X_val)[:, 1]
        aucs.append(roc_auc_score(y_val, prob))
    print(f"Mean 5-fold AUROC: {np.mean(aucs):.4f}")

    # Train final model on all data
    final_clf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
    final_clf.fit(X, y)

    # Predict on new images and save submission
    preds = predict("./input/MyImages", final_clf)
    os.makedirs("./working", exist_ok=True)
    preds.to_csv("./working/submission.csv", index=False)


if __name__ == "__main__":
    main()

