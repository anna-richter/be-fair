import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import lightgbm as lgb


def extract_hist(image_path, bins=8):
    img = Image.open(image_path).convert("RGB")
    arr = np.array(img)
    features = []
    for c in range(3):
        hist, _ = np.histogram(arr[:, :, c], bins=bins, range=(0, 256), density=True)
        features.extend(hist)
    return np.array(features)


def load_data():
    df = pd.read_csv("./input/mydataset.csv")
    df["label_bin"] = (df["label"] == "malignant").astype(int)
    features = []
    for img_name in df["image_name"]:
        path = os.path.join("./input/MyImages", f"{img_name}.jpg")
        features.append(extract_hist(path))
    X = np.vstack(features)
    y = df["label_bin"].values
    return df["image_name"].values, X, y


final_model = None


def predict(image_folder):
    image_files = [
        f for f in os.listdir(image_folder) if f.lower().endswith((".jpg", ".png"))
    ]
    image_names = [os.path.splitext(f)[0] for f in image_files]
    features = []
    for f in image_files:
        path = os.path.join(image_folder, f)
        features.append(extract_hist(path))
    X_new = np.vstack(features)
    probs = final_model.predict_proba(X_new)[:, 1]
    return pd.DataFrame({"image_name": image_names, "malignant_prob": probs})


if __name__ == "__main__":
    image_names, X, y = load_data()
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    scores = []
    for train_idx, test_idx in skf.split(X, y):
        model = lgb.LGBMClassifier(random_state=42)
        model.fit(X[train_idx], y[train_idx])
        preds = model.predict_proba(X[test_idx])[:, 1]
        scores.append(roc_auc_score(y[test_idx], preds))
    print(f"Mean CV AUROC: {np.mean(scores):.4f}")
    final_model = lgb.LGBMClassifier(random_state=42)
    final_model.fit(X, y)
    submission = predict("./input/MyImages")
    submission.to_csv("./working/submission.csv", index=False)

