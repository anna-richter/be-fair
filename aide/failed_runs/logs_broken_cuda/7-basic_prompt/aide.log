# Previous (buggy) implementation

```python
import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models

# Configuration
DATA_DIR = "./input"
IMG_DIR = os.path.join(DATA_DIR, "MyImages")
CSV_PATH = os.path.join(DATA_DIR, "mydataset.csv")
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
BATCH_SIZE = 32
IMG_SIZE = 224
EPOCHS = 3
NUM_FOLDS = 5
MODEL_PATH = "./working/final_model.pth"


# Dataset definition
class LesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_name = row["image_name"] + ".jpg"
        img_path = os.path.join(self.img_dir, img_name)
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row["malignant"], dtype=torch.float32)
        return img, label


# Read and preprocess labels
df = pd.read_csv(CSV_PATH)
# Binary label: malignant=1, else=0
df["malignant"] = (df["label"] == "malignant").astype(int)

# Image transforms
train_transform = transforms.Compose(
    [
        transforms.Resize((IMG_SIZE, IMG_SIZE)),
        transforms.RandomHorizontalFlip(),
        transforms.RandomRotation(15),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)
val_transform = transforms.Compose(
    [
        transforms.Resize((IMG_SIZE, IMG_SIZE)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)

# Cross-validation
skf = StratifiedKFold(n_splits=NUM_FOLDS, shuffle=True, random_state=42)
aucs = []

for fold, (train_idx, val_idx) in enumerate(skf.split(df, df["malignant"]), 1):
    train_df, val_df = df.iloc[train_idx], df.iloc[val_idx]
    train_ds = LesionDataset(train_df, IMG_DIR, transform=train_transform)
    val_ds = LesionDataset(val_df, IMG_DIR, transform=val_transform)
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=4
    )
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    # Model
    model = models.resnet18(pretrained=True)
    for param in model.parameters():
        param.requires_grad = False
    model.fc = nn.Linear(model.fc.in_features, 1)
    model = model.to(DEVICE)

    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.fc.parameters(), lr=1e-3)

    # Train head
    model.train()
    for epoch in range(EPOCHS):
        for imgs, labels in train_loader:
            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
            optimizer.zero_grad()
            outputs = model(imgs)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

    # Validation
    model.eval()
    all_preds, all_targets = [], []
    with torch.no_grad():
        for imgs, labels in val_loader:
            imgs = imgs.to(DEVICE)
            logits = model(imgs)
            probs = torch.sigmoid(logits).cpu().numpy().ravel()
            all_preds.extend(probs)
            all_targets.extend(labels.numpy())
    auc = roc_auc_score(all_targets, all_preds)
    print(f"Fold {fold} AUROC: {auc:.4f}")
    aucs.append(auc)

mean_auc = np.mean(aucs)
print(f"Mean CV AUROC: {mean_auc:.4f}")

# Retrain on full data
full_ds = LesionDataset(df, IMG_DIR, transform=train_transform)
full_loader = DataLoader(full_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=4)
final_model = models.resnet18(pretrained=True)
for param in final_model.parameters():
    param.requires_grad = False
final_model.fc = nn.Linear(final_model.fc.in_features, 1)
final_model = final_model.to(DEVICE)
optimizer = optim.Adam(final_model.fc.parameters(), lr=1e-3)
criterion = nn.BCEWithLogitsLoss()
final_model.train()
for epoch in range(EPOCHS):
    for imgs, labels in full_loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE).unsqueeze(1)
        optimizer.zero_grad()
        loss = criterion(final_model(imgs), labels)
        loss.backward()
        optimizer.step()
# Save final model
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)
torch.save(final_model.state_dict(), MODEL_PATH)


# Prediction function
def predict(image_folder):
    """
    Predict malignancy probability for all .jpg images in image_folder.
    Returns a DataFrame with columns ['image_name','malignant_prob'].
    """
    # Load model
    model = models.resnet18(pretrained=False)
    model.fc = nn.Linear(model.fc.in_features, 1)
    model.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    model.to(DEVICE).eval()
    tf = val_transform
    results = []
    for fname in os.listdir(image_folder):
        if fname.lower().endswith(".jpg"):
            img = Image.open(os.path.join(image_folder, fname)).convert("RGB")
            inp = tf(img).unsqueeze(0).to(DEVICE)
            with torch.no_grad():
                prob = torch.sigmoid(model(inp)).item()
            results.append(
                {"image_name": os.path.splitext(fname)[0], "malignant_prob": prob}
            )
    return pd.DataFrame(results)


