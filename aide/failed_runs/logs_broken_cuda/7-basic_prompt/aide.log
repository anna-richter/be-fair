```python
import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
from torchvision import transforms, models
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score

# 1. Load metadata and labels
df = pd.read_csv("input/mydataset.csv")
df["binary_label"] = (df["label"] == "malignant").astype(int)
image_names = df["image_name"].tolist()
train_paths = [os.path.join("input", "MyImages", f"{n}.jpg") for n in image_names]
y = df["binary_label"].values

# 2. Prepare model and transforms
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
backbone = models.resnet18(pretrained=True)
feature_extractor = (
    torch.nn.Sequential(*list(backbone.children())[:-1]).to(device).eval()
)
feat_dim = backbone.fc.in_features  # 512 for ResNet18
transform = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


def extract_features(paths, batch_size=32):
    """
    Extract features with quad-TTA (original, H, V, HV) in batches.
    Args:
      paths (list of str): paths to images
      batch_size (int): number of images per batch
    Returns:
      numpy.ndarray of shape (len(paths), feat_dim)
    """
    flips = [(False, False), (True, False), (False, True), (True, True)]
    n = len(paths)
    feats = np.zeros((n, feat_dim), dtype=np.float32)
    with torch.no_grad():
        for hflip, vflip in flips:
            for i in range(0, n, batch_size):
                batch_paths = paths[i : i + batch_size]
                imgs = []
                for p in batch_paths:
                    img = Image.open(p).convert("RGB")
                    if hflip:
                        img = img.transpose(Image.FLIP_LEFT_RIGHT)
                    if vflip:
                        img = img.transpose(Image.FLIP_TOP_BOTTOM)
                    imgs.append(transform(img))
                x_batch = torch.stack(imgs, dim=0).to(device)
                f_batch = (
                    feature_extractor(x_batch)
                    .cpu()
                    .numpy()
                    .reshape(len(batch_paths), -1)
                )
                feats[i : i + batch_size] += f_batch
    feats /= len(flips)
    return feats


# 3. Extract batched TTA features for all training images
features = extract_features(train_paths, batch_size=64)

# 4. 5-fold CV for AUROC
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
for train_idx, val_idx in skf.split(features, y):
    clf = LogisticRegression(max_iter=1000, solver="lbfgs")
    clf.fit(features[train_idx], y[train_idx])
    probs = clf.predict_proba(features[val_idx])[:, 1]
    aucs.append(roc_auc_score(y[val_idx], probs))
mean_auc = np.mean(aucs)
print(f"Mean 5-fold AUROC: {mean_auc:.4f}")

# 5. Train final model on all data
final_clf = LogisticRegression(max_iter=1000, solver="lbfgs")
final_clf.fit(features, y)


def predict(image_dir, batch_size=64):
    """
    Predict malignancy probability for images in a directory using batched quad-TTA.
    Args:
      image_dir (str): path to folder containing .jpg images
      batch_size (int): batch size for feature extraction
    Returns:
      pandas.DataFrame with columns ['image_name','malignant_prob']
    """
    img_files = [f for f in os.listdir(image_dir) if f.lower().endswith(".jpg")]
    paths = [os.path.join(image_dir, f) for f in img_files]
    feats = extract_features(paths, batch_size=batch_size)
    probs = final_clf.predict_proba(feats)[:, 1]
    return pd.DataFrame({"image_name": img_files, "malignant_prob": probs})


# 6. Generate submission and save
submission = predict("input/MyImages", batch_size=64)
os.makedirs("working", exist_ok=True)
submission.to_csv("working/submission.csv", index=False)
print("Saved submission.csv with malignancy probabilities.")

