criterion = nn.BCEWithLogitsLoss()
optimizer = optim.Adam(model_full.parameters(), lr=1e-4)

model_full.train()
for epoch in range(5):
    for x, y in loader_full:
        x, y = x.to(device), y.float().to(device)
        optimizer.zero_grad()
        logits = model_full(x).squeeze(1)
        loss = criterion(logits, y)
        loss.backward()
        optimizer.step()

# Save model
os.makedirs("./working", exist_ok=True)
torch.save(model_full.state_dict(), "./working/model.pth")


# Prediction function
def predict(image_folder, batch_size=32):
    """Load trained model and predict malignant probability for each image in image_folder.
    Returns a DataFrame with columns [image_name, malignant_probability]."""
    # load model
    model = make_model()
    model.load_state_dict(torch.load("./working/model.pth", map_location=device))
    model.eval()
    # dataset
    files = sorted([f for f in os.listdir(image_folder) if f.lower().endswith(".jpg")])
    imgs = []
    names = []
    for f in files:
        path = os.path.join(image_folder, f)
        img = Image.open(path).convert("RGB")
        img = val_transform(img)
        imgs.append(img)
        names.append(os.path.splitext(f)[0])
    ds = torch.stack(imgs)
    loader = DataLoader(ds, batch_size=batch_size)
    probs = []
    with torch.no_grad():
        for batch in loader:
            batch = batch.to(device)
            logits = model(batch).squeeze(1)
            probs.extend(torch.sigmoid(logits).cpu().numpy().tolist())
    return pd.DataFrame({"image_name": names, "malignant_probability": probs})


# Generate submission
submission = predict("./input/MyImages")
submission.to_csv("./working/submission.csv", index=False)
print("Saved submission.csv")

