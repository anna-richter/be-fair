import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
from torchvision.models import efficientnet_b0, EfficientNet_B0_Weights

# Dataset
class SkinLesionDataset(Dataset):
    def __init__(self, df, image_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.image_dir = image_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.image_dir, row.image_name + '.jpg')
        img = Image.open(img_path).convert('RGB')
        if self.transform:
            img = self.transform(img)
        label = 1 if row.label == 'malignant' else 0
        return img, label

# Load metadata
df = pd.read_csv('./input/mydataset.csv')
# Keep only image_name and label
df = df[['image_name', 'label']].copy()

# Transforms
train_transform = transforms.Compose([
    transforms.Resize((224,224)),
    transforms.RandomHorizontalFlip(),
    transforms.RandomRotation(15),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225]),
])
val_transform = transforms.Compose([
    transforms.Resize((224,224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225]),
])

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')

def make_model():
    weights = EfficientNet_B0_Weights.IMAGENET1K_V1
    model = efficientnet_b0(weights=weights)
    # Replace head
    model.classifier[1] = nn.Linear(model.classifier[1].in_features, 1)
    return model.to(device)

# Cross-validation
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []

for fold, (train_idx, val_idx) in enumerate(skf.split(df, (df.label=='malignant').astype(int))):
    df_train = df.iloc[train_idx]
    df_val = df.iloc[val_idx]
    ds_train = SkinLesionDataset(df_train, './input/MyImages', transform=train_transform)
    ds_val = SkinLesionDataset(df_val, './input/MyImages', transform=val_transform)
    loader_train = DataLoader(ds_train, batch_size=32, shuffle=True, num_workers=4)
    loader_val = DataLoader(ds_val, batch_size=32, shuffle=False, num_workers=4)

    model = make_model()
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.parameters(), lr=1e-4)

    # train 2 epochs
    model.train()
    for epoch in range(2):
        for x,y in loader_train:
            x,y = x.to(device), y.float().to(device)
            optimizer.zero_grad()
            logits = model(x).squeeze(1)
            loss = criterion(logits, y)
            loss.backward()
            optimizer.step()

    # eval
    model.eval()
    preds, truths = [], []
    with torch.no_grad():
        for x,y in loader_val:
            x = x.to(device)
            logits = model(x).squeeze(1)
            probs = torch.sigmoid(logits).cpu().numpy()
            preds.extend(probs.tolist())
            truths.extend(y.numpy().tolist())
    auc = roc_auc_score(truths, preds)
    print(f'Fold {fold} AUROC: {auc:.4f}')
    aucs.append(auc)

mean_auc = np.mean(aucs)
print(f'Mean CV AUROC: {mean_auc:.4f}')

# Retrain on full data
ds_full = SkinLesionDataset(df, './input/MyImages', transform=train_transform)
loader_full = DataLoader(ds_full, batch_size=32, shuffle=True, num_workers=4)

model_full = make_model()
criterion = nn.BCEWithLogitsLoss()
optimizer = optim.Adam(model_full.parameters(), lr=1e-4)

model_full.train()
for epoch in range(5):
    for x,y in loader_full:
        x,y = x.to(device), y.float().to(device)
        optimizer.zero_grad()
        logits = model_full(x).squeeze(1)
        loss = criterion(logits, y)
        loss.backward()
        optimizer.step()

# Save model
os.makedirs('./working', exist_ok=True)
torch.save(model_full.state_dict(), './working/model.pth')

# Prediction function
def predict(image_folder, batch_size=32):
    """Load trained model and predict malignant probability for each image in image_folder.
    Returns a DataFrame with columns [image_name, malignant_probability]."""
    # load model
    model = make_model()
    model.load_state_dict(torch.load('./working/model.pth', map_location=device))
    model.eval()
    # dataset
    files = sorted([f for f in os.listdir(image_folder) if f.lower().endswith('.jpg')])
    imgs = []
    names = []
    for f in files:
        path = os.path.join(image_folder, f)
        img = Image.open(path).convert('RGB')
        img = val_transform(img)
        imgs.append(img)
        names.append(os.path.splitext(f)[0])
    ds = torch.stack(imgs)
    loader = DataLoader(ds, batch_size=batch_size)
    probs = []
    with torch.no_grad():
        for batch in loader:
            batch = batch.to(device)
            logits = model(batch).squeeze(1)
            probs.extend(torch.sigmoid(logits).cpu().numpy().tolist())
    return pd.DataFrame({'image_name': names, 'malignant_probability': probs})

# Generate submission
submission = predict('./input/MyImages')
submission.to_csv('./working/submission.csv', index=False)
print('Saved submission.csv')
