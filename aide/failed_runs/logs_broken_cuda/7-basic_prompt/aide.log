import os
import pandas as pd
import numpy as np
from PIL import Image
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score

# 1. Load metadata and labels
df = pd.read_csv("input/mydataset.csv")
df["binary_label"] = (df["label"] == "malignant").astype(int)
image_names = df["image_name"].tolist()
train_paths = [os.path.join("input", "MyImages", f"{n}.jpg") for n in image_names]
y = df["binary_label"].values

# 2. Prepare model and transforms
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
backbone = models.resnet18(pretrained=True)
feature_extractor = (
    torch.nn.Sequential(*list(backbone.children())[:-1]).to(device).eval()
)
feat_dim = backbone.fc.in_features  # 512 for ResNet18

base_transform = transforms.Compose(
    [
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
    ]
)


class QuadTTADataset(Dataset):
    """Dataset returning 4 TTA variants per image: orig, H flip, V flip, HV flip."""

    def __init__(self, paths, transform):
        self.paths = paths
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        p = self.paths[idx]
        img = Image.open(p).convert("RGB")
        t = self.transform
        i0 = t(img)
        i1 = t(img.transpose(Image.FLIP_LEFT_RIGHT))
        i2 = t(img.transpose(Image.FLIP_TOP_BOTTOM))
        i3 = t(img.transpose(Image.FLIP_LEFT_RIGHT).transpose(Image.FLIP_TOP_BOTTOM))
        # Stack into shape (4, C, H, W)
        return torch.stack([i0, i1, i2, i3], dim=0)


def extract_features(paths, batch_size=64, num_workers=4):
    """
    Extract features with quad-TTA in one forward pass per batch.
    Returns: np.ndarray of shape (len(paths), feat_dim)
    """
    ds = QuadTTADataset(paths, base_transform)
    loader = DataLoader(
        ds,
        batch_size=batch_size,
        shuffle=False,
        num_workers=num_workers,
        pin_memory=True,
    )
    all_feats = np.zeros((len(paths), feat_dim), dtype=np.float32)
    idx = 0
    with torch.no_grad():
        for batch in loader:
            # batch shape: (B, 4, C, H, W)
            B = batch.size(0)
            x = batch.view(B * 4, *batch.shape[2:]).to(device, non_blocking=True)
            f = feature_extractor(x)  # (B*4, feat_dim, 1,1)
            f = f.view(B, 4, feat_dim).mean(dim=1).cpu().numpy()
            all_feats[idx : idx + B] = f
            idx += B
    return all_feats


# 3. Extract features once
features = extract_features(train_paths, batch_size=64)

# 4. 5-fold CV for AUROC
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
for tr, va in skf.split(features, y):
    clf = LogisticRegression(max_iter=1000, solver="lbfgs")
    clf.fit(features[tr], y[tr])
    probs = clf.predict_proba(features[va])[:, 1]
    aucs.append(roc_auc_score(y[va], probs))
mean_auc = np.mean(aucs)
print(f"Mean 5-fold AUROC: {mean_auc:.4f}")

# 5. Train final model
final_clf = LogisticRegression(max_iter=1000, solver="lbfgs")
final_clf.fit(features, y)


def predict(image_dir, batch_size=64, num_workers=4):
    """
    Predict malignancy probabilities for all .jpg files in image_dir.
    Returns a DataFrame with columns ['image_name','malignant_prob'].
    """
    img_files = sorted([f for f in os.listdir(image_dir) if f.lower().endswith(".jpg")])
    paths = [os.path.join(image_dir, f) for f in img_files]
    feats = extract_features(paths, batch_size=batch_size, num_workers=num_workers)
    probs = final_clf.predict_proba(feats)[:, 1]
    return pd.DataFrame({"image_name": img_files, "malignant_prob": probs})


# 6. Generate submission
submission = predict("input/MyImages", batch_size=64)
os.makedirs("working", exist_ok=True)
submission.to_csv("working/submission.csv", index=False)
print("Saved submission.csv with malignancy probabilities.")

