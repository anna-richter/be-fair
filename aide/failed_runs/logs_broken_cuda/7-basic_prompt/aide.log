    probs = clf.predict_proba(features[val_idx])[:,1]
    aucs.append(roc_auc_score(y[val_idx], probs))
mean_auc = np.mean(aucs)
print(f"Mean 5-fold AUROC with EfficientNet-B0 + 4-way TTA: {mean_auc:.4f}")

