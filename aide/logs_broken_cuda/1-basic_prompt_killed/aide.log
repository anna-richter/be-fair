import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader, Subset
import torchvision.transforms as T
import timm

# Dataset class
class SkinLesionDataset(Dataset):
    def __init__(self, df, img_dir, transform=None):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, f"{row.image_name}.jpg")
        img = Image.open(img_path).convert("RGB")
        if self.transform:
            img = self.transform(img)
        label = torch.tensor(row.label_bin, dtype=torch.float32)
        return img, label

# Train and validate for one fold
def train_fold(model, device, train_loader, val_loader, epochs=3):
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-5)
    for epoch in range(epochs):
        model.train()
        for imgs, lbls in train_loader:
            imgs, lbls = imgs.to(device), lbls.to(device).unsqueeze(1)
            preds = model(imgs)
            loss = criterion(preds, lbls)
            optimizer.zero_grad(); loss.backward(); optimizer.step()
    model.eval()
    ys, ps = [], []
    with torch.no_grad():
        for imgs, lbls in val_loader:
            imgs = imgs.to(device)
            logits = model(imgs).squeeze(1).cpu().numpy()
            prob = 1 / (1 + np.exp(-logits))
            ps.extend(prob)
            ys.extend(lbls.numpy())
    return roc_auc_score(ys, ps)

# Predict function
def predict(model, image_paths, img_dir, device):
    """Given a trained model, returns malignant probabilities for list of image filenames (without extension)."""
    model.eval()
    transform = T.Compose([
        T.Resize((224,224)),
        T.ToTensor(),
        T.Normalize(mean=(0.485,0.456,0.406),std=(0.229,0.224,0.225))
    ])
    probs = []
    with torch.no_grad():
        for name in image_paths:
            img = Image.open(os.path.join(img_dir, f"{name}.jpg")).convert("RGB")
            x = transform(img).unsqueeze(0).to(device)
            logit = model(x).item()
            probs.append(1/(1+np.exp(-logit)))
    return probs

def main():
    # Config
    data_csv = "./input/mydataset.csv"
    img_dir = "./input/MyImages"
