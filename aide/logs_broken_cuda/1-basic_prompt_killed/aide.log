                    std=(0.229, 0.224, 0.225)),
    ])

    # Datasets and loaders
    ds_train = SkinLesionDataset(train_df, img_dir, transform=train_transform)
    ds_val = SkinLesionDataset(val_df, img_dir, transform=val_transform)
    dl_train = DataLoader(ds_train, batch_size=64, shuffle=True, num_workers=4, pin_memory=True)
