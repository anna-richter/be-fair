    model.eval()
    probs = []
    with torch.no_grad():
        for p in image_paths:
            img = Image.open(p).convert("RGB")
            img = transform(img).unsqueeze(0).to(device)
            logits = model(img)
            prob = torch.sigmoid(logits).item()
            probs.append(prob)
