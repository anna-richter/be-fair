            imgs, lbls = imgs.to(device), lbls.to(device).unsqueeze(1)
            preds = final_model(imgs)
            loss = criterion(preds, lbls)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    # Example prediction usage and saving to submission.csv (if needed)
    # Here we just demonstrate on first 10 images
    sample_names = df.image_name.tolist()[:10]
    probs = predict(final_model, sample_names, img_dir, device)
    sub = pd.DataFrame({"image_name": sample_names, "malignant_prob": probs})
    sub.to_csv("./working/submission.csv", index=False)
    print("Sample predictions saved to ./working/submission.csv")


if __name__ == "__main__":
    main()

