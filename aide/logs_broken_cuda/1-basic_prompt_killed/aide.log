            avg_probs = ((probs1 + probs2) / 2).cpu().numpy()
            all_preds.extend(avg_probs.tolist())
            all_trues.extend(labels.numpy().tolist())

    auc = roc_auc_score(all_trues, all_preds)
    print(f"Validation AUROC with CosineAnnealingLR: {auc:.4f}")


