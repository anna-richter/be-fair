Design: I propose adding a StandardScaler to normalize the ResNet‐50 features before logistic regression, by wrapping both in an sklearn Pipeline. This will ensure the linear classifier sees standardized inputs, often boosting performance. We’ll build a pipeline of (scaler, logistic regression), evaluate via 5‐fold CV, then train on all data and save the pipeline for inference. The predict() function will load this pipeline and reuse the same feature extractor to return malignancy probabilities.
Code: import os
import pandas as pd
import numpy as np
from PIL import Image
import joblib
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score


class ImageDataset(Dataset):
    def __init__(self, image_names, image_dir, transform):
        self.image_names = image_names
        self.image_dir = image_dir
        self.transform = transform

    def __len__(self):
        return len(self.image_names)

    def __getitem__(self, idx):
        name = self.image_names[idx]
        path = os.path.join(self.image_dir, name + ".jpg")
        img = Image.open(path).convert("RGB")
        return self.transform(img), name


def extract_features(model, loader, device):
    model.eval()
    feats = []
    names = []
    with torch.no_grad():
        for imgs, batch_names in loader:
            imgs = imgs.to(device)
            f = model(imgs).cpu().numpy()
            feats.append(f)
            names.extend(batch_names)
    feats = np.vstack(feats)
    return feats, names


def predict(image_folder: str, model_path: str = "working/logistic.pkl"):
    """
    Predict malignancy probabilities for .jpg images in a folder.
    Args:
        image_folder (str): Directory containing .jpg images
        model_path (str): Path to saved sklearn Pipeline
    Returns:
        pandas.DataFrame with columns ['image_name', 'malignant_prob']
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    backbone = models.resnet50(pretrained=True)
    backbone.fc = torch.nn.Identity()
    backbone.to(device)
    backbone.eval()
    tfm = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    imgs = [
        os.path.splitext(f)[0]
        for f in os.listdir(image_folder)
        if f.lower().endswith(".jpg")
    ]
    ds = ImageDataset(imgs, image_folder, tfm)
    loader = DataLoader(ds, batch_size=64, num_workers=4, shuffle=False)
    feats, names = extract_features(backbone, loader, device)
    pipeline = joblib.load(model_path)
    probs = pipeline.predict_proba(feats)[:, 1]
    return pd.DataFrame({"image_name": names, "malignant_prob": probs})


if __name__ == "__main__":
    # paths
    csv_path = "./input/mydataset.csv"
    image_dir = "./input/MyImages"
    working_dir = "./working"
    os.makedirs(working_dir, exist_ok=True)

    # load data
    df = pd.read_csv(csv_path)
    df["target"] = (df["label"] == "malignant").astype(int)
    image_names = df["image_name"].tolist()
    labels = df["target"].values

    # transforms & device
    tfm = transforms.Compose(
        [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        ]
    )
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    # feature extractor
    backbone = models.resnet50(pretrained=True)
    backbone.fc = torch.nn.Identity()
    backbone.to(device)

    # extract features
    ds_all = ImageDataset(image_names, image_dir, tfm)
    loader_all = DataLoader(ds_all, batch_size=64, num_workers=4, shuffle=False)
    X, names_order = extract_features(backbone, loader_all, device)

    # align labels
    name_to_target = dict(zip(df["image_name"], df["target"]))
    y = np.array([name_to_target[n] for n in names_order])

    # 5-fold CV with scaling + logistic
    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    aucs = []
    for i, (train_idx, val_idx) in enumerate(skf.split(X, y), 1):
        X_train, X_val = X[train_idx], X[val_idx]
        y_train, y_val = y[train_idx], y[val_idx]
        pipeline = Pipeline(
            [
                ("scaler", StandardScaler()),
                ("clf", LogisticRegression(solver="lbfgs", max_iter=1000)),
            ]
        )
        pipeline.fit(X_train, y_train)
        preds = pipeline.predict_proba(X_val)[:, 1]
        auc = roc_auc_score(y_val, preds)
        print(f"Fold {i} AUROC: {auc:.4f}")
        aucs.append(auc)
    print(f"Mean CV AUROC: {np.mean(aucs):.4f}")

    # train final pipeline on all data
    final_pipeline = Pipeline(
        [
            ("scaler", StandardScaler()),
            ("clf", LogisticRegression(solver="lbfgs", max_iter=1000)),
        ]
    )
    final_pipeline.fit(X, y)
    joblib.dump(final_pipeline, os.path.join(working_dir, "logistic.pkl"))

