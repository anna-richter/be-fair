import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
import torch.nn as nn
import torch.optim as optim


class SkinLesionDataset(Dataset):
    def __init__(self, df, image_dir, transform):
        self.df = df.reset_index(drop=True)
        self.image_dir = image_dir
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.image_dir, row.image_name + ".jpg")
        img = Image.open(img_path).convert("RGB")
        img = self.transform(img)
        label = torch.tensor(row.label, dtype=torch.float32)
        return img, label


class InferenceDataset(Dataset):
    def __init__(self, image_paths, transform):
        self.image_paths = image_paths
        self.transform = transform

    def __len__(self):
        return len(self.image_paths)

    def __getitem__(self, idx):
        path = self.image_paths[idx]
        img = Image.open(path).convert("RGB")
        img = self.transform(img)
        name = os.path.splitext(os.path.basename(path))[0]
        return img, name


def predict(image_dir, model, device, batch_size=32):
    """
    Predict malignant probabilities for all .jpg in image_dir.
    Args:
        image_dir (str): directory containing .jpg images to predict on.
        model (torch.nn.Module): trained model.
        device (torch.device): cpu or cuda.
        batch_size (int): batch size for DataLoader.
    Returns:
        pd.DataFrame with columns ['image_name','malignant_probability'].
    """
    model.eval()
    transform = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ]
    )
    files = [
        os.path.join(image_dir, f)
        for f in os.listdir(image_dir)
        if f.lower().endswith(".jpg")
    ]
    ds = InferenceDataset(files, transform)
    dl = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=4)
    names, preds = [], []
    with torch.no_grad():
        for imgs, img_names in dl:
            imgs = imgs.to(device)
            logits = model(imgs)
            probs = torch.sigmoid(logits).cpu().numpy().flatten()
            preds.extend(probs.tolist())
            names.extend(img_names)
    return pd.DataFrame({"image_name": names, "malignant_probability": preds})


if __name__ == "__main__":
    # Config
    data_csv = "./input/mydataset.csv"
    image_dir = "./input/MyImages"
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    df = pd.read_csv(data_csv)
    df["label"] = df["label"].apply(lambda x: 1 if x == "malignant" else 0)

    skf = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)
    fold_aucs = []
    for fold, (train_idx, val_idx) in enumerate(skf.split(df, df.label)):
        train_df = df.iloc[train_idx]
        val_df = df.iloc[val_idx]

        train_tf = transforms.Compose(
            [
                transforms.RandomResizedCrop(224),
                transforms.RandomHorizontalFlip(),
                transforms.ToTensor(),
                transforms.Normalize(
                    mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]
                ),
            ]
        )
        val_tf = transforms.Compose(
            [
                transforms.Resize(256),
                transforms.CenterCrop(224),
                transforms.ToTensor(),
                transforms.Normalize(
                    mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]
                ),
            ]
        )

        train_ds = SkinLesionDataset(train_df, image_dir, train_tf)
        val_ds = SkinLesionDataset(val_df, image_dir, val_tf)
        train_dl = DataLoader(train_ds, batch_size=32, shuffle=True, num_workers=4)
        val_dl = DataLoader(val_ds, batch_size=32, shuffle=False, num_workers=4)

        # Use a lighter backbone to speed up training
        model = models.mobilenet_v2(pretrained=True)
        in_ftrs = model.classifier[1].in_features
        model.classifier[1] = nn.Linear(in_ftrs, 1)
        model = model.to(device)

        criterion = nn.BCEWithLogitsLoss()
        optimizer = optim.Adam(model.parameters(), lr=1e-3)

        # Train for 2 epochs per fold
        for epoch in range(2):
            model.train()
            for imgs, labels in train_dl:
                imgs, labels = imgs.to(device), labels.to(device).unsqueeze(1)
                optimizer.zero_grad()
                logits = model(imgs)
                loss = criterion(logits, labels)
                loss.backward()
                optimizer.step()

        # Validate
        model.eval()
        preds, trues = [], []
        with torch.no_grad():
            for imgs, labels in val_dl:
                imgs = imgs.to(device)
                logits = model(imgs)
                probs = torch.sigmoid(logits).cpu().numpy().flatten()
                preds.extend(probs.tolist())
                trues.extend(labels.numpy().flatten().tolist())
        auc = roc_auc_score(trues, preds)
        print(f"Fold {fold+1} AUROC: {auc:.4f}")
        fold_aucs.append(auc)
        best_model = model  # keep last fold's model

    print(f"Average Validation AUROC: {np.mean(fold_aucs):.4f}")
    # If you have new images to predict, uncomment and adjust the line below:
    # submission = predict("./input/MyTestImages", best_model, device)
    # submission.to_csv("./working/submission.csv", index=False)

