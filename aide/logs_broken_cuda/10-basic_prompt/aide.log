import os
import pandas as pd
import numpy as np
from PIL import Image
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import torch
from torch import nn, optim
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T
import torchvision.models as models

DATA_CSV = "./input/mydataset.csv"
IMG_DIR = "./input/MyImages"
MODEL_PATH = "./working/model.pth"
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

class SkinDataset(Dataset):
    def __init__(self, df, img_dir, transform):
        self.df = df.reset_index(drop=True)
        self.img_dir = img_dir
        self.transform = transform
        # malignant=1, others=0
        self.labels = (self.df['label'] == 'malignant').astype(int).values
    def __len__(self):
        return len(self.df)
    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path = os.path.join(self.img_dir, row['image_name'] + ".jpg")
        img = Image.open(img_path).convert("RGB")
        img = self.transform(img)
        label = self.labels[idx]
        return img, label

def train_epoch(model, loader, criterion, optimizer):
    model.train()
    running = 0.0
    for imgs, labels in loader:
        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)
        optimizer.zero_grad()
        out = model(imgs)
        loss = criterion(out, labels)
        loss.backward()
        optimizer.step()
        running += loss.item() * imgs.size(0)
    return running / len(loader.dataset)

def eval_epoch(model, loader):
    model.eval()
    probs, targets = [], []
    with torch.no_grad():
        for imgs, labels in loader:
            imgs = imgs.to(DEVICE)
            out = model(imgs)
            p = torch.softmax(out, dim=1)[:,1].cpu().numpy()
            probs.append(p)
            targets.append(labels.numpy())
    probs = np.concatenate(probs)
    targets = np.concatenate(targets)
    return roc_auc_score(targets, probs)

# read data
df = pd.read_csv(DATA_CSV)
df['image_name'] = df['image_name'].astype(str)
# 5-fold CV
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
aucs = []
for fold, (train_idx, val_idx) in enumerate(skf.split(df, (df['label']=='malignant'))):
    train_df, val_df = df.iloc[train_idx], df.iloc[val_idx]
    tr_tf = T.Compose([T.Resize((224,224)), T.RandomHorizontalFlip(), T.ToTensor(),
                       T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])
    val_tf = T.Compose([T.Resize((224,224)), T.ToTensor(),
                        T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])
    tr_ds = SkinDataset(train_df, IMG_DIR, tr_tf)
    vl_ds = SkinDataset(val_df, IMG_DIR, val_tf)
    tr_ld = DataLoader(tr_ds, batch_size=32, shuffle=True, num_workers=4)
    vl_ld = DataLoader(vl_ds, batch_size=32, shuffle=False, num_workers=4)
    model = models.resnet18(pretrained=True)
    model.fc = nn.Linear(model.fc.in_features, 2)
    model = model.to(DEVICE)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    for epoch in range(2):
        train_epoch(model, tr_ld, criterion, optimizer)
    auc = eval_epoch(model, vl_ld)
    print(f"Fold {fold} AUROC: {auc:.4f}")
    aucs.append(auc)
print(f"Mean validation AUROC: {np.mean(aucs):.4f}")

# Retrain on full data
full_tf = T.Compose([T.Resize((224,224)), T.RandomHorizontalFlip(), T.ToTensor(),
                     T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])
full_ds = SkinDataset(df, IMG_DIR, full_tf)
full_ld = DataLoader(full_ds, batch_size=32, shuffle=True, num_workers=4)
model = models.resnet18(pretrained=True)
model.fc = nn.Linear(model.fc.in_features, 2)
model = model.to(DEVICE)
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=1e-4)
for epoch in range(3):
    train_epoch(model, full_ld, criterion, optimizer)
torch.save(model.state_dict(), MODEL_PATH)

def predict(image_dir, batch_size=32):
    """
    Predict malignant probability for all images in image_dir.
    Returns a DataFrame with columns ['image_name','malignant_prob'].
    """
    df_pred = pd.DataFrame({'image_name': [f[:-4] for f in os.listdir(image_dir) if f.lower().endswith('.jpg')]})
    tf = T.Compose([T.Resize((224,224)), T.ToTensor(),
                    T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])
    class PredDS(Dataset):
        def __init__(self, df, img_dir, transform):
            self.df, self.img_dir, self.transform = df, img_dir, transform
        def __len__(self):
            return len(self.df)
        def __getitem__(self, i):
            name = self.df.iloc[i]['image_name']
            img = Image.open(os.path.join(self.img_dir, name+".jpg")).convert("RGB")
            return self.transform(img), name
    ds = PredDS(df_pred, image_dir, tf)
    ld = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=4)
    model = models.resnet18(pretrained=False)
    model.fc = nn.Linear(model.fc.in_features, 2)
    model.load_state_dict(torch.load(MODEL_PATH, map_location=DEVICE))
    model = model.to(DEVICE).eval()
    results = []
    with torch.no_grad():
        for imgs, names in ld:
            imgs = imgs.to(DEVICE)
            out = model(imgs)
            p = torch.softmax(out, dim=1)[:,1].cpu().numpy()
            for name, prob in zip(names, p):
                results.append({'image_name': name, 'malignant_prob': prob})
    return pd.DataFrame(results)

