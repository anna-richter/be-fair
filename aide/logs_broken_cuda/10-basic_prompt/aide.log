        if self.transform:
            img = self.transform(img)
        label = 1 if row["label"] == "malignant" else 0
        return img, label


# 2. Load data and split
df = pd.read_csv("./input/mydataset.csv")
df["label"] = df["label"].map(
    lambda x: "malignant" if x == "malignant" else "benign_or_other"
)
train_df, val_df = train_test_split(
    df, test_size=0.2, stratify=df["label"], random_state=42
)

# 3. Transforms and dataloaders
mean, std = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]
tfm = transforms.Compose(
    [
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean, std),
    ]
)
train_ds = SkinLesionDataset(train_df, "./input/MyImages", tfm)
val_ds = SkinLesionDataset(val_df, "./input/MyImages", tfm)
train_loader = DataLoader(train_ds, batch_size=64, shuffle=False, num_workers=4)
val_loader = DataLoader(val_ds, batch_size=64, shuffle=False, num_workers=4)

# 4. Feature extractor
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
backbone = models.resnet50(pretrained=True)
backbone.fc = torch.nn.Identity()  # remove final layer
backbone = backbone.to(device).eval()
for p in backbone.parameters():
    p.requires_grad = False


def extract_features(loader):
    feats = []
    labels = []
    with torch.no_grad():
        for imgs, lbls in loader:
            imgs = imgs.to(device)
            out = backbone(imgs)  # batch x 2048
            feats.append(out.cpu().numpy())
            labels.extend(lbls.numpy())
    return np.vstack(feats), np.array(labels)


# 5. Extract train/val features
X_train, y_train = extract_features(train_loader)
X_val, y_val = extract_features(val_loader)

# 6. Train a logistic regression
clf = LogisticRegression(max_iter=1000, class_weight="balanced")
clf.fit(X_train, y_train)
probs = clf.predict_proba(X_val)[:, 1]
auc = roc_auc_score(y_val, probs)
print(f"Validation AUROC: {auc:.4f}")

# 7. Save classifier and feature extractor config
os.makedirs("./working", exist_ok=True)
with open("./working/logreg.pkl", "wb") as f:
    pickle.dump(clf, f)
# we will reload the ResNet50 in predict()


# 8. Predict function
def predict(
    image_paths,
    backbone_model=None,
    classifier_path="./working/logreg.pkl",
    batch_size=64,
):
    """
    Predict malignant probability for each image path.
    Args:
      image_paths: list of file paths to images.
      backbone_model: optional pretrained resnet50 without fc. If None, will load.
      classifier_path: path to pickled LogisticRegression.
      batch_size: inference batch size.
    Returns:
      np.ndarray of probabilities.
    """
    if backbone_model is None:
        backbone_model = models.resnet50(pretrained=True)
        backbone_model.fc = torch.nn.Identity()
        backbone_model = backbone_model.to(device).eval()
    with open(classifier_path, "rb") as f:
        clf = pickle.load(f)
    tfm = transforms.Compose(
        [
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean, std),
        ]
    )
    all_probs = []
    # batch inference
    for i in range(0, len(image_paths), batch_size):
        batch_paths = image_paths[i : i + batch_size]
        imgs = [tfm(Image.open(p).convert("RGB")) for p in batch_paths]
        imgs = torch.stack(imgs).to(device)
        with torch.no_grad():
            feats = backbone_model(imgs).cpu().numpy()
        probs = clf.predict_proba(feats)[:, 1]
        all_probs.extend(probs.tolist())
    return np.array(all_probs)


