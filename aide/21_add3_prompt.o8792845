                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform=None):                                            
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    row.image_name +                                            
                    '.jpg')).convert('RGB')                                     
                            if self.transform:                                  
                                img = self.transform(img)                       
                            label =                                             
                    torch.tensor(row.label,                                     
                    dtype=torch.float32)                                        
                            return img, label,                                  
                    row.skin_tone, row.image_name                               
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        total_loss = 0                                          
                        for imgs, labels, _, _ in loader:                       
                            imgs, labels =                                      
                    imgs.to(device), labels.to(device)                          
                            optimizer.zero_grad()                               
                            outputs =                                           
                    model(imgs).squeeze(1)                                      
                            loss = criterion(outputs,                           
                    labels)                                                     
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    imgs.size(0)                                                
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                    def eval_model(model, loader, device):                      
                        model.eval()                                            
                        preds, targets = [], []                                 
                        with torch.no_grad():                                   
                            for imgs, labels, _, _ in                           
                    loader:                                                     
                                imgs = imgs.to(device)                          
                                outputs =                                       
                    torch.sigmoid(model(imgs).squeeze(1))                       
                                preds.append(outputs.cpu()                      
                    .numpy())                                                   
                                targets.append(labels.nump                      
                    y())                                                        
                        preds = np.concatenate(preds)                           
                        targets = np.concatenate(targets)                       
                        return roc_auc_score(targets,                           
                    preds)                                                      
                                                                                
                    def predict(image_folder):                                  
                        """                                                     
