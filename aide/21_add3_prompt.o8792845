                    labels.to(device)                                           
                            preds = model(imgs).squeeze(1)                      
                            loss = criterion(preds, labels)                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                                                                                
                    def eval_fold(model, loader, device):                       
                        model.eval()                                            
                        ys, ps = [], []                                         
                        with torch.no_grad():                                   
                            for imgs, labels in loader:                         
                                bs, nc, c, h, w =                               
                    imgs.shape                                                  
