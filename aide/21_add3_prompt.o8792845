                    ```python                                                   
                    import os                                                   
                    import random                                               
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    import torch                                                
                    import torch.nn as nn                                       
                    from torch.utils.data import Dataset,                       
                    DataLoader, WeightedRandomSampler                           
                    from torchvision import transforms,                         
                    models                                                      
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                                                                                
                    def cutmix_data(x, y, alpha=1.0):                           
                        if alpha <= 0:                                          
                            return x, y, y, 1.0                                 
                        lam = np.random.beta(alpha, alpha)                      
                        batch_size, _, H, W = x.size()                          
                        rand_index =                                            
                    torch.randperm(batch_size).to(x.device                      
                    )                                                           
                        y_a, y_b = y, y[rand_index]                             
                        # generate bounding box                                 
                        cut_rat = np.sqrt(1. - lam)                             
                        cut_w = int(W * cut_rat)                                
                        cut_h = int(H * cut_rat)                                
                        cx = np.random.randint(W)                               
                        cy = np.random.randint(H)                               
                        x1 = np.clip(cx - cut_w // 2, 0,                        
                    W)                                                          
                        y1 = np.clip(cy - cut_h // 2, 0,                        
                    H)                                                          
                        x2 = np.clip(cx + cut_w // 2, 0,                        
                    W)                                                          
                        y2 = np.clip(cy + cut_h // 2, 0,                        
                    H)                                                          
                        x[:, :, y1:y2, x1:x2] =                                 
                    x[rand_index, :, y1:y2, x1:x2]                              
                        lam = 1. - ((x2 - x1) * (y2 - y1)                       
                    / float(W * H))                                             
                        return x, y_a, y_b, lam                                 
                                                                                
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.df)                                 
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    row.image_name +                                            
                    ".jpg")).convert("RGB")                                     
                            data = self.transform(img)                          
                            label =                                             
                    torch.tensor(row.label,                                     
                    dtype=torch.float32)                                        
                            return data, label                                  
                                                                                
                    def train_fold(model, loader,                               
                    criterion, optimizer, device,                               
                    cutmix_alpha=1.0, cutmix_prob=0.5):                         
                        model.train()                                           
                        for imgs, labels in loader:                             
                            imgs, labels =                                      
                    imgs.to(device), labels.to(device)                          
                            if random.random() <                                
                    cutmix_prob:                                                
                                imgs, y_a, y_b, lam =                           
                    cutmix_data(imgs, labels,                                   
                    alpha=cutmix_alpha)                                         
                                preds =                                         
                    model(imgs).squeeze(1)                                      
                                loss = lam *                                    
                    criterion(preds, y_a) + (1 - lam) *                         
                    criterion(preds, y_b)                                       
                            else:                                               
                                preds =                                         
                    model(imgs).squeeze(1)                                      
                                loss = criterion(preds,                         
                    labels)                                                     
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                                                                                
                    def eval_fold(model, loader, device):                       
                        model.eval()                                            
                        all_labels, all_probs = [], []                          
