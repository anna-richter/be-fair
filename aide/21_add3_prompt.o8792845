                    0.456, 0.406],[0.229, 0.224, 0.225]),                       
                        ])                                                      
                        results = []                                            
                        for fname in                                            
                    sorted(os.listdir(img_folder)):                             
                            if                                                  
                    fname.lower().endswith((".jpg",                             
                    ".png", ".jpeg")):                                          
                                img =                                           
                    Image.open(os.path.join(img_folder,                         
                    fname)).convert("RGB")                                      
                                x =                                             
                    tf(img).unsqueeze(0).to(device)                             
                                x_flip = torch.flip(x,                          
                    dims=[3])                                                   
                                with torch.no_grad():                           
                                    p1 =                                        
                    torch.sigmoid(model(x)).item()                              
                                    p2 =                                        
                    torch.sigmoid(model(x_flip)).item()                         
                                prob = (p1 + p2) / 2                            
                                results.append({                                
