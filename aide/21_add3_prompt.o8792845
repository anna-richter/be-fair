                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img =                                               
                    Image.open(os.path.join(self.img_dir,                       
                    row.image_name +                                            
                    ".jpg")).convert("RGB")                                     
                            data = self.transform(img)                          
                            # data shape: if TTA,                               
                    (n_crops, C, H, W) else (C,H,W)                             
