                            optimizer.zero_grad()                               
                            outputs = model(imgs)                               
                            loss = criterion(outputs,                           
                    lbls)                                                       
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
