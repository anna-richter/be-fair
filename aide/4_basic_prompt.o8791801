                    device)                                                     
                                scheduler.step()                                
                            # Evaluate                                          
                            auc = eval_model(model,                             
                    val_loader, device)                                         
                            print(f"Fold {fold+1} ROC AUC:                      
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
                        mean_auc, std_auc = np.mean(aucs),                      
                    np.std(aucs)                                                
                        print(f"Mean CV ROC AUC:                                
                    {mean_auc:.4f} ± {std_auc:.4f}")                            
                        # Retrain on full data                                  
                        full_ds = LesionDataset(df,                             
                    img_dir, train_transform)                                   
                        full_loader = DataLoader(full_ds,                       
                    batch_size=32, shuffle=True,                                
