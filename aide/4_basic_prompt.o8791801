                            models_list.append(model)                           
                        transform = transforms.Compose([                        
                            transforms.Resize((224, 224)),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize(mean=[0.4                      
                    85, 0.456, 0.406], std=[0.229, 0.224,                       
                    0.225]),                                                    
                        ])                                                      
                        results = []                                            
                        for fname in                                            
