                                    outputs, lbls_shuf                          
                                )                                               
                            else:                                               
                                outputs = model(imgs)                           
                                loss = criterion(outputs,                       
                    lbls)                                                       
                            optimizer.zero_grad()                               
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        return running_loss /                                   
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    def eval_model(model, loader, device):                      
