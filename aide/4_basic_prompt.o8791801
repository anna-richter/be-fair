                            auc = eval_model(model, val_ld,                     
                    device)                                                     
                            print(f"Fold {fold+1} ROC AUC:                      
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
                            torch.save(model.state_dict(),                      
