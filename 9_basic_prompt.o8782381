                    targets.to(device).unsqueeze(1)                             
                            optimizer.zero_grad()                               
                            logits = model(imgs)                                
                            loss = criterion(logits,                            
                    targets)                                                    
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
