                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms                          
                    import timm                                                 
                                                                                
                                                                                
                    # Dataset for training/validation                           
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row['image_name']}.jpg")                                 
                            image =                                             
                    Image.open(img_path).convert("RGB")                         
                            x = self.transform(image)                           
                            y = 1 if row["label"] ==                            
                    "malignant" else 0                                          
                            return x, y                                         
                                                                                
                                                                                
                    # Dataset for prediction                                    
                    class PredictDataset(Dataset):                              
                        def __init__(self, image_paths,                         
                    transform):                                                 
                            self.image_paths = image_paths                      
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                                                                                
                        def __getitem__(self, idx):                             
                            path = self.image_paths[idx]                        
                            img =                                               
                    Image.open(path).convert("RGB")                             
                            return self.transform(img)                          
                                                                                
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        total_loss = 0.0                                        
                        for xb, yb in loader:                                   
                            xb, yb = xb.to(device),                             
                    yb.to(device,                                               
                    dtype=torch.float32).unsqueeze(1)                           
                            optimizer.zero_grad()                               
                            out = model(xb)                                     
                            loss = criterion(out, yb)                           
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    xb.size(0)                                                  
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        all_preds, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for xb, yb in loader:                               
                                xb = xb.to(device)                              
                                out = model(xb)                                 
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatte                     
                    n()                                                         
                                all_preds.extend(probs)                         
                                all_labels.extend(yb.numpy(                     
                    ))                                                          
                        return np.array(all_labels),                            
                    np.array(all_preds)                                         
                                                                                
                                                                                
                    def predict(model, image_paths, device,                     
                    transform, batch_size=32):                                  
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths.                             
                        Args:                                                   
                          model: trained torch.nn.Module                        
                          image_paths: list of strings                          
                    (paths to .jpg files)                                       
                          device: torch.device                                  
                          transform:                                            
