                    torch.stack(imgs).to(device)                                
                                outputs = model(imgs)                           
                                probs =                                         
                    torch.sigmoid(outputs).cpu().numpy().r                      
                    avel().tolist()                                             
                                preds.extend(probs)                             
                        return preds                                            
                                                                                
                    # If test images folder exists,                             
                    generate submission.csv                                     
                    test_dir = "input/test_images"                              
                    if os.path.isdir(test_dir):                                 
                        test_paths =                                            
                    sorted([os.path.join(test_dir,f) for f                      
                    in os.listdir(test_dir) if                                  
                    f.lower().endswith(('.jpg','.png'))])                       
                        probs = predict(test_paths)                             
                        submission = pd.DataFrame({                             
                            "image_name":                                       
                    [os.path.basename(p) for p in                               
                    test_paths],                                                
                            "malignant_prob": probs                             
                        })                                                      
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        submission.to_csv("working/submiss                      
                    ion.csv", index=False)                                      
