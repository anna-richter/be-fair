                    import os                                                   
                    import pandas as pd                                         
                    import numpy as np                                          
                    from PIL import Image                                       
                    from sklearn.model_selection import                         
                    StratifiedKFold                                             
                    from sklearn.metrics import                                 
                    roc_auc_score                                               
                    import torch                                                
                    from torch import nn, optim                                 
                    from torch.utils.data import Dataset,                       
                    DataLoader                                                  
                    from torchvision import transforms                          
                    import timm                                                 
                                                                                
                    # Dataset for training/validation                           
                    class SkinLesionDataset(Dataset):                           
                        def __init__(self, df, img_dir,                         
                    transform):                                                 
                            self.df =                                           
                    df.reset_index(drop=True)                                   
                            self.img_dir = img_dir                              
                            self.transform = transform                          
                                                                                
                        def __len__(self):                                      
                            return len(self.df)                                 
                                                                                
                        def __getitem__(self, idx):                             
                            row = self.df.iloc[idx]                             
                            img_path =                                          
                    os.path.join(self.img_dir,                                  
                    f"{row['image_name']}.jpg")                                 
                            image =                                             
                    Image.open(img_path).convert('RGB')                         
                            x = self.transform(image)                           
                            y = 1 if                                            
                    row['label']=='malignant' else 0                            
                            return x, y                                         
                                                                                
                    # Dataset for prediction                                    
                    class PredictDataset(Dataset):                              
                        def __init__(self, image_paths,                         
                    transform):                                                 
                            self.image_paths = image_paths                      
                            self.transform = transform                          
                        def __len__(self):                                      
                            return len(self.image_paths)                        
                        def __getitem__(self, idx):                             
                            path = self.image_paths[idx]                        
                            img =                                               
                    Image.open(path).convert('RGB')                             
                            return self.transform(img)                          
                                                                                
                    def train_one_epoch(model, loader,                          
                    criterion, optimizer, device):                              
                        model.train()                                           
                        total_loss = 0.0                                        
                        for xb, yb in loader:                                   
                            xb, yb = xb.to(device),                             
                    yb.to(device,                                               
                    dtype=torch.float32).unsqueeze(1)                           
                            optimizer.zero_grad()                               
                            out = model(xb)                                     
                            loss = criterion(out, yb)                           
                            loss.backward()                                     
                            optimizer.step()                                    
                            total_loss += loss.item() *                         
                    xb.size(0)                                                  
                        return total_loss /                                     
                    len(loader.dataset)                                         
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        all_preds, all_labels = [], []                          
                        with torch.no_grad():                                   
                            for xb, yb in loader:                               
                                xb = xb.to(device)                              
                                out = model(xb)                                 
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatt                      
                    en()                                                        
                                all_preds.extend(probs)                         
                                all_labels.extend(yb.numpy                      
                    ())                                                         
                        return np.array(all_labels),                            
                    np.array(all_preds)                                         
                                                                                
                    def predict(model, image_paths,                             
                    device, transform, batch_size=32):                          
                        """                                                     
                        Predict malignancy probabilities                        
                    for a list of image file paths.                             
                        Args:                                                   
                          model: trained torch.nn.Module                        
                          image_paths: list of strings                          
                    (paths to .jpg files)                                       
                          device: torch.device                                  
                          transform:                                            
                    torchvision.transforms.Compose                              
                          batch_size: int                                       
                        Returns:                                                
                          numpy array of probabilities                          
                    between 0 and 1                                             
                        """                                                     
                        ds = PredictDataset(image_paths,                        
                    transform)                                                  
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False)                       
                        model.eval()                                            
                        preds = []                                              
                        with torch.no_grad():                                   
                            for xb in loader:                                   
                                xb = xb.to(device)                              
                                out = model(xb)                                 
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatt                      
                    en()                                                        
                                preds.extend(probs)                             
                        return np.array(preds)                                  
                                                                                
                    if __name__ == "__main__":                                  
                        # Config                                                
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_FOLDS = 5                                             
                        EPOCHS = 3                                              
                        BATCH_SIZE = 32                                         
                        LR = 1e-4                                               
                        DEVICE = torch.device('cuda' if                         
                    torch.cuda.is_available() else 'cpu')                       
                                                                                
                        # Data and transforms                                   
                        df = pd.read_csv(CSV_PATH)                              
                        df =                                                    
                    df[['image_name','label']].dropna()                         
                        train_transform =                                       
                    transforms.Compose([                                        
                            transforms.Resize((224,224)),                       
                            transforms.RandomHorizontalFli                      
                    p(),                                                        
                            transforms.RandomRotation(15),                      
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,0.                      
                    456,0.406],[0.229,0.224,0.225]),                            
                        ])                                                      
                        val_transform =                                         
                    transforms.Compose([                                        
                            transforms.Resize((224,224)),                       
                            transforms.ToTensor(),                              
                            transforms.Normalize([0.485,0.                      
                    456,0.406],[0.229,0.224,0.225]),                            
                        ])                                                      
                                                                                
                        # 5-fold cross-validation                               
                        skf =                                                   
                    StratifiedKFold(n_splits=N_FOLDS,                           
                    shuffle=True, random_state=42)                              
                        labels =                                                
                    (df['label']=='malignant').astype(int)                      
                    .values                                                     
                        aucs = []                                               
                        for fold, (tr_idx, val_idx) in                          
                    enumerate(skf.split(df, labels), 1):                        
                            dtr = df.iloc[tr_idx]                               
                            dval = df.iloc[val_idx]                             
                            train_ds =                                          
                    SkinLesionDataset(dtr, IMG_DIR,                             
                    train_transform)                                            
                            val_ds =                                            
                    SkinLesionDataset(dval, IMG_DIR,                            
                    val_transform)                                              
                            tr_loader =                                         
                    DataLoader(train_ds,                                        
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                            val_loader =                                        
                    DataLoader(val_ds,                                          
                    batch_size=BATCH_SIZE, shuffle=False,                       
                    num_workers=4)                                              
                            # Model                                             
                            model =                                             
                    timm.create_model('efficientnet_b0',                        
                    pretrained=True, num_classes=1)                             
                            model = model.to(DEVICE)                            
                            criterion =                                         
                    nn.BCEWithLogitsLoss()                                      
                            optimizer =                                         
                    optim.AdamW(model.parameters(), lr=LR)                      
                            # Train                                             
                            for epoch in range(EPOCHS):                         
                                train_one_epoch(model,                          
                    tr_loader, criterion, optimizer,                            
                    DEVICE)                                                     
                            # Eval                                              
                            y_true, y_pred =                                    
                    evaluate(model, val_loader, DEVICE)                         
                            auc = roc_auc_score(y_true,                         
                    y_pred)                                                     
                            print(f"Fold {fold} ROC AUC:                        
                    {auc:.4f}")                                                 
                            aucs.append(auc)                                    
                        avg_auc = np.mean(aucs)                                 
                        print(f"Average ROC AUC across                          
                    {N_FOLDS} folds: {avg_auc:.4f}")                            
                                                                                
                        # Final retraining on full data                         
                        full_ds = SkinLesionDataset(df,                         
                    IMG_DIR, train_transform)                                   
                        full_loader = DataLoader(full_ds,                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4)                                              
                        final_model =                                           
                    timm.create_model('efficientnet_b0',                        
                    pretrained=True,                                            
                    num_classes=1).to(DEVICE)                                   
                        optimizer =                                             
                    optim.AdamW(final_model.parameters(),                       
                    lr=LR)                                                      
                        criterion = nn.BCEWithLogitsLoss()                      
                        for epoch in range(EPOCHS):                             
                            train_one_epoch(final_model,                        
                    full_loader, criterion, optimizer,                          
                    DEVICE)                                                     
                        # Optionally save the final model                       
                        torch.save(final_model.state_dict(                      
                    ),                                                          
                    "./working/final_efficientnet_b0.pth")                      
                        print("Final model trained on full                      
                    dataset and saved.")                                        
                        # Example usage of predict()                            
                        # sample_paths =                                        
                    [os.path.join(IMG_DIR, f"{n}.jpg") for                      
                    n in df['image_name'].values[:5]]                           
                        # probs = predict(final_model,                          
                    sample_paths, DEVICE, val_transform)                        
                        # print("Sample probabilities:",                        
                    probs)                                                      
