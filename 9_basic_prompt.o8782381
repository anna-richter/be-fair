                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        return running_loss /                                   
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    def evaluate(model, loader, device):                        
                        model.eval()                                            
                        all_targets, all_probs = [], []                         
                        with torch.no_grad():                                   
