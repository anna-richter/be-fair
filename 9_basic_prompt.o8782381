                                probs =                                         
                    probs.cpu().numpy().flatten()                               
                            for p, prob in                                      
                    zip(batch_paths, probs):                                    
                                results[p] = prob                               
                        return results                                          
                                                                                
                    def main():                                                 
                        torch.backends.cudnn.benchmark =                        
                    True                                                        
                        csv_path = "./input/mydataset.csv"                      
                        image_dir = "./input/MyImages"                          
