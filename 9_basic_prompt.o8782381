                            logits = model(imgs)                                
                            loss = criterion(logits,                            
                    targets)                                                    
                            loss.backward()                                     
                            optimizer.step()                                    
                            running_loss += loss.item() *                       
                    imgs.size(0)                                                
                        return running_loss /                                   
                    len(loader.dataset)                                         
                                                                                
                                                                                
                    def evaluate_tta(model, loader,                             
                    device):                                                    
                        model.eval()                                            
                        all_targets, all_probs = [], []                         
                        with torch.no_grad():                                   
                            for imgs, targets in loader:                        
                                # imgs shape: [batch, 10,                       
                    C, H, W]                                                    
                                bs, nc, c, h, w =                               
                    imgs.shape                                                  
                                imgs = imgs.view(bs * nc,                       
                    c, h, w).to(device)                                         
                                logits = model(imgs)                            
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().res                     
                    hape(bs, nc)                                                
                                avg_probs =                                     
                    probs.mean(axis=1)                                          
                                all_probs.extend(avg_probs.                     
                    tolist())                                                   
                                all_targets.extend(targets.                     
                    numpy().tolist())                                           
                        return roc_auc_score(all_targets,                       
                    all_probs)                                                  
                                                                                
                                                                                
                    def predict(image_paths,                                    
                    model_path="working/model.pth",                             
                    batch_size=32):                                             
                        """                                                     
                        Given a list of image file paths,                       
                    load the trained model and return                           
                        a dict {image_path:                                     
                    malignancy_probability} using 10-crop                       
                    TTA.                                                        
                        """                                                     
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=False, num_classes=1)                            
                        model.load_state_dict(torch.load(mo                     
                    del_path, map_location=device))                             
                        model.to(device).eval()                                 
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        normalize =                                             
                    transforms.Normalize(mean=mean,                             
                    std=std)                                                    
                        tta_transform = transforms.Compose(                     
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),  #                     
                    returns tuple of PIL Images                                 
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [normalize(transfor                     
                    ms.ToTensor()(crop)) for crop in crops]                     
                                    )                                           
                                ),  # shape: [10, C, H, W]                      
                            ]                                                   
                        )                                                       
                        results = {}                                            
                        for p in image_paths:                                   
                            image =                                             
                    Image.open(p).convert("RGB")                                
                            crops = tta_transform(image)  #                     
                    [10, C, H, W]                                               
                            inputs = crops.to(device)                           
                            with torch.no_grad():                               
                                logits = model(inputs)                          
                                probs =                                         
                    torch.sigmoid(logits).cpu().numpy().fla                     
                    tten()                                                      
                            results[p] =                                        
                    float(probs.mean())                                         
                        return results                                          
                                                                                
                                                                                
                    def main():                                                 
                        # Paths and device                                      
                        csv_path = "./input/mydataset.csv"                      
                        image_dir = "./input/MyImages"                          
                        os.makedirs("working",                                  
                    exist_ok=True)                                              
                        device = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        # Load and prepare data                                 
                        df = pd.read_csv(csv_path)                              
                        df["label"] =                                           
                    df["label"].map(lambda x: 1 if x ==                         
                    "malignant" else 0)                                         
                        train_df, val_df =                                      
                    train_test_split(                                           
                            df, test_size=0.2,                                  
                    stratify=df["label"], random_state=42                       
                        )                                                       
                                                                                
                        # Transforms                                            
                        train_tfms = transforms.Compose(                        
                            [                                                   
                                transforms.RandomResizedCro                     
                    p(224),                                                     
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.ToTensor(),                          
                                transforms.Normalize(mean=[                     
                    0.485, 0.456, 0.406], std=[0.229,                           
                    0.224, 0.225]),                                             
                            ]                                                   
                        )                                                       
                        # TTA transforms for validation                         
                        mean = [0.485, 0.456, 0.406]                            
                        std = [0.229, 0.224, 0.225]                             
                        normalize =                                             
                    transforms.Normalize(mean=mean,                             
                    std=std)                                                    
                        tta_tfms = transforms.Compose(                          
                            [                                                   
                                transforms.Resize(256),                         
                                transforms.TenCrop(224),                        
                                transforms.Lambda(                              
                                    lambda crops:                               
                    torch.stack(                                                
                                        [normalize(transfor                     
                    ms.ToTensor()(crop)) for crop in crops]                     
                                    )                                           
                                ),                                              
                            ]                                                   
                        )                                                       
                                                                                
                        # Datasets and loaders                                  
                        train_ds = SkinDataset(train_df,                        
                    image_dir, transform=train_tfms)                            
                        val_ds = SkinDataset(val_df,                            
                    image_dir, transform=tta_tfms)                              
                        train_loader = DataLoader(train_ds,                     
                    batch_size=32, shuffle=True,                                
                    num_workers=4)                                              
                        val_loader = DataLoader(val_ds,                         
                    batch_size=16, shuffle=False,                               
                    num_workers=4)                                              
                                                                                
                        # Model, loss, optimizer                                
                        model =                                                 
                    timm.create_model("efficientnet_b0",                        
                    pretrained=True, num_classes=1)                             
                        model.to(device)                                        
                        criterion =                                             
                    torch.nn.BCEWithLogitsLoss()                                
                        optimizer =                                             
                    torch.optim.AdamW(model.parameters(),                       
                    lr=1e-4)                                                    
                                                                                
                        # Training loop with TTA evaluation                     
                        best_auc = 0.0                                          
                        for epoch in range(1, 6):                               
                            train_loss =                                        
                    train_one_epoch(model, train_loader,                        
                    criterion, optimizer, device)                               
                            val_auc = evaluate_tta(model,                       
                    val_loader, device)                                         
                            print(f"Epoch {epoch}: Train                        
                    Loss={train_loss:.4f}, Val                                  
                    AUROC={val_auc:.4f}")                                       
                            if val_auc > best_auc:                              
                                best_auc = val_auc                              
                                torch.save(model.state_dict                     
                    (), "working/model.pth")                                    
                        print(f"Best Validation AUROC:                          
                    {best_auc:.4f}")                                            
                                                                                
                        # If sample submission exists or                        
                    test folder, generate predictions                           
                        # 1) sample_submission.csv                              
                        sample_sub =                                            
                    "./input/sample_submission.csv"                             
                        test_dir = "./input/test_images"                        
                        if os.path.exists(sample_sub):                          
                            sub_df =                                            
                    pd.read_csv(sample_sub)                                     
                            image_paths = [                                     
                                os.path.join(image_dir,                         
                    f"{name}.jpg") for name in                                  
                    sub_df.image_name                                           
                            ]                                                   
                            preds = predict(image_paths,                        
                    model_path="working/model.pth")                             
                            sub_df["label"] =                                   
                    sub_df.image_name.map(                                      
                                lambda n:                                       
                    preds.get(os.path.join(image_dir,                           
                    f"{n}.jpg"), 0.0)                                           
                            )                                                   
                            sub_df.to_csv("working/submissi                     
                    on.csv", index=False)                                       
                        # 2) test_images folder                                 
                        elif os.path.isdir(test_dir):                           
                            image_paths =                                       
                    glob.glob(os.path.join(test_dir,                            
                    "*.jpg"))                                                   
                            preds = predict(image_paths,                        
                    model_path="working/model.pth")                             
                            out = []                                            
                            for p, prob in preds.items():                       
                                name =                                          
                    os.path.splitext(os.path.basename(p))[0                     
                    ]                                                           
                                out.append({"image_name":                       
                    name, "label": prob})                                       
                            pd.DataFrame(out).to_csv("worki                     
                    ng/submission.csv", index=False)                            
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        main()                                                  
                                                                                
