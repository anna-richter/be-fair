                            transforms.Normalize(mean=[0.4                      
                    85, 0.456, 0.406], std=[0.229, 0.224,                       
                    0.225]),                                                    
                        ])                                                      
                        results = {}                                            
                        for i in range(0,                                       
                    len(image_paths), batch_size):                              
                            batch_paths =                                       
                    image_paths[i:i+batch_size]                                 
                            batch_imgs = torch.stack(                           
                                [base_tfms(Image.open(p).c                      
                    onvert("RGB")) for p in batch_paths]                        
                            ).to(device)                                        
                            with torch.no_grad():                               
