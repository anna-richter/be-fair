                    0.225]),                                                    
                            ]                                                   
                        )                                                       
                                                                                
                        # 5-fold cross-validation                               
                        skf =                                                   
                    StratifiedKFold(n_splits=N_FOLDS,                           
                    shuffle=True, random_state=42)                              
                        labels = (df["label"] ==                                
                    "malignant").astype(int).values                             
                        aucs = []                                               
                        for fold, (tr_idx, val_idx) in                          
                    enumerate(skf.split(df, labels), 1):                        
                            dtr = df.iloc[tr_idx]                               
                            dval = df.iloc[val_idx]                             
                            train_ds =                                          
                    SkinLesionDataset(dtr, IMG_DIR,                             
                    train_transform)                                            
                            val_ds =                                            
                    SkinLesionDataset(dval, IMG_DIR,                            
                    val_transform)                                              
                            tr_loader = DataLoader(                             
                                train_ds,                                       
                    batch_size=BATCH_SIZE, shuffle=True,                        
                    num_workers=4                                               
                            )                                                   
