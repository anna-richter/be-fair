                        ds = PredictDataset(image_paths,                        
                    transform)                                                  
                        loader = DataLoader(ds,                                 
                    batch_size=batch_size, shuffle=False)                       
                        model.eval()                                            
                        preds = []                                              
                        with torch.no_grad():                                   
                            for xb in loader:                                   
                                xb = xb.to(device)                              
                                out = model(xb)                                 
                                probs =                                         
                    torch.sigmoid(out).cpu().numpy().flatte                     
                    n()                                                         
                                preds.extend(probs)                             
                        return np.array(preds)                                  
                                                                                
                                                                                
                    if __name__ == "__main__":                                  
                        # Config                                                
                        IMG_DIR = "./input/MyImages"                            
                        CSV_PATH = "./input/mydataset.csv"                      
                        N_FOLDS = 5                                             
                        EPOCHS = 3                                              
                        BATCH_SIZE = 32                                         
                        LR = 1e-4                                               
                        DEVICE = torch.device("cuda" if                         
                    torch.cuda.is_available() else "cpu")                       
                                                                                
                        # Data and transforms                                   
                        df = pd.read_csv(CSV_PATH)                              
                        df = df[["image_name",                                  
                    "label"]].dropna()                                          
                        train_transform =                                       
                    transforms.Compose(                                         
                            [                                                   
                                transforms.Resize((224,                         
                    224)),                                                      
                                transforms.RandomHorizontal                     
                    Flip(),                                                     
                                transforms.RandomRotation(1                     
                    5),                                                         
